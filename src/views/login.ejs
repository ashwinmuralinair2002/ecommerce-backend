<!-- Login page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />
    <title>SoundWave | Login</title>
    <%- include('./partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <script>
        async function handleLogin() {
            // Clear previous messages
            const msgContainer = document.getElementById('auth-message');
            msgContainer.classList.add('hidden');
            msgContainer.textContent = '';
            msgContainer.className = 'hidden mt-4 p-3 rounded-lg text-sm font-medium text-center transition-all duration-300';

            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            const submitButton = document.getElementById('loginBtn');
            const btnText = submitButton.querySelector('.btn-text');

            const email = emailInput.value.trim();
            const password = passwordInput.value;

            // Helper for showing message
            const showMessage = (msg, type) => {
                msgContainer.textContent = msg;
                msgContainer.classList.remove('hidden');
                if (type === 'error') {
                    msgContainer.classList.add('bg-red-100', 'text-red-700');
                    msgContainer.classList.remove('bg-primary-light/40', 'text-primary');
                } else {
                    msgContainer.classList.add('bg-primary-light/40', 'text-primary');
                    msgContainer.classList.remove('bg-red-100', 'text-red-700');
                }
            };

            if (!email || !password) {
                showMessage('Please fill in all fields.', 'error');
                return;
            }

            // Disable button and show loading state without shifting layout
            submitButton.disabled = true;
            btnText.textContent = 'Logging in...';

            if (!submitButton.querySelector('.btn-spinner')) {
                const spinner = document.createElement('span');
                spinner.className = 'btn-spinner';
                submitButton.prepend(spinner);
            }

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                let data;
                try {
                    data = await response.json();
                } catch {
                    throw new Error("Invalid server response");
                }

                if (!response.ok) {
                    if (data.success === false && data.errors && data.errors.length > 0) {
                        throw new Error(data.errors?.[0]?.message || 'Validation failed');
                    } else if (data.message) {
                        throw new Error(data.message);
                    }
                    // Handle Blocked User
                    if (response.status === 403 && data.error === 'User account is blocked') {
                        throw new Error('This account is currently unavailable. Please contact support if needed.');
                    }
                    throw new Error(data.error || "Something went wrong");
                }

                // Success: Session cookie is handled by browser automatically

                showMessage('Login Successful! Redirecting...', 'success');

                // Redirect
                setTimeout(() => {
                    if (data.redirect) {
                        window.location.replace(data.redirect);
                    } else if (data.user && data.user.role === 'admin') {
                        window.location.replace('/admin/dashboard');
                    } else {
                        window.location.replace('/');
                    }
                }, 1000);

            } catch (error) {
                showMessage(error.message, 'error');
            } finally {
                submitButton.disabled = false;
                btnText.textContent = 'Log In';

                const spinnerEl = submitButton.querySelector('.btn-spinner');
                if (spinnerEl) spinnerEl.remove();
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const submitButton = document.getElementById('loginBtn');
            if (submitButton) {
                submitButton.addEventListener('click', (e) => {
                    e.preventDefault(); // Prevent implicit form submission if any
                    handleLogin();
                });
            }

            const forgotPasswordBtn = document.getElementById('forgot-password-btn');
            if (forgotPasswordBtn) {
                forgotPasswordBtn.addEventListener('click', () => {
                    window.location.replace('/forgot-password');
                });
            }

            const createAccountBtn = document.getElementById('create-account-btn');
            if (createAccountBtn) {
                createAccountBtn.addEventListener('click', () => {
                    window.location.replace('/signup');
                });
            }

            const urlParams = new URLSearchParams(window.location.search);
            const errorParam = urlParams.get('error');
            const messageParam = urlParams.get('message');

            const msgContainer = document.getElementById('auth-message');

            const showMessage = (msg, type) => {
                msgContainer.textContent = msg;
                msgContainer.classList.remove('hidden');
                if (type === 'error') {
                    msgContainer.classList.add('bg-red-100', 'text-red-700');
                } else {
                    msgContainer.classList.add('bg-primary-light/40', 'text-primary');
                }
            };

            if (errorParam) {
                if (errorParam === 'account_unavailable') {
                    Swal.fire({
                        title: 'Access Restricted',
                        text: 'This account is currently unavailable. Please contact support if needed.',
                        icon: 'warning'
                    });
                } else {
                    showMessage(decodeURIComponent(errorParam), 'error');
                }
            } else if (messageParam) {
                showMessage(decodeURIComponent(messageParam), 'success'); // or neutral
            }

            // Clean URL param
            if (errorParam || messageParam) {
                window.history.replaceState({}, document.title, window.location.pathname);
            }

        });
    </script>
</head>

<body>
    <div class="theme-auth-shell relative flex min-h-screen w-full flex-col overflow-x-hidden"
        style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
        <header class="theme-top-nav flex items-center justify-between border-b px-10 py-3">
            <div class="flex items-center gap-4 text-white">
                <div class="size-4">
                    <svg viewBox="0 0 48 48" fill="none">
                        <path
                            d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462C2.19985 28.361 1.76794 23.9758 2.60947 19.7452C3.451 15.5145 5.52816 11.6284 8.57829 8.5783C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948C23.9758 1.76795 28.361 2.19986 32.3462 3.85057C36.3314 5.50129 39.7376 8.29668 42.134 11.8833C44.5305 15.4698 45.8096 19.6865 45.8096 24L24 24L24 45.8096Z"
                            fill="currentColor" />
                    </svg>
                </div>
                <h2 class="text-lg font-bold tracking-tight">SoundWave</h2>
            </div>
        </header>

        <main class="flex flex-1 items-center justify-center px-4 py-8">
            <div class="theme-auth-card w-full max-w-md p-8">
                <h2 class="text-center text-[28px] font-bold text-primary mb-6">
                    Log in to SoundWave
                </h2>

                <div class="relative mb-4">
                    <input type="text" id="email" placeholder="Email / Phone Number"
                        class="peer form-input h-14 w-full rounded-lg border border-primary-light/70 bg-white px-4 pt-4 text-base placeholder-transparent focus:border-primary focus:outline-none" />
                    <label for="email"
                        class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-primary/80 peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-primary pointer-events-none">
                        Email / Phone Number
                    </label>
                </div>

                <div class="relative mb-6">
                    <input type="password" id="password" placeholder="Password"
                        class="peer form-input h-14 w-full rounded-lg border border-primary-light/70 bg-white px-4 pt-4 pr-10 text-base placeholder-transparent focus:border-primary focus:outline-none" />
                    <label for="password"
                        class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-primary/80 peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-primary pointer-events-none">
                        Password
                    </label>
                    <button type="button" onclick="togglePasswordVisibility('password', 'login-pass-icon')"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-primary/80 hover:text-primary focus:outline-none p-1">
                        <span id="login-pass-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </button>
                </div>

                <button id="loginBtn"
                    class="theme-primary-btn mb-3 h-10 w-full rounded-lg text-sm flex items-center justify-center gap-2">
                    <span class="btn-text">Log In</span>
                </button>

                <button onclick="window.location.replace('/api/auth/google')"
                    class="theme-secondary-btn mb-4 h-10 w-full rounded-lg text-sm">
                    Log in with Google
                </button>

                <!-- Auth Message Container -->
                <div id="auth-message"
                    class="hidden mt-4 p-3 rounded-lg text-sm font-medium text-center transition-all duration-300">
                </div>

                <div class="flex flex-col items-center gap-2">
                    <button id="forgot-password-btn" class="text-sm text-primary">Forgot Password?</button>
                    <button id="create-account-btn" class="text-sm text-primary">Create Account</button>
                </div>
            </div>
        </main>
    </div>
</body>

</html>
