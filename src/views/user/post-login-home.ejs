<!-- Authenticated user home page template -->
<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <title>SoundWave | Home</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-background-soft" style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

    <%- include('../partials/user/navbar') %>

        <!-- ================= CONTENT ================= -->
        <main class="max-w-[1200px] mx-auto px-10 py-10 space-y-14">

            <!-- Categories -->
            <section>
                <h2 class="text-xl font-bold text-primary mb-6">Product Categories</h2>
                <% if (categories && categories.length> 0) { %>
                    <div class="grid grid-cols-<%= Math.min(categories.length, 5) %> gap-6">
                        <% categories.forEach(cat=> { %>
                            <% const categoryImage = (cat.image && cat.image.url) ? cat.image.url : '/images/placeholder.png'; %>
                            <div class="text-center space-y-3">
                                <div class="aspect-square bg-cover bg-center rounded-lg"
                                    style="background-image:url('<%= categoryImage %>')"></div>
                                <p class="font-medium">
                                    <%= cat.name %>
                                </p>
                            </div>
                            <% }) %>
                    </div>
                    <% } else { %>
                        <p class="text-primary/80 text-sm">No categories available at the moment.</p>
                        <% } %>
            </section>

            <!-- Best Sellers -->
            <section>
                <h2 class="text-xl font-bold text-primary mb-4">Best Sellers</h2>
                <% if (bestSellers && bestSellers.length> 0) { %>
                    <div class="grid grid-cols-4 gap-6">
                        <% bestSellers.forEach(function(product) { %>
                            <% var heroImg = (product.variants && product.variants[0] && product.variants[0].images && product.variants[0].images[0]) ? product.variants[0].images[0] : null; %>
                                <a href="/product/<%= product._id %>"
                                    class="group bg-white rounded-xl overflow-hidden border border-primary-light/45 hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
                                    <div class="aspect-square overflow-hidden bg-primary-light/20">
                                        <img src="<%= heroImg ? heroImg.url : '' %>" alt="<%= product.title %>"
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                    </div>
                                    <div class="p-4 space-y-1">
                                        <p class="font-medium text-primary text-sm leading-tight truncate">
                                            <%= product.title %>
                                        </p>
                                        <p class="inline-flex items-center rounded-md bg-accent px-2 py-0.5 text-sm font-bold text-black">₹ <%=
                                                product.price.toLocaleString('en-IN') %>
                                        </p>
                                        <% if (product.originalPrice && product.originalPrice> product.price) { %>
                                            <p class="text-xs text-gray-400 line-through">₹ <%=
                                                    product.originalPrice.toLocaleString('en-IN') %>
                                            </p>
                                            <% } %>
                                    </div>
                                </a>
                                <% }) %>
                    </div>
                    <% } else { %>
                        <p class="text-primary/80 text-sm py-6 text-center">No products available</p>
                        <% } %>
            </section>

            <!-- New Arrivals -->
            <section>
                <h2 class="text-xl font-bold text-primary mb-4">New Arrivals</h2>
                <% if (newArrivals && newArrivals.length> 0) { %>
                    <div class="grid grid-cols-4 gap-6">
                        <% newArrivals.forEach(function(product) { %>
                            <% var heroImg = (product.variants && product.variants[0] && product.variants[0].images && product.variants[0].images[0]) ? product.variants[0].images[0] : null; %>
                                <a href="/product/<%= product._id %>"
                                    class="group bg-white rounded-xl overflow-hidden border border-primary-light/45 hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
                                    <div class="aspect-square overflow-hidden bg-primary-light/20">
                                        <img src="<%= heroImg ? heroImg.url : '' %>" alt="<%= product.title %>"
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                    </div>
                                    <div class="p-4 space-y-1">
                                        <p class="font-medium text-primary text-sm leading-tight truncate">
                                            <%= product.title %>
                                        </p>
                                        <p class="inline-flex items-center rounded-md bg-accent px-2 py-0.5 text-sm font-bold text-black">₹ <%=
                                                product.price.toLocaleString('en-IN') %>
                                        </p>
                                        <% if (product.originalPrice && product.originalPrice> product.price) { %>
                                            <p class="text-xs text-gray-400 line-through">₹ <%=
                                                    product.originalPrice.toLocaleString('en-IN') %>
                                            </p>
                                            <% } %>
                                    </div>
                                </a>
                                <% }) %>
                    </div>
                    <% } else { %>
                        <p class="text-primary/80 text-sm py-6 text-center">No products available</p>
                        <% } %>
            </section>

            <!-- Today's Deals -->
            <section>
                <h2 class="text-xl font-bold text-primary mb-4">Today's Deals</h2>
                <% if (deals && deals.length> 0) { %>
                    <div class="grid grid-cols-4 gap-6">
                        <% deals.forEach(function(product) { %>
                            <% var heroImg = (product.variants && product.variants[0] && product.variants[0].images && product.variants[0].images[0]) ? product.variants[0].images[0] : null; %>
                                <a href="/product/<%= product._id %>"
                                    class="group bg-white rounded-xl overflow-hidden border border-primary-light/45 hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
                                    <div class="aspect-square overflow-hidden bg-primary-light/20">
                                        <img src="<%= heroImg ? heroImg.url : '' %>" alt="<%= product.title %>"
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                    </div>
                                    <div class="p-4 space-y-1">
                                        <p class="font-medium text-primary text-sm leading-tight truncate">
                                            <%= product.title %>
                                        </p>
                                        <p class="inline-flex items-center rounded-md bg-accent px-2 py-0.5 text-sm font-bold text-black">₹ <%=
                                                product.price.toLocaleString('en-IN') %>
                                        </p>
                                        <% if (product.originalPrice && product.originalPrice> product.price) { %>
                                            <p class="text-xs text-gray-400 line-through">₹ <%=
                                                    product.originalPrice.toLocaleString('en-IN') %>
                                            </p>
                                            <% } %>
                                    </div>
                                </a>
                                <% }) %>
                    </div>
                    <% } else { %>
                        <p class="text-primary/80 text-sm py-6 text-center">No products available</p>
                        <% } %>
            </section>

        </main>

        <footer class="flex justify-center border-t border-primary-light/45 mt-10">
            <div class="flex max-w-[960px] flex-1 flex-col">
                <footer class="flex flex-col gap-6 px-5 py-10 text-center @container">
                    <div
                        class="flex flex-wrap items-center justify-center gap-6 @[480px]:flex-row @[480px]:justify-around">
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">About</a>
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Support</a>
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Contact</a>
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Privacy
                            Policy</a>
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Terms of
                            Service</a>
                    </div>

                    <div class="flex flex-wrap justify-center gap-4">
                        <a href="#" class="text-primary hover:text-primary">
                            <!-- Twitter -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="currentColor" class="size-6">
                                <path
                                    d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                            </svg>
                        </a>
                        <a href="#" class="text-primary hover:text-primary">
                            <!-- Instagram -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="currentColor" class="size-6">
                                <path
                                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                            </svg>
                        </a>
                        <a href="#" class="text-primary hover:text-primary">
                            <!-- Facebook -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="currentColor" class="size-6">
                                <path
                                    d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                            </svg>
                        </a>
                    </div>

                    <p class="text-primary text-base font-normal leading-normal">
                        ©2024 SoundWave. All rights reserved.
                    </p>
                </footer>
            </div>
        </footer>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('signup') === 'success') {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.onmouseenter = Swal.stopTimer;
                            toast.onmouseleave = Swal.resumeTimer;
                        }
                    });

                    Toast.fire({
                        icon: 'success',
                        title: 'Account created successfully. Welcome to SoundWave!'
                    });

                    // Clean URL
                    const url = new URL(window.location);
                    url.searchParams.delete('signup');
                    window.history.replaceState({}, '', url);
                }
            });
        </script>
</body>

</html>
