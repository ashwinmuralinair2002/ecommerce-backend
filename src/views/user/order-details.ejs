<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SoundWave | <%= order.orderId %></title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .price-breakdown-card {
            margin-top: 10px;
            padding: 10px;
            border-top: 1px solid #eee;
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            margin: 4px 0;
        }

        .price-row.discount {
            color: #28a745;
        }

        .price-row.gst {
            color: #555;
        }

        .price-row.total {
            border-top: 1px dashed #ccc;
            margin-top: 6px;
            padding-top: 6px;
            font-size: 15px;
        }
    </style>
</head>

<body>
<%- include('../partials/user/currency-helper') %>
<%
    const orderData = order || {};
    const items = Array.isArray(orderData.items) ? orderData.items : [];
    const pricing = orderData.pricing || {};
    const address = orderData.shippingAddress || {};
    const pricingSubtotal = pricing.subtotal ?? orderData.totalAmount ?? 0;
    const offerDiscountTotal = pricing.offerDiscountTotal ?? 0;
    const couponDiscount = pricing.couponDiscount ?? 0;
    const gst = pricing.gst ?? 0;
    const finalTotal = pricing.finalTotal ?? orderData.totalAmount ?? 0;
    const totalSaved = Number(offerDiscountTotal || 0) + Number(couponDiscount || 0);

    const formatDate = (value) => value ? new Date(value).toLocaleDateString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    }) : 'N/A';
    const formatStatusLabel = (status) => {
        const normalizedStatus = String(status || '').toLowerCase();

        if (!normalizedStatus) {
            return 'Pending';
        }

        return normalizedStatus
            .split('_')
            .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
            .join(' ');
    };
    const getStatusClasses = (status) => {
        const normalizedStatus = String(status || '').toLowerCase();

        if (normalizedStatus === 'pending') {
            return 'bg-yellow-100 text-yellow-800 border-yellow-200';
        }

        if (normalizedStatus === 'shipped') {
            return 'bg-blue-100 text-blue-800 border-blue-200';
        }

        if (normalizedStatus === 'delivered') {
            return 'bg-green-100 text-green-800 border-green-200';
        }

        if (normalizedStatus === 'cancelled') {
            return 'bg-red-100 text-red-700 border-red-200';
        }

        if (normalizedStatus === 'partially_cancelled') {
            return 'bg-orange-100 text-orange-700 border-orange-200';
        }

        if (normalizedStatus === 'return_requested') {
            return 'bg-orange-100 text-orange-700 border-orange-200';
        }

        if (normalizedStatus === 'return_rejected') {
            return 'bg-red-100 text-red-700 border-red-200';
        }

        if (normalizedStatus === 'returned') {
            return 'bg-green-100 text-green-800 border-green-200';
        }

        return 'bg-gray-100 text-gray-700 border-gray-200';
    };
%>

    <div class="relative flex min-h-screen w-full flex-col bg-white"
        style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

        <%- include('../partials/user/navbar') %>

        <main class="flex flex-1 gap-0 px-0 py-0 bg-white">
            <%- include('../partials/user/account-sidebar', { activePage: 'orders' }) %>

            <section class="flex-1 bg-white p-6">
                <nav class="mb-3 flex text-sm text-gray-500" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-2">
                        <li class="inline-flex items-center">
                            <a href="/home" class="inline-flex items-center text-gray-500 hover:text-primary">Home</a>
                        </li>
                        <li class="inline-flex items-center">
                            <div class="flex items-center">
                                <span class="mx-2 text-gray-400">/</span>
                                <a href="/orders" class="text-gray-500 hover:text-primary">My Orders</a>
                            </div>
                        </li>
                        <li aria-current="page">
                            <div class="flex items-center">
                                <span class="mx-2 text-gray-400">/</span>
                                <span class="font-medium text-primary"><%= orderData.orderId %></span>
                            </div>
                        </li>
                    </ol>
                </nav>

                <div class="grid grid-cols-1 gap-5 xl:grid-cols-12 xl:gap-8">
                    <section class="space-y-4 xl:col-span-8">
                        <div class="rounded-2xl border border-primary-light/40 bg-white p-5 shadow-sm">
                            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                                <div>
                                    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary/70">Order Details</p>
                                    <h1 class="mt-2 text-3xl font-bold text-primary"><%= orderData.orderId %></h1>
                                    <p class="mt-2 text-sm text-gray-500">Placed on <%= formatDate(orderData.createdAt) %></p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm text-gray-500">Order Status:</span>
                                    <span
                                        id="order-status-badge"
                                        data-status="<%= orderData.orderStatus || 'pending' %>"
                                        class="inline-flex items-center self-start rounded-full border px-3 py-1 text-xs font-semibold <%= getStatusClasses(orderData.orderStatus) %>">
                                        <%= formatStatusLabel(orderData.orderStatus) %>
                                    </span>
                                </div>
                            </div>

                            <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
                                <div class="rounded-xl bg-background-soft px-4 py-3">
                                    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Payment</p>
                                    <p class="mt-1 text-base font-bold text-primary"><%= orderData.paymentMethod || 'COD' %></p>
                                </div>
                                <div class="rounded-xl bg-background-soft px-4 py-3">
                                    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Items</p>
                                    <p class="mt-1 text-base font-bold text-primary"><%= Number(pricing.totalItems || 0) %></p>
                                </div>
                                <div class="rounded-xl bg-background-soft px-4 py-3">
                                    <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Total</p>
                                    <p class="mt-1 text-base font-bold text-primary"><%= formatCurrency(finalTotal) %></p>
                                </div>
                            </div>
                        </div>

                        <div class="rounded-2xl border border-primary-light/40 bg-white p-5 shadow-sm">
                            <h2 class="text-xl font-bold text-primary">Items</h2>
                            <p class="mt-1 text-sm text-gray-500">Products included in this order.</p>

                            <% if (items.length === 0) { %>
                                <div class="mt-4 rounded-xl border border-dashed border-primary-light/45 px-4 py-8 text-sm text-gray-500">
                                    No order items available.
                                </div>
                            <% } else { %>
                                <div class="mt-5 space-y-4">
                                    <% items.forEach((item) => { %>
                                        <% const itemBasePrice = item.priceSnapshot ?? item.price ?? 0; %>
                                        <% const itemOfferDiscount = item.offerDiscount ?? 0; %>
                                        <% const itemGST = item.gstAmount || 0; %>
                                        <% const itemFinalPrice = item.finalPrice || item.priceSnapshot || item.price || 0; %>
                                        <% const itemDisplayTotal = item.finalPrice ?? item.totalPrice ?? item.priceSnapshot ?? item.price ?? 0; %>
                                        <article data-order-item class="rounded-xl border border-primary-light/35 bg-white p-4 transition hover:shadow-md">
                                            <div class="flex flex-col gap-4 lg:flex-row lg:items-center">
                                                <a href="<%= item.productId ? `/product/${item.productId}` : '#' %>"
                                                    class="block min-w-0 flex-1 cursor-pointer rounded-lg transition hover:bg-gray-50">
                                                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                                                        <div class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-xl border border-primary-light/35 bg-gray-100">
                                                            <img
                                                                src="<%= item.imageUrl && item.imageUrl.trim() !== '' ? item.imageUrl : '/images/placeholder.png' %>"
                                                                alt="<%= item.productName || 'Product image' %>"
                                                                class="h-full w-full object-cover">
                                                        </div>

                                                        <div class="min-w-0 flex-1">
                                                            <h3 class="text-lg font-bold text-primary"><%= item.productName || 'Product' %></h3>
                                                            <p class="mt-1 text-sm text-gray-500">Variant: <%= item.colorName || 'Default' %></p>
                                                            <div class="mt-3 flex flex-wrap gap-2">
                                                                <span class="rounded-full bg-background-soft px-3 py-1 text-xs font-medium text-primary">Qty: <%= Number(item.quantity || 0) %></span>
                                                                <span class="rounded-full bg-background-soft px-3 py-1 text-xs font-medium text-primary">Unit Price: <%= formatCurrency(item.priceSnapshot ?? item.price ?? 0) %></span>
                                                            </div>
                                                            <div class="price-breakdown-card">
                                                                <div class="price-row">
                                                                    <span>Base Price</span>
                                                                    <span><%= formatCurrency(itemBasePrice) %></span>
                                                                </div>
                                                                <% if (Number(itemOfferDiscount || 0) > 0) { %>
                                                                    <div class="price-row discount">
                                                                        <span>Offer Discount</span>
                                                                        <span>- <%= formatCurrency(itemOfferDiscount) %></span>
                                                                    </div>
                                                                <% } %>
                                                                <% if (item.couponDiscount && item.couponDiscount > 0) { %>
                                                                  <div class="text-sm text-green-600">
                                                                    Coupon Discount: -₹<%= item.couponDiscount.toFixed(2) %>
                                                                  </div>
                                                                <% } %>
                                                                <% if (Number(itemGST || 0) > 0) { %>
                                                                    <div class="price-row gst">
                                                                        <span>GST</span>
                                                                        <span><%= formatCurrency(itemGST) %></span>
                                                                    </div>
                                                                <% } %>
                                                                <div class="price-row total">
                                                                    <span><strong>Final Price</strong></span>
                                                                    <span><strong><%= formatCurrency(itemFinalPrice) %></strong></span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>

                                                <div class="flex flex-col items-start gap-3 lg:items-end">
                                                    <span
                                                        data-item-status-badge
                                                        data-status="<%= item.status || orderData.orderStatus || 'pending' %>"
                                                        class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold capitalize <%= getStatusClasses(item.status || orderData.orderStatus) %>">
                                                        <%= formatStatusLabel(item.status || orderData.orderStatus || 'pending') %>
                                                    </span>

                                                    <div class="text-left lg:text-right">
                                                        <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Item Total</p>
                                                        <p class="mt-1 text-lg font-bold text-primary"><%= formatCurrency(itemDisplayTotal) %></p>
                                                    </div>

                                                    <% if (item.status === 'pending' && item.itemId) { %>
                                                        <button
                                                            type="button"
                                                            data-cancel-item-btn
                                                            data-order-id="<%= orderData.orderId || '' %>"
                                                            data-item-id="<%= item.itemId || '' %>"
                                                            class="theme-secondary-btn inline-flex h-9 items-center justify-center rounded-lg px-4 text-sm font-medium transition">
                                                            Cancel Item
                                                        </button>
                                                    <% } %>

                                                    <% if (item.status === 'delivered' && item.itemId) { %>
                                                        <button
                                                            type="button"
                                                            data-return-item-btn
                                                            data-order-id="<%= orderData.orderId %>"
                                                            data-item-id="<%= item.itemId %>"
                                                            class="theme-secondary-btn inline-flex h-9 items-center justify-center rounded-lg px-4 text-sm font-medium transition">
                                                            Return Item
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </article>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </section>

                    <aside class="space-y-5 xl:col-span-4">
                        <div class="rounded-2xl border border-primary-light/45 bg-white p-5 shadow-sm">
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <h2 class="text-xl font-bold text-primary">Price Breakdown</h2>
                                    <p class="mt-1 text-sm text-gray-500">Final bill summary for this order.</p>
                                </div>
                                <button type="button" onclick="downloadInvoice()"
                                    class="theme-secondary-btn inline-flex h-10 items-center justify-center rounded-lg px-4 text-sm font-medium transition">
                                    Download Invoice
                                </button>
                            </div>

                            <div class="mt-5 space-y-3 border-b border-primary-light/35 pb-4 text-sm">
                                <div class="flex items-center justify-between">
                                    <span class="text-gray-500">Total Items</span>
                                    <span class="font-semibold text-primary"><%= Number(pricing.totalItems || 0) %></span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-gray-500">Subtotal</span>
                                    <span class="font-semibold text-primary"><%= formatCurrency(pricingSubtotal) %></span>
                                </div>
                                <% if (Number(offerDiscountTotal || 0) > 0) { %>
                                    <div class="flex items-center justify-between">
                                        <span class="text-gray-500">Offer Discount</span>
                                        <span class="font-semibold text-green-600">-<%= formatCurrency(offerDiscountTotal) %></span>
                                    </div>
                                <% } %>
                                <% if (orderData.coupon && Number(couponDiscount || 0) > 0) { %>
                                    <div class="rounded-xl bg-background-soft px-3 py-2 text-xs text-primary">
                                        Coupon Applied: <strong><%= orderData.coupon.code %></strong>
                                    </div>
                                <% } %>
                                <% if (Number(couponDiscount || 0) > 0) { %>
                                    <div class="flex items-center justify-between">
                                        <span class="text-gray-500">Coupon Discount</span>
                                        <span class="font-semibold text-green-600">-<%= formatCurrency(couponDiscount) %></span>
                                    </div>
                                <% } %>
                                <div class="flex items-center justify-between">
                                    <span class="text-gray-500">GST</span>
                                    <span class="font-semibold text-primary"><%= formatCurrency(gst) %></span>
                                </div>
                            </div>

                            <% if (!orderData.pricing) { %>
                                <p class="mt-4 text-sm text-gray-500">Detailed pricing unavailable for older orders.</p>
                            <% } %>

                            <% if (totalSaved > 0) { %>
                                <p class="mt-4 text-sm font-medium text-green-700">You saved <%= formatCurrency(totalSaved) %></p>
                            <% } %>

                            <div class="mt-4 flex items-center justify-between">
                                <span class="text-base font-bold text-primary">Grand Total</span>
                                <span class="text-xl font-bold text-primary"><%= formatCurrency(finalTotal) %></span>
                            </div>
                        </div>

                        <div class="rounded-2xl border border-primary-light/45 bg-white p-5 shadow-sm">
                            <h2 class="text-xl font-bold text-primary">Shipping Address</h2>
                            <p class="mt-1 text-sm text-gray-500">Delivery details for this order.</p>

                            <div class="mt-4 rounded-xl bg-background-soft px-4 py-4 text-sm">
                                <p class="font-semibold text-primary"><%= address.name || 'Customer' %></p>
                                <p class="mt-2 text-gray-600"><%= address.phone || 'Phone not available' %></p>
                                <p class="mt-2 text-gray-600"><%= address.addressLine1 || 'Address not available' %></p>
                                <p class="mt-1 text-gray-600"><%= [address.city, address.state, address.pincode].filter(Boolean).join(', ') || 'Location not available' %></p>
                            </div>
                        </div>
                    </aside>
                </div>
            </section>
        </main>
    </div>

    <script>
        const ORDER_STATUS_STYLES = {
            pending: 'bg-yellow-100 text-yellow-800 border-yellow-200',
            shipped: 'bg-blue-100 text-blue-800 border-blue-200',
            delivered: 'bg-green-100 text-green-800 border-green-200',
            cancelled: 'bg-red-100 text-red-700 border-red-200',
            partially_cancelled: 'bg-orange-100 text-orange-700 border-orange-200',
            return_requested: 'bg-orange-100 text-orange-700 border-orange-200',
            return_rejected: 'bg-red-100 text-red-700 border-red-200',
            returned: 'bg-green-100 text-green-800 border-green-200'
        };

        function formatStatusLabel(status) {
            const normalizedStatus = String(status || 'pending').toLowerCase();

            return normalizedStatus
                .split('_')
                .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
                .join(' ');
        }

        function getStatusClasses(status) {
            return ORDER_STATUS_STYLES[String(status || 'pending').toLowerCase()] || 'bg-gray-100 text-gray-700 border-gray-200';
        }

        function updateStatusBadge(element, status) {
            if (!element) {
                return;
            }

            const normalizedStatus = String(status || 'pending').toLowerCase();
            const allStatusClasses = Object.values(ORDER_STATUS_STYLES).join(' ').split(' ');

            element.classList.remove(...allStatusClasses);
            element.classList.add(...getStatusClasses(normalizedStatus).split(' '));
            element.dataset.status = normalizedStatus;
            element.textContent = formatStatusLabel(normalizedStatus);
        }

        function downloadInvoice() {
            const orderId = "<%= orderData.orderId || '' %>";

            if (!orderId) {
                return;
            }

            window.open(`/api/invoice/${orderId}`, '_blank');
        }

        function getCancellationReasonModalHtml() {
            return `
                <div class="space-y-3 text-left">
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="cancel-reason" value="Found a better price" class="h-4 w-4">
                        <span>Found a better price</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="cancel-reason" value="Ordered by mistake" class="h-4 w-4">
                        <span>Ordered by mistake</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="cancel-reason" value="Delivery taking too long" class="h-4 w-4">
                        <span>Delivery taking too long</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="cancel-reason" value="Changed my mind" class="h-4 w-4">
                        <span>Changed my mind</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="cancel-reason" value="Other" class="h-4 w-4">
                        <span>Other</span>
                    </label>
                    <textarea
                        id="cancel-reason-other"
                        maxlength="1000"
                        placeholder="Tell us the reason"
                        class="hidden w-full rounded-lg border border-primary-light/40 px-3 py-2 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"></textarea>
                </div>
            `;
        }

        function bindCancellationReasonInteractions() {
            const radioButtons = document.querySelectorAll('input[name="cancel-reason"]');
            const otherInput = document.getElementById('cancel-reason-other');

            if (!radioButtons.length || !otherInput) {
                return;
            }

            radioButtons.forEach((radio) => {
                radio.addEventListener('change', () => {
                    const showOtherInput = radio.checked && radio.value === 'Other';
                    otherInput.classList.toggle('hidden', !showOtherInput);

                    if (showOtherInput) {
                        otherInput.focus();
                    } else {
                        otherInput.value = '';
                    }
                });
            });
        }

        function getReturnReasonModalHtml() {
            return `
                <div class="space-y-3 text-left">
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="return-reason" value="Damaged or defective product" class="h-4 w-4">
                        <span>Damaged or defective product</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="return-reason" value="Product not as described" class="h-4 w-4">
                        <span>Product not as described</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="return-reason" value="Wrong item received" class="h-4 w-4">
                        <span>Wrong item received</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="return-reason" value="Poor quality" class="h-4 w-4">
                        <span>Poor quality</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="return-reason" value="No longer needed" class="h-4 w-4">
                        <span>No longer needed</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-lg border border-primary-light/30 px-3 py-2">
                        <input type="radio" name="return-reason" value="Other" class="h-4 w-4">
                        <span>Other</span>
                    </label>
                    <textarea
                        id="return-reason-other"
                        maxlength="1000"
                        placeholder="Tell us the reason"
                        class="hidden w-full rounded-lg border border-primary-light/40 px-3 py-2 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"></textarea>
                </div>
            `;
        }

        function bindReturnReasonInteractions() {
            const radioButtons = document.querySelectorAll('input[name="return-reason"]');
            const otherInput = document.getElementById('return-reason-other');

            if (!radioButtons.length || !otherInput) {
                return;
            }

            radioButtons.forEach((radio) => {
                radio.addEventListener('change', () => {
                    const showOtherInput = radio.checked && radio.value === 'Other';
                    otherInput.classList.toggle('hidden', !showOtherInput);

                    if (showOtherInput) {
                        otherInput.focus();
                    } else {
                        otherInput.value = '';
                    }
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const orderStatusBadge = document.getElementById('order-status-badge');
            const cancelButtons = document.querySelectorAll('[data-cancel-item-btn]');
            const returnButtons = document.querySelectorAll('[data-return-item-btn]');

            cancelButtons.forEach((button) => {
                button.addEventListener('click', async (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    if (button.dataset.loading === 'true') return;
                    button.dataset.loading = 'true';

                    const orderId = button.dataset.orderId;
                    const itemId = button.dataset.itemId;

                    if (!orderId || !itemId) {
                        button.dataset.loading = 'false';
                        await Swal.fire('Error', 'Missing cancellation details for this item.', 'error');
                        return;
                    }

                    button.disabled = true;
                    button.classList.add('opacity-50', 'pointer-events-none');

                    const confirmation = await Swal.fire({
                        title: 'Cancel this item?',
                        html: getCancellationReasonModalHtml(),
                        showCancelButton: true,
                        confirmButtonText: 'Cancel Item',
                        cancelButtonText: 'Back',
                        focusConfirm: false,
                        didOpen: () => {
                            bindCancellationReasonInteractions();
                        },
                        preConfirm: () => {
                            const selectedOption = document.querySelector('input[name="cancel-reason"]:checked');
                            const otherInput = document.getElementById('cancel-reason-other');

                            if (!selectedOption) {
                                Swal.showValidationMessage('Please select a cancellation reason.');
                                return false;
                            }

                            if (selectedOption.value === 'Other') {
                                const otherReason = otherInput ? otherInput.value.trim() : '';

                                if (!otherReason) {
                                    Swal.showValidationMessage('Please enter a reason for "Other".');
                                    return false;
                                }

                                return otherReason;
                            }

                            return selectedOption.value;
                        }
                    });

                    if (!confirmation.isConfirmed) {
                        button.disabled = false;
                        button.classList.remove('opacity-50', 'pointer-events-none');
                        button.dataset.loading = 'false';
                        return;
                    }

                    try {
                        const selectedReason = confirmation.value;
                        const response = await fetch(`/api/order/${encodeURIComponent(orderId)}/item/${encodeURIComponent(itemId)}/cancel`, {
                            method: 'PATCH',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                reason: selectedReason
                            })
                        });

                        const data = await response.json().catch(() => null);

                        if (!response.ok || !data || !data.success) {
                            throw new Error(data?.message || 'Failed to cancel item');
                        }

                        const itemCard = button.closest('article');
                        const itemRow = button.closest('[data-order-item]');
                        const itemStatusBadge = itemCard ? itemCard.querySelector('[data-item-status-badge]') : null;
                        const normalizedStatus = String(data.updatedOrderStatus || '').toLowerCase().trim();

                        if (itemRow) {
                            itemRow.classList.add('opacity-60');
                        }
                        updateStatusBadge(itemStatusBadge, 'cancelled');
                        button.remove();

                        if (normalizedStatus) {
                            updateStatusBadge(orderStatusBadge, normalizedStatus);
                        }

                        button.dataset.loading = 'false';
                        await Swal.fire({
                            icon: 'success',
                            title: 'Cancelled',
                            text: data.message || 'Item cancelled successfully',
                            timer: 1600,
                            showConfirmButton: false
                        });
                    } catch (error) {
                        button.disabled = false;
                        button.classList.remove('opacity-50', 'pointer-events-none');
                        button.dataset.loading = 'false';

                        await Swal.fire('Error', error.message || 'Failed to cancel item', 'error');
                    }
                });
            });

            returnButtons.forEach((button) => {
                button.addEventListener('click', async (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    if (button.dataset.loading === 'true') return;
                    button.dataset.loading = 'true';

                    const orderId = button.dataset.orderId;
                    const itemId = button.dataset.itemId;

                    if (!orderId || !itemId) {
                        button.dataset.loading = 'false';
                        await Swal.fire('Error', 'Missing return details for this item.', 'error');
                        return;
                    }

                    button.disabled = true;
                    button.classList.add('opacity-50', 'pointer-events-none');

                    const confirmation = await Swal.fire({
                        title: 'Request Return',
                        html: getReturnReasonModalHtml(),
                        showCancelButton: true,
                        confirmButtonText: 'Request Return',
                        cancelButtonText: 'Back',
                        focusConfirm: false,
                        didOpen: () => {
                            bindReturnReasonInteractions();
                        },
                        preConfirm: () => {
                            const selectedOption = document.querySelector('input[name="return-reason"]:checked');
                            const otherInput = document.getElementById('return-reason-other');

                            if (!selectedOption) {
                                Swal.showValidationMessage('Please select a return reason.');
                                return false;
                            }

                            if (selectedOption.value === 'Other') {
                                const otherReason = otherInput ? otherInput.value.trim() : '';

                                if (!otherReason) {
                                    Swal.showValidationMessage('Please enter a reason for "Other".');
                                    return false;
                                }

                                return otherReason;
                            }

                            return selectedOption.value;
                        }
                    });

                    if (!confirmation.isConfirmed) {
                        button.disabled = false;
                        button.classList.remove('opacity-50', 'pointer-events-none');
                        button.dataset.loading = 'false';
                        return;
                    }

                    try {
                        const selectedReason = confirmation.value;
                        const response = await fetch(`/api/order/${orderId}/item/${itemId}/return`, {
                            method: 'PATCH',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                reason: selectedReason
                            })
                        });

                        const data = await response.json().catch(() => null);

                        if (!response.ok || !data || !data.success) {
                            throw new Error(data?.message || 'Failed to request return');
                        }

                        const itemCard = button.closest('article');
                        const itemStatusBadge = itemCard ? itemCard.querySelector('[data-item-status-badge]') : null;

                        updateStatusBadge(itemStatusBadge, 'return_requested');
                        button.remove();
                        button.dataset.loading = 'false';

                        await Swal.fire({
                            icon: 'success',
                            title: 'Return Requested',
                            text: data.message || 'Return request submitted successfully',
                            timer: 1600,
                            showConfirmButton: false
                        });
                    } catch (error) {
                        button.disabled = false;
                        button.classList.remove('opacity-50', 'pointer-events-none');
                        button.dataset.loading = 'false';

                        await Swal.fire('Error', error.message || 'Failed to request return', 'error');
                    }
                });
            });
        });
    </script>
</body>

</html>
