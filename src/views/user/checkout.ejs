<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SoundWave | Checkout</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
</head>

<body class="bg-background-soft" style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>
<%- include('../partials/user/currency-helper') %>
<%
    const checkoutData = (typeof checkout !== 'undefined' && checkout) ? checkout : { items: [], pricing: {}, address: null };
    const checkoutItems = Array.isArray(checkoutData.items) ? checkoutData.items : [];
    const pricing = checkoutData.pricing || {};
    const appliedCoupon = checkoutData.coupon || null;
    const availableCoupons = Array.isArray(checkoutData && checkoutData.availableCoupons) ? checkoutData.availableCoupons : [];
    const bestAvailableCoupon = availableCoupons.length > 0 ? availableCoupons[0] : null;
    const selectedAddress = checkoutData.address || null;
    const placeholderImage = '/images/placeholder.png';
    const userAddresses = locals.user && Array.isArray(locals.user.addresses) ? locals.user.addresses : [];
    const addressLine = selectedAddress
        ? [selectedAddress.houseNo, selectedAddress.originalStreet || selectedAddress.street].filter(Boolean).join(', ')
        : '';
    const addressLocation = selectedAddress
        ? [selectedAddress.city, selectedAddress.state, selectedAddress.zip || selectedAddress.postalCode].filter(Boolean).join(', ')
        : '';
    const selectedAddressIndex = selectedAddress
        ? userAddresses.findIndex((address) => String(address && address._id) === String(selectedAddress._id))
        : -1;
    const editAddressHref = selectedAddress && selectedAddress._id
        ? `/account/addresses/${selectedAddress._id}/edit?returnTo=cart`
        : '/account/addresses';

    const getVariantLabel = (item) => {
        const variant = item && item.variant ? item.variant : {};
        return variant.colorName || variant.name || 'Default';
    };

    const totalItems = Number(pricing.totalItems || 0);
    const baseSubtotal = checkoutItems.reduce((sum, item) => (
        sum + (Number(item.priceSnapshot || 0) * Number(item.quantity || 0))
    ), 0);
    const offerDiscountTotal = checkoutItems.reduce((sum, item) => (
        sum + (Number(item.offerDiscountPerUnit || 0) * Number(item.quantity || 0))
    ), 0);
    const subtotal = Number(pricing.subtotal || 0);
    const discountedSubtotal = Number(pricing.discountedSubtotal || subtotal || 0);
    const gst = Number(pricing.gst || 0);
    const totalPrice = Number(pricing.finalTotal || 0);
    const couponDiscount = Number(pricing.couponDiscount || 0);
    const couponApplied = Boolean(pricing.couponApplied);
    const couponValidationReason = String(pricing.couponValidationReason || '');
    const currentCouponCode = appliedCoupon && appliedCoupon.code ? String(appliedCoupon.code) : '';
    const hasSelectedAddress = Boolean(selectedAddress);
    const walletBalanceValue = Number(walletBalance || 0);
    const isWalletUnavailable = walletBalanceValue <= 0;
%>

<%- include('../partials/user/navbar') %>

<main class="w-full px-3 py-5 md:px-5 lg:px-6 xl:px-8">
    <div class="mx-auto max-w-[1450px]">
        <nav class="mb-3 flex text-sm text-gray-500" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-2">
                <li class="inline-flex items-center">
                    <a href="/home" class="inline-flex items-center text-gray-500 hover:text-primary">Home</a>
                </li>
                <li class="inline-flex items-center">
                    <span class="mx-2 text-gray-400">/</span>
                    <a href="/cart" class="inline-flex items-center text-gray-500 hover:text-primary">Cart</a>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <span class="mx-2 text-gray-400">/</span>
                        <span class="font-medium text-primary">Checkout</span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="mb-6 flex flex-col gap-2 border-b border-primary-light/45 pb-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-primary">Checkout</h1>
                <p class="mt-1 text-sm text-gray-500">Review your items, confirm your address, and choose a payment method.</p>
            </div>
            <div class="inline-flex items-center rounded-lg bg-primary-light/30 px-3 py-2 text-sm font-medium text-primary">
                <span><%= totalItems %></span>&nbsp;items ready
            </div>
        </div>

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 xl:gap-6">
            <section class="lg:col-span-8">
                <div class="overflow-hidden rounded-xl border border-primary-light/45 bg-white shadow-sm">
                    <div class="flex items-center justify-between border-b border-primary-light/45 px-5 py-4">
                        <div>
                            <h2 class="text-xl font-bold text-primary">Order Review</h2>
                            <p class="mt-1 text-sm text-gray-500">Compact item summary for final confirmation.</p>
                        </div>
                        <a href="/cart" class="text-sm font-medium text-primary transition hover:opacity-80">Back to Cart</a>
                    </div>

                    <div class="divide-y divide-primary-light/35">
                        <% checkoutItems.forEach((item) => {
                            const product = item.product || {};
                            const variant = item.variant || {};
                            const quantity = Number(item.quantity || 0);
                            const basePrice = Number(item.priceSnapshot || 0);
                            const offerDiscount = Number(item.offerDiscount || (Number(item.offerDiscountPerUnit || 0) * quantity) || 0);
                            const finalSubtotal = Number(item.finalSubtotal || item.itemSubtotal || 0);
                            const variantImages = Array.isArray(variant.images) ? variant.images : [];
                            const variantImage = variantImages[0];
                            const productImageUrl = variantImage && variantImage.url ? variantImage.url : placeholderImage;
                        %>
                            <article class="px-5 py-4">
                                <div class="flex items-center gap-4">
                                    <div class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-lg border border-primary-light/35 bg-background-soft">
                                        <img src="<%= productImageUrl %>" alt="<%= product.title || 'Checkout product image' %>" class="h-full w-full object-cover" onerror="this.onerror=null;this.src='<%= placeholderImage %>';">
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <h3 class="truncate text-base font-bold text-primary"><%= product.title || 'Product unavailable' %></h3>
                                        <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
                                            <span>Variant: <span class="font-medium text-primary"><%= getVariantLabel(item) %></span></span>
                                            <span>Qty: <span class="font-medium text-primary"><%= quantity %></span></span>
                                        </div>
                                    </div>

                                        <div class="flex flex-col items-end text-sm">
                                            <div class="flex items-center gap-6">
                                                <div class="text-right">
                                                    <p class="text-gray-500">Price Breakdown</p>
                                                    <p class="font-semibold text-primary"><%= formatCurrency(basePrice) %></p>
                                                    <% if (offerDiscount > 0) { %>
                                                        <p class="text-xs text-green-600">- <%= formatCurrency(offerDiscount) %></p>
                                                        <p class="text-xs text-green-700">You saved <%= formatCurrency(offerDiscount) %> with this offer</p>
                                                    <% } %>
                                                    <p class="font-bold text-primary">= <%= formatCurrency(finalSubtotal) %></p>
                                                </div>

                                                <div class="text-right">
                                                    <p class="text-gray-500">Subtotal</p>
                                                    <p class="font-bold text-primary"><%= formatCurrency(finalSubtotal) %></p>
                                                </div>
                                            </div>
                                    </div>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                </div>
            </section>

            <aside class="space-y-4 lg:col-span-4">
                <div class="rounded-xl border border-primary-light/45 bg-white p-5 shadow-sm">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h2 class="text-xl font-bold text-primary">Delivery Address</h2>
                            <p class="mt-1 text-sm text-gray-500">Select the address for this order.</p>
                        </div>
                        <% if (selectedAddress && selectedAddress.label) { %>
                            <span class="rounded-full bg-primary-light/25 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary"><%= selectedAddress.label %></span>
                        <% } %>
                    </div>

                    <% if (selectedAddress) { %>
                        <div class="relative mt-4">
                            <button type="button" id="toggle-address-selector" class="flex w-full items-start justify-between gap-3 rounded-lg border border-primary-light/35 bg-white px-4 py-3 text-left text-sm transition hover:bg-primary-light/10">
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <p id="selected-address-name" class="font-semibold text-primary"><%= selectedAddress.name || (locals.user && locals.user.name) || 'Primary Address' %></p>
                                        <span id="selected-address-badge" class="inline-block rounded bg-accent px-2 py-0.5 text-xs font-semibold text-black <%= selectedAddress.isDefault ? '' : 'hidden' %>">Default</span>
                                    </div>
                                    <p id="selected-address-phone" class="mt-2 text-gray-600 <%= selectedAddress.phone ? '' : 'hidden' %>"><%= selectedAddress.phone || '' %></p>
                                    <p id="selected-address-line" class="mt-1 text-gray-600 <%= addressLine ? '' : 'hidden' %>"><%= addressLine %></p>
                                    <p id="selected-address-location" class="mt-1 text-gray-600 <%= addressLocation ? '' : 'hidden' %>"><%= addressLocation %></p>
                                </div>
                                <div class="flex flex-col items-end gap-2">
                                    <span class="text-xs font-medium text-primary">Change Address</span>
                                    <svg id="address-selector-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" class="text-primary transition-transform duration-200">
                                        <path d="M181.66,114.34a8,8,0,0,1,0,11.32l-48,48a8,8,0,0,1-11.32,0l-48-48a8,8,0,0,1,11.32-11.32L128,156.69l42.34-42.35A8,8,0,0,1,181.66,114.34Z"></path>
                                    </svg>
                                </div>
                            </button>

                            <% if (userAddresses.length > 1) { %>
                                <div id="address-selector" class="absolute left-0 right-0 top-[calc(100%+0.5rem)] z-20 hidden rounded-lg border border-primary-light/35 bg-white p-2 shadow-lg">
                                    <div class="space-y-2">
                                        <% userAddresses.forEach((address, index) => {
                                            const optionLine = [address.houseNo, address.originalStreet || address.street].filter(Boolean).join(', ');
                                            const optionLocation = [address.city, address.state, address.zip || address.postalCode].filter(Boolean).join(', ');
                                        %>
                                            <button
                                                type="button"
                                                class="address-option flex w-full flex-col rounded-lg border border-transparent px-3 py-3 text-left transition hover:border-primary-light/35 hover:bg-primary-light/10 <%= index === selectedAddressIndex ? 'border-primary-light/35 bg-primary-light/10' : '' %>"
                                                data-id="<%= address._id || '' %>"
                                                data-name="<%= address.name || '' %>"
                                                data-phone="<%= address.phone || '' %>"
                                                data-line="<%= optionLine %>"
                                                data-location="<%= optionLocation %>"
                                                data-is-default="<%= address.isDefault ? 'true' : 'false' %>">
                                                <span class="font-medium text-primary"><%= address.name || 'Saved Address' %></span>
                                                <% if (address.phone) { %>
                                                    <span class="mt-1 text-sm text-gray-600"><%= address.phone %></span>
                                                <% } %>
                                                <% if (optionLine) { %>
                                                    <span class="mt-1 line-clamp-1 text-sm text-gray-600"><%= optionLine %></span>
                                                <% } %>
                                                <% if (optionLocation) { %>
                                                    <span class="line-clamp-1 text-sm text-gray-600"><%= optionLocation %></span>
                                                <% } %>
                                            </button>
                                        <% }) %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="mt-4 rounded-lg border border-dashed border-primary-light/45 bg-primary-light/10 p-4 text-sm text-gray-600">
                            No saved delivery address found. Add one before continuing.
                        </div>
                    <% } %>

                    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-1">
                        <a id="edit-address-link" href="<%= editAddressHref %>" class="flex h-11 w-full items-center justify-center rounded-lg border border-primary-light/45 px-5 text-sm font-medium text-primary transition hover:bg-primary-light/20">
                            Edit Address
                        </a>
                        <a href="/account/addresses/new?returnTo=cart" class="flex h-11 w-full items-center justify-center rounded-lg bg-accent px-5 text-sm font-bold text-black transition hover:opacity-90">
                            Add New Address
                        </a>
                    </div>
                </div>

                <div class="rounded-xl border border-primary-light/45 bg-white p-5 shadow-sm">
                    <div class="rounded-lg border border-primary-light/35 p-3">
                        <label for="coupon-input" class="text-sm font-semibold text-primary">Apply Coupon</label>
                        <p class="mt-1 text-xs text-gray-500">
                            <% if (couponApplied) { %>
                                Your coupon is already applied to this order summary.
                            <% } else if (bestAvailableCoupon) { %>
                                You have a better coupon available for this order total.
                            <% } else { %>
                                Add a code manually or use one of the matching suggestions below.
                            <% } %>
                        </p>

                        <div class="mt-2 flex gap-2">
                            <input
                                id="coupon-input"
                                type="text"
                                placeholder="Enter coupon code"
                                value="<%= currentCouponCode %>"
                                class="w-full rounded border border-primary-light/35 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-0"
                            />

                            <button
                                id="apply-coupon-btn"
                                class="rounded bg-primary px-4 py-2 text-sm text-white transition hover:opacity-90">
                                Apply
                            </button>
                        </div>

                        <div class="mt-2 flex items-center justify-between gap-3">
                            <p id="coupon-message" class="text-sm <%= couponApplied ? 'text-green-600' : (couponValidationReason ? 'text-red-500' : 'text-gray-500') %>">
                                <% if (couponApplied) { %>
                                    Coupon applied successfully
                                <% } else if (couponValidationReason) { %>
                                    Unable to apply coupon
                                <% } else { %>
                                    Enter a coupon code to check for an additional discount.
                                <% } %>
                            </p>

                            <% if (couponApplied) { %>
                                <button id="remove-coupon" type="button" class="text-sm font-medium text-primary underline underline-offset-2">
                                    Remove
                                </button>
                            <% } %>
                        </div>

                        <% if (bestAvailableCoupon && !couponApplied) { %>
                            <div class="mt-3 flex items-center justify-between gap-3 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2">
                                <div class="min-w-0">
                                    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Best coupon</p>
                                    <p class="text-sm font-semibold text-primary"><%= bestAvailableCoupon.code %> - Save <%= formatCurrency(bestAvailableCoupon.discount) %></p>
                                </div>
                                <button
                                    type="button"
                                    class="suggested-coupon-btn rounded bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-emerald-700"
                                    data-coupon-code="<%= bestAvailableCoupon.code %>">
                                    Apply
                                </button>
                            </div>
                        <% } %>

                        <% if (availableCoupons.length > 0) { %>
                            <details id="available-coupons" class="mt-3 rounded-lg bg-primary-light/10 p-3">
                                <summary class="cursor-pointer list-none text-sm font-medium text-primary">
                                    <span><%= couponApplied ? 'More matching coupons' : 'View available coupons' %></span>
                                </summary>

                                <div class="mt-3 space-y-2">
                                    <% availableCoupons.forEach((entry) => { %>
                                        <div class="flex items-center justify-between gap-3 rounded-lg border border-primary-light/35 bg-white px-3 py-2">
                                            <div class="min-w-0">
                                                <p class="text-sm font-semibold text-primary"><%= entry.code %> - Save <%= formatCurrency(entry.discount) %></p>
                                                <% if (Number(entry.minOrderValue || 0) > 0) { %>
                                                    <p class="text-xs text-gray-500">Minimum order <%= formatCurrency(entry.minOrderValue) %></p>
                                                <% } %>
                                            </div>
                                            <button
                                                type="button"
                                                class="suggested-coupon-btn rounded border border-primary-light/45 px-3 py-1.5 text-xs font-semibold text-primary transition hover:bg-primary-light/15"
                                                data-coupon-code="<%= entry.code %>"
                                                <%= couponApplied ? 'disabled' : '' %>>
                                                Apply
                                            </button>
                                        </div>
                                    <% }) %>
                                </div>
                            </details>
                        <% } %>
                    </div>

                    <h2 class="mt-5 text-xl font-bold text-primary">Order Summary</h2>

                    <div class="mt-5 space-y-3 border-b border-primary-light/45 pb-4 text-sm">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Total Items</span>
                            <span class="font-semibold text-primary"><%= totalItems %></span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Subtotal</span>
                            <span class="font-semibold text-primary"><%= formatCurrency(baseSubtotal) %></span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Offer Discount</span>
                            <span class="font-semibold text-green-600">-<%= formatCurrency(offerDiscountTotal) %></span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">Discounted Subtotal</span>
                            <span class="font-semibold text-primary"><%= formatCurrency(subtotal) %></span>
                        </div>
                        <% if (couponDiscount > 0) { %>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-500">Coupon Discount</span>
                                <span class="font-semibold text-green-600">-<%= formatCurrency(couponDiscount) %></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-500">Final Subtotal</span>
                                <span class="font-semibold text-primary"><%= formatCurrency(discountedSubtotal) %></span>
                            </div>
                        <% } %>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-500">GST (18%)</span>
                            <span class="font-semibold text-primary"><%= formatCurrency(gst) %></span>
                        </div>
                    </div>

                    <div class="mt-4 flex items-center justify-between">
                        <span class="text-base font-bold text-primary">Final Total</span>
                        <span class="text-xl font-bold text-primary"><%= formatCurrency(totalPrice) %></span>
                    </div>
                </div>

                <div class="rounded-xl border border-primary-light/45 bg-white p-5 shadow-sm">
                    <h2 class="text-xl font-bold text-primary">Payment Method</h2>
                    <div class="mt-4 space-y-3">
                        <label class="flex items-start gap-3 rounded-lg border border-primary-light/35 bg-primary-light/10 px-4 py-3">
                            <input type="radio" name="paymentMethod" value="cod" class="mt-1 h-4 w-4 border-primary-light text-primary focus:ring-primary" checked="checked">
                            <span class="block">
                                <span class="block font-semibold text-primary">Cash on Delivery</span>
                                <span class="mt-1 block text-sm text-gray-500">Pay when your order arrives.</span>
                            </span>
                        </label>

                        <label class="flex items-start gap-3 rounded-lg border border-primary-light/35 bg-primary-light/10 px-4 py-3">
                            <input type="radio" name="paymentMethod" value="online" class="mt-1 h-4 w-4 border-primary-light text-primary focus:ring-primary">
                            <span class="block">
                                <span class="block font-semibold text-primary">Online Payment</span>
                                <span class="mt-1 block text-sm text-gray-500">Pay securely using Razorpay.</span>
                            </span>
                        </label>

                        <label class="flex items-start gap-3 rounded-lg border border-primary-light/35 bg-primary-light/10 px-4 py-3">
                            <input type="radio" name="paymentMethod" value="wallet" class="mt-1 h-4 w-4 border-primary-light text-primary focus:ring-primary" <%= isWalletUnavailable ? 'disabled' : '' %>>
                            <span class="block">
                                <span class="block font-semibold text-primary">Wallet</span>
                                <span class="mt-1 block text-sm text-gray-500">Balance: <%= formatCurrency(walletBalance) %></span>
                                <% if (isWalletUnavailable) { %>
                                    <span class="mt-1 block text-sm text-red-500">Insufficient wallet balance</span>
                                <% } %>
                            </span>
                        </label>
                    </div>

                    <% if (!hasSelectedAddress) { %>
                        <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
                            Please select a delivery address to continue.
                        </p>
                    <% } %>

                    <button
                        id="place-order-button"
                        type="button"
                        class="theme-primary-btn mt-6 flex h-12 w-full items-center justify-center rounded-lg px-5 text-sm font-bold transition <%= hasSelectedAddress ? '' : 'pointer-events-none opacity-50' %>"
                        <%= hasSelectedAddress ? '' : 'disabled aria-disabled="true"' %>>
                        Place Order
                    </button>
                </div>
            </aside>
        </div>
    </div>
</main>

<script>
    (() => {
        const addressSelector = document.getElementById('address-selector');
        const toggleAddressSelectorButton = document.getElementById('toggle-address-selector');
        const addressSelectorIcon = document.getElementById('address-selector-icon');
        const selectedAddressName = document.getElementById('selected-address-name');
        const selectedAddressBadge = document.getElementById('selected-address-badge');
        const selectedAddressPhone = document.getElementById('selected-address-phone');
        const selectedAddressLine = document.getElementById('selected-address-line');
        const selectedAddressLocation = document.getElementById('selected-address-location');
        const editAddressLink = document.getElementById('edit-address-link');
        const placeOrderButton = document.getElementById('place-order-button');
        const couponInput = document.getElementById('coupon-input');
        const applyCouponButton = document.getElementById('apply-coupon-btn');
        const removeCouponButton = document.getElementById('remove-coupon');
        const couponMessage = document.getElementById('coupon-message');
        const suggestedCouponButtons = Array.from(document.querySelectorAll('.suggested-coupon-btn'));
        const walletBalance = <%- JSON.stringify(walletBalanceValue) %>;
        const walletRadio = document.querySelector('input[name="paymentMethod"][value="wallet"]');
        const codRadio = document.querySelector('input[name="paymentMethod"][value="cod"]');
        const razorpayKeyId = "<%= RAZORPAY_KEY_ID %>";
        const currentUserName = <%- JSON.stringify((user && user.name) || '') %>;
        const currentUserEmail = <%- JSON.stringify((user && user.email) || '') %>;
        const couponApplied = <%- JSON.stringify(couponApplied) %>;
        const couponValidationReason = <%- JSON.stringify(couponValidationReason) %>;
        const currentCouponCode = <%- JSON.stringify(currentCouponCode) %>;
        let isPlacingOrder = false;

        console.log("RAZORPAY KEY FRONTEND:", "<%= RAZORPAY_KEY_ID %>");

        const notifyError = (message) => {
            const nextMessage = message || 'Unable to place order';

            if (typeof window.showToast === 'function') {
                window.showToast(nextMessage, 'error');
                return;
            }

            window.alert(nextMessage);
        };

        const getCouponMessage = (reasonCode) => {
            const messages = {
                COUPON_NOT_FOUND: 'Coupon not found',
                COUPON_INACTIVE: 'Coupon is inactive',
                COUPON_EXPIRED: 'Coupon expired',
                COUPON_NOT_STARTED: 'Coupon is not active yet',
                MIN_ORDER_NOT_MET: 'Minimum order not met',
                USAGE_LIMIT_EXCEEDED: 'Coupon usage limit exceeded',
                USER_LIMIT_EXCEEDED: 'Coupon usage limit reached for your account',
                INVALID_COUPON: 'Invalid coupon'
            };

            return messages[reasonCode] || 'Unable to apply coupon';
        };

        const setCouponMessageState = (message, type) => {
            if (!couponMessage) return;

            couponMessage.textContent = message || '';
            couponMessage.classList.remove('text-green-600', 'text-red-500', 'text-gray-500');

            if (type === 'success') {
                couponMessage.classList.add('text-green-600');
                return;
            }

            if (type === 'error') {
                couponMessage.classList.add('text-red-500');
                return;
            }

            couponMessage.classList.add('text-gray-500');
        };

        const applyCoupon = (rawCouponCode) => {
            const normalizedCouponCode = String(rawCouponCode || '').trim().toUpperCase();
            const nextUrl = new URL(window.location.href);

            if (normalizedCouponCode) {
                nextUrl.searchParams.set('couponCode', normalizedCouponCode);
            } else {
                nextUrl.searchParams.delete('couponCode');
            }

            window.location.href = nextUrl.toString();
        };

        const validateCouponInput = (rawCouponCode) => {
            const couponCode = String(rawCouponCode || '').trim().toUpperCase();

            if (!couponCode) {
                return 'Enter a valid coupon code';
            }

            if (couponCode.length < 4 || couponCode.length > 20) {
                return 'Invalid coupon format';
            }

            if (couponCode.includes(' ')) {
                return 'No spaces allowed';
            }

            return '';
        };

        const setSuggestedButtonsDisabled = (isDisabled, activeCode = '') => {
            suggestedCouponButtons.forEach((button) => {
                button.disabled = isDisabled;
                button.classList.toggle('pointer-events-none', isDisabled);
                button.classList.toggle('opacity-60', isDisabled);

                if (isDisabled && activeCode && button.getAttribute('data-coupon-code') === activeCode) {
                    button.textContent = 'Applying...';
                    return;
                }

                button.textContent = 'Apply';
            });
        };

        const preserveCouponCodeInCheckoutLinks = () => {
            if (!currentCouponCode) {
                return;
            }

            document.querySelectorAll('a[href]').forEach((link) => {
                const href = link.getAttribute('href') || '';

                if (!href.startsWith('/checkout')) {
                    return;
                }

                const nextUrl = new URL(href, window.location.origin);
                nextUrl.searchParams.set('couponCode', currentCouponCode);
                link.setAttribute('href', `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
            });
        };

        if (couponApplied) {
            setCouponMessageState('Coupon applied successfully', 'success');
        } else if (couponValidationReason) {
            setCouponMessageState(getCouponMessage(couponValidationReason), 'error');
        } else {
            setCouponMessageState('Enter a coupon code to check for an additional discount.', 'neutral');
        }

        if (walletRadio && walletRadio.disabled && walletRadio.checked && codRadio) {
            codRadio.checked = true;
        }

        preserveCouponCodeInCheckoutLinks();

        if (couponInput) {
            couponInput.addEventListener('input', () => {
                couponInput.value = String(couponInput.value || '').trimStart().toUpperCase();
            });
        }

        if (applyCouponButton && couponInput) {
            if (couponApplied) {
                applyCouponButton.disabled = true;
                applyCouponButton.classList.add('pointer-events-none', 'opacity-60');
            }

            applyCouponButton.addEventListener('click', async () => {
                const couponCode = String(couponInput.value || '').trim().toUpperCase();
                const validationMessage = validateCouponInput(couponCode);

                if (validationMessage) {
                    setCouponMessageState(validationMessage, 'error');
                    return;
                }

                applyCouponButton.disabled = true;
                applyCouponButton.classList.add('pointer-events-none', 'opacity-60');
                applyCouponButton.textContent = 'Applying...';

                try {
                    applyCoupon(couponCode);
                } finally {
                    window.setTimeout(() => {
                        applyCouponButton.disabled = false;
                        applyCouponButton.classList.remove('pointer-events-none', 'opacity-60');
                        applyCouponButton.textContent = 'Apply';
                    }, 0);
                }
            });

            couponInput.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    applyCouponButton.click();
                }
            });
        }

        if (removeCouponButton) {
            removeCouponButton.addEventListener('click', () => {
                applyCoupon('');
            });
        }

        suggestedCouponButtons.forEach((button) => {
            button.addEventListener('click', () => {
                if (button.disabled) {
                    return;
                }

                const couponCode = button.getAttribute('data-coupon-code') || '';
                const validationMessage = validateCouponInput(couponCode);

                if (validationMessage) {
                    setCouponMessageState(validationMessage, 'error');
                    return;
                }

                setSuggestedButtonsDisabled(true, couponCode);
                applyCoupon(couponCode);
            });
        });

        const placeOrder = async (paymentMethod) => {
            const response = await fetch('/api/order/place', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    paymentMethod,
                    couponCode: currentCouponCode || ''
                })
            });

            const data = await response.json().catch(() => null);

            if (data && data.success) {
                window.location.href = `/order-success?orderId=${data.orderId}`;
                return true;
            }

            const message = data && data.message ? data.message : 'Unable to place order';
            notifyError(message);

            return false;
        };

        const setAddressDropdownState = (isOpen) => {
            if (!addressSelector) return;
            addressSelector.classList.toggle('hidden', !isOpen);
            if (addressSelectorIcon) {
                addressSelectorIcon.classList.toggle('rotate-180', isOpen);
            }
        };

        const setAddressText = (element, value) => {
            if (!element) return;
            element.textContent = value || '';
            element.classList.toggle('hidden', !value);
        };

        const selectAddressOption = (optionButton) => {
            if (!optionButton) return;

            document.querySelectorAll('.address-option').forEach((option) => {
                option.classList.toggle('border-primary-light/35', option === optionButton);
                option.classList.toggle('bg-primary-light/10', option === optionButton);
            });

            if (selectedAddressName) {
                selectedAddressName.textContent = optionButton.getAttribute('data-name') || 'Saved Address';
            }

            setAddressText(selectedAddressPhone, optionButton.getAttribute('data-phone') || '');
            setAddressText(selectedAddressLine, optionButton.getAttribute('data-line') || '');
            setAddressText(selectedAddressLocation, optionButton.getAttribute('data-location') || '');

            if (selectedAddressBadge) {
                selectedAddressBadge.classList.toggle('hidden', optionButton.getAttribute('data-is-default') !== 'true');
            }

            if (editAddressLink) {
                const addressId = optionButton.getAttribute('data-id');
                editAddressLink.setAttribute('href', addressId ? `/account/addresses/${addressId}/edit?returnTo=cart` : '/account/addresses');
            }

            setAddressDropdownState(false);
        };

        if (toggleAddressSelectorButton && addressSelector) {
            toggleAddressSelectorButton.addEventListener('click', () => {
                setAddressDropdownState(addressSelector.classList.contains('hidden'));
            });
        }

        document.addEventListener('click', (event) => {
            if (addressSelector && toggleAddressSelectorButton) {
                const clickedInsideSelector = addressSelector.contains(event.target);
                const clickedTrigger = toggleAddressSelectorButton.contains(event.target);

                if (!clickedInsideSelector && !clickedTrigger) {
                    setAddressDropdownState(false);
                }
            }

            const addressOption = event.target.closest('.address-option');
            if (addressOption) {
                selectAddressOption(addressOption);
            }
        });

        if (placeOrderButton) {
            placeOrderButton.addEventListener('click', async () => {
                if (placeOrderButton.disabled || isPlacingOrder) {
                    return;
                }

                isPlacingOrder = true;
                placeOrderButton.disabled = true;
                placeOrderButton.classList.add('pointer-events-none', 'opacity-50');
                showLoader();

                try {
                    const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value || null;
                    console.log('Selected method:', paymentMethod);

                    if (paymentMethod === 'wallet' && walletBalance <= 0) {
                        notifyError('Wallet balance is empty');
                        return;
                    }

                    if (paymentMethod === 'online') {
                        if (!razorpayKeyId) {
                            notifyError('Online payment is not configured');
                            return;
                        }

                        const orderResponse = await fetch('/payment/create-order', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                couponCode: currentCouponCode || ''
                            })
                        });

                        const orderData = await orderResponse.json().catch(() => null);

                        if (!orderData || !orderData.success || !orderData.data) {
                            const message = orderData && orderData.message ? orderData.message : 'Unable to initiate payment';
                            notifyError(message);
                            return;
                        }

                        const options = {
                            key: "<%= RAZORPAY_KEY_ID %>",
                            amount: orderData.data.amount,
                            currency: orderData.data.currency,
                            name: 'Your Store',
                            description: 'Order Payment',
                            order_id: orderData.data.razorpayOrderId,
                            handler: async function (response) {
                                try {
                                    showLoader();
                                    const res = await fetch('/api/order/place', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json'
                                        },
                                        body: JSON.stringify({
                                            paymentMethod: 'online',
                                            couponCode: currentCouponCode || '',
                                            razorpay_payment_id: response.razorpay_payment_id,
                                            razorpay_order_id: response.razorpay_order_id,
                                            razorpay_signature: response.razorpay_signature
                                        })
                                    });

                                    const data = await res.json();

                                    if (data.success) {
                                        window.location.href = `/order-success?orderId=${data.orderId}`;
                                    } else {
                                        hideLoader();
                                        window.alert('Order placement failed');
                                    }
                                } catch (err) {
                                    console.error('Order placement error:', err);
                                    hideLoader();
                                    window.alert('Something went wrong');
                                }
                            },
                            prefill: {
                                name: currentUserName || 'Test User',
                                email: currentUserEmail || 'test@example.com',
                                contact: '9999999999'
                            },
                            modal: {
                                ondismiss: function () {
                                    hideLoader();
                                    window.location.href = "/payment-failure";
                                }
                            },
                            config: {
                                display: {
                                    blocks: {
                                        upi: {
                                            name: 'Pay using UPI',
                                            instruments: [
                                                {
                                                    method: 'upi'
                                                }
                                            ]
                                        }
                                    },
                                    sequence: ['upi'],
                                    preferences: {
                                        show_default_blocks: false
                                    }
                                }
                            },
                            theme: {
                                color: '#000000'
                            }
                        };

                        console.log("RAZORPAY OPTIONS:", options);
                        console.log("RAZORPAY KEY FINAL:", options.key);

                        const rzp = new Razorpay(options);
                        rzp.on('payment.failed', function (response) {
                            console.error('RAZORPAY FAILURE:', response.error);
                            hideLoader();
                            window.location.href = "/payment-failure";
                        });
                        rzp.open();
                        hideLoader();
                        return;
                    }

                    await placeOrder(paymentMethod);
                } catch (error) {
                    notifyError('Unable to place order');
                } finally {
                    hideLoader();
                    isPlacingOrder = false;
                    placeOrderButton.disabled = false;
                    placeOrderButton.classList.remove('opacity-50', 'pointer-events-none');
                }
            });
        }
    })();
</script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/loading.util.js"></script>
</body>

</html>
