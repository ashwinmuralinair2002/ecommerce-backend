<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SoundWave | Payment Failed</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-background-soft" style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>
<%
    const orderData = typeof order !== 'undefined' ? order : null;
    const checkoutData = typeof checkout !== 'undefined' ? checkout : null;
    const items = orderData?.items || checkoutData?.items || [];
    const pricing = orderData?.pricing || checkoutData?.pricing || {};
    const address = orderData?.shippingAddress || checkoutData?.address || null;
    const shippingAddress = address || {};
    const hasOrderData = Boolean(orderData && (orderData.orderId || items.length || Object.keys(pricing).length || Object.keys(shippingAddress).length));

    const formatCurrency = (value) => {
        const amount = Number(value || 0);
        return `₹ ${amount.toLocaleString('en-IN')}`;
    };

    const addressLine1 = shippingAddress.addressLine1 || 'Address not available';
    const locationLine = [shippingAddress.city, shippingAddress.state, shippingAddress.pincode].filter(Boolean).join(', ');
%>

    <%- include('../partials/user/navbar') %>

    <main class="w-full px-4 py-5 md:px-6 lg:px-8 xl:px-10">
        <% if (items.length > 0) { %>
        <div class="mx-auto max-w-[1400px]">
            <nav class="mb-3 flex text-sm text-gray-500" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-2">
                    <li class="inline-flex items-center">
                        <a href="/home" class="inline-flex items-center text-gray-500 hover:text-primary">Home</a>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <span class="mx-2 text-gray-400">/</span>
                            <span class="font-medium text-primary">Payment Failed</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-6 py-6 shadow-sm">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-wide text-red-700">Payment Failed</p>
                        <h1 class="mt-1 text-3xl font-bold text-red-700">Payment Failed</h1>
                        <p class="mt-2 text-sm text-red-700/90">Your payment could not be completed. No amount was deducted.</p>
                        <% if (hasOrderData) { %>
                            <p class="mt-2 text-sm text-red-700/90">Order ID: <span class="font-semibold"><%= orderData.orderId || 'N/A' %></span></p>
                            <div class="mt-4 flex flex-wrap gap-3">
                                <a href="/orders/<%= orderData.orderId %>" class="inline-flex h-10 items-center justify-center rounded-lg bg-red-700 px-4 text-sm font-semibold text-white transition hover:bg-red-800">
                                    View Order
                                </a>
                                <a href="/orders" class="inline-flex h-10 items-center justify-center rounded-lg border border-red-300 px-4 text-sm font-semibold text-red-700 transition hover:bg-red-100">
                                    My Orders
                                </a>
                            </div>
                        <% } else { %>
                            <p class="mt-4 text-sm text-red-700/90">No order was created due to payment failure.</p>
                        <% } %>
                    </div>
                    <div class="flex h-14 w-14 items-center justify-center rounded-full bg-red-100 text-red-700">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256">
                            <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66A8,8,0,0,1,50.34,194.34L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 xl:gap-6">
                <section class="space-y-5 lg:col-span-8">
                    <div class="overflow-hidden rounded-xl border border-primary-light/45 bg-white shadow-sm">
                        <div class="border-b border-primary-light/45 px-5 py-4">
                            <h2 class="text-xl font-bold text-primary">Order Items</h2>
                            <p class="mt-1 text-sm text-gray-500">Review the items included in this order.</p>
                        </div>

                        <% if (!hasOrderData) { %>
                            <div class="px-5 py-8 text-sm text-gray-500">
                                No order was created due to payment failure.
                            </div>
                        <% } else if (items.length === 0) { %>
                            <div class="px-5 py-8 text-sm text-gray-500">
                                No order items available.
                            </div>
                        <% } else { %>
                            <div class="divide-y divide-primary-light/35">
                                <% items.forEach((item) => { %>
                                    <article class="px-5 py-4">
                                        <div class="flex items-center gap-4">
                                            <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-lg border border-primary-light/40 bg-white">
                                                <% if (item.imageUrl) { %>
                                                    <img src="<%= item.imageUrl %>" alt="Product" class="h-full w-full object-cover" />
                                                <% } %>
                                            </div>

                                            <div class="flex-1">
                                                <h3 class="text-base font-bold text-primary"><%= item.productName || 'Product' %></h3>
                                                <p class="text-sm text-gray-500">
                                                    Color: <%= item.colorName || 'Default' %> · Qty: <%= Number(item.quantity || 0) %>
                                                </p>
                                            </div>

                                            <div class="text-right">
                                                <p class="text-sm font-semibold text-primary"><%= formatCurrency(item.price) %></p>
                                                <p class="text-xs text-gray-500">Total</p>
                                                <p class="font-bold text-primary"><%= formatCurrency(item.totalPrice) %></p>
                                            </div>
                                        </div>
                                    </article>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </section>

                <aside class="space-y-4 lg:col-span-4">
                    <div class="rounded-xl border border-primary-light/45 bg-white p-5 shadow-sm">
                        <h2 class="text-xl font-bold text-primary">Delivery Address</h2>
                        <p class="mt-1 text-sm text-gray-500">Shipping details used for this order.</p>

                        <div class="mt-4 rounded-lg border border-primary-light/35 bg-white px-4 py-3 text-sm">
                            <p class="font-semibold text-primary"><%= shippingAddress.name || 'Customer' %></p>
                            <p class="mt-2 text-gray-600"><%= shippingAddress.phone || 'Phone not available' %></p>
                            <p class="mt-2 text-gray-600"><%= addressLine1 %></p>
                            <p class="mt-1 text-gray-600"><%= locationLine || 'Location not available' %></p>
                        </div>
                    </div>

                    <div class="rounded-xl border border-primary-light/45 bg-white p-5 shadow-sm">
                        <h2 class="text-xl font-bold text-primary">Price Summary</h2>

                        <div class="mt-5 space-y-3 border-b border-primary-light/45 pb-4 text-sm">
                            <div class="flex items-center justify-between">
                                <span class="text-gray-500">Total Items</span>
                                <span class="font-semibold text-primary"><%= Number(pricing.totalItems || 0) %></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-500">Subtotal</span>
                                <span class="font-semibold text-primary"><%= formatCurrency(pricing.subtotal) %></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-500">GST</span>
                                <span class="font-semibold text-primary"><%= formatCurrency(pricing.gst) %></span>
                            </div>
                        </div>

                        <div class="mt-4 flex items-center justify-between">
                            <span class="text-base font-bold text-primary">Final Total</span>
                            <span class="text-xl font-bold text-primary"><%= formatCurrency(pricing.finalTotal) %></span>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
        <% } else { %>
        <div class="py-10 text-center">
            <h2 class="mb-2 text-xl font-semibold text-red-600">Payment Failed</h2>
            <p class="mb-4 text-gray-500">
                Your payment could not be completed.
            </p>
            <div class="flex flex-col items-center gap-3">
                <a href="/checkout" class="theme-primary-btn inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-bold transition">Retry Payment</a>
                <a href="/cart" class="theme-secondary-btn inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium transition">Go to Cart</a>
            </div>
        </div>
        <% } %>
    </main>
</body>

</html>
