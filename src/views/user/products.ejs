<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <title>SoundWave | Products</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        // Auto-submit functionality wrapper
        function submitForm() {
            const minPriceInput = document.querySelector('input[name="minPrice"]');
            if (minPriceInput && minPriceInput.value && parseInt(minPriceInput.value) < 100) {
                minPriceInput.value = 100;
            }
            document.getElementById('filter-form').submit();
        }
    </script>
</head>

<body class="bg-[#f8fcf8]" style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

    <!-- ================= NAVBAR ================= -->
    <header class="flex items-center justify-between border-b border-[#e7f4e7] px-10 py-3 bg-white sticky top-0 z-50">
        <!-- Left -->
        <div class="flex items-center gap-10">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-3 text-[#0d1c0d]">
                <div class="size-4">
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134
            C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462
            C2.19985 28.361 1.76794 23.9758 2.60947 19.7452
            C3.451 15.5145 5.52816 11.6284 8.57829 8.5783
            C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948
            C23.9758 1.76795 28.361 2.19986 32.3462 3.85057
            C36.3314 5.50129 39.7376 8.29668 42.134 11.8833
            C44.5305 15.4698 45.8096 19.6865 45.8096 24
            L24 24 L24 45.8096Z" fill="currentColor" />
                    </svg>
                </div>
                <span class="font-bold text-lg">SoundWave</span>
            </a>

            <!-- Menu -->
            <nav class="flex gap-8 text-sm font-medium text-[#0d1c0d]">
                <a href="/products" class="text-[#15803d]">Products</a>
                <a href="/deals">Today’s Deals</a>
                <a href="/best-sellers">Best Sellers</a>
                <a href="/new-arrivals">New Arrivals</a>
                <a href="/brands">Brands</a>
            </nav>
        </div>

        <!-- Right -->
        <div class="flex items-center gap-4">
            <div class="relative">
                <input type="text" placeholder="Search"
                    class="h-10 w-56 rounded-lg bg-[#e7f4e7] pl-10 pr-4 text-sm placeholder:text-[#499c49] focus:outline-none" />
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-[#499c49]" xmlns="http://www.w3.org/2000/svg"
                    width="18" height="18" fill="currentColor" viewBox="0 0 256 256">
                    <path
                        d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32Z" />
                </svg>
            </div>

            <% if (user) { %>
                <button class="h-10 w-10 rounded-lg bg-[#e7f4e7] text-[#499c49] hover:bg-[#dcf0dc]">❤️</button>
                <button class="h-10 w-10 rounded-lg bg-[#e7f4e7] text-[#499c49] hover:bg-[#dcf0dc]">🛒</button>
                <a href="/account"
                    class="h-10 w-10 rounded-full bg-[#e7f4e7] flex items-center justify-center ring-2 ring-green-500 overflow-hidden">
                    <% if (user.profileImage) { %>
                        <img src="<%= user.profileImage %>" alt="Profile" class="h-full w-full object-cover" />
                        <% } else { %>
                            <span class="text-xs font-bold text-[#2d6a2d]">
                                <%= user.name ? user.name.substring(0,2).toUpperCase() : 'U' %>
                            </span>
                            <% } %>
                </a>
                <% } else { %>
                    <a href="/login"
                        class="flex items-center justify-center h-10 px-6 rounded-lg bg-[#15803d] text-white text-sm font-bold hover:bg-[#166534] transition-colors shadow-sm">
                        Login
                    </a>
                    <% } %>
        </div>
    </header>

    <!-- ================= CONTENT ================= -->
    <main class="max-w-[1400px] mx-auto px-6 py-8">

        <form id="filter-form" action="/products" method="GET" class="flex gap-8 items-start">

            <!-- Sidebar Filters (Desktop) - Green Theme -->
            <aside
                class="w-64 flex-shrink-0 space-y-8 sticky top-24 hidden lg:block bg-[#f0f9f0] p-4 rounded-xl border border-[#e7f4e7]">

                <!-- Sort By (Moved to Top) -->
                <div>
                    <h3 class="font-bold text-[#0d1c0d] mb-3 text-sm uppercase tracking-wide">Sort By</h3>
                    <select name="sort" onchange="submitForm()"
                        class="w-full text-sm border-gray-200 rounded-lg focus:border-[#15803d] focus:ring-[#15803d]">
                        <option value="newest" <%=query.sort==='newest' ? 'selected' : '' %>>Newest</option>
                        <option value="price_asc" <%=query.sort==='price_asc' ? 'selected' : '' %>>Price: Low to High
                        </option>
                        <option value="price_desc" <%=query.sort==='price_desc' ? 'selected' : '' %>>Price: High to Low
                        </option>
                        <option value="az" <%=query.sort==='az' ? 'selected' : '' %>>Name: A to Z</option>
                        <option value="za" <%=query.sort==='za' ? 'selected' : '' %>>Name: Z to A</option>
                    </select>
                </div>

                <!-- Category Filter -->
                <div>
                    <h3 class="font-bold text-[#0d1c0d] mb-3 text-sm uppercase tracking-wide">Category</h3>
                    <div class="space-y-2">
                        <% categories.forEach(cat=> { %>
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" name="category" value="<%= cat._id %>" onchange="submitForm()"
                                    <%=(Array.isArray(query.category) ? query.category.includes(String(cat._id)) :
                                    query.category===String(cat._id)) ? 'checked' : '' %>
                                class="rounded border-gray-300 text-[#15803d] focus:ring-[#15803d]" />
                                <span class="text-sm text-gray-600 group-hover:text-[#15803d]">
                                    <%= cat.name %>
                                </span>
                            </label>
                            <% }) %>
                    </div>
                </div>

                <!-- Connection Filter -->
                <div>
                    <h3 class="font-bold text-[#0d1c0d] mb-3 text-sm uppercase tracking-wide">Connection</h3>
                    <div class="space-y-2">
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input type="checkbox" name="connection" value="Wired" onchange="submitForm()"
                                <%=(Array.isArray(query.connection) ? query.connection.includes('Wired') :
                                query.connection==='Wired' ) ? 'checked' : '' %>
                            class="rounded border-gray-300 text-[#15803d] focus:ring-[#15803d]" />
                            <span class="text-sm text-gray-600 group-hover:text-[#15803d]">Wired</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input type="checkbox" name="connection" value="Wireless" onchange="submitForm()"
                                <%=(Array.isArray(query.connection) ? query.connection.includes('Wireless') :
                                query.connection==='Wireless' ) ? 'checked' : '' %>
                            class="rounded border-gray-300 text-[#15803d] focus:ring-[#15803d]" />
                            <span class="text-sm text-gray-600 group-hover:text-[#15803d]">Wireless</span>
                        </label>
                    </div>
                </div>

                <!-- Brand Filter (Dynamic) -->
                <div>
                    <h3 class="font-bold text-[#0d1c0d] mb-3 text-sm uppercase tracking-wide">Brands</h3>
                    <div class="space-y-2 max-h-48 overflow-y-auto pr-2 custom-scrollbar">
                        <% if (brands && brands.length> 0) { %>
                            <% brands.forEach(brand=> { %>
                                <label class="flex items-center gap-2 cursor-pointer group">
                                    <input type="checkbox" name="brand" value="<%= brand._id %>" onchange="submitForm()"
                                        <%=(Array.isArray(query.brand) ? query.brand.includes(String(brand._id)) :
                                        query.brand===String(brand._id)) ? 'checked' : '' %>
                                    class="rounded border-gray-300 text-[#15803d] focus:ring-[#15803d]" />
                                    <span class="text-sm text-gray-600 group-hover:text-[#15803d]">
                                        <%= brand.name %>
                                    </span>
                                </label>
                                <% }) %>
                                    <% } else { %>
                                        <p class="text-sm text-gray-500">No brands available</p>
                                        <% } %>
                    </div>
                </div>

                <!-- Price Range -->
                <div>
                    <h3 class="font-bold text-[#0d1c0d] mb-3 text-sm uppercase tracking-wide">Price Range</h3>
                    <div class="space-y-3">
                        <div class="flex items-center gap-2">
                            <input type="number" name="minPrice" placeholder="Min" value="<%= query.minPrice || '' %>"
                                min="100" onchange="submitForm()"
                                class="w-full text-sm border-gray-200 rounded-lg focus:border-[#15803d] focus:ring-[#15803d] px-3 py-2" />
                            <span class="text-gray-400">-</span>
                            <input type="number" name="maxPrice" placeholder="Max" value="<%= query.maxPrice || '' %>"
                                min="100" onchange="submitForm()"
                                class="w-full text-sm border-gray-200 rounded-lg focus:border-[#15803d] focus:ring-[#15803d] px-3 py-2" />
                        </div>
                    </div>
                </div>

                <!-- Clear Filters Button -->
                <a href="/products"
                    class="w-full mt-4 flex items-center justify-center px-4 py-2 border border-[#e7f4e7] rounded-lg shadow-sm text-sm font-medium text-[#15803d] bg-white hover:bg-[#e7f4e7] transition-colors">
                    Clear Filters
                </a>

            </aside>

            <!-- Product Grid Area - Background White -->
            <section class="flex-1 bg-white rounded-xl p-6 min-h-screen">

                <!-- Page Title (Moved to Top Left) -->
                <div
                    class="flex flex-col sm:flex-row justify-between items-end mb-6 gap-4 border-b border-gray-100 pb-4">
                    <div>
                        <h1 class="text-3xl font-bold text-[#0d1c0d]">Products</h1>
                        <p class="text-sm text-gray-500 mt-1">
                            Showing <span class="font-bold text-[#0d1c0d]">
                                <%= products.length %>
                            </span> results
                        </p>
                    </div>
                </div>

                <!-- Grid -->
                <% if (products && products.length> 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        <% products.forEach(product=> { %>
                            <% const heroImg=product.images.find(img=> img.isHero) || product.images[0];
                                const imageUrl = (heroImg && heroImg.url) ? heroImg.url : '/images/placeholder.png'; %>
                                <a href="/product/<%= product._id %>"
                                    class="group bg-white rounded-xl overflow-hidden border border-[#e7f4e7] hover:shadow-lg hover:-translate-y-1 transition-all duration-200 flex flex-col h-full">
                                    <!-- Image -->
                                    <div class="aspect-square overflow-hidden bg-[#f0f5f0] relative">
                                        <img src="<%= imageUrl %>" alt="<%= product.title %>"
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                            loading="lazy" onerror="this.src='/images/placeholder.png'" />

                                        <% if (product.discountPercentage> 0) { %>
                                            <div
                                                class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-2 py-1 rounded">
                                                -<%= product.discountPercentage %>%
                                            </div>
                                            <% } %>
                                    </div>

                                    <!-- Content -->
                                    <div class="p-4 space-y-2 flex-1 flex flex-col">
                                        <h3
                                            class="font-medium text-[#0d1c0d] text-sm leading-tight line-clamp-2 min-h-[2.5em]">
                                            <%= product.title %>
                                        </h3>

                                        <div class="mt-auto pt-2">
                                            <div class="flex items-baseline gap-2">
                                                <span class="text-[#15803d] font-bold text-lg">
                                                    ₹<%= product.price.toLocaleString('en-IN') %>
                                                </span>
                                                <% if (product.originalPrice && product.originalPrice> product.price) {
                                                    %>
                                                    <span class="text-xs text-gray-400 line-through">
                                                        ₹<%= product.originalPrice.toLocaleString('en-IN') %>
                                                    </span>
                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                                <% }) %>
                    </div>
                    <% } else { %>
                        <!-- Empty State -->
                        <div class="flex flex-col items-center justify-center py-20 text-center">
                            <div class="bg-[#f0f5f0] p-4 rounded-full mb-4">
                                <svg class="w-8 h-8 text-[#499c49]" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4">
                                    </path>
                                </svg>
                            </div>
                            <h3 class="text-lg font-bold text-[#0d1c0d]">No products found</h3>
                            <p class="text-sm text-gray-500 mt-1">Try adjusting your filters.</p>
                            <a href="/products" class="mt-4 text-[#15803d] font-bold text-sm hover:underline">Clear all
                                filters</a>
                        </div>
                        <% } %>

            </section>
        </form>

    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="flex justify-center border-t border-[#e7f4e7] mt-10 bg-white">
        <div class="flex max-w-[960px] flex-1 flex-col">
            <footer class="flex flex-col gap-6 px-5 py-10 text-center @container">
                <div class="flex flex-wrap items-center justify-center gap-6 @[480px]:flex-row @[480px]:justify-around">
                    <a class="text-[#479e47] text-base font-normal leading-normal min-w-40" href="#">About</a>
                    <a class="text-[#479e47] text-base font-normal leading-normal min-w-40" href="#">Support</a>
                    <a class="text-[#479e47] text-base font-normal leading-normal min-w-40" href="#">Contact</a>
                    <a class="text-[#479e47] text-base font-normal leading-normal min-w-40" href="#">Privacy Policy</a>
                    <a class="text-[#479e47] text-base font-normal leading-normal min-w-40" href="#">Terms of
                        Service</a>
                </div>

                <div class="flex flex-wrap justify-center gap-4">
                    <a href="#" class="text-[#479e47] hover:text-[#15803d]">
                        <!-- Twitter -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                            fill="currentColor" class="size-6">
                            <path
                                d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                        </svg>
                    </a>
                    <a href="#" class="text-[#479e47] hover:text-[#15803d]">
                        <!-- Instagram -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                            fill="currentColor" class="size-6">
                            <path
                                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                        </svg>
                    </a>
                    <a href="#" class="text-[#479e47] hover:text-[#15803d]">
                        <!-- Facebook -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                            fill="currentColor" class="size-6">
                            <path
                                d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                        </svg>
                    </a>
                </div>

                <p class="text-[#479e47] text-base font-normal leading-normal">
                    ©2024 SoundWave. All rights reserved.
                </p>
            </footer>
        </div>
    </footer>
</body>

</html>