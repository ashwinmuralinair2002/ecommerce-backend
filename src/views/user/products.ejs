<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <title>SoundWave | Products</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        // Auto-submit functionality wrapper
        function submitForm() {
            const minPriceInput = document.querySelector('input[name="minPrice"]');
            const maxPriceInput = document.querySelector('input[name="maxPrice"]');

            // Validate minimum price
            if (minPriceInput && minPriceInput.value && parseInt(minPriceInput.value) < 100) {
                minPriceInput.value = 100;
            }

            // Validate range (Max > Min)
            if (minPriceInput && maxPriceInput && minPriceInput.value && maxPriceInput.value) {
                if (parseInt(maxPriceInput.value) <= parseInt(minPriceInput.value)) {
                    // Create inline error or use alert for now
                    const container = minPriceInput.closest('.space-y-3');
                    let errorMsg = container.querySelector('.price-error');
                    if (!errorMsg) {
                        errorMsg = document.createElement('p');
                        errorMsg.className = 'price-error text-red-500 text-xs mt-1';
                        container.appendChild(errorMsg);
                    }
                    errorMsg.textContent = 'Max price must be greater than Min price';
                    return; // Stop submission
                } else {
                    // Clear error
                    const container = minPriceInput.closest('.space-y-3');
                    const errorMsg = container.querySelector('.price-error');
                    if (errorMsg) errorMsg.remove();
                }
            }

            document.getElementById('filter-form').submit();
        }
    </script>
</head>

<body class="bg-background-soft" style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

    <%- include('../partials/user/navbar') %>

        <!-- ================= CONTENT ================= -->
        <main class="w-full px-4 md:px-6 lg:px-8 xl:px-10 py-5">

            <form id="filter-form" action="/products" method="GET" class="flex gap-6 items-start">

                <!-- Sidebar Filters (Desktop) - Green Theme -->
                <aside
                    class="w-60 flex-shrink-0 space-y-7 sticky top-24 hidden lg:block bg-primary-light p-4 rounded-xl border border-primary-light/45">

                    <!-- Sort By (Moved to Top) -->
                    <div>
                        <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide">Sort By</h3>
                        <select name="sort" onchange="submitForm()"
                            class="w-full text-sm border-gray-200 rounded-lg focus:border-primary focus:ring-primary">
                            <option value="newest" <%=query.sort==='newest' ? 'selected' : '' %>>Newest</option>
                            <option value="price_asc" <%=query.sort==='price_asc' ? 'selected' : '' %>>Price: Low to
                                High
                            </option>
                            <option value="price_desc" <%=query.sort==='price_desc' ? 'selected' : '' %>>Price: High to
                                Low
                            </option>
                            <option value="az" <%=query.sort==='az' ? 'selected' : '' %>>Name: A to Z</option>
                            <option value="za" <%=query.sort==='za' ? 'selected' : '' %>>Name: Z to A</option>
                        </select>
                    </div>

                    <!-- Category Filter -->
                    <div>
                        <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide">Category</h3>
                        <div class="space-y-2">
                            <% categories.forEach(cat=> { %>
                                <label class="flex items-center gap-2 cursor-pointer group">
                                    <input type="checkbox" name="category" value="<%= cat._id %>"
                                        onchange="submitForm()" <%=(Array.isArray(query.category) ?
                                        query.category.includes(String(cat._id)) : query.category===String(cat._id))
                                        ? 'checked' : '' %>
                                    class="rounded border-gray-300 text-primary focus:ring-primary" />
                                    <span class="text-sm text-gray-600 group-hover:text-primary">
                                        <%= cat.name %>
                                    </span>
                                </label>
                                <% }) %>
                        </div>
                    </div>

                    <!-- Connection Filter -->
                    <div>
                        <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide">Connection</h3>
                        <div class="space-y-2">
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" name="connection" value="Wired" onchange="submitForm()"
                                    <%=(Array.isArray(query.connection) ? query.connection.includes('Wired') :
                                    query.connection==='Wired' ) ? 'checked' : '' %>
                                class="rounded border-gray-300 text-primary focus:ring-primary" />
                                <span class="text-sm text-gray-600 group-hover:text-primary">Wired</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" name="connection" value="Wireless" onchange="submitForm()"
                                    <%=(Array.isArray(query.connection) ? query.connection.includes('Wireless') :
                                    query.connection==='Wireless' ) ? 'checked' : '' %>
                                class="rounded border-gray-300 text-primary focus:ring-primary" />
                                <span class="text-sm text-gray-600 group-hover:text-primary">Wireless</span>
                            </label>
                        </div>
                    </div>

                    <!-- Brand Filter (Dynamic) -->
                    <div>
                        <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide">Brands</h3>
                        <div class="space-y-2 max-h-48 overflow-y-auto pr-2 custom-scrollbar">
                            <% if (brands && brands.length> 0) { %>
                                <% brands.forEach(brand=> { %>
                                    <label class="flex items-center gap-2 cursor-pointer group">
                                        <input type="checkbox" name="brand" value="<%= brand._id %>"
                                            onchange="submitForm()" <%=(Array.isArray(query.brand) ?
                                            query.brand.includes(String(brand._id)) : query.brand===String(brand._id))
                                            ? 'checked' : '' %>
                                        class="rounded border-gray-300 text-primary focus:ring-primary" />
                                        <span class="text-sm text-gray-600 group-hover:text-primary">
                                            <%= brand.name %>
                                        </span>
                                    </label>
                                    <% }) %>
                                        <% } else { %>
                                            <p class="text-sm text-gray-500">No brands available</p>
                                            <% } %>
                        </div>
                    </div>

                    <!-- Price Range -->
                    <div>
                        <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide">Price Range</h3>
                        <div class="space-y-3">
                            <div class="flex items-center gap-2">
                                <input type="number" name="minPrice" placeholder="Min"
                                    value="<%= query.minPrice || '' %>" min="100" onchange="submitForm()"
                                    class="w-full text-sm border-gray-200 rounded-lg focus:border-primary focus:ring-primary px-3 py-2" />
                                <span class="text-gray-400">-</span>
                                <input type="number" name="maxPrice" placeholder="Max"
                                    value="<%= query.maxPrice || '' %>" min="100" onchange="submitForm()"
                                    class="w-full text-sm border-gray-200 rounded-lg focus:border-primary focus:ring-primary px-3 py-2" />
                            </div>
                        </div>
                    </div>

                    <% if (filterOptions && filterOptions.discountRanges && filterOptions.discountRanges.length) { %>
                        <div>
                            <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide">Discount</h3>
                            <div class="space-y-2">
                                <% filterOptions.discountRanges.forEach(function(val) { %>
                                    <label class="flex items-center gap-2 cursor-pointer group">
                                        <input type="checkbox" name="discountRange" value="<%= val %>" onchange="submitForm()"
                                            <%= (Array.isArray(query.discountRange) ? query.discountRange.includes(String(val)) : query.discountRange===String(val)) ? 'checked' : '' %>
                                        class="rounded border-gray-300 text-primary focus:ring-primary" />
                                        <span class="text-sm text-gray-600 group-hover:text-primary">Up to <%= val %>%</span>
                                    </label>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <% if (filterOptions && filterOptions.newArrivals && filterOptions.newArrivals.length) { %>
                        <div>
                            <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide">New Arrivals</h3>
                            <div class="space-y-2">
                                <% filterOptions.newArrivals.forEach(function(days) { %>
                                    <label class="flex items-center gap-2 cursor-pointer group">
                                        <input type="checkbox" name="newArrivals" value="<%= days %>" onchange="submitForm()"
                                            <%= (Array.isArray(query.newArrivals) ? query.newArrivals.includes(String(days)) : query.newArrivals===String(days)) ? 'checked' : '' %>
                                        class="rounded border-gray-300 text-primary focus:ring-primary" />
                                        <span class="text-sm text-gray-600 group-hover:text-primary">Last <%= days %> days</span>
                                    </label>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <% if (filterOptions && filterOptions.hasMicrophone) { %>
                        <div>
                            <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide">Microphone</h3>
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" name="hasMicrophone" value="true" onchange="submitForm()"
                                    <%= (Array.isArray(query.hasMicrophone) ? query.hasMicrophone.includes('true') : query.hasMicrophone==='true') ? 'checked' : '' %>
                                class="rounded border-gray-300 text-primary focus:ring-primary" />
                                <span class="text-sm text-gray-600 group-hover:text-primary">With Microphone</span>
                            </label>
                        </div>
                    <% } %>

                    <% const multiGroups = [
                        { key: 'noiseControlTypes', label: 'Noise Control', options: filterOptions && filterOptions.noiseControlTypes ? filterOptions.noiseControlTypes : [] },
                        { key: 'controlMethods', label: 'Control Method', options: filterOptions && filterOptions.controlMethods ? filterOptions.controlMethods : [] },
                        { key: 'formFactor', label: 'Form Factor', options: filterOptions && filterOptions.formFactor ? filterOptions.formFactor : [] },
                        { key: 'cableFeatures', label: 'Cable Features', options: filterOptions && filterOptions.cableFeatures ? filterOptions.cableFeatures : [] },
                        { key: 'earpieceShape', label: 'Earpiece Shape', options: filterOptions && filterOptions.earpieceShape ? filterOptions.earpieceShape : [] },
                        { key: 'smartFeatures', label: 'Smart Features', options: filterOptions && filterOptions.smartFeatures ? filterOptions.smartFeatures : [] },
                        { key: 'sensitivityRange', label: 'Sensitivity', options: filterOptions && filterOptions.sensitivityRange ? filterOptions.sensitivityRange : [] },
                        { key: 'compatibleDevices', label: 'Compatible Devices', options: filterOptions && filterOptions.compatibleDevices ? filterOptions.compatibleDevices : [] },
                        { key: 'materials', label: 'Material', options: filterOptions && filterOptions.materials ? filterOptions.materials : [] },
                        { key: 'impedanceRange', label: 'Impedance', options: filterOptions && filterOptions.impedanceRange ? filterOptions.impedanceRange : [] },
                        { key: 'audioDriverTypes', label: 'Audio Driver Type', options: filterOptions && filterOptions.audioDriverTypes ? filterOptions.audioDriverTypes : [] }
                    ]; %>

                    <% multiGroups.forEach(function(group) { %>
                        <% if (group.options && group.options.length) { %>
                            <div>
                                <h3 class="font-bold text-primary mb-3 text-sm uppercase tracking-wide"><%= group.label %></h3>
                                <div class="space-y-2">
                                    <% group.options.forEach(function(opt) { %>
                                        <label class="flex items-center gap-2 cursor-pointer group">
                                            <input type="checkbox" name="<%= group.key %>" value="<%= opt %>" onchange="submitForm()"
                                                <%= (Array.isArray(query[group.key]) ? query[group.key].includes(String(opt)) : query[group.key]===String(opt)) ? 'checked' : '' %>
                                            class="rounded border-gray-300 text-primary focus:ring-primary" />
                                            <span class="text-sm text-gray-600 group-hover:text-primary"><%= opt %></span>
                                        </label>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>

                    <!-- Clear Filters Button -->
                    <a href="/products"
                        class="w-full mt-4 flex items-center justify-center px-4 py-2 border border-primary-light/45 rounded-lg shadow-sm text-sm font-medium text-primary bg-white hover:bg-primary-light/35 transition-colors">
                        Clear Filters
                    </a>

                </aside>

                <!-- Product Grid Area - Background White -->
                <section class="flex-1 bg-white rounded-xl p-5 lg:p-6 min-h-screen">

                    <!-- Page Title (Moved to Top Left) -->
                    <div class="mb-5 border-b border-gray-100 pb-4">
                        <!-- Breadcrumbs -->
                        <nav class="flex text-sm text-gray-500 mb-3" aria-label="Breadcrumb">
                            <ol class="inline-flex items-center space-x-1 md:space-x-2">
                                <li class="inline-flex items-center">
                                    <a href="/" class="inline-flex items-center text-gray-500 hover:text-primary">
                                        Home
                                    </a>
                                </li>
                                <li aria-current="page">
                                    <div class="flex items-center">
                                        <span class="mx-2 text-gray-400">/</span>
                                        <span class="text-primary font-medium">Products</span>
                                    </div>
                                </li>
                            </ol>
                        </nav>

                        <div class="flex flex-col sm:flex-row justify-between items-end gap-3">
                            <div>
                                <h1 class="text-3xl font-bold text-primary">Products</h1>
                                <p class="text-sm text-gray-500 mt-1">
                                    Showing <span class="font-bold text-primary">
                                        <%= products.length %>
                                    </span> results
                                </p>
                            </div>
                        </div>

                        <!-- Grid -->
                        <% if (products && products.length> 0) { %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-5">
                                <% products.forEach(product=> { %>
                                    <% const variantImages = Array.isArray(product.variants) && product.variants.length > 0 && Array.isArray(product.variants[0].images) ? product.variants[0].images : [];
                                        const heroImg = variantImages[0];
                                        const imageUrl = (heroImg && heroImg.url) ? heroImg.url : '/images/placeholder.png';
                                        %>
                                        <a href="/product/<%= product._id %>"
                                            class="group flex flex-col gap-3 pb-3 border border-primary-light/45 p-2 rounded-lg bg-white shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 h-full">
                                            <!-- Image -->
                                            <div class="aspect-square overflow-hidden bg-primary-light/20 relative rounded-lg">
                                                <img src="<%= imageUrl %>" alt="<%= product.title %>"
                                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 rounded-lg"
                                                    loading="lazy" onerror="this.src='/images/placeholder.png'" />

                                                <% if (product.discountPercentage> 0) { %>
                                                    <div
                                                        class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-2 py-1 rounded">
                                                        -<%= product.discountPercentage %>%
                                                    </div>
                                                    <% } %>
                                            </div>

                                            <!-- Content -->
                                            <div class="space-y-2 flex-1 flex flex-col">
                                                <h3
                                                    class="font-medium text-primary text-sm leading-tight line-clamp-2 min-h-[2.5em]">
                                                    <%= product.title %>
                                                </h3>

                                                <div class="mt-auto pt-2">
                                                    <div class="flex items-baseline gap-2">
                                                        <span class="text-primary text-sm font-normal leading-normal">
                                                            ₹<%= product.price.toLocaleString('en-IN') %>
                                                        </span>
                                                        <% if (product.originalPrice && product.originalPrice>
                                                            product.price) {
                                                            %>
                                                            <span class="text-xs text-gray-400 line-through">
                                                                ₹<%= product.originalPrice.toLocaleString('en-IN') %>
                                                            </span>
                                                            <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                        <% }) %>
                            </div>
                            <% } else { %>
                                <!-- Empty State -->
                                <div class="flex flex-col items-center justify-center py-20 text-center">
                                    <div class="bg-primary-light/20 p-4 rounded-full mb-4">
                                        <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4">
                                            </path>
                                        </svg>
                                    </div>
                                    <h3 class="text-lg font-bold text-primary">No products found</h3>
                                    <p class="text-sm text-gray-500 mt-1">Try adjusting your filters.</p>
                                    <a href="/products"
                                        class="mt-4 text-primary font-bold text-sm hover:underline">Clear
                                        all
                                        filters</a>
                                </div>
                                <% } %>

                </section>
            </form>

        </main>

        <!-- ================= FOOTER ================= -->
        <footer class="flex justify-center border-t border-primary-light/45 mt-10 bg-white">
            <div class="flex max-w-[960px] flex-1 flex-col">
                <footer class="flex flex-col gap-6 px-5 py-10 text-center @container">
                    <div
                        class="flex flex-wrap items-center justify-center gap-6 @[480px]:flex-row @[480px]:justify-around">
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">About</a>
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Support</a>
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Contact</a>
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Privacy
                            Policy</a>
                        <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Terms of
                            Service</a>
                    </div>

                    <div class="flex flex-wrap justify-center gap-4">
                        <a href="#" class="text-primary hover:text-primary">
                            <!-- Twitter -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="currentColor" class="size-6">
                                <path
                                    d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                            </svg>
                        </a>
                        <a href="#" class="text-primary hover:text-primary">
                            <!-- Instagram -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="currentColor" class="size-6">
                                <path
                                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                            </svg>
                        </a>
                        <a href="#" class="text-primary hover:text-primary">
                            <!-- Facebook -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="currentColor" class="size-6">
                                <path
                                    d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                            </svg>
                        </a>
                    </div>

                    <p class="text-primary text-base font-normal leading-normal">
                        ©2024 SoundWave. All rights reserved.
                    </p>
                </footer>
            </div>
        </footer>
</body>

</html>
