<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SoundWave | My Orders</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
<%- include('../partials/user/currency-helper') %>
<%
    const orderList = Array.isArray(orders) ? orders : [];
    const currentSearch = typeof search === 'string' ? search : '';
    const currentSort = typeof sort === 'string' && sort ? sort : 'newest';
    const currentDate = typeof date === 'string' ? date : '';
    const currentPaymentMethod = typeof paymentMethod === 'string'
        ? paymentMethod
        : (typeof query?.paymentMethod === 'string' ? query.paymentMethod : '');
    const activePage = Number(currentPage) > 0 ? Number(currentPage) : 1;
    const pageCount = Number(totalPages) > 0 ? Number(totalPages) : 1;
    const totalOrderCount = Number(totalOrders) >= 0 ? Number(totalOrders) : orderList.length;
    const paginationParams = new URLSearchParams();

    if (currentSearch) paginationParams.set('search', currentSearch);
    if (currentDate) paginationParams.set('date', currentDate);
    if (currentSort) paginationParams.set('sort', currentSort);
    if (currentPaymentMethod) paginationParams.set('paymentMethod', currentPaymentMethod);

    const buildPageHref = (pageNumber) => {
        const params = new URLSearchParams(paginationParams.toString());
        params.set('page', pageNumber);
        return `/orders?${params.toString()}`;
    };

    const pageWindowStart = Math.max(1, activePage - 2);
    const pageWindowEnd = Math.min(pageCount, pageWindowStart + 4);
    const visiblePageStart = Math.max(1, pageWindowEnd - 4);

    const formatDate = (value) => value ? new Date(value).toLocaleDateString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    }) : 'N/A';
    const getStatusClasses = (status) => {
        const normalizedStatus = String(status || '').toLowerCase();

        if (normalizedStatus === 'pending') {
            return 'bg-yellow-100 text-yellow-800 border-yellow-200';
        }

        if (normalizedStatus === 'shipped') {
            return 'bg-blue-100 text-blue-800 border-blue-200';
        }

        if (normalizedStatus === 'delivered') {
            return 'bg-green-100 text-green-800 border-green-200';
        }

        if (normalizedStatus === 'cancelled') {
            return 'bg-red-100 text-red-700 border-red-200';
        }

        return 'bg-gray-100 text-gray-700 border-gray-200';
    };
%>

    <div class="relative flex min-h-screen w-full flex-col bg-white"
        style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

        <%- include('../partials/user/navbar') %>

        <main class="flex flex-1 gap-0 px-0 py-0 bg-white">
            <%- include('../partials/user/account-sidebar', { activePage: 'orders' }) %>

            <section class="flex-1 bg-white p-6">
                <nav class="mb-3 flex text-sm text-gray-500" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-2">
                        <li class="inline-flex items-center">
                            <a href="/home" class="inline-flex items-center text-gray-500 hover:text-primary">Home</a>
                        </li>
                        <li aria-current="page">
                            <div class="flex items-center">
                                <span class="mx-2 text-gray-400">/</span>
                                <span class="font-medium text-primary">My Orders</span>
                            </div>
                        </li>
                    </ol>
                </nav>

                <section class="mb-6 rounded-2xl border border-primary-light/40 bg-white px-6 py-6 shadow-sm">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary/70">Account</p>
                            <h1 class="mt-2 text-3xl font-bold text-primary">My Orders</h1>
                            <p class="mt-2 text-sm text-gray-500">Track every purchase, review totals, and open any order for full details.</p>
                        </div>
                        <div class="rounded-xl bg-primary/5 px-4 py-3 text-sm text-primary">
                            <span class="font-semibold"><%= totalOrderCount %></span> order<%= totalOrderCount === 1 ? '' : 's' %>
                        </div>
                    </div>
                </section>

                <section class="mb-6 rounded-2xl border border-primary-light/40 bg-white px-6 py-6 shadow-sm">
                    <form action="/orders" method="GET" class="flex flex-col gap-4 lg:flex-row lg:items-center">
                        <div class="relative flex-1">
                            <input
                                type="text"
                                name="search"
                                placeholder="Search orders..."
                                value="<%= currentSearch %>"
                                class="w-full rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary placeholder:text-primary/50 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
                        </div>

                        <button
                            type="button"
                            id="clear-search-btn"
                            class="inline-flex h-[50px] items-center justify-center rounded-xl border border-primary-light/50 bg-white px-5 text-sm font-semibold text-primary transition hover:bg-primary/5">
                            Clear
                        </button>

                        <select
                            name="date"
                            onchange="this.form.submit()"
                            class="rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                            <option value="" <%= currentDate === '' ? 'selected' : '' %>>All</option>
                            <option value="7d" <%= currentDate === '7d' ? 'selected' : '' %>>Last 7 days</option>
                            <option value="30d" <%= currentDate === '30d' ? 'selected' : '' %>>Last 30 days</option>
                            <option value="6m" <%= currentDate === '6m' ? 'selected' : '' %>>Last 6 months</option>
                            <option value="1y" <%= currentDate === '1y' ? 'selected' : '' %>>Last 1 year</option>
                        </select>

                        <select
                            name="sort"
                            onchange="this.form.submit()"
                            class="rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                            <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest First</option>
                            <option value="oldest" <%= currentSort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                        </select>

                        <select
                            name="paymentMethod"
                            onchange="this.form.submit()"
                            class="rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                            <option value="" <%= currentPaymentMethod === '' ? 'selected' : '' %>>All Payments</option>
                            <option value="online" <%= currentPaymentMethod === 'online' ? 'selected' : '' %>>Online</option>
                            <option value="COD" <%= currentPaymentMethod === 'COD' ? 'selected' : '' %>>Cash on Delivery</option>
                            <option value="wallet" <%= currentPaymentMethod === 'wallet' ? 'selected' : '' %>>Wallet</option>
                        </select>

                        <button
                            type="submit"
                            class="inline-flex h-[50px] items-center justify-center rounded-xl bg-primary px-5 text-sm font-semibold text-white transition hover:opacity-90">
                            Apply
                        </button>

                        <a
                            href="/orders"
                            class="inline-flex h-[50px] items-center justify-center rounded-xl border border-primary-light/50 bg-white px-5 text-sm font-semibold text-primary transition hover:bg-primary/5">
                            Clear Filters
                        </a>
                    </form>
                </section>

                <% if (orderList.length === 0) { %>
                    <section class="rounded-2xl border border-dashed border-primary-light/50 bg-white px-6 py-14 text-center shadow-sm">
                        <h2 class="text-2xl font-bold text-primary">No orders found</h2>
                        <p class="mt-2 text-sm text-gray-500">Try changing your search, date filter, or sort selection. Once you place an order, it will appear here with status and amount details.</p>
                        <a href="/products" class="theme-primary-btn mt-6 inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-bold transition">
                            Start Shopping
                        </a>
                    </section>
                <% } else { %>
                    <section class="grid grid-cols-1 gap-4">
                        <% orderList.forEach((order) => { %>
                            <a href="/orders/<%= order.orderId %>"
                                class="group block rounded-2xl border border-primary-light/40 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary-light/80 hover:shadow-lg">
                                <div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">
                                    <div class="space-y-3">
                                        <div class="flex flex-wrap items-center gap-3">
                                            <span class="rounded-full bg-primary/8 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-primary">Order</span>
                                            <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold capitalize <%= getStatusClasses(order.orderStatus) %>">
                                                <%= order.orderStatus || 'pending' %>
                                            </span>
                                        </div>
                                        <div>
                                            <h2 class="text-xl font-bold text-primary group-hover:text-primary/85"><%= order.orderId %></h2>
                                            <p class="mt-1 text-sm text-gray-500">Placed on <%= formatDate(order.createdAt) %></p>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:min-w-[420px]">
                                        <div class="rounded-xl bg-background-soft px-4 py-3">
                                            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Total Amount</p>
                                            <p class="mt-1 text-base font-bold text-primary"><%= formatCurrency(order.totalAmount) %></p>
                                        </div>
                                        <div class="rounded-xl bg-background-soft px-4 py-3">
                                            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Items</p>
                                            <p class="mt-1 text-base font-bold text-primary"><%= Number(order.totalItems || 0) %></p>
                                        </div>
                                        <div class="col-span-2 rounded-xl bg-primary px-4 py-3 text-white sm:col-span-1">
                                            <p class="text-xs font-medium uppercase tracking-wide text-white/70">View</p>
                                            <p class="mt-1 text-base font-bold">Open details</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        <% }) %>
                    </section>

                    <% if (pageCount > 1) { %>
                        <nav class="mt-6 flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
                            <% if (activePage > 1) { %>
                                <a
                                    href="<%= buildPageHref(activePage - 1) %>"
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-white text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    &laquo; Previous
                                </a>
                            <% } else { %>
                                <span class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium">
                                    &laquo; Previous
                                </span>
                            <% } %>

                            <% for (let i = visiblePageStart; i <= pageWindowEnd; i += 1) { %>
                                <% if (i === activePage) { %>
                                    <span class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#685BCB] text-white text-sm font-bold"><%= i %></span>
                                <% } else { %>
                                    <a
                                        href="<%= buildPageHref(i) %>"
                                        class="flex items-center justify-center h-10 w-10 rounded-lg bg-white text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                        <%= i %>
                                    </a>
                                <% } %>
                            <% } %>

                            <% if (activePage < pageCount) { %>
                                <a
                                    href="<%= buildPageHref(activePage + 1) %>"
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-white text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    Next &raquo;
                                </a>
                            <% } else { %>
                                <span class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium">
                                    Next &raquo;
                                </span>
                            <% } %>
                        </nav>
                    <% } %>
                <% } %>
            </section>
        </main>
    </div>
    <script>
        const clearSearchButton = document.getElementById('clear-search-btn');

        if (clearSearchButton) {
            clearSearchButton.addEventListener('click', () => {
                window.location.href = '/orders';
            });
        }
    </script>
</body>

</html>
