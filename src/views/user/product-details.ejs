<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />
    <title>
        <%= product.title %> | SoundWave
    </title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.svg" /> <!-- Fixed favicon path -->
    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>

<body class="bg-background-soft" style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
    <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">

            <!-- Navbar -->
            <%- include('../partials/user/navbar') %>

                <div class="w-full px-4 md:px-6 lg:px-8 xl:px-10 py-5">
                    <% const hasVariants = Array.isArray(product.variants) && product.variants.length > 0;
                        const getCroppedImageUrl = (image) => {
                        if (!image || !image.url) return '/images/placeholder.png';
                        const crop = image.crop;
                        if (!crop) return image.url;
                        const x = Number(crop.x);
                        const y = Number(crop.y);
                        const width = Number(crop.width);
                        const height = Number(crop.height);
                        if (![x, y, width, height].every(Number.isFinite)) return image.url;
                        if (width <= 0 || height <= 0) return image.url;
                        if (!String(image.url).includes('/upload/')) return image.url;
                        return String(image.url).replace('/upload/', '/upload/c_crop,x_' + Math.max(0, Math.round(x)) + ',y_' + Math.max(0, Math.round(y)) + ',w_' + Math.round(width) + ',h_' + Math.round(height) + '/');
                        };
                        const selectedVariant = hasVariants ? product.variants[0] : null;
                        const selectedVariantId = selectedVariant && selectedVariant._id ? String(selectedVariant._id) : '';
                        const variantImages = selectedVariant && Array.isArray(selectedVariant.images) ? selectedVariant.images : [];
                        const allImages = variantImages;
                        const heroImage=allImages.find(img=> img.isHero) || allImages[0];
                        const heroUrl = heroImage ? getCroppedImageUrl(heroImage) : '/images/placeholder.png';
                        const warrantyDuration = product.warranty && product.warranty.duration ? product.warranty.duration : '';
                        const warrantyProvider = product.warranty && product.warranty.provider ? product.warranty.provider : 'Brand';
                        const hasWarranty = warrantyDuration && warrantyDuration !== 'No Warranty';
                        const nonEmpty = (arr) => Array.isArray(arr) ? arr.filter(Boolean) : [];
                        const noiseCancellationTypes = nonEmpty(product.noiseControlTypes);
                        const advancedAudio = nonEmpty(product.audioDriverTypes);
                        const buildMeta = nonEmpty(product.materials).concat(nonEmpty(product.cableFeatures));
                        const smartMeta = nonEmpty(product.controlMethods).concat(nonEmpty(product.smartFeatures));
                        const compatibilityMeta = nonEmpty(product.compatibleDevices).concat(nonEmpty(product.includedComponents));
                        %>
                        <div class="w-full">
                            <nav class="flex text-sm text-gray-500 mb-3" aria-label="Breadcrumb">
                                <ol class="inline-flex items-center space-x-1 md:space-x-2">
                                    <li class="inline-flex items-center">
                                        <a href="/" class="inline-flex items-center text-gray-500 hover:text-primary">
                                            Home
                                        </a>
                                    </li>
                                    <li>
                                        <div class="flex items-center">
                                            <span class="mx-2 text-gray-400">/</span>
                                            <a href="/products" class="text-gray-500 hover:text-primary">Products</a>
                                        </div>
                                    </li>
                                    <li aria-current="page">
                                        <div class="flex items-center">
                                            <span class="mx-2 text-gray-400">/</span>
                                            <span class="text-primary font-medium">
                                                <%= product.title %>
                                            </span>
                                        </div>
                                    </li>
                                </ol>
                            </nav>

                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
                                <!-- Left Column -->
                                <section class="lg:col-span-5">
                                    <div class="lg:sticky lg:top-24">
                                        <div class="flex flex-col sm:flex-row gap-3 relative z-20">
                                            <% if (allImages.length> 1) { %>
                                                <div
                                                    class="order-2 sm:order-1 flex sm:flex-col gap-2 overflow-x-auto sm:overflow-visible py-1 scrollbar-hide sm:min-w-[88px]">
                                                    <% allImages.forEach((img, index)=> { %>
                                                        <button
                                                            class="thumbnail-image w-20 h-20 border-2 rounded-lg overflow-hidden flex-shrink-0 transition-all duration-200 bg-white p-1 <%= (getCroppedImageUrl(img) === heroUrl) ? 'border-primary ring-1 ring-primary scale-105' : 'border-gray-200 hover:border-primary-light' %>"
                                                            data-index="<%= index %>">
                                                            <img src="<%= getCroppedImageUrl(img) %>" class="w-full h-full object-contain">
                                                        </button>
                                                        <% }); %>
                                                </div>
                                                <% } %>

                                                    <div class="order-1 sm:order-2 flex-1">
                                                        <div id="imageContainer"
                                                            class="group relative w-full aspect-square bg-white rounded-xl border border-gray-200 shadow-sm flex justify-center items-center overflow-visible cursor-crosshair">
                                                            <img src="<%= heroUrl %>" alt="<%= product.title %>"
                                                                class="w-full h-full object-contain p-4 rounded-xl"
                                                                id="mainImage">

                                                            <button id="prevBtn"
                                                                class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 p-2 rounded-full shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-sm z-10"
                                                                aria-label="Previous image">
                                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                                    viewBox="0 0 24 24" stroke-width="2"
                                                                    stroke="currentColor" class="w-5 h-5">
                                                                    <path stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        d="M15.75 19.5L8.25 12l7.5-7.5" />
                                                                </svg>
                                                            </button>
                                                            <button id="nextBtn"
                                                                class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 p-2 rounded-full shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-sm z-10"
                                                                aria-label="Next image">
                                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                                    viewBox="0 0 24 24" stroke-width="2"
                                                                    stroke="currentColor" class="w-5 h-5">
                                                                    <path stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                                                                </svg>
                                                            </button>

                                                            <div id="zoomBox"
                                                                class="hidden xl:block absolute left-[102%] top-0 w-[95%] h-full bg-white border border-gray-200 shadow-2xl rounded-xl z-50 bg-no-repeat opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none"
                                                                style="background-size: 200%;">
                                                            </div>
                                                        </div>
                                                    </div>
                                        </div>
                                        <div class="mt-4 bg-white border border-primary-light/40 rounded-lg p-4">
                                            <h3 class="text-primary text-lg font-bold leading-tight mb-2">Description</h3>
                                            <p class="text-primary text-sm leading-6 whitespace-pre-line">
                                                <%= product.description || product.shortDescription %>
                                            </p>
                                        </div>
                                    </div>
                                </section>

                                <!-- Middle Column -->
                                <section class="lg:col-span-4 space-y-4">
                                    <h1 class="text-primary tracking-light text-[30px] font-bold leading-tight">
                                        <%= product.title %>
                                    </h1>
                                    <div class="flex items-center gap-3 text-sm text-primary">
                                        <span class="font-semibold">4.2</span>
                                        <div class="text-accent">★★★★☆</div>
                                        <span class="text-gray-500">No reviews yet</span>
                                    </div>
                                    <p class="text-sm text-gray-600">
                                        Brand:
                                        <span class="text-primary font-medium">
                                            <%= product.brand ? product.brand.name : 'N/A' %>
                                        </span>
                                    </p>

                                    <div class="bg-white border border-primary-light/40 rounded-lg p-4">
                                        <h3 class="text-primary text-lg font-bold leading-tight mb-2">Specifications
                                        </h3>
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
                                            <div
                                                class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                                <p class="text-primary text-sm font-normal leading-normal">Brand</p>
                                                <p class="text-primary text-sm font-normal leading-normal">
                                                    <%= product.brand ? product.brand.name : 'N/A' %>
                                                </p>
                                            </div>
                                            <div
                                                class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                                <p class="text-primary text-sm font-normal leading-normal">Category</p>
                                                <p class="text-primary text-sm font-normal leading-normal">
                                                    <%= product.category && product.category.name ? product.category.name : (product.category || 'N/A') %>
                                                </p>
                                            </div>
                                            <div
                                                class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                                <p class="text-primary text-sm font-normal leading-normal">Connection
                                                    Type
                                                </p>
                                                <p class="text-primary text-sm font-normal leading-normal">
                                                    <%= product.connectionType %>
                                                </p>
                                            </div>
                                            <div
                                                class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                                <p class="text-primary text-sm font-normal leading-normal">Form Factor</p>
                                                <p class="text-primary text-sm font-normal leading-normal">
                                                    <%= product.formFactor || '—' %>
                                                </p>
                                            </div>
                                            <% if (product.driverSize) { %>
                                                <div
                                                    class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                                    <p class="text-primary text-sm font-normal leading-normal">Driver
                                                        Size
                                                    </p>
                                                    <p class="text-primary text-sm font-normal leading-normal">
                                                        <%= product.driverSize %>
                                                    </p>
                                                </div>
                                                <% } %>
                                                    <% if (product.batteryLife) { %>
                                                        <div
                                                            class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                                            <p
                                                                class="text-primary text-sm font-normal leading-normal">
                                                                Battery Life</p>
                                                            <p
                                                                class="text-primary text-sm font-normal leading-normal">
                                                                <%= product.batteryLife %>
                                                            </p>
                                                        </div>
                                                        <% } %>
                                                            <% if (product.bluetoothVersion) { %>
                                                                <div
                                                                    class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                                                    <p
                                                                        class="text-primary text-sm font-normal leading-normal">
                                                                        Bluetooth Version</p>
                                                                    <p
                                                                        class="text-primary text-sm font-normal leading-normal">
                                                                        <%= product.bluetoothVersion %>
                                                                    </p>
                                                                </div>
                                                                <% } %>
                                                                    <% if (product.weight) { %>
                                                                        <div
                                                                            class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                                                            <p
                                                                                class="text-primary text-sm font-normal leading-normal">
                                                                                Weight</p>
                                                                            <p
                                                                                class="text-primary text-sm font-normal leading-normal">
                                                                                <%= product.weight %>g
                                                                            </p>
                                                                        </div>
                                                                        <% } %>
                                        </div>
                                    </div>

                                    <% if (noiseCancellationTypes.length || advancedAudio.length || buildMeta.length || smartMeta.length || compatibilityMeta.length || product.formFactor || product.earpieceShape || product.impedanceRange || product.sensitivityRange || typeof product.ambientModeAvailable === 'boolean' || product.hasMicrophone || product.batteryChargingTime) { %>
                                        <div class="bg-white border border-primary-light/40 rounded-lg p-4 space-y-4">
                                            <h3 class="text-primary text-lg font-bold leading-tight">Technical Highlights</h3>
                                            <% if (noiseCancellationTypes.length || advancedAudio.length || product.formFactor || product.earpieceShape || product.impedanceRange || product.sensitivityRange || typeof product.ambientModeAvailable === 'boolean') { %>
                                                <div>
                                                    <p class="text-sm font-semibold text-primary mb-1">Audio</p>
                                                    <div class="space-y-1 text-sm text-gray-700">
                                                        <% if (product.formFactor) { %>
                                                            <p><span class="font-semibold text-primary">Form Factor:</span> <%= product.formFactor %></p>
                                                        <% } %>
                                                        <% if (product.earpieceShape) { %>
                                                            <p><span class="font-semibold text-primary">Earpiece Shape:</span> <%= product.earpieceShape %></p>
                                                        <% } %>
                                                        <% if (product.impedanceRange) { %>
                                                            <p><span class="font-semibold text-primary">Impedance Range:</span> <%= product.impedanceRange %></p>
                                                        <% } %>
                                                        <% if (product.sensitivityRange) { %>
                                                            <p><span class="font-semibold text-primary">Sensitivity Range:</span> <%= product.sensitivityRange %></p>
                                                        <% } %>
                                                        <% if (noiseCancellationTypes.length) { %>
                                                            <p><span class="font-semibold text-primary">Noise Cancellation Types:</span> <%= noiseCancellationTypes.join(', ') %></p>
                                                        <% } %>
                                                        <% if (advancedAudio.length) { %>
                                                            <p><span class="font-semibold text-primary">Audio Driver Types:</span> <%= advancedAudio.join(', ') %></p>
                                                        <% } %>
                                                        <% if (typeof product.ambientModeAvailable === 'boolean') { %>
                                                            <p><span class="font-semibold text-primary">Ambient Mode:</span> <%= product.ambientModeAvailable ? 'Yes' : 'No' %></p>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% } %>
                                            <% if (buildMeta.length) { %>
                                                <div>
                                                    <p class="text-sm font-semibold text-primary mb-1">Build & Materials</p>
                                                    <div class="space-y-1 text-sm text-gray-700">
                                                        <% if (Array.isArray(product.materials) && product.materials.length) { %>
                                                            <p><span class="font-semibold text-primary">Materials:</span> <%= product.materials.join(', ') %></p>
                                                        <% } %>
                                                        <% if (Array.isArray(product.cableFeatures) && product.cableFeatures.length) { %>
                                                            <p><span class="font-semibold text-primary">Cable Features:</span> <%= product.cableFeatures.join(', ') %></p>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% } %>
                                            <% if (smartMeta.length || typeof product.hasMicrophone === 'boolean' || product.batteryChargingTime) { %>
                                                <div>
                                                    <p class="text-sm font-semibold text-primary mb-1">Controls & Smart</p>
                                                    <div class="space-y-1 text-sm text-gray-700">
                                                        <% if (Array.isArray(product.controlMethods) && product.controlMethods.length) { %>
                                                            <p><span class="font-semibold text-primary">Control Methods:</span> <%= product.controlMethods.join(', ') %></p>
                                                        <% } %>
                                                        <% if (Array.isArray(product.smartFeatures) && product.smartFeatures.length) { %>
                                                            <p><span class="font-semibold text-primary">Smart Features:</span> <%= product.smartFeatures.join(', ') %></p>
                                                        <% } %>
                                                        <% if (typeof product.hasMicrophone === 'boolean') { %>
                                                            <p><span class="font-semibold text-primary">Microphone:</span> <%= product.hasMicrophone ? 'Yes' : 'No' %></p>
                                                        <% } %>
                                                        <% if (product.batteryChargingTime) { %>
                                                            <p><span class="font-semibold text-primary">Battery Charging Time:</span> <%= product.batteryChargingTime %>h</p>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% } %>
                                            <% if (compatibilityMeta.length) { %>
                                                <div>
                                                    <p class="text-sm font-semibold text-primary mb-1">Compatibility & Box Contents</p>
                                                    <div class="space-y-1 text-sm text-gray-700">
                                                        <% if (Array.isArray(product.compatibleDevices) && product.compatibleDevices.length) { %>
                                                            <p><span class="font-semibold text-primary">Compatible Devices:</span> <%= product.compatibleDevices.join(', ') %></p>
                                                        <% } %>
                                                        <% if (Array.isArray(product.includedComponents) && product.includedComponents.length) { %>
                                                            <p><span class="font-semibold text-primary">Included Components:</span> <%= product.includedComponents.join(', ') %></p>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>

                                </section>

                                <!-- Right Column -->
                                <aside class="lg:col-span-3">
                                    <div
                                        class="lg:sticky lg:top-24 border border-primary-light/45 bg-white rounded-lg shadow-sm p-4 space-y-4">
                                        <div class="pb-3 border-b border-primary-light/30">
                                            <h2 class="text-primary tracking-light text-[30px] font-bold leading-tight">
                                                ₹<%= product.price.toLocaleString('en-IN') %>
                                            </h2>
                                            <% if (product.originalPrice && product.originalPrice> product.price) { %>
                                                <div class="flex items-center gap-2 mt-1">
                                                    <span class="text-gray-500 line-through text-sm">
                                                        ₹<%= product.originalPrice.toLocaleString('en-IN') %>
                                                    </span>
                                                    <span
                                                        class="rounded-md bg-accent px-2 py-1 text-xs font-bold text-black">
                                                        <%= product.discountPercentage %>% OFF
                                                    </span>
                                                </div>
                                                <% } %>
                                        </div>

                                        <div>
                                            <% const stock = selectedVariant ? (parseInt(selectedVariant.stockCount, 10) || 0) : 0; %>
                                            <% const threshold = parseInt(product.reorderThreshold, 10) || 5; %>
                                            <% const isProductUnavailable = product.isListed === false || product.isDeleted === true; %>
                                            <% const canAddToCartInitially = !isProductUnavailable && stock > 0; %>
                                            <% if (stock === 0) { %>
                                                <span id="variantStockLabel" class="text-red-600 font-semibold">Out of Stock</span>
                                            <% } else if (stock <= threshold) { %>
                                                <span id="variantStockLabel" class="text-orange-600 font-semibold">Low Stock (<%= stock %> left)</span>
                                            <% } else { %>
                                                <span id="variantStockLabel" class="text-green-700 font-semibold">In Stock</span>
                                            <% } %>
                                        </div>

                                        <% if (hasVariants) { %>
                                            <div>
                                                <p class="text-sm text-primary font-semibold mb-2">Color</p>
                                                <div id="colorSelector" class="flex flex-wrap gap-2">
                                                    <% product.variants.forEach((variant, index) => { %>
                                                        <button type="button" class="variant-chip h-8 w-8 rounded-full border-2 <%= index === 0 ? 'border-primary ring-1 ring-primary' : 'border-gray-300' %>"
                                                            data-variant-index="<%= index %>"
                                                            title="<%= variant.colorName || variant.colorCode %>"
                                                            style="background-color:<%= variant.colorCode %>"></button>
                                                    <% }) %>
                                                </div>
                                                <p id="selectedColorLabel" class="text-xs text-[#685BCB] mt-2">
                                                    <%= selectedVariant && (selectedVariant.colorName || selectedVariant.colorCode) %>
                                                </p>
                                            </div>
                                        <% } %>

                                        <div class="space-y-3">
                                            <div class="flex items-center border border-primary-light/45 rounded-lg">
                                                <button type="button" id="decrementQuantityButton"
                                                    class="px-3 py-2 text-primary hover:bg-primary-light/35 font-bold">-</button>
                                                <span id="productQuantityValue" class="px-3 py-2 text-primary font-medium">1</span>
                                                <button type="button" id="incrementQuantityButton"
                                                    class="px-3 py-2 text-primary hover:bg-primary-light/35 font-bold">+</button>
                                            </div>

                                            <button id="addToCartButton" type="button"
                                                class="theme-primary-btn w-full items-center justify-center overflow-hidden rounded-lg h-10 px-4 text-sm leading-normal tracking-[0.015em] <%= canAddToCartInitially ? 'cursor-pointer' : 'cursor-not-allowed opacity-50 pointer-events-none' %>"
                                                <%= canAddToCartInitially ? '' : 'disabled aria-disabled="true"' %>>
                                                <%= canAddToCartInitially ? 'Add to Cart' : 'Out of Stock' %>
                                            </button>
                                            <p id="addToCartFeedback" class="hidden text-xs"></p>
                                            <p id="productAvailabilityMessage" class="text-xs <%= isProductUnavailable ? 'text-red-600' : 'text-gray-500' %> <%= (isProductUnavailable || !canAddToCartInitially) ? '' : 'hidden' %>">
                                                <%= isProductUnavailable ? 'This product is currently unavailable' : 'Selected variant is out of stock' %>
                                            </p>
                                            <button
                                                class="theme-accent-btn w-full flex h-10 items-center justify-center rounded-lg px-6 text-sm font-bold">
                                                Buy Now
                                            </button>
                                            <button
                                                type="button"
                                                data-add-to-wishlist
                                                data-product-id="<%= product._id %>"
                                                data-variant-id="<%= selectedVariantId %>"
                                                class="w-full flex items-center justify-center gap-2 rounded-lg h-10 border border-primary-light/45 text-primary hover:bg-primary-light/35">
                                                <span>❤️</span>
                                                <span data-wishlist-label>Add to Wishlist</span>
                                            </button>
                                        </div>

                                        <div class="pt-3 border-t border-primary-light/30 space-y-2 text-sm text-primary">
                                            <p><span class="font-semibold">Delivery:</span> Free delivery by tomorrow
                                                for eligible locations.</p>
                                            <% if (hasWarranty) { %>
                                                <p>
                                                    <span class="font-semibold">Warranty:</span>
                                                    <%= warrantyDuration %> <%= warrantyProvider === 'SoundWave' ? 'SoundWave warranty.' : 'manufacturer warranty.' %>
                                                </p>
                                                <% } %>
                                            <p class="text-gray-600">Secure transaction. Your data is protected.</p>
                                        </div>
                                    </div>
                                    <div class="mt-4 bg-white border border-primary-light/40 rounded-lg p-4">
                                        <h3 class="text-primary text-lg font-bold leading-tight mb-2">Customer Reviews
                                        </h3>
                                        <p class="text-primary text-base font-normal leading-normal">No reviews yet.</p>
                                    </div>
                                </aside>
                            </div>

                            <div class="mt-8 space-y-6">
                                <section>
                                    <h3
                                        class="text-primary text-lg font-bold leading-tight tracking-[-0.015em] pb-2">
                                        Similar Products</h3>
                                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                                        <% if (relatedProducts && relatedProducts.length> 0) { %>
                                            <% relatedProducts.forEach(relProduct=> {
                                                const relVariant = Array.isArray(relProduct.variants) && relProduct.variants.length > 0 && Array.isArray(relProduct.variants[0].images) ? relProduct.variants[0].images : [];
                                                const relImg = relVariant.length > 0 ? getCroppedImageUrl(relVariant[0]) : '/images/placeholder.png';
                                                %>
                                                <a href="/product/<%= relProduct._id %>" class="block">
                                                    <div
                                                        class="flex flex-col gap-3 pb-3 border border-primary-light/45 p-2 rounded-lg bg-white cursor-pointer transition hover:shadow-lg hover:scale-[1.02]">
                                                        <div class="w-full aspect-square overflow-hidden rounded-lg">
                                                            <img src="<%= relImg %>" alt="<%= relProduct.title %>"
                                                                class="w-full h-full object-cover">
                                                        </div>
                                                        <div>
                                                            <p
                                                                class="text-primary text-base font-medium leading-normal hover:underline line-clamp-1">
                                                                <%= relProduct.title %>
                                                            </p>
                                                            <p class="text-primary text-sm font-normal leading-normal">₹
                                                                <%= relProduct.price.toLocaleString('en-IN') %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </a>
                                                <% }); %>
                                            <% } else { %>
                                                <div class="col-span-full py-2">
                                                    <p class="text-gray-500 italic">No related products available.</p>
                                                </div>
                                                <% } %>
                                    </div>
                                </section>

                                <section>
                                    <h3
                                        class="text-primary text-lg font-bold leading-tight tracking-[-0.015em] pb-2">
                                        Customers Also Bought</h3>
                                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                                        <% if (alsoBought && alsoBought.length> 0) { %>
                                            <% alsoBought.forEach(abProduct=> {
                                                const abVariant = Array.isArray(abProduct.variants) && abProduct.variants.length > 0 && Array.isArray(abProduct.variants[0].images) ? abProduct.variants[0].images : [];
                                                const abImg = abVariant.length > 0 ? getCroppedImageUrl(abVariant[0]) : '/images/placeholder.png';
                                                %>
                                                <a href="/product/<%= abProduct._id %>" class="block">
                                                    <div
                                                        class="flex flex-col gap-3 pb-3 border border-primary-light/45 p-2 rounded-lg bg-white cursor-pointer transition hover:shadow-lg hover:scale-[1.02]">
                                                        <div class="w-full aspect-square overflow-hidden rounded-lg">
                                                            <img src="<%= abImg %>" alt="<%= abProduct.title %>"
                                                                class="w-full h-full object-cover">
                                                        </div>
                                                        <div>
                                                            <p
                                                                class="text-primary text-base font-medium leading-normal hover:underline line-clamp-1">
                                                                <%= abProduct.title %>
                                                            </p>
                                                            <p class="text-primary text-sm font-normal leading-normal">₹
                                                                <%= abProduct.price.toLocaleString('en-IN') %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </a>
                                                <% }); %>
                                                    <% } else { %>
                                                        <div class="col-span-full py-2">
                                                            <p class="text-gray-500 italic">No recommendations
                                                                available.
                                                            </p>
                                                        </div>
                                                        <% } %>
                                    </div>
                                </section>
                            </div>
                        </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        let currentIndex = 0;
                        let currentVariantIndex = 0;
                        let selectedQuantity = 1;
                        let isAddingToCart = false;
                        const variants = <%- JSON.stringify(product && Array.isArray(product.variants) ? product.variants : []) %>;
                        const productId = <%- JSON.stringify(product && product._id ? String(product._id) : '') %>;

                        const mainImg = document.getElementById("mainImage");
                        const zoomBox = document.getElementById("zoomBox");
                        const container = document.getElementById("imageContainer");
                        const prevBtn = document.getElementById("prevBtn");
                        const nextBtn = document.getElementById("nextBtn");
                        const colorLabel = document.getElementById("selectedColorLabel");
                        const stockLabel = document.getElementById("variantStockLabel");
                        const addToCartButton = document.getElementById("addToCartButton");
                        const addToCartFeedback = document.getElementById("addToCartFeedback");
                        const productAvailabilityMessage = document.getElementById("productAvailabilityMessage");
                        const decrementQuantityButton = document.getElementById("decrementQuantityButton");
                        const incrementQuantityButton = document.getElementById("incrementQuantityButton");
                        const productQuantityValue = document.getElementById("productQuantityValue");
                        const wishlistButtons = Array.from(document.querySelectorAll('[data-add-to-wishlist]'));
                        const wishlistVariantIds = new Set(<%- JSON.stringify(Array.isArray(wishlistVariantIds) ? wishlistVariantIds.map(String) : []) %>);
                        const colorChips = Array.from(document.querySelectorAll(".variant-chip"));
                        const thumbnailStrip = document.querySelector(".thumbnail-image")?.parentElement || null;
                        const isProductUnavailable = <%- JSON.stringify(product.isListed === false || product.isDeleted === true) %>;
                        const MAX_QUANTITY = 5;

                        function syncNavbarCartCount(count) {
                            if (typeof window.syncNavbarCartCount === 'function') {
                                window.syncNavbarCartCount(count);
                                return;
                            }
                            const cartCountElement = document.querySelector('[data-cart-count]');
                            if (!cartCountElement) return;
                            cartCountElement.textContent = String(Number(count) || 0);
                        }

                        function setWishlistButtonState(button, isAdded) {
                            if (!button) return;

                            const label = button.querySelector('[data-wishlist-label]');
                            if (label) {
                                label.textContent = isAdded ? 'Added' : 'Add to Wishlist';
                            }

                            button.disabled = isAdded;
                            button.classList.toggle('opacity-60', isAdded);
                            button.classList.toggle('cursor-not-allowed', isAdded);
                            button.classList.toggle('hover:bg-primary-light/35', !isAdded);
                        }

                        function syncWishlistButtons() {
                            const activeVariant = variants[currentVariantIndex] || variants[0] || {};
                            const activeVariantId = activeVariant && activeVariant._id ? String(activeVariant._id) : '';

                            wishlistButtons.forEach((button) => {
                                button.dataset.variantId = activeVariantId;
                                setWishlistButtonState(button, wishlistVariantIds.has(activeVariantId));
                            });
                        }

                        function showAddToCartFeedback(message, type) {
                            if (!addToCartFeedback) return;
                            addToCartFeedback.classList.add('hidden');
                            addToCartFeedback.textContent = '';
                            addToCartFeedback.classList.remove('text-red-600', 'text-green-700');
                        }

                        function updateQuantityControls() {
                            const activeVariant = variants[currentVariantIndex] || {};
                            const stockCount = parseInt(activeVariant.stockCount, 10) || 0;
                            const maxAllowedQuantity = Math.max(1, Math.min(MAX_QUANTITY, stockCount || MAX_QUANTITY));

                            if (stockCount > 0 && selectedQuantity > maxAllowedQuantity) {
                                selectedQuantity = maxAllowedQuantity;
                            }

                            if (productQuantityValue) {
                                productQuantityValue.textContent = String(selectedQuantity);
                            }

                            if (decrementQuantityButton) {
                                decrementQuantityButton.disabled = selectedQuantity <= 1;
                            }

                            if (incrementQuantityButton) {
                                incrementQuantityButton.disabled = stockCount <= 0 || selectedQuantity >= maxAllowedQuantity;
                            }
                        }

                        function toUrls(images) {
                            return (images || [])
                                .map((img) => {
                                    if (!img || typeof img !== 'object') return img;
                                    const crop = img.crop;
                                    if (!crop || !img.url || !String(img.url).includes('/upload/')) return img.url;
                                    const x = Number(crop.x);
                                    const y = Number(crop.y);
                                    const width = Number(crop.width);
                                    const height = Number(crop.height);
                                    if (![x, y, width, height].every(Number.isFinite)) return img.url;
                                    if (width <= 0 || height <= 0) return img.url;
                                    return String(img.url).replace('/upload/', `/upload/c_crop,x_${Math.max(0, Math.round(x))},y_${Math.max(0, Math.round(y))},w_${Math.round(width)},h_${Math.round(height)}/`);
                                })
                                .filter((url) => typeof url === 'string' && url.trim().length > 0);
                        }

                        function getActiveImageUrls() {
                            if (variants.length > 0) {
                                const variant = variants[currentVariantIndex] || {};
                                const variantUrls = toUrls(variant.images || []);
                                if (variantUrls.length > 0) return variantUrls;
                            }
                            return [];
                        }

                        let activeImageUrls = getActiveImageUrls();

                        // Sync initial index with server rendered image
                        if (mainImg && activeImageUrls.length > 0) {
                            const currentSrc = mainImg.getAttribute('src');
                            const found = activeImageUrls.findIndex((url) => (
                                url === currentSrc ||
                                mainImg.src === url ||
                                mainImg.src.endsWith(url)
                            ));
                            if (found !== -1) currentIndex = found;
                        }

                        function updateZoomBackground() {
                            if (zoomBox && mainImg) {
                                zoomBox.style.backgroundImage = `url('${mainImg.src}')`;
                                zoomBox.style.backgroundSize = "200% 200%";
                            }
                        }

                        function renderThumbnails() {
                            if (!thumbnailStrip) return;
                            thumbnailStrip.innerHTML = '';
                            if (activeImageUrls.length <= 1) {
                                thumbnailStrip.classList.add('hidden');
                                return;
                            }
                            thumbnailStrip.classList.remove('hidden');
                            activeImageUrls.forEach((url, index) => {
                                const btn = document.createElement('button');
                                btn.className = `thumbnail-image w-20 h-20 border-2 rounded-lg overflow-hidden flex-shrink-0 transition-all duration-200 bg-white p-1 ${index === currentIndex ? 'border-primary ring-1 ring-primary scale-105' : 'border-gray-200 hover:border-primary-light'}`;
                                btn.dataset.index = String(index);
                                btn.innerHTML = `<img src="${url}" class="w-full h-full object-contain">`;
                                btn.addEventListener('click', () => updateHeroImage(index));
                                thumbnailStrip.appendChild(btn);
                            });
                        }

                        function updateSelectedColorState() {
                            if (!colorChips.length) return;
                            colorChips.forEach((chip, idx) => {
                                if (idx === currentVariantIndex) {
                                    chip.classList.add('border-primary', 'ring-1', 'ring-primary');
                                    chip.classList.remove('border-gray-300');
                                } else {
                                    chip.classList.remove('border-primary', 'ring-1', 'ring-primary');
                                    chip.classList.add('border-gray-300');
                                }
                            });
                            if (colorLabel && variants[currentVariantIndex]) {
                                colorLabel.textContent = variants[currentVariantIndex].colorName || variants[currentVariantIndex].colorCode || '';
                            }
                            if (stockLabel) {
                                const activeVariant = variants[currentVariantIndex] || {};
                                const stockCount = parseInt(activeVariant.stockCount, 10) || 0;
                                const reorderThreshold = <%- JSON.stringify(parseInt(product.reorderThreshold, 10) || 5) %>;

                                let stockText = 'Out of Stock';
                                let stockClass = 'text-red-600';

                                if (stockCount > 0 && stockCount <= reorderThreshold) {
                                    stockText = `Low Stock (${stockCount} left)`;
                                    stockClass = 'text-orange-600';
                                } else if (stockCount > reorderThreshold) {
                                    stockText = 'In Stock';
                                    stockClass = 'text-green-700';
                                }

                                stockLabel.textContent = stockText;
                                stockLabel.classList.remove('text-green-700', 'text-orange-600', 'text-red-600');
                                stockLabel.classList.add(stockClass);
                            }
                            updateQuantityControls();
                            updateAddToCartState();
                            syncWishlistButtons();
                        }

                        function updateAddToCartState() {
                            if (!addToCartButton) return;

                            const activeVariant = variants[currentVariantIndex] || {};
                            const stockCount = parseInt(activeVariant.stockCount, 10) || 0;
                            const canAddToCart = !isProductUnavailable && stockCount > 0;

                            addToCartButton.disabled = !canAddToCart;
                            addToCartButton.setAttribute('aria-disabled', canAddToCart ? 'false' : 'true');
                            addToCartButton.textContent = canAddToCart ? 'Add to Cart' : 'Out of Stock';
                            addToCartButton.classList.toggle('cursor-pointer', canAddToCart);
                            addToCartButton.classList.toggle('cursor-not-allowed', !canAddToCart);
                            addToCartButton.classList.toggle('opacity-50', !canAddToCart);
                            addToCartButton.classList.toggle('pointer-events-none', !canAddToCart);
                            updateQuantityControls();

                            if (!productAvailabilityMessage) return;

                            if (isProductUnavailable) {
                                productAvailabilityMessage.textContent = 'This product is currently unavailable';
                                productAvailabilityMessage.classList.remove('hidden', 'text-gray-500');
                                productAvailabilityMessage.classList.add('text-red-600');
                                return;
                            }

                            if (stockCount <= 0) {
                                productAvailabilityMessage.textContent = 'Selected variant is out of stock';
                                productAvailabilityMessage.classList.remove('hidden', 'text-red-600');
                                productAvailabilityMessage.classList.add('text-gray-500');
                                return;
                            }

                            productAvailabilityMessage.classList.add('hidden');
                        }

                        // Initialize Zoom
                        updateZoomBackground();
                        renderThumbnails();
                        updateSelectedColorState();

                        function updateHeroImage(index) {
                            if (!activeImageUrls.length || !mainImg) return;

                            if (index < 0) index = activeImageUrls.length - 1;
                            if (index >= activeImageUrls.length) index = 0;

                            currentIndex = index;
                            mainImg.src = activeImageUrls[currentIndex];

                            updateZoomBackground();

                            // Update thumbnails visual state
                            document.querySelectorAll(".thumbnail-image").forEach((btn, idx) => {
                                if (idx === currentIndex) {
                                    btn.classList.add('border-primary', 'ring-1', 'ring-primary', 'scale-105');
                                    btn.classList.remove('border-gray-200', 'hover:border-primary-light');
                                } else {
                                    btn.classList.remove('border-primary', 'ring-1', 'ring-primary', 'scale-105');
                                    btn.classList.add('border-gray-200', 'hover:border-primary-light');
                                }
                            });
                        }

                        function switchVariant(variantIndex) {
                            currentVariantIndex = variantIndex;
                            activeImageUrls = getActiveImageUrls();
                            currentIndex = 0;
                            if (mainImg && activeImageUrls.length > 0) {
                                mainImg.src = activeImageUrls[0];
                            }
                            updateZoomBackground();
                            renderThumbnails();
                            updateSelectedColorState();
                        }

                        // Event Listeners
                        if (prevBtn) {
                            prevBtn.addEventListener("click", function () {
                                updateHeroImage(currentIndex - 1);
                            });
                        }

                        if (nextBtn) {
                            nextBtn.addEventListener("click", function () {
                                updateHeroImage(currentIndex + 1);
                            });
                        }
                        colorChips.forEach((chip) => {
                            chip.addEventListener('click', () => {
                                switchVariant(Number(chip.dataset.variantIndex));
                            });
                        });

                        if (decrementQuantityButton) {
                            decrementQuantityButton.addEventListener('click', () => {
                                if (decrementQuantityButton.disabled) return;
                                selectedQuantity = Math.max(1, selectedQuantity - 1);
                                updateQuantityControls();
                                showAddToCartFeedback('', 'success');
                            });
                        }

                        if (incrementQuantityButton) {
                            incrementQuantityButton.addEventListener('click', () => {
                                if (incrementQuantityButton.disabled) return;
                                selectedQuantity = Math.min(MAX_QUANTITY, selectedQuantity + 1);
                                updateQuantityControls();
                                showAddToCartFeedback('', 'success');
                            });
                        }

                        if (addToCartButton) {
                            addToCartButton.addEventListener('click', async () => {
                                if (addToCartButton.disabled || isAddingToCart) return;

                                const activeVariant = variants[currentVariantIndex] || {};
                                const variantId = activeVariant && activeVariant._id ? String(activeVariant._id) : '';

                                if (!productId || !variantId) {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: 'Unable to identify the selected product variant.'
                                    });
                                    return;
                                }

                                isAddingToCart = true;
                                addToCartButton.disabled = true;
                                showAddToCartFeedback('', 'success');

                                try {
                                    const response = await fetch('/api/cart/add', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                            'X-Requested-With': 'XMLHttpRequest'
                                        },
                                        body: JSON.stringify({
                                            productId,
                                            variantId,
                                            quantity: selectedQuantity
                                        })
                                    });

                                    const result = await response.json().catch(() => null);

                                    if (!response.ok || !result || result.success !== true) {
                                        throw new Error(result && result.message ? result.message : 'Unable to add item to cart');
                                    }

                                    const totalItems = result.data && typeof result.data.totalItems === 'number'
                                        ? result.data.totalItems
                                        : 0;
                                    syncNavbarCartCount(totalItems);
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Added to Cart',
                                        text: 'Item has been added to your cart',
                                        timer: 1500,
                                        showConfirmButton: false
                                    });
                                } catch (error) {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: error.message || 'Failed to add item to cart'
                                    });
                                } finally {
                                    isAddingToCart = false;
                                    updateAddToCartState();
                                }
                            });
                        }

                        wishlistButtons.forEach((button) => {
                            button.addEventListener('click', async () => {
                                const activeVariant = variants[currentVariantIndex] || variants[0] || {};
                                const activeVariantId = activeVariant && activeVariant._id ? String(activeVariant._id) : '';
                                const variantId = activeVariantId || button.dataset.variantId;

                                button.dataset.variantId = variantId;

                                const currentProductId = button.dataset.productId;

                                if (!variantId) {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: 'Unable to identify the selected product variant.'
                                    });
                                    return;
                                }

                                if (wishlistVariantIds.has(variantId)) {
                                    setWishlistButtonState(button, true);
                                    return;
                                }

                                try {
                                    button.disabled = true;

                                    const res = await fetch('/wishlist/add', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ productId: currentProductId, variantId })
                                    });

                                    const data = await res.json();

                                    if (!data.success) throw new Error(data.message);

                                    wishlistVariantIds.add(variantId);
                                    syncWishlistButtons();
                                    if (typeof data.wishlistCount === 'number' && typeof window.syncNavbarWishlistCount === 'function') {
                                        window.syncNavbarWishlistCount(data.wishlistCount);
                                    } else if (typeof window.refreshNavbarWishlistCount === 'function') {
                                        window.refreshNavbarWishlistCount();
                                    }

                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Success',
                                        text: data.alreadyExists ? 'Already in wishlist' : 'Added to wishlist',
                                        timer: 1500,
                                        showConfirmButton: false
                                    });
                                } catch (err) {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: err.message || 'Something went wrong'
                                    });
                                } finally {
                                    syncWishlistButtons();
                                }
                            });
                        });

                        // Amazon-style Zoom Logic
                        if (container && zoomBox) {
                            container.addEventListener("mousemove", function (e) {
                                const rect = container.getBoundingClientRect();

                                const x = ((e.clientX - rect.left) / rect.width) * 100;
                                const y = ((e.clientY - rect.top) / rect.height) * 100;

                                zoomBox.style.backgroundPosition = `${x}% ${y}%`;
                                zoomBox.style.display = "block";
                                // Ensure visible if CSS was hiding it
                                zoomBox.style.visibility = "visible";
                                zoomBox.style.opacity = "1";
                            });

                            container.addEventListener("mouseleave", function () {
                                zoomBox.style.display = "none";
                            });
                        }
                    });
                </script>

                <footer class="flex justify-center border-t border-primary-light/45 mt-10 bg-white">
                    <div class="flex max-w-[960px] flex-1 flex-col">
                        <footer class="flex flex-col gap-6 px-5 py-10 text-center @container">
                            <div
                                class="flex flex-wrap items-center justify-center gap-6 @[480px]:flex-row @[480px]:justify-around">
                                <a class="text-primary text-base font-normal leading-normal min-w-40"
                                    href="#">About</a>
                                <a class="text-primary text-base font-normal leading-normal min-w-40"
                                    href="#">Support</a>
                                <a class="text-primary text-base font-normal leading-normal min-w-40"
                                    href="#">Contact</a>
                                <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Privacy
                                    Policy</a>
                                <a class="text-primary text-base font-normal leading-normal min-w-40" href="#">Terms
                                    of
                                    Service</a>
                            </div>
                            <p class="text-primary text-base font-normal leading-normal">
                                ©2024 SoundWave. All rights reserved.
                            </p>
                        </footer>
                    </div>
                </footer>

        </div>
    </div>
</body>

</html>
