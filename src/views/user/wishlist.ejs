<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SoundWave | Wishlist</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-white" style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>
<%
    const wishlistData = (typeof wishlist !== 'undefined' && wishlist) ? wishlist : { items: [] };
    const wishlistItems = Array.isArray(wishlistData.items) ? wishlistData.items : [];
    const formatCurrency = (value) => `₹${Number(value || 0).toLocaleString('en-IN')}`;
%>

    <%- include('../partials/user/navbar') %>

    <main class="max-w-6xl mx-auto px-4 py-6">
        <nav class="mb-4 flex text-sm text-gray-500" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-2">
                <li class="inline-flex items-center">
                    <a href="/home" class="inline-flex items-center text-gray-500 hover:text-primary">Home</a>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <span class="mx-2 text-gray-400">/</span>
                        <span class="font-medium text-primary">Wishlist</span>
                    </div>
                </li>
            </ol>
        </nav>

        <section class="mb-8 rounded-2xl border border-primary-light/40 bg-white px-6 py-6 shadow-sm">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary/70">Account</p>
                    <h1 class="mt-2 text-3xl font-bold text-primary">My Wishlist</h1>
                    <p class="mt-2 text-sm text-gray-500">Save favorites for later and move them into your cart when you are ready.</p>
                </div>
                <div class="rounded-xl bg-primary/5 px-4 py-3 text-sm text-primary">
                    <span id="wishlist-count" class="font-semibold"><%= wishlistItems.length %></span> item<%= wishlistItems.length === 1 ? '' : 's' %>
                </div>
            </div>
        </section>

        <section id="wishlist-empty-state" class="<%= wishlistItems.length ? 'hidden' : '' %> rounded-2xl border border-dashed border-primary-light/50 bg-white px-6 py-16 text-center shadow-sm">
            <h2 class="text-2xl font-bold text-primary">Your wishlist is empty</h2>
            <p class="mt-2 text-sm text-gray-500">Browse products and add the ones you want to keep an eye on.</p>
        </section>

        <section id="wishlist-grid" class="<%= wishlistItems.length ? '' : 'hidden' %> grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            <% wishlistItems.forEach((item) => {
                const product = item.product || {};
                const image = product.images && product.images.length
                    ? (product.images[0].url)
                    : '/images/placeholder.png';
                const productId = product._id || item.productId || '';
                const variantId = item.variantId || '';
            %>
                <article
                    class="wishlist-card overflow-hidden rounded-2xl border border-primary-light/40 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-md"
                    data-product-id="<%= productId %>"
                    data-variant-id="<%= variantId %>">
                    <a href="/product/<%= productId %>" class="block">
                        <div class="aspect-square flex items-center justify-center bg-gray-100 rounded-lg">
                            <img
                                src="<%= image %>"
                                alt="<%= product.title || product.name || 'Wishlist product image' %>"
                                class="max-h-full max-w-full object-contain"
                                onerror="this.onerror=null;this.src='/images/placeholder.png';">
                        </div>

                        <div class="p-5">
                            <h2 class="line-clamp-2 text-lg font-bold text-primary"><%= product.name || 'Untitled Product' %></h2>
                            <% const wishlistMrp = Number(product.price || 0); %>
                            <% const wishlistDiscount = Number(product.discountPercentage || 0); %>
                            <% const wishlistFinalPrice = wishlistMrp - ((wishlistMrp * wishlistDiscount) / 100); %>
                            <% if (wishlistDiscount > 0) { %>
                                <div class="mt-2">
                                    <p class="text-sm text-gray-400 line-through">₹<%= wishlistMrp.toLocaleString('en-IN') %></p>
                                    <p class="text-xl font-semibold text-primary">₹<%= wishlistFinalPrice.toLocaleString('en-IN') %></p>
                                </div>
                            <% } else { %>
                                <p class="mt-2 text-xl font-semibold text-primary">₹<%= wishlistMrp.toLocaleString('en-IN') %></p>
                            <% } %>
                            <% if ((product.priceChange || 0) > 0) { %>
                                <p class="mt-2 text-sm font-medium text-red-600">↑ Price increased by ₹<%= Math.abs(product.priceChange || 0) %></p>
                            <% } %>
                            <% if ((product.priceChange || 0) < 0) { %>
                                <p class="mt-2 text-sm font-medium text-green-600">↓ Price dropped by ₹<%= Math.abs(product.priceChange || 0) %></p>
                            <% } %>
                        </div>
                    </a>

                    <div class="px-5 pb-5">
                        <div class="flex gap-2 mt-3">
                            <button
                                type="button"
                                data-move-to-cart
                                data-product-id="<%= product._id %>"
                                data-variant-id="<%= item.variantId %>"
                                class="theme-primary-btn h-9 px-3 text-sm rounded-lg flex-1">
                                Move to Cart
                            </button><button
                                type="button"
                                data-remove-wishlist
                                data-product-id="<%= productId %>"
                                data-variant-id="<%= variantId %>"
                                class="theme-secondary-btn h-9 px-3 text-sm rounded-lg flex-1">
                                Remove
                            </button>
                        </div>
                    </div>
                </article>
            <% }) %>
        </section>
    </main>

    <script>
        (() => {
            const wishlistGrid = document.getElementById('wishlist-grid');
            const emptyState = document.getElementById('wishlist-empty-state');
            const wishlistCount = document.getElementById('wishlist-count');

            if (!wishlistGrid) return;

            const setCardLoading = (card, isLoading) => {
                if (!card) return;

                const buttons = card.querySelectorAll('button');

                buttons.forEach((button) => {
                    button.disabled = isLoading;
                    button.classList.toggle('opacity-50', isLoading);
                    button.classList.toggle('pointer-events-none', isLoading);
                });
            };

            const updateEmptyState = () => {
                const remainingCards = wishlistGrid.querySelectorAll('.wishlist-card').length;

                if (wishlistCount) {
                    wishlistCount.textContent = String(remainingCards);
                }

                if (typeof window.syncNavbarWishlistCount === 'function') {
                    window.syncNavbarWishlistCount(remainingCards);
                }

                if (remainingCards === 0) {
                    wishlistGrid.classList.add('hidden');
                    emptyState.classList.remove('hidden');
                }
            };

            const removeCard = (card) => {
                if (!card) return;
                card.remove();
                updateEmptyState();
            };

            const callWishlistEndpoint = async (url, method) => {
                const response = await fetch(url, {
                    method,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json().catch(() => ({}));

                if (!response.ok || data.success === false) {
                    throw new Error(data.message || 'Request failed');
                }

                return data;
            };

            wishlistGrid.addEventListener('click', async (event) => {
                const actionButton = event.target.closest('[data-move-to-cart], [data-remove-wishlist]');

                if (!actionButton) return;

                const card = actionButton.closest('.wishlist-card');
                const productId = actionButton.getAttribute('data-product-id');
                const variantId = actionButton.getAttribute('data-variant-id');

                if (!card || !productId || !variantId) return;

                const isMoveToCart = actionButton.hasAttribute('data-move-to-cart');
                const endpoint = isMoveToCart ? '/wishlist/move-to-cart' : '/wishlist/remove';
                const method = isMoveToCart ? 'PATCH' : 'DELETE';
                const params = new URLSearchParams({ productId, variantId });

                try {
                    setCardLoading(card, true);
                    await callWishlistEndpoint(`${endpoint}?${params.toString()}`, method);
                    removeCard(card);
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: isMoveToCart ? 'Item moved to cart' : 'Item removed from wishlist',
                        timer: 1500,
                        showConfirmButton: false
                    });
                } catch (error) {
                    setCardLoading(card, false);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message || 'Something went wrong'
                    });
                }
            });
        })();
    </script>
</body>

</html>
