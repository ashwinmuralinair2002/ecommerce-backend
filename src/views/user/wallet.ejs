<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SoundWave | Wallet</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
<%
    const walletBalance = Number(balance || 0);
    const walletTransactions = Array.isArray(transactions) ? transactions : [];
    const currentSort = sort === 'oldest' ? 'oldest' : 'newest';
    const currentType = ['credit', 'debit'].includes(type) ? type : 'all';

    const formatCurrency = (value) => `₹ ${Number(value || 0).toLocaleString('en-IN', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    })}`;
    const formatDate = (value) => value ? new Date(value).toLocaleDateString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    }) : 'N/A';
%>

    <div class="relative flex min-h-screen w-full flex-col bg-white"
        style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

        <%- include('../partials/user/navbar') %>

        <main class="flex flex-1 gap-0 px-0 py-0 bg-white">
            <%- include('../partials/user/account-sidebar', { activePage: 'wallet' }) %>

            <section class="flex-1 bg-white p-6">
                <nav class="mb-3 flex text-sm text-gray-500" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-2">
                        <li class="inline-flex items-center">
                            <a href="/home" class="inline-flex items-center text-gray-500 hover:text-primary">Home</a>
                        </li>
                        <li aria-current="page">
                            <div class="flex items-center">
                                <span class="mx-2 text-gray-400">/</span>
                                <span class="font-medium text-primary">Wallet</span>
                            </div>
                        </li>
                    </ol>
                </nav>

                <section class="mb-6 rounded-2xl border border-primary-light/40 bg-white px-6 py-6 shadow-sm">
                    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary/70">Account</p>
                    <h1 class="mt-2 text-3xl font-bold text-primary">Wallet</h1>
                    <p class="mt-2 text-sm text-gray-500">View your available balance and every credit or debit in one place.</p>
                </section>

                <section class="mb-6 rounded-xl bg-white p-6 shadow">
                    <h2 class="text-lg font-semibold text-gray-600">Wallet Balance</h2>
                    <p class="mt-2 text-3xl font-bold text-green-600">
                        ₹<%= walletBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    </p>
                </section>

                <section class="mb-6 rounded-2xl border border-primary-light/40 bg-white px-6 py-6 shadow-sm">
                    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-primary">Balance Actions</h2>
                            <p class="mt-1 text-sm text-gray-500">Recharge support is reserved for the Razorpay integration step.</p>
                        </div>
                        <button
                            type="button"
                            id="wallet-recharge-btn"
                            class="inline-flex h-11 items-center justify-center rounded-xl bg-primary px-5 text-sm font-semibold text-white transition hover:opacity-90">
                            Add Money
                        </button>
                    </div>
                </section>

                <section class="mb-6 rounded-2xl border border-primary-light/40 bg-white px-6 py-6 shadow-sm">
                    <form action="/wallet" method="GET" class="flex flex-col gap-4 md:flex-row md:items-end">
                        <div class="flex-1">
                            <label for="wallet-sort" class="mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Sort</label>
                            <select
                                id="wallet-sort"
                                name="sort"
                                class="w-full rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                                <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest first</option>
                                <option value="oldest" <%= currentSort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
                            </select>
                        </div>

                        <div class="flex-1">
                            <label for="wallet-type" class="mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Type</label>
                            <select
                                id="wallet-type"
                                name="type"
                                class="w-full rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                                <option value="all" <%= currentType === 'all' ? 'selected' : '' %>>All</option>
                                <option value="credit" <%= currentType === 'credit' ? 'selected' : '' %>>Credit</option>
                                <option value="debit" <%= currentType === 'debit' ? 'selected' : '' %>>Debit</option>
                            </select>
                        </div>

                        <button
                            type="submit"
                            class="inline-flex h-11 items-center justify-center rounded-xl border border-primary-light/50 bg-white px-5 text-sm font-semibold text-primary transition hover:bg-primary/5">
                            Apply Filters
                        </button>
                    </form>
                </section>

                <section class="rounded-2xl border border-primary-light/40 bg-white p-6 shadow-sm">
                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <h2 class="text-xl font-bold text-primary">Transactions</h2>
                            <p class="mt-1 text-sm text-gray-500">Every wallet movement is listed here using the stored transaction amount.</p>
                        </div>
                        <div class="rounded-xl bg-primary/5 px-4 py-3 text-sm text-primary">
                            <span class="font-semibold"><%= walletTransactions.length %></span> transaction<%= walletTransactions.length === 1 ? '' : 's' %>
                        </div>
                    </div>

                    <% if (walletTransactions.length === 0) { %>
                        <div class="mt-6 rounded-xl border border-dashed border-primary-light/45 px-4 py-10 text-center">
                            <h3 class="text-lg font-bold text-primary">No wallet transactions yet</h3>
                            <p class="mt-2 text-sm text-gray-500">Refunds, recharges, and debits will appear here once they happen.</p>
                        </div>
                    <% } else { %>
                        <div class="mt-6 overflow-x-auto">
                            <table class="min-w-full divide-y divide-primary-light/35">
                                <thead>
                                    <tr class="text-left text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
                                        <th class="px-4 py-3">Date</th>
                                        <th class="px-4 py-3">Type</th>
                                        <th class="px-4 py-3">Amount</th>
                                        <th class="px-4 py-3">Reason</th>
                                        <th class="px-4 py-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-primary-light/25">
                                    <% walletTransactions.forEach((tx) => { %>
                                        <%
                                            let reasonLabel = 'Other';

                                            if (tx.reason === 'refund_cancelled') {
                                                reasonLabel = 'Refund (Cancellation)';
                                            } else if (tx.reason === 'refund_returned') {
                                                reasonLabel = 'Refund (Return)';
                                            } else if (tx.reason === 'purchase') {
                                                reasonLabel = 'Purchase';
                                            } else if (tx.reason === 'recharge') {
                                                reasonLabel = 'Recharge';
                                            }
                                        %>
                                        <tr class="transition hover:bg-background-soft">
                                            <td class="px-4 py-4 text-sm text-gray-600"><%= formatDate(tx.createdAt) %></td>
                                            <td class="px-4 py-4">
                                                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide <%= tx.type === 'credit' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                                                    <%= tx.type || 'N/A' %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-4 text-sm font-bold <%= tx.type === 'credit' ? 'text-green-700' : 'text-red-700' %>">
                                                <%= formatCurrency(tx.amount) %>
                                            </td>
                                            <td class="px-4 py-4 text-sm text-primary"><%= reasonLabel %></td>
                                            <td class="px-4 py-4 text-sm">
                                                <% if (tx.orderId) { %>
                                                    <a href="/orders/<%= tx.orderId %>"
                                                        class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 hover:bg-blue-200 transition">
                                                        View Order
                                                    </a>
                                                <% } else { %>
                                                    <span class="text-gray-400">N/A</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </section>
            </section>
        </main>
    </div>

    <script>
        const rechargeButton = document.getElementById('wallet-recharge-btn');

        if (rechargeButton) {
            rechargeButton.addEventListener('click', async () => {
                try {
                    const response = await fetch('/wallet/recharge', { method: 'POST' });
                    const data = await response.json();
                    window.alert(data.message || 'Razorpay integration pending');
                } catch (error) {
                    window.alert('Unable to reach wallet recharge right now.');
                }
            });
        }
    </script>
</body>

</html>
