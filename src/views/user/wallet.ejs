<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SoundWave | Wallet</title>

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Noto+Sans:wght@400;500;700&display=swap" />

    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
<%- include('../partials/user/currency-helper') %>
<%
    const walletBalance = Number(balance || 0);
    const walletTransactions = Array.isArray(transactions) ? transactions : [];
    const currentSort = sort === 'oldest' ? 'oldest' : 'newest';
    const currentType = ['credit', 'debit'].includes(type) ? type : 'all';
    const currentWalletPage = Math.max(Number(currentPage || 1), 1);
    const walletTotalPages = Math.max(Number(totalPages || 1), 1);

    const formatDate = (value) => value ? new Date(value).toLocaleDateString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    }) : 'N/A';
    const walletQueryParts = [];
    if (currentSort !== 'newest') walletQueryParts.push(`sort=${encodeURIComponent(currentSort)}`);
    if (currentType !== 'all') walletQueryParts.push(`type=${encodeURIComponent(currentType)}`);
    const walletBaseQs = walletQueryParts.length > 0 ? `&${walletQueryParts.join('&')}` : '';
%>

    <div class="relative flex min-h-screen w-full flex-col bg-white"
        style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

        <%- include('../partials/user/navbar') %>

        <main class="flex flex-1 gap-0 px-0 py-0 bg-white">
            <%- include('../partials/user/account-sidebar', { activePage: 'wallet' }) %>

            <section class="flex-1 bg-white p-6">
                <nav class="mb-3 flex text-sm text-gray-500" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-2">
                        <li class="inline-flex items-center">
                            <a href="/home" class="inline-flex items-center text-gray-500 hover:text-primary">Home</a>
                        </li>
                        <li aria-current="page">
                            <div class="flex items-center">
                                <span class="mx-2 text-gray-400">/</span>
                                <span class="font-medium text-primary">Wallet</span>
                            </div>
                        </li>
                    </ol>
                </nav>

                <section class="mb-6 rounded-2xl border border-primary-light/40 bg-white px-6 py-6 shadow-sm">
                    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-primary/70">Account</p>
                    <h1 class="mt-2 text-3xl font-bold text-primary">Wallet</h1>
                    <p class="mt-2 text-sm text-gray-500">View your available balance and every credit or debit in one place.</p>
                </section>

                <section class="mb-6 rounded-xl bg-white p-6 shadow">
                    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                        <div>
                            <h2 class="text-lg font-semibold text-gray-600">Wallet Balance</h2>
                            <p class="mt-2 text-3xl font-bold text-green-600">
                                <%= formatCurrency(walletBalance) %>
                            </p>
                        </div>
                        <button
                            type="button"
                            id="rechargeWalletBtn"
                            class="inline-flex items-center justify-center rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-green-700 disabled:cursor-not-allowed disabled:opacity-70">
                            Recharge Wallet
                        </button>
                    </div>
                </section>

                <section class="mb-6 rounded-2xl border border-primary-light/40 bg-white px-6 py-6 shadow-sm">
                    <form action="/wallet" method="GET" class="flex flex-col gap-4 md:flex-row md:items-end">
                        <div class="flex-1">
                            <label for="wallet-sort" class="mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Sort</label>
                            <select
                                id="wallet-sort"
                                name="sort"
                                class="w-full rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                                <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest first</option>
                                <option value="oldest" <%= currentSort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
                            </select>
                        </div>

                        <div class="flex-1">
                            <label for="wallet-type" class="mb-2 block text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Type</label>
                            <select
                                id="wallet-type"
                                name="type"
                                class="w-full rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                                <option value="all" <%= currentType === 'all' ? 'selected' : '' %>>All</option>
                                <option value="credit" <%= currentType === 'credit' ? 'selected' : '' %>>Credit</option>
                                <option value="debit" <%= currentType === 'debit' ? 'selected' : '' %>>Debit</option>
                            </select>
                        </div>

                        <button
                            type="submit"
                            class="inline-flex h-11 items-center justify-center rounded-xl border border-primary-light/50 bg-white px-5 text-sm font-semibold text-primary transition hover:bg-primary/5">
                            Apply Filters
                        </button>
                    </form>
                </section>

                <section class="rounded-2xl border border-primary-light/40 bg-white p-6 shadow-sm">
                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <h2 class="text-xl font-bold text-primary">Transactions</h2>
                            <p class="mt-1 text-sm text-gray-500">Every wallet movement is listed here using the stored transaction amount.</p>
                        </div>
                        <div class="rounded-xl bg-primary/5 px-4 py-3 text-sm text-primary">
                            <span class="font-semibold"><%= walletTransactions.length %></span> transaction<%= walletTransactions.length === 1 ? '' : 's' %>
                        </div>
                    </div>

                    <% if (walletTransactions.length === 0) { %>
                        <div class="mt-6 rounded-xl border border-dashed border-primary-light/45 px-4 py-10 text-center">
                            <h3 class="text-lg font-bold text-primary">No wallet transactions yet</h3>
                            <p class="mt-2 text-sm text-gray-500">Refunds, recharges, and debits will appear here once they happen.</p>
                        </div>
	                    <% } else { %>
	                        <div class="mt-6 overflow-x-auto">
                            <table class="min-w-full divide-y divide-primary-light/35">
                                <thead>
                                    <tr class="text-left text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
                                        <th class="px-4 py-3">Date</th>
                                        <th class="px-4 py-3">Type</th>
                                        <th class="px-4 py-3">Amount</th>
                                        <th class="px-4 py-3">Reason</th>
                                        <th class="px-4 py-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-primary-light/25">
                                    <% walletTransactions.forEach((tx) => { %>
                                        <%
                                            let reasonLabel = 'Other';

                                            if (tx.reason === 'refund_cancelled') {
                                                reasonLabel = 'Refund (Cancellation)';
                                            } else if (tx.reason === 'refund_returned') {
                                                reasonLabel = 'Refund (Return)';
                                            } else if (tx.reason === 'purchase') {
                                                reasonLabel = 'Purchase';
                                            } else if (tx.reason === 'recharge') {
                                                reasonLabel = 'Recharge';
                                            } else if (tx.reason === 'online recharge') {
                                                reasonLabel = 'Online Recharge';
                                            }
                                        %>
                                        <tr class="transition hover:bg-background-soft">
                                            <td class="px-4 py-4 text-sm text-gray-600"><%= formatDate(tx.createdAt) %></td>
                                            <td class="px-4 py-4">
                                                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide <%= tx.type === 'credit' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                                                    <%= tx.type || 'N/A' %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-4 text-sm font-bold <%= tx.type === 'credit' ? 'text-green-700' : 'text-red-700' %>">
                                                <%= formatCurrency(tx.amount) %>
                                            </td>
                                            <td class="px-4 py-4 text-sm text-primary"><%= reasonLabel %></td>
                                            <td class="px-4 py-4 text-sm">
                                                <% if (tx.orderId) { %>
                                                    <a href="/orders/<%= tx.orderId %>"
                                                        class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 hover:bg-blue-200 transition">
                                                        View Order
                                                    </a>
                                                <% } else { %>
                                                    <span class="text-gray-400">N/A</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
	                            </table>
	                        </div>
                            <% if (walletTotalPages > 0) { %>
                                <div class="mt-6 flex items-center justify-center gap-2">
                                    <% if (currentWalletPage > 1) { %>
                                        <a href="/wallet?page=<%= currentWalletPage - 1 %><%= walletBaseQs %>"
                                            class="flex h-10 items-center justify-center rounded-lg bg-[#FFFFFF] px-4 text-sm font-medium text-[#1F1F1F] transition-colors hover:bg-[#D3CEEA]">
                                            &laquo; Previous
                                        </a>
                                    <% } else { %>
                                        <span class="flex h-10 items-center justify-center rounded-lg bg-gray-100 px-4 text-sm font-medium text-gray-400 cursor-not-allowed">
                                            &laquo; Previous
                                        </span>
                                    <% } %>

                                    <div class="flex gap-1">
                                        <% for (let i = 1; i <= walletTotalPages; i++) { %>
                                            <% if (i === currentWalletPage) { %>
                                                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#685BCB] text-sm font-bold text-white">
                                                    <%= i %>
                                                </span>
                                            <% } else { %>
                                                <a href="/wallet?page=<%= i %><%= walletBaseQs %>"
                                                    class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#FFFFFF] text-sm font-medium text-[#1F1F1F] transition-colors hover:bg-[#D3CEEA]">
                                                    <%= i %>
                                                </a>
                                            <% } %>
                                        <% } %>
                                    </div>

                                    <% if (currentWalletPage < walletTotalPages) { %>
                                        <a href="/wallet?page=<%= currentWalletPage + 1 %><%= walletBaseQs %>"
                                            class="flex h-10 items-center justify-center rounded-lg bg-[#FFFFFF] px-4 text-sm font-medium text-[#1F1F1F] transition-colors hover:bg-[#D3CEEA]">
                                            Next &raquo;
                                        </a>
                                    <% } else { %>
                                        <span class="flex h-10 items-center justify-center rounded-lg bg-gray-100 px-4 text-sm font-medium text-gray-400 cursor-not-allowed">
                                            Next &raquo;
                                        </span>
                                    <% } %>
                                </div>
                                <p class="mt-2 text-center text-sm text-[#685BCB]">
                                    Showing page <%= currentWalletPage %> of <%= walletTotalPages %>
                                </p>
                            <% } %>
	                    <% } %>
	                </section>
            </section>
        </main>
    </div>

    <div id="walletToast" class="pointer-events-none fixed right-4 top-4 z-50 hidden max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-lg"></div>

    <div id="rechargeWalletModal" class="fixed inset-0 z-40 hidden items-center justify-center bg-black/40 px-4">
        <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold text-primary">Recharge Wallet</h2>
                    <p class="mt-1 text-sm text-gray-500">Enter an amount between ₹10 and ₹50,000.</p>
                </div>
                <button
                    type="button"
                    id="closeRechargeModalBtn"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full text-xl leading-none text-gray-400 transition hover:bg-gray-100 hover:text-gray-600"
                    aria-label="Close recharge modal">
                    &times;
                </button>
            </div>

            <div class="mt-5">
                <label for="rechargeAmountInput" class="mb-2 block text-sm font-semibold text-gray-700">Amount</label>
                <input
                    id="rechargeAmountInput"
                    type="number"
                    min="10"
                    max="50000"
                    step="1"
                    placeholder="Enter recharge amount"
                    class="w-full rounded-xl border border-primary-light/50 bg-white px-4 py-3 text-sm text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
                <p id="rechargeAmountError" class="mt-2 hidden text-sm font-medium text-red-600"></p>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <button
                    type="button"
                    id="cancelRechargeBtn"
                    class="inline-flex items-center justify-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
                    Cancel
                </button>
                <button
                    type="button"
                    id="confirmRechargeBtn"
                    class="inline-flex items-center justify-center rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-green-700 disabled:cursor-not-allowed disabled:opacity-70">
                    Proceed to Pay
                </button>
            </div>
        </div>
    </div>

    <script>
        const rechargeButton = document.getElementById('rechargeWalletBtn');
        const rechargeModal = document.getElementById('rechargeWalletModal');
        const closeRechargeModalBtn = document.getElementById('closeRechargeModalBtn');
        const cancelRechargeBtn = document.getElementById('cancelRechargeBtn');
        const confirmRechargeBtn = document.getElementById('confirmRechargeBtn');
        const rechargeAmountInput = document.getElementById('rechargeAmountInput');
        const rechargeAmountError = document.getElementById('rechargeAmountError');
        const walletToast = document.getElementById('walletToast');
        const razorpayKeyId = "<%= RAZORPAY_KEY_ID %>";
        let toastTimeoutId = null;

        function showToast(message, type = 'success') {
            if (!walletToast) {
                return;
            }

            walletToast.textContent = message;
            walletToast.className = `pointer-events-none fixed right-4 top-4 z-50 max-w-sm rounded-xl px-4 py-3 text-sm font-medium text-white shadow-lg ${type === 'success' ? 'bg-green-600' : 'bg-red-600'}`;
            walletToast.classList.remove('hidden');

            if (toastTimeoutId) {
                window.clearTimeout(toastTimeoutId);
            }

            toastTimeoutId = window.setTimeout(() => {
                walletToast.classList.add('hidden');
            }, 3200);
        }

        function resetRechargeModal() {
            rechargeAmountInput.value = '';
            rechargeAmountError.textContent = '';
            rechargeAmountError.classList.add('hidden');
        }

        function openRechargeModal() {
            resetRechargeModal();
            rechargeModal.classList.remove('hidden');
            rechargeModal.classList.add('flex');
            window.setTimeout(() => rechargeAmountInput.focus(), 0);
        }

        function closeRechargeModal() {
            rechargeModal.classList.add('hidden');
            rechargeModal.classList.remove('flex');
            resetRechargeModal();
        }

        function getRechargeAmount() {
            const amount = Number(rechargeAmountInput.value);

            if (!amount || amount < 10 || amount > 50000) {
                rechargeAmountError.textContent = 'Enter a valid amount between ₹10 and ₹50,000';
                rechargeAmountError.classList.remove('hidden');
                return null;
            }

            rechargeAmountError.textContent = '';
            rechargeAmountError.classList.add('hidden');
            return amount;
        }

        if (rechargeButton) {
            rechargeButton.addEventListener('click', () => {
                openRechargeModal();
            });
        }

        if (closeRechargeModalBtn) {
            closeRechargeModalBtn.addEventListener('click', closeRechargeModal);
        }

        if (cancelRechargeBtn) {
            cancelRechargeBtn.addEventListener('click', closeRechargeModal);
        }

        if (rechargeModal) {
            rechargeModal.addEventListener('click', (event) => {
                if (event.target === rechargeModal) {
                    closeRechargeModal();
                }
            });
        }

        if (rechargeAmountInput) {
            rechargeAmountInput.addEventListener('input', () => {
                if (!rechargeAmountError.classList.contains('hidden')) {
                    getRechargeAmount();
                }
            });

            rechargeAmountInput.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    confirmRechargeBtn?.click();
                }
            });
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && rechargeModal && !rechargeModal.classList.contains('hidden')) {
                closeRechargeModal();
            }
        });

        if (confirmRechargeBtn) {
            confirmRechargeBtn.addEventListener('click', async () => {
                const amount = getRechargeAmount();

                if (!amount) {
                    return;
                }

                if (!window.Razorpay || !razorpayKeyId) {
                    showToast('Online recharge is not available right now.', 'error');
                    return;
                }

                try {
                    rechargeButton.disabled = true;
                    confirmRechargeBtn.disabled = true;
                    closeRechargeModal();

                    const res = await fetch('/wallet/create-recharge-order', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ amount })
                    });
                    const data = await res.json();

                    if (!data.success) {
                        showToast('Failed to initiate recharge', 'error');
                        return;
                    }

                    const options = {
                        key: razorpayKeyId,
                        amount: data.data.amount,
                        currency: data.data.currency,
                        order_id: data.data.razorpayOrderId,
                        name: 'Wallet Recharge',
                        description: 'Add money to wallet',
                        method: {
                            upi: true,
                            card: true,
                            netbanking: true,
                            wallet: true
                        },
                        handler: async function (response) {
                            const verifyRes = await fetch('/wallet/verify-recharge', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_signature: response.razorpay_signature
                                })
                            });

                            const verifyData = await verifyRes.json();

                            if (verifyData.success) {
                                showToast('Wallet recharged successfully', 'success');
                                window.location.reload();
                            } else {
                                showToast('Recharge verification failed', 'error');
                            }
                        },
                        theme: {
                            color: '#000000'
                        }
                    };

                    const rzp = new Razorpay(options);
                    rzp.on('payment.failed', function (failureResponse) {
                        console.error('Wallet recharge payment failed:', failureResponse.error);
                        showToast('Payment failed. Wallet not credited.', 'error');
                    });
                    rzp.open();
                } catch (err) {
                    console.error(err);
                    showToast('Something went wrong', 'error');
                } finally {
                    rechargeButton.disabled = false;
                    confirmRechargeBtn.disabled = false;
                }
            });
        }
    </script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</body>

</html>
