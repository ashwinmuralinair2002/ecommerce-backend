<!-- View for adding a new user address -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />

    <title>SoundWave | Add Address</title>

    <%- include('./partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-white"
        style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

        <!-- ================= NAVBAR ================= -->
        <!-- Navbar -->
        <%- include('partials/user/navbar') %>

            <!-- ================= CONTENT ================= -->
            <main class="flex flex-1 gap-0 px-0 py-0 bg-white">

                <!-- SIDEBAR -->
                <aside class="w-64 theme-filter-sidebar p-3 text-primary">
                    <div class="space-y-2">
                        <a href="/account"
                            class="block px-3 py-2 hover:bg-primary-light/35 rounded-lg transition-colors">Account
                            Details</a>
                        <div class="bg-primary-light/35 px-3 py-2 rounded-lg font-medium">Address</div>
                        <div class="px-3 py-2">Payment Details</div>
                        <div class="px-3 py-2">Wallet</div>
                        <div class="px-3 py-2">Your Orders</div>
                        <a href="/api/auth/logout"
                            class="block px-3 py-2 text-red-600 hover:bg-primary-light/35 rounded-lg transition-colors">Logout</a>
                    </div>
                </aside>

                <!-- MAIN PANEL -->
                <section class="flex-1 bg-white p-6">
                    <!-- Breadcrumb -->
                    <div class="flex items-center gap-2 text-sm mb-4">
                        <a href="/account/addresses" class="text-primary hover:underline">My Addresses</a>
                        <span class="text-gray-400">/</span>
                        <span class="text-gray-900">Add New</span>
                    </div>

                    <h1 class="text-2xl font-bold text-primary mb-6">Add New Address</h1>

                    <form action="/account/addresses/new" method="POST" class="max-w-2xl">
                        <!-- Two Column Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <!-- Full Name -->
                            <div class="relative">
                                <input name="name" id="name" placeholder="Full Name"
                                    class="peer form-input w-full rounded-lg text-gray-900 focus:outline-0 focus:ring-0 border <%= (locals.errors && errors.name) ? 'border-red-500' : 'border-primary-light/50' %> bg-white focus:border-primary h-14 pt-4 placeholder-transparent text-base"
                                    value="<%= (locals.formData && formData.name) || '' %>" required />
                                <label for="name"
                                    class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-[18px] peer-placeholder-shown:text-base peer-placeholder-shown:text-primary peer-focus:top-1 peer-focus:text-xs peer-focus:text-primary pointer-events-none">Full
                                    Name</label>
                                <p class="text-red-500 text-xs mt-1 empty:hidden error-msg">
                                    <%= (locals.errors && errors.name) || '' %>
                                </p>
                            </div>

                            <!-- Phone Number -->
                            <div class="relative">
                                <input name="phone" id="phone" placeholder="Phone Number"
                                    class="peer form-input w-full rounded-lg text-gray-900 focus:outline-0 focus:ring-0 border <%= (locals.errors && errors.phone) ? 'border-red-500' : 'border-primary-light/50' %> bg-white focus:border-primary h-14 pt-4 placeholder-transparent text-base"
                                    value="<%= (locals.formData && formData.phone) || '' %>" required />
                                <label for="phone"
                                    class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-[18px] peer-placeholder-shown:text-base peer-placeholder-shown:text-primary peer-focus:top-1 peer-focus:text-xs peer-focus:text-primary pointer-events-none">Phone
                                    Number</label>
                                <p class="text-red-500 text-xs mt-1 empty:hidden error-msg">
                                    <%= (locals.errors && errors.phone) || '' %>
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <!-- House No -->
                            <div class="relative">
                                <input name="houseNo" id="houseNo" placeholder="House No"
                                    class="peer form-input w-full rounded-lg text-gray-900 focus:outline-0 focus:ring-0 border <%= (locals.errors && errors.houseNo) ? 'border-red-500' : 'border-primary-light/50' %> bg-white focus:border-primary h-14 pt-4 placeholder-transparent text-base"
                                    value="<%= (locals.formData && formData.houseNo) || '' %>" required />
                                <label for="houseNo"
                                    class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-[18px] peer-placeholder-shown:text-base peer-placeholder-shown:text-primary peer-focus:top-1 peer-focus:text-xs peer-focus:text-primary pointer-events-none">House
                                    No</label>
                                <p class="text-red-500 text-xs mt-1 empty:hidden error-msg">
                                    <%= (locals.errors && errors.houseNo) || '' %>
                                </p>
                            </div>

                            <!-- Street -->
                            <div class="relative">
                                <input name="street" id="street" placeholder="Street"
                                    class="peer form-input w-full rounded-lg text-gray-900 focus:outline-0 focus:ring-0 border <%= (locals.errors && errors.street) ? 'border-red-500' : 'border-primary-light/50' %> bg-white focus:border-primary h-14 pt-4 placeholder-transparent text-base"
                                    value="<%= (locals.formData && formData.street) || '' %>" required />
                                <label for="street"
                                    class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-[18px] peer-placeholder-shown:text-base peer-placeholder-shown:text-primary peer-focus:top-1 peer-focus:text-xs peer-focus:text-primary pointer-events-none">Street</label>
                                <p class="text-red-500 text-xs mt-1 empty:hidden error-msg">
                                    <%= (locals.errors && errors.street) || '' %>
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <!-- City -->
                            <div class="relative">
                                <input name="city" id="city" placeholder="City"
                                    class="peer form-input w-full rounded-lg text-gray-900 focus:outline-0 focus:ring-0 border <%= (locals.errors && errors.city) ? 'border-red-500' : 'border-primary-light/50' %> bg-white focus:border-primary h-14 pt-4 placeholder-transparent text-base"
                                    value="<%= (locals.formData && formData.city) || '' %>" required />
                                <label for="city"
                                    class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-[18px] peer-placeholder-shown:text-base peer-placeholder-shown:text-primary peer-focus:top-1 peer-focus:text-xs peer-focus:text-primary pointer-events-none">City</label>
                                <p class="text-red-500 text-xs mt-1 empty:hidden error-msg">
                                    <%= (locals.errors && errors.city) || '' %>
                                </p>
                            </div>

                            <!-- State -->
                            <div class="relative">
                                <input name="state" id="state" placeholder="State"
                                    class="peer form-input w-full rounded-lg text-gray-900 focus:outline-0 focus:ring-0 border <%= (locals.errors && errors.state) ? 'border-red-500' : 'border-primary-light/50' %> bg-white focus:border-primary h-14 pt-4 placeholder-transparent text-base"
                                    value="<%= (locals.formData && formData.state) || '' %>" required />
                                <label for="state"
                                    class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-[18px] peer-placeholder-shown:text-base peer-placeholder-shown:text-primary peer-focus:top-1 peer-focus:text-xs peer-focus:text-primary pointer-events-none">State</label>
                                <p class="text-red-500 text-xs mt-1 empty:hidden error-msg">
                                    <%= (locals.errors && errors.state) || '' %>
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <!-- Postal Code -->
                            <div class="relative">
                                <input name="postalCode" id="postalCode" placeholder="Postal Code"
                                    class="peer form-input w-full rounded-lg text-gray-900 focus:outline-0 focus:ring-0 border <%= (locals.errors && errors.postalCode) ? 'border-red-500' : 'border-primary-light/50' %> bg-white focus:border-primary h-14 pt-4 placeholder-transparent text-base"
                                    value="<%= (locals.formData && formData.postalCode) || '' %>" required />
                                <label for="postalCode"
                                    class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-[18px] peer-placeholder-shown:text-base peer-placeholder-shown:text-primary peer-focus:top-1 peer-focus:text-xs peer-focus:text-primary pointer-events-none">Postal
                                    Code</label>
                                <p class="text-red-500 text-xs mt-1 empty:hidden error-msg">
                                    <%= (locals.errors && errors.postalCode) || '' %>
                                </p>
                            </div>

                            <!-- Address Label -->
                            <div>
                                <select name="label" id="label"
                                    class="form-select w-full h-14 rounded-lg border <%= (locals.errors && errors.label) ? 'border-red-500' : 'border-primary-light/50' %> bg-white text-base focus:border-primary focus:ring-0"
                                    required>
                                    <% const currentLabel=(locals.formData && formData.label) || '' ; %>
                                        <option value="" <%=currentLabel==='' ? 'selected' : '' %>>Select Label</option>
                                        <option value="Home" <%=currentLabel==='Home' ? 'selected' : '' %>>Home</option>
                                        <option value="Work" <%=currentLabel==='Work' ? 'selected' : '' %>>Work</option>
                                        <option value="Other" <%=currentLabel==='Other' ? 'selected' : '' %>>Other
                                        </option>
                                </select>
                                <p class="text-red-500 text-xs mt-1 empty:hidden error-msg">
                                    <%= (locals.errors && errors.label) || '' %>
                                </p>
                            </div>
                        </div>

                        <div class="mb-6 max-w-[50%]">
                            <% const currentIsDefault=(locals.formData && formData.isDefault) || 'No' ; %>
                                <label for="isDefault" class="block text-sm text-primary mb-2">Default</label>
                                <select name="isDefault" id="isDefault"
                                    class="form-select w-full h-14 rounded-lg border border-primary-light/50 bg-white text-base focus:border-primary focus:ring-0">
                                    <option value="Yes" <%=currentIsDefault==='Yes' ? 'selected' : '' %>>Yes</option>
                                    <option value="No" <%=currentIsDefault==='No' ? 'selected' : '' %>>No</option>
                                </select>
                        </div>

                        <!-- Buttons -->
                        <div class="flex gap-3 justify-end">
                            <a href="/account/addresses"
                                class="px-6 py-3 bg-gray-100 text-gray-900 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">
                                Cancel
                            </a>
                            <button type="submit"
                                class="theme-primary-btn rounded-lg px-6 py-3 text-sm">
                                Save Address
                            </button>
                        </div>
                    </form>

                    <script>
                        const form = document.querySelector('form');
                        const inputs = form.querySelectorAll('input, select');

                        const validateField = (input) => {
                            const name = input.name;
                            const value = input.value.trim();
                            let error = '';

                            if (name === 'name') {
                                if (!value) error = 'Full Name is required';
                                else if (!/^[A-Za-z ]{3,}$/.test(value)) error = 'Name must be at least 3 chars (letters only)';
                            } else if (name === 'phone') {
                                if (!value) error = 'Phone Number is required';
                                else if (!/^[0-9]{10}$/.test(value)) error = 'Phone must be exactly 10 digits';
                            } else if (name === 'postalCode') {
                                if (!value) error = 'Postal Code is required';
                                else if (!/^[0-9]{6}$/.test(value)) error = 'Postal Code must be exactly 6 digits';
                            } else if (['houseNo', 'street'].includes(name)) {
                                if (!value) error = `${input.placeholder} is required`;
                                else if (value.length < 2) error = 'Must be at least 2 characters';
                            } else if (name === 'city') {
                                if (!value) error = 'City is required';
                                else if (!/^[A-Za-z]+(?:\s[A-Za-z]+)*$/.test(value)) error = 'City must contain only letters and spaces.';
                            } else if (name === 'state') {
                                if (!value) error = 'State is required';
                                else if (!/^[A-Za-z]+(?:\s[A-Za-z]+)*$/.test(value)) error = 'State must contain only letters and spaces.';
                            } else if (name === 'label') {
                                if (!value) error = 'Address Label is required';
                            }

                            // Display Error
                            const container = input.closest('div');
                            const errorMsg = container.querySelector('.error-msg') || container.parentElement.querySelector('.error-msg');

                            // Handle select specifically if needed, but structure assumes generic next sibling or standard placement
                            // Refined selector for select inside div structure
                            let errorEl = input.parentElement.querySelector('.error-msg');
                            if (!errorEl) errorEl = input.nextElementSibling?.classList?.contains('error-msg') ? input.nextElementSibling : null;


                            if (error) {
                                input.classList.add('border-red-500');
                                input.classList.remove('border-primary-light/50');
                                if (errorEl) errorEl.textContent = error;
                            } else {
                                input.classList.remove('border-red-500');
                                input.classList.add('border-primary-light/50');
                                if (errorEl) errorEl.textContent = '';
                            }

                            return !error;
                        };

                        inputs.forEach(input => {
                            input.addEventListener('input', () => validateField(input));
                            input.addEventListener('blur', () => validateField(input));
                        });

                        form.addEventListener('submit', (e) => {
                            let isValid = true;
                            let firstError = null;

                            inputs.forEach(input => {
                                if (!validateField(input)) {
                                    isValid = false;
                                    if (!firstError) firstError = input;
                                }
                            });

                            if (!isValid) {
                                e.preventDefault();
                                firstError.focus();
                                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                        });
                    </script>

                </section>
            </main>
    </div>
</body>

</html>
