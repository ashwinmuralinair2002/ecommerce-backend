<!-- User saved addresses list template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />

    <title>SoundWave | My Addresses</title>

    <%- include('./partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <script>
        function confirmDeleteAddress(addressId) {
            confirmAction({
                title: 'Delete Address?',
                text: 'Are you sure you want to remove this address?',
                confirmButtonText: 'Yes, delete it',
                confirmButtonColor: '#d33'
            }, () => {
                const form = document.getElementById('delete-form-' + addressId);
                if (form) form.submit();
            });
        }
    </script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-white"
        style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

        <!-- ================= NAVBAR ================= -->
        <!-- Navbar -->
        <%- include('partials/user/navbar') %>

            <!-- ================= CONTENT ================= -->
            <main class="flex flex-1 gap-0 px-0 py-0 bg-white">

                <!-- SIDEBAR -->
                <aside class="w-64 theme-filter-sidebar p-3 text-primary">
                    <div class="space-y-2">
                        <a href="/account"
                            class="block px-3 py-2 hover:bg-primary-light/35 rounded-lg transition-colors">Account
                            Details</a>
                        <div class="bg-primary-light/35 px-3 py-2 rounded-lg font-medium">Address</div>
                        <div class="px-3 py-2">Payment Details</div>
                        <div class="px-3 py-2">Wallet</div>
                        <div class="px-3 py-2">Your Orders</div>
                        <form action="/api/auth/logout" method="POST">
                            <button type="submit"
                                class="block w-full text-left px-3 py-2 text-red-600 hover:bg-primary-light/35 rounded-lg transition-colors">Logout</button>
                        </form>
                    </div>
                </aside>

                <!-- MAIN PANEL -->
                <section class="flex-1 bg-white p-6">
                    <div class="flex justify-between items-center mb-6">
                        <h1 class="text-2xl font-bold text-primary">My Addresses</h1>
                        <a href="/account/addresses/new"
                            class="theme-primary-btn rounded-lg px-4 py-2 text-sm">
                            Add New Address
                        </a>
                    </div>

                    <% if (user.addresses && user.addresses.length> 0) { %>
                        <div class="space-y-4">
                            <% user.addresses.forEach(function(address) { %>
                                <div class="border border-primary-light/45 rounded-lg shadow-sm p-4">
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <span
                                                class="inline-block bg-primary-light/35 text-primary text-xs font-medium px-2 py-1 rounded mb-2">
                                                <%= address.label || 'Home' %>
                                            </span>
                                            <% if (address.isDefault) { %>
                                                <span
                                                    class="inline-block bg-green-100 text-green-700 text-xs font-medium px-2 py-1 rounded mb-2 ml-2">
                                                    Default
                                                </span>
                                                <% } %>
                                            <p class="font-bold text-lg">
                                                <%= address.name || user.name || 'Name not set' %>
                                            </p>
                                            <p class="text-gray-600 text-sm mt-1">
                                                <%= address.phone ? address.phone : '' %>
                                            </p>
                                            <p class="text-gray-600 text-sm">
                                                <%= address.houseNo ? address.houseNo + ', ' : '' %>
                                                    <%= address.street %>,
                                                        <%= address.city %>, <%= address.state %>
                                                                <%= address.zip %>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex gap-3 mt-4 pt-4 border-t border-gray-100">
                                        <a href="/account/addresses/<%= address._id %>/edit"
                                            class="theme-primary-btn rounded-lg px-4 py-2 text-sm">
                                            Edit
                                        </a>
                                        <form id="delete-form-<%= address._id %>"
                                            action="/account/addresses/<%= address._id %>/delete" method="POST"
                                            class="hidden">
                                        </form>
                                        <button onclick="confirmDeleteAddress('<%= address._id %>')"
                                            class="px-4 py-2 bg-gray-100 text-[#111811] text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors border border-gray-200">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <div class="text-center py-12 text-gray-500">
                                <p class="mb-4">No address found.</p>
                                <a href="/account/addresses/new" class="text-primary hover:underline">Add your first
                                    address</a>
                            </div>
                            <% } %>

                </section>
            </main>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');

            if (success === 'address_saved') {
                showToast('Address saved successfully!', 'success');
                // Clean URL
                const newUrl = window.location.pathname;
                window.history.replaceState({}, document.title, newUrl);
            } else if (success === 'address_updated') {
                showToast('Address updated successfully!', 'success');
                const newUrl = window.location.pathname;
                window.history.replaceState({}, document.title, newUrl);
            }
        });
    </script>
</body>

</html>
