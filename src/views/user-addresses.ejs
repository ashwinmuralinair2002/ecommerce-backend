<!-- User saved addresses list template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />

    <title>SoundWave | My Addresses</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <script>
        function confirmDeleteAddress(addressId) {
            confirmAction({
                title: 'Delete Address?',
                text: 'Are you sure you want to remove this address?',
                confirmButtonText: 'Yes, delete it',
                confirmButtonColor: '#d33'
            }, () => {
                const form = document.getElementById('delete-form-' + addressId);
                if (form) form.submit();
            });
        }
    </script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-[#f8fcf8]"
        style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

        <!-- ================= NAVBAR ================= -->
        <header class="flex items-center justify-between border-b border-[#e7f4e7] px-10 py-3 bg-white">
            <div class="flex items-center gap-10">
                <!-- Logo -->
                <a href="/home" class="flex items-center gap-3 text-[#0d1c0d] hover:opacity-80 transition-opacity">
                    <div class="size-4">
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134
              C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462
              C2.19985 28.361 1.76794 23.9758 2.60947 19.7452
              C3.451 15.5145 5.52816 11.6284 8.57829 8.5783
              C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948
              C23.9758 1.76795 28.361 2.19986 32.3462 3.85057
              C36.3314 5.50129 39.7376 8.29668 42.134 11.8833
              C44.5305 15.4698 45.8096 19.6865 45.8096 24
              L24 24 L24 45.8096Z" fill="currentColor" />
                        </svg>
                    </div>
                    <span class="font-bold text-lg">SoundWave</span>
                </a>

                <!-- Menu -->
                <nav class="flex gap-8 text-sm font-medium text-[#0d1c0d]">
                    <a href="/deals">Today's Deals</a>
                    <a href="/best-sellers">Best Sellers</a>
                    <a href="/new-arrivals">New Arrivals</a>
                    <a href="/brands">Brands</a>
                </nav>
            </div>

            <!-- Right -->
            <div class="flex items-center gap-4">
                <div class="relative">
                    <input type="text" placeholder="Search"
                        class="h-10 w-56 rounded-lg bg-[#e7f4e7] pl-10 pr-4 text-sm placeholder:text-[#499c49] focus:outline-none" />
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-[#499c49]"
                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                        viewBox="0 0 256 256">
                        <path
                            d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32Z" />
                    </svg>
                </div>

                <button class="h-10 w-10 rounded-lg bg-[#e7f4e7]">❤️</button>
                <button class="h-10 w-10 rounded-lg bg-[#e7f4e7]">🛒</button>
                <a href="/account"
                    class="h-10 w-10 rounded-full bg-[#e7f4e7] flex items-center justify-center ring-2 ring-green-500 overflow-hidden">
                    <% if (user && user.profileImage) { %>
                        <img src="<%= user.profileImage %>" alt="Profile" class="h-full w-full object-cover" />
                        <% } else { %>
                            <% const _np=(user && user.name) ? user.name.trim().split(/\s+/) : []; const
                                _ini=_np.length> 1 ? (_np[0][0] + _np[_np.length-1][0]).toUpperCase() : (user &&
                                user.name ? user.name.substring(0,2).toUpperCase() : 'U'); %>
                                <span class="text-xs font-bold text-[#2d6a2d]">
                                    <%= _ini %>
                                </span>
                                <% } %>
                </a>
            </div>
        </header>

        <!-- ================= CONTENT ================= -->
        <main class="flex flex-1 gap-6 px-6 py-5">

            <!-- SIDEBAR -->
            <aside class="w-80 bg-[#f8fcf8] p-4">
                <div class="space-y-2">
                    <a href="/account" class="block px-3 py-2 hover:bg-[#e6f4e6] rounded-lg transition-colors">Account
                        Details</a>
                    <div class="bg-[#e6f4e6] px-3 py-2 rounded-lg font-medium">Address</div>
                    <div class="px-3 py-2">Payment Details</div>
                    <div class="px-3 py-2">Wallet</div>
                    <div class="px-3 py-2">Your Orders</div>
                    <a href="/api/auth/logout"
                        class="block px-3 py-2 text-red-600 hover:bg-[#e6f4e6] rounded-lg transition-colors">Logout</a>
                </div>
            </aside>

            <!-- MAIN PANEL -->
            <section class="flex-1 bg-white rounded-lg p-6">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-2xl font-bold">My Addresses</h1>
                    <a href="/account/addresses/new"
                        class="px-4 py-2 bg-[#1ff91f] text-[#111811] text-sm font-bold rounded-lg hover:bg-green-400 transition-colors">
                        Add New Address
                    </a>
                </div>

                <% if (user.addresses && user.addresses.length> 0) { %>
                    <div class="space-y-4">
                        <% user.addresses.forEach(function(address) { %>
                            <div class="border border-gray-200 rounded-lg p-4">
                                <div class="flex justify-between items-start">
                                    <div class="flex-1">
                                        <span
                                            class="inline-block bg-[#e6f4e6] text-[#5f8c5f] text-xs font-medium px-2 py-1 rounded mb-2">
                                            <%= address.label || 'Home' %>
                                        </span>
                                        <p class="font-bold text-lg">
                                            <%= address.name || user.name || 'Name not set' %>
                                        </p>
                                        <p class="text-gray-600 text-sm mt-1">
                                            <%= address.phone ? address.phone : '' %>
                                        </p>
                                        <p class="text-gray-600 text-sm">
                                            <%= address.houseNo ? address.houseNo + ', ' : '' %>
                                                <%= address.street %>,
                                                    <%= address.city %>, <%= address.state %>
                                                            <%= address.zip %>
                                        </p>
                                    </div>
                                </div>
                                <div class="flex gap-3 mt-4 pt-4 border-t border-gray-100">
                                    <a href="/account/addresses/<%= address._id %>/edit"
                                        class="px-4 py-2 bg-[#1ff91f] text-[#111811] text-sm font-bold rounded-lg hover:bg-green-400 transition-colors">
                                        Edit
                                    </a>
                                    <form id="delete-form-<%= address._id %>"
                                        action="/account/addresses/<%= address._id %>/delete" method="POST"
                                        class="hidden">
                                    </form>
                                    <button onclick="confirmDeleteAddress('<%= address._id %>')"
                                        class="px-4 py-2 bg-gray-100 text-[#111811] text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors border border-gray-200">
                                        Delete
                                    </button>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="text-center py-12 text-gray-500">
                            <p class="mb-4">No addresses found.</p>
                            <a href="/account/addresses/new" class="text-green-600 hover:underline">Add your first
                                address</a>
                        </div>
                        <% } %>

            </section>
        </main>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');

            if (success === 'address_saved') {
                showToast('Address saved successfully!', 'success');
                // Clean URL
                const newUrl = window.location.pathname;
                window.history.replaceState({}, document.title, newUrl);
            } else if (success === 'address_updated') {
                showToast('Address updated successfully!', 'success');
                const newUrl = window.location.pathname;
                window.history.replaceState({}, document.title, newUrl);
            }
        });
    </script>
</body>

</html>