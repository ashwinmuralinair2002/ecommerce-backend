<!-- User saved addresses list template -->
<html>

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900&amp;family=Space+Grotesk%3Awght%40400%3B500%3B700" />

    <title>Stitch Design</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <script>
        function confirmDeleteAddress(addressId) {
            confirmAction({
                title: 'Delete Address?',
                text: 'Are you sure you want to remove this address?',
                confirmButtonText: 'Yes, delete it',
                confirmButtonColor: '#d33'
            }, () => {
                // Submit hidden form
                const form = document.getElementById('delete-form-' + addressId);
                if (form) form.submit();
            });
        }
    </script>
</head>

<body>
    <div class="relative flex h-auto min-h-screen w-full flex-col bg-white group/design-root overflow-x-hidden"
        style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
        <div class="layout-container flex h-full grow flex-col">
            <header
                class="flex items-center justify-between whitespace-nowrap border-b border-solid border-b-[#f0f5f0] px-10 py-3">
                <div class="flex items-center gap-8">
                    <div class="flex items-center gap-4 text-[#111811]">
                        <div class="size-4">
                            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462C2.19985 28.361 1.76794 23.9758 2.60947 19.7452C3.451 15.5145 5.52816 11.6284 8.57829 8.5783C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948C23.9758 1.76795 28.361 2.19986 32.3462 3.85057C36.3314 5.50129 39.7376 8.29668 42.134 11.8833C44.5305 15.4698 45.8096 19.6865 45.8096 24L24 24L24 45.8096Z"
                                    fill="currentColor"></path>
                            </svg>
                        </div>
                        <h2 class="text-[#111811] text-lg font-bold leading-tight tracking-[-0.015em]">SoundWave</h2>
                    </div>
                    <div class="flex items-center gap-9">
                        <a class="text-[#111811] text-sm font-medium leading-normal" href="#">New Arrivals</a>
                        <a class="text-[#111811] text-sm font-medium leading-normal" href="#">Best Sellers</a>
                        <a class="text-[#111811] text-sm font-medium leading-normal" href="#">Headphones</a>
                        <a class="text-[#111811] text-sm font-medium leading-normal" href="#">Earbuds</a>
                        <a class="text-[#111811] text-sm font-medium leading-normal" href="#">Speakers</a>
                        <a class="text-[#111811] text-sm font-medium leading-normal" href="#">Accessories</a>
                    </div>
                </div>
                <div class="flex flex-1 justify-end gap-8">
                    <label class="flex flex-col min-w-40 !h-10 max-w-64">
                        <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
                            <div class="text-[#5f8c5f] flex border-none bg-[#f0f5f0] items-center justify-center pl-4 rounded-l-lg border-r-0"
                                data-icon="MagnifyingGlass" data-size="24px" data-weight="regular">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" fill="currentColor"
                                    viewBox="0 0 256 256">
                                    <path
                                        d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z">
                                    </path>
                                </svg>
                            </div>
                            <input placeholder="Search"
                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#111811] focus:outline-0 focus:ring-0 border-none bg-[#f0f5f0] focus:border-none h-full placeholder:text-[#5f8c5f] px-4 rounded-l-none border-l-0 pl-2 text-base font-normal leading-normal"
                                value="" />
                        </div>
                    </label>
                    <div class="flex gap-2">
                        <button
                            class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 bg-[#f0f5f0] text-[#111811] gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-2.5">
                            <div class="text-[#111811]" data-icon="MagnifyingGlass" data-size="20px"
                                data-weight="regular">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" fill="currentColor"
                                    viewBox="0 0 256 256">
                                    <path
                                        d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z">
                                    </path>
                                </svg>
                            </div>
                        </button>
                        <button
                            class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 bg-[#f0f5f0] text-[#111811] gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-2.5">
                            <div class="text-[#111811]" data-icon="ShoppingCart" data-size="20px" data-weight="regular">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" fill="currentColor"
                                    viewBox="0 0 256 256">
                                    <path
                                        d="M222.14,58.87A8,8,0,0,0,216,56H54.68L49.79,29.14A16,16,0,0,0,34.05,16H16a8,8,0,0,0,0,16h18L59.56,172.29a24,24,0,0,0,5.33,11.27,28,28,0,1,0,44.4,8.44h45.42A27.75,27.75,0,0,0,152,204a28,28,0,1,0,28-28H83.17a8,8,0,0,1-7.87-6.57L72.13,152h116a24,24,0,0,0,23.61-19.71l12.16-66.86A8,8,0,0,0,222.14,58.87ZM96,204a12,12,0,1,1-12-12A12,12,0,0,1,96,204Zm96,0a12,12,0,1,1-12-12A12,12,0,0,1,192,204Zm4-74.57A8,8,0,0,1,188.1,136H69.22L57.59,72H206.41Z">
                                    </path>
                                </svg>
                            </div>
                        </button>
                    </div>
                    <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10"
                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuB5tuG4HxyTljsrR_HEqngBcDa_dAt_YzyNwWD9gFctlu0mTwupC0kmYW8rpqfLyng1i3QD63LZXKfcdXJ0WnwC6Oe7zbxa3jrCySW5w6Ppry8tvWyDtzHfEc-dBFIhQlLOoK1Z-zIwVcdhlYRQgDXOL4BIfUCo1JMbQxYRfRO3v4JhrsCAu3kT1fo45puNxcWgzrYuyS3SZpWxoEI4dl5L8qJC5Zy6hnKMtG4b9xbyDkHlqbUC0BTmslAK2MlP1DUl8EhNnD3-MjWh");'>
                    </div>
                </div>
            </header>
            <div class="gap-1 px-6 flex flex-1 justify-center py-5">
                <div class="layout-content-container flex flex-col w-80">
                    <div class="flex h-full min-h-[700px] flex-col justify-between bg-white p-4">
                        <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                                <a href="/account"
                                    class="flex items-center gap-3 px-3 py-2 hover:bg-[#f0f5f0] rounded-lg transition-colors">
                                    <div class="text-[#111811]" data-icon="User" data-size="24px" data-weight="regular">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px"
                                            fill="currentColor" viewBox="0 0 256 256">
                                            <path
                                                d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z">
                                            </path>
                                        </svg>
                                    </div>
                                    <p class="text-[#111811] text-sm font-medium leading-normal">Account Details</p>
                                </a>
                                <div class="flex items-center gap-3 px-3 py-2 rounded-lg bg-[#f0f5f0]">
                                    <div class="text-[#111811]" data-icon="MapPin" data-size="24px" data-weight="fill">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px"
                                            fill="currentColor" viewBox="0 0 256 256">
                                            <path
                                                d="M128,16a88.1,88.1,0,0,0-88,88c0,75.3,80,132.17,83.41,134.55a8,8,0,0,0,9.18,0C136,236.17,216,179.3,216,104A88.1,88.1,0,0,0,128,16Zm0,56a32,32,0,1,1-32,32A32,32,0,0,1,128,72Z">
                                            </path>
                                        </svg>
                                    </div>
                                    <p class="text-[#111811] text-sm font-medium leading-normal">Address</p>
                                </div>
                                <div class="flex items-center gap-3 px-3 py-2">
                                    <div class="text-[#111811]" data-icon="CreditCard" data-size="24px"
                                        data-weight="regular">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px"
                                            fill="currentColor" viewBox="0 0 256 256">
                                            <path
                                                d="M224,48H32A16,16,0,0,0,16,64V192a16,16,0,0,0,16,16H224a16,16,0,0,0,16-16V64A16,16,0,0,0,224,48Zm0,16V88H32V64Zm0,128H32V104H224v88Zm-16-24a8,8,0,0,1-8,8H168a8,8,0,0,1,0-16h32A8,8,0,0,1,208,168Zm-64,0a8,8,0,0,1-8,8H120a8,8,0,0,1,0-16h16A8,8,0,0,1,144,168Z">
                                            </path>
                                        </svg>
                                    </div>
                                    <p class="text-[#111811] text-sm font-medium leading-normal">Payment Details</p>
                                </div>
                                <div class="flex items-center gap-3 px-3 py-2">
                                    <div class="text-[#111811]" data-icon="Wallet" data-size="24px"
                                        data-weight="regular">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px"
                                            fill="currentColor" viewBox="0 0 256 256">
                                            <path
                                                d="M216,72H56a8,8,0,0,1,0-16H192a8,8,0,0,0,0-16H56A24,24,0,0,0,32,64V192a24,24,0,0,0,24,24H216a16,16,0,0,0,16-16V88A16,16,0,0,0,216,72Zm0,128H56a8,8,0,0,1-8-8V86.63A23.84,23.84,0,0,0,56,88H216Zm-48-60a12,12,0,1,1,12,12A12,12,0,0,1,168,140Z">
                                            </path>
                                        </svg>
                                    </div>
                                    <p class="text-[#111811] text-sm font-medium leading-normal">Wallet</p>
                                </div>
                                <div class="flex items-center gap-3 px-3 py-2">
                                    <div class="text-[#111811]" data-icon="Package" data-size="24px"
                                        data-weight="regular">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px"
                                            fill="currentColor" viewBox="0 0 256 256">
                                            <path
                                                d="M223.68,66.15,135.68,18a15.88,15.88,0,0,0-15.36,0l-88,48.17a16,16,0,0,0-8.32,14v95.64a16,16,0,0,0,8.32,14l88,48.17a15.88,15.88,0,0,0,15.36,0l88-48.17a16,16,0,0,0,8.32-14V80.18A16,16,0,0,0,223.68,66.15ZM128,32l80.34,44-29.77,16.3-80.35-44ZM128,120,47.66,76l33.9-18.56,80.34,44ZM40,90l80,43.78v85.79L40,175.82Zm176,85.78h0l-80,43.79V133.82l32-17.51V152a8,8,0,0,0,16,0V107.55L216,90v85.77Z">
                                            </path>
                                        </svg>
                                    </div>
                                    <p class="text-[#111811] text-sm font-medium leading-normal">Your Orders</p>
                                </div>
                                <a href="/api/auth/logout" class="flex items-center gap-3 px-3 py-2 group">
                                    <div class="text-red-600 group-hover:text-red-700" data-icon="LogOut"
                                        data-size="24px" data-weight="regular">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px"
                                            fill="currentColor" viewBox="0 0 256 256">
                                            <path
                                                d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm-40-88a8,8,0,0,1,8-8h56V96a8,8,0,0,1,13.66-5.66l40,40a8,8,0,0,1,0,11.32l-40,40A8,8,0,0,1,152,176V152H96A8,8,0,0,1,88,128Z">
                                            </path>
                                        </svg>
                                    </div>
                                    <p class="text-red-600 font-medium leading-normal group-hover:text-red-700">Logout
                                    </p>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
                    <div class="flex flex-wrap justify-between gap-3 p-4">
                        <p class="text-[#111811] tracking-light text-[32px] font-bold leading-tight min-w-72">My
                            Addresses</p>
                        <a href="/account/addresses/new"
                            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-8 px-4 bg-[#f0f5f0] text-[#111811] text-sm font-medium leading-normal">
                            <span class="truncate">Add New Address</span>
                        </a>
                    </div>

                    <% if (user.addresses && user.addresses.length> 0) { %>
                        <% user.addresses.forEach(function(address) { %>
                            <div class="p-4">
                                <div class="flex items-stretch justify-between gap-4 rounded-lg">
                                    <div class="flex flex-col gap-1 flex-[2_2_0px]">
                                        <p class="text-[#5f8c5f] text-sm font-normal leading-normal">
                                            <%= address.label || 'Home' %>
                                        </p>
                                        <p class="text-[#111811] text-base font-bold leading-tight">
                                            <%= address.name || user.name || 'Name not set' %>
                                        </p>
                                        <p class="text-[#5f8c5f] text-sm font-normal leading-normal">
                                            <%= address.phone ? address.phone + ' ' : '' %>
                                                <%= address.houseNo ? address.houseNo + ', ' : '' %>
                                                    <%= address.street %>, <%= address.city %>, <%= address.state %>
                                                                <%= address.zip %>
                                        </p>
                                    </div>
                                    <div class="w-full bg-center bg-no-repeat aspect-video bg-cover rounded-lg flex-1"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBfVftXfkbqCUiBdRR7BspkXKQsHxvq9R75qGDu9S4keMERR6OH8BtkmIad4qw_oxCnp7X-qy6_twCoe7PtcwRNYU7a8d9W9Haio1MrQMKo0s2CJaY0Yvhm3Xcz4KMxJPZBMs6wV67WXsqKbzueJC4BOKvGotRzWEIw9J0ufWpVAryIkQD-rsSyGPB47mLJqKpqgoJSoIak4uHKk_meiC5qoqkyow5izlp6Kwa_t97Udny26zmsUcXxRRSjgALZDZ8oqBpo70KIATFe");'>
                                    </div>
                                </div>
                            </div>
                            <div class="flex justify-stretch">
                                <div class="flex flex-1 gap-3 flex-wrap px-4 py-3 justify-start">
                                    <a href="/account/addresses/<%= address._id %>/edit"
                                        class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-[#1ff91f] text-[#111811] text-sm font-bold leading-normal tracking-[0.015em]">
                                        <span class="truncate">Edit</span>
                                    </a>
                                    <form id="delete-form-<%= address._id %>"
                                        action="/account/addresses/<%= address._id %>/delete" method="POST"
                                        style="display: none;">
                                    </form>
                                    <button onclick="confirmDeleteAddress('<%= address._id %>')"
                                        class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-transparent text-[#111811] text-sm font-bold leading-normal tracking-[0.015em] border border-gray-200">
                                        <span class="truncate">Delete</span>
                                    </button>
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div class="p-4">
                                        <p>No addresses found.</p>
                                    </div>
                                    <% } %>

                </div>
            </div>
        </div>
    </div>
</body>

</html>