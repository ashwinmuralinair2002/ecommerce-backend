<!-- User account dashboard template -->
<!DOCTYPE html>
<html>

<head>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
  <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
    href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />

  <title>SoundWave | User Account</title>

  <%- include('./partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/utils.js"></script>
  <script>
    function confirmDeleteAccount() {
      confirmAction({
        title: 'Delete Account?',
        text: 'This action is permanent and cannot be undone.',
        confirmButtonText: 'Yes, delete it',
        confirmButtonColor: '#ef4444', // Red-500
      }, async () => {
        try {
          const response = await fetch('/api/profile/delete', { method: 'DELETE' });
          const data = await response.json();

          if (response.ok) {
            // Redirect to landing page on success (session destroyed by backend)
            window.location.href = '/';
          } else {
            showMessage(data.error || 'Failed to delete account', 'error');
          }
        } catch (error) {
          console.error('Error:', error);
          showMessage('An unexpected error occurred', 'error');
        }
      });
    }

    // Inline Message Utility
    function showInlineMessage(message, type) {
      const msgDiv = document.getElementById('profile-message');
      msgDiv.textContent = message;
      msgDiv.classList.remove('hidden', 'text-primary', 'text-red-600', 'bg-primary-light/35', 'bg-red-50');

      if (type === 'success') {
        msgDiv.classList.add('text-primary', 'bg-primary-light/35', 'border', 'border-primary-light/70');
      } else {
        msgDiv.classList.add('text-red-600', 'bg-red-50', 'border', 'border-red-200');
      }

      msgDiv.classList.remove('hidden');

      // Auto-hide after 3 seconds
      setTimeout(() => {
        msgDiv.classList.add('hidden');
      }, 3000);
    }

    // Edit Profile Logic
    let originalData = {};

    function toggleEdit() {
      const inputs = document.querySelectorAll('.profile-input');
      const editBtn = document.getElementById('edit-btn');
      const actionBtns = document.getElementById('action-btns');

      // Clear any existing messages
      document.getElementById('profile-message').classList.add('hidden');

      const isEditing = !inputs[0].readOnly;

      if (!isEditing) {
        // Enable Editing
        originalData = {
          name: inputs[0].value,
          email: inputs[1].value,
          phone: inputs[2].value
        };

        inputs.forEach(input => {
          // Email is typically not editable here directly due to verification needs in standard flows,
          // but if the intention is to allow ONLY name and phone editing based on the request:
          // The prompt says "Enable editing for: Name, Email (if allowed), Phone Number".
          // The previous code seemed to allow Name and Email editing. 
          // I will enable all inputs except maybe restricted ones if any. 
          // The prompt specifically asked to "Enable editing for Name, Email, Phone Number".

          input.readOnly = false;
          input.classList.remove('bg-gray-50');
          input.classList.add('bg-white', 'border-primary');
        });

        editBtn.classList.add('hidden');
        actionBtns.classList.remove('hidden');
      } else {
        // Cancel Editing
        cancelEdit();
      }
    }

    function cancelEdit() {
      const inputs = document.querySelectorAll('.profile-input');
      const editBtn = document.getElementById('edit-btn');
      const actionBtns = document.getElementById('action-btns');

      // Clear messages
      document.getElementById('profile-message').classList.add('hidden');

      inputs.forEach((input, index) => {
        input.readOnly = true;
        input.classList.add('bg-gray-50');
        input.classList.remove('bg-white', 'border-primary');

        if (input.name === 'name') input.value = originalData.name;
        if (input.name === 'email') input.value = originalData.email;
        if (input.name === 'phone') input.value = originalData.phone;
      });

      editBtn.classList.remove('hidden');
      actionBtns.classList.add('hidden');
    }

    async function saveProfile() {
      const inputs = document.querySelectorAll('.profile-input');
      const name = inputs[0].value.trim();
      const email = inputs[1].value.trim();
      const phone = inputs[2].value.trim();
      const saveBtn = document.querySelector('#action-btns button:first-child');

      if (!name || !email) {
        showInlineMessage('Name and Email are required', 'error');
        return;
      }

      if (phone && !/^\d+$/.test(phone)) {
        showInlineMessage('Phone number must contain only digits', 'error');
        return;
      }

      // Disable button
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
      saveBtn.classList.add('opacity-50', 'cursor-not-allowed');

      try {
        let emailChanged = false;

        // 1. Check & Request Email Change First
        if (email !== originalData.email) {
          const emailRes = await fetch('/api/profile/email/request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newEmail: email })
          });
          const emailResult = await emailRes.json();

          if (!emailRes.ok) {
            throw new Error(emailResult.error || 'Failed to request email change');
          }
          emailChanged = true;
        }

        // 2. Update Basic Profile Info (Name, Phone)
        // We always run this to ensure name/phone updates are captured even if email also changed.
        // We pass 'email' as originalData.email so the backend doesn't try to update it immediately, 
        // OR we rely on the backend to ignore email if we don't send it?
        // Let's send the *original* email in the body for the profile update part to be safe, 
        // effectively telling the backend "keep email as is for now".
        // Or better: Just send name and phone.
        const profileRes = await fetch('/api/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            phone,
            // We intentionally do NOT send 'email' here if it changed, 
            // or we send the OLD email to satisfy any "required" checks without changing it.
            // Assuming backend uses what's sent. 
            // If we send new email here, backend might update it directly if not guarded.
            // Let's rely on the fact we want to update name/phone.
            // If we omit email, does backend complain? 
            // checking profile.service.js: it checks `if (data.name) user.name = data.name`. 
            // It does NOT seem to look for email in `updateProfile`. Good.
          })
        });

        const profileData = await profileRes.json();

        if (!profileRes.ok) {
          throw new Error(profileData.error || 'Failed to update profile details');
        }

        // Success!

        // Update local data for Name/Phone
        originalData.name = profileData.name;
        if (profileData.phone) originalData.phone = profileData.phone;

        if (emailChanged) {
          // Redirect to OTP
          window.location.href = `/verify-otp?mode=email_change`;
          return;
        }

        showInlineMessage('Profile updated successfully', 'success');

        // Logic to return to read-only mode
        // Update Original Data
        originalData.name = profileData.name;
        originalData.email = profileData.email; // Should match original if not changed
        if (profileData.phone) originalData.phone = profileData.phone;

        // Return to Read-only
        const editBtn = document.getElementById('edit-btn');
        const actionBtns = document.getElementById('action-btns');

        setTimeout(() => {
          inputs.forEach(input => {
            input.readOnly = true;
            input.classList.add('bg-gray-50');
            input.classList.remove('bg-white', 'border-primary');
          });

          editBtn.classList.remove('hidden');
          actionBtns.classList.add('hidden');
        }, 1500);

      } catch (error) {
        console.error('Error:', error);
        showInlineMessage(error.message || 'An unexpected error occurred', 'error');
      } finally {
        // Re-enable button if we didn't redirect
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save';
          saveBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      }
    }
    async function uploadProfilePhoto(input) {
      const file = input.files[0];
      if (!file) return;

      // Validate Type
      if (!['image/jpeg', 'image/jpg'].includes(file.type)) {
        showInlineMessage('Only JPG/JPEG images are allowed', 'error');
        input.value = ''; // Reset
        return;
      }

      // Validate Size (2MB)
      if (file.size > 2 * 1024 * 1024) {
        showInlineMessage('Image size must be less than 2MB', 'error');
        input.value = ''; // Reset
        return;
      }

      const formData = new FormData();
      formData.append('profileImage', file);

      const statusEl = document.getElementById('upload-status');
      statusEl.textContent = 'Uploading...';
      statusEl.classList.remove('hidden', 'text-red-500', 'text-primary');
      statusEl.classList.add('text-blue-600');

      try {
        const response = await fetch('/api/profile/upload-photo', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.ok) {
          // Update Image Preview
          document.getElementById('profile-image-preview').src = data.profileImage;
          statusEl.textContent = 'Photo updated successfully';
          statusEl.classList.remove('text-blue-600');
          statusEl.classList.add('text-primary');
          setTimeout(() => statusEl.classList.add('hidden'), 3000);
          showInlineMessage('Profile photo updated', 'success');
        } else {
          throw new Error(data.error || 'Upload failed');
        }
      } catch (error) {
        console.error('Upload Error:', error);
        statusEl.textContent = 'Upload failed';
        statusEl.classList.remove('text-blue-600');
        statusEl.classList.add('text-red-500');
        showInlineMessage(error.message, 'error');
      } finally {
        input.value = ''; // Reset for re-selection
      }
    }
  </script>
</head>

<body>
  <div class="relative flex min-h-screen w-full flex-col bg-white"
    style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

    <!-- Navbar -->
    <%- include('./partials/user/navbar') %>

      <!-- ================= CONTENT ================= -->
      <main class="flex flex-1 gap-0 px-0 py-0 bg-white">

        <!-- SIDEBAR -->
        <aside class="w-64 theme-filter-sidebar p-3 text-primary">
          <div class="space-y-2">
            <div class="bg-primary-light/35 px-3 py-2 rounded-lg font-medium">Account Details</div>
            <a href="/account/addresses"
              class="block px-3 py-2 hover:bg-primary-light/35 rounded-lg transition-colors">Address</a>
            <div class="px-3 py-2">Payment Details</div>
            <div class="px-3 py-2">Wallet</div>
            <a href="/orders"
              class="block px-3 py-2 hover:bg-primary-light/35 rounded-lg transition-colors">Your Orders</a>
            <form action="/api/auth/logout" method="POST">
              <button type="submit"
                class="block w-full text-left px-3 py-2 text-red-600 hover:bg-primary-light/35 rounded-lg transition-colors">Logout</button>
            </form>
          </div>
        </aside>

        <!-- MAIN PANEL -->
        <section class="flex-1 bg-white p-6">
          <h1 class="text-2xl font-bold mb-6">Account Details</h1>

          <div class="flex items-center gap-6 mb-8">
            <div class="relative group">
              <div class="h-24 w-24 rounded-full overflow-hidden border-2 border-primary-light/60 ring-2 ring-primary-light/35">
                <img id="profile-image-preview"
                  src="<%= user.profileImage || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=random' %>"
                  alt="Profile Photo" class="h-full w-full object-cover" />
              </div>
              <label for="profile-upload"
                class="absolute bottom-0 right-0 h-8 w-8 bg-primary rounded-full flex items-center justify-center cursor-pointer hover:brightness-90 transition-colors shadow-lg border-2 border-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"
                  stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </label>
              <input type="file" id="profile-upload" accept="image/jpeg, image/jpg" class="hidden"
                onchange="uploadProfilePhoto(this)" />
            </div>
            <div>
              <h3 class="font-bold text-lg">
                <%= user.name %>
              </h3>
              <p class="text-sm text-gray-500">
                <%= user.email %>
              </p>
              <p id="upload-status" class="text-xs text-primary font-medium mt-1 hidden">Uploading...</p>
            </div>
          </div>

          <div class="flex items-center justify-between mb-3">
            <h3 class="font-bold">Personal Information</h3>
            <div id="action-btns" class="hidden flex gap-2">
              <button onclick="saveProfile()" class="text-sm text-primary font-bold hover:underline">Save</button>
              <button onclick="cancelEdit()" class="text-sm text-gray-500 font-bold hover:underline">Cancel</button>
            </div>
          </div>

          <div class="space-y-4 max-w-md">
            <!-- Inline Message Container -->
            <div id="profile-message" class="hidden w-full p-3 rounded-lg text-sm font-medium transition-all"></div>

            <input name="name" class="profile-input w-full h-12 rounded-lg border px-4 bg-gray-50" placeholder="Name"
              value="<%= user.name %>" readonly />
            <input name="email" class="profile-input w-full h-12 rounded-lg border px-4 bg-gray-50" placeholder="Email"
              value="<%= user.email %>" readonly />
            <input name="phone" class="profile-input w-full h-12 rounded-lg border px-4 bg-gray-50 text-gray-500"
              placeholder="Phone Number" value="<%= user.phone || '' %>" readonly />

            <!-- Action Buttons (Change Password & Edit Profile) -->
            <div class="pt-4 flex flex-col sm:flex-row gap-3">
              <a href="/account/change-password"
                class="theme-primary-btn flex h-10 flex-1 items-center justify-center rounded-lg text-sm">
                Change Password
              </a>
              <button id="edit-btn" onclick="toggleEdit()"
                class="theme-primary-btn flex-1 h-10 rounded-lg text-sm">
                Edit Profile
              </button>
            </div>

            <!-- Delete Account Button (Repositioned) -->
            <div class="pt-4">
              <button onclick="confirmDeleteAccount()"
                class="w-full h-10 rounded-lg bg-red-100 text-red-700 font-bold hover:bg-red-200 transition-colors">
                Delete Account
              </button>
              <p class="text-xs text-red-500 mt-1 text-center">This action is permanent and cannot be undone.</p>
            </div>

          </div>

          <!-- Original Delete Button Location (Removed) -->
        </section>

      </main>
  </div>
</body>

</html>
