<!-- Change Password Page -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />
    <title>SoundWave | Change Password</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-[#f8fcf8]"
        style='font-family:"Space Grotesk","Noto Sans",sans-serif;'>

        <!-- HEADER -->
        <header class="flex items-center justify-between border-b border-[#e6f4e6] px-10 py-3">
            <div class="flex items-center gap-4 text-[#0d1c0d]">
                <div class="size-4">
                    <svg viewBox="0 0 48 48" fill="currentColor">
                        <path
                            d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462C2.19985 28.361 1.76794 23.9758 2.60947 19.7452C3.451 15.5145 5.52816 11.6284 8.57829 8.5783C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948C23.9758 1.76795 28.361 2.19986 32.3462 3.85057C36.3314 5.50129 39.7376 8.29668 42.134 11.8833C44.5305 15.4698 45.8096 19.6865 45.8096 24L24 24L24 45.8096Z" />
                    </svg>
                </div>
                <h2 class="text-lg font-bold">SoundWave</h2>
            </div>
        </header>

        <!-- CONTENT -->
        <main class="flex flex-1 items-center justify-center px-4 py-8">
            <div class="w-full max-w-md bg-white rounded-lg p-8 shadow-sm">
                <h1 class="text-2xl font-bold mb-6 text-center text-[#0d1c0d]">Change Password</h1>

                <form id="changePasswordForm" class="space-y-4">
                    <!-- Old Password -->
                    <div class="relative">
                        <input type="password" id="oldPassword" placeholder="Current Password"
                            class="peer form-input w-full h-12 rounded-lg border border-[#cee8ce] px-4 pt-4 text-base placeholder-transparent focus:outline-none focus:border-[#499c49] pr-10" />
                        <label for="oldPassword"
                            class="absolute left-4 top-1 text-xs text-[#499c49] transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-400 peer-focus:top-1 peer-focus:text-xs">Current
                            Password</label>
                        <button type="button" onclick="togglePasswordVisibility('oldPassword', 'icon-old')"
                            class="absolute right-3 top-3.5 text-gray-400 hover:text-[#499c49]">
                            <span id="icon-old">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </span>
                        </button>
                    </div>

                    <!-- New Password -->
                    <div class="relative">
                        <input type="password" id="newPassword" placeholder="New Password"
                            class="peer form-input w-full h-12 rounded-lg border border-[#cee8ce] px-4 pt-4 text-base placeholder-transparent focus:outline-none focus:border-[#499c49] pr-10" />
                        <label for="newPassword"
                            class="absolute left-4 top-1 text-xs text-[#499c49] transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-400 peer-focus:top-1 peer-focus:text-xs">New
                            Password</label>
                        <button type="button" onclick="togglePasswordVisibility('newPassword', 'icon-new')"
                            class="absolute right-3 top-3.5 text-gray-400 hover:text-[#499c49]">
                            <span id="icon-new">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </span>
                        </button>
                    </div>

                    <!-- Confirm New Password -->
                    <div class="relative">
                        <input type="password" id="confirmPassword" placeholder="Confirm New Password"
                            class="peer form-input w-full h-12 rounded-lg border border-[#cee8ce] px-4 pt-4 text-base placeholder-transparent focus:outline-none focus:border-[#499c49] pr-10" />
                        <label for="confirmPassword"
                            class="absolute left-4 top-1 text-xs text-[#499c49] transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-400 peer-focus:top-1 peer-focus:text-xs">Confirm
                            New Password</label>
                        <button type="button" onclick="togglePasswordVisibility('confirmPassword', 'icon-confirm')"
                            class="absolute right-3 top-3.5 text-gray-400 hover:text-[#499c49]">
                            <span id="icon-confirm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </span>
                        </button>
                    </div>

                    <!-- Message Container -->
                    <div id="msgContainer" class="hidden p-3 rounded-lg text-sm text-center"></div>

                    <div class="flex gap-4 pt-4">
                        <button type="submit" id="submitBtn"
                            class="flex-1 h-10 rounded-lg bg-[#499c49] text-white font-bold hover:bg-[#3d8b3d] transition-colors">
                            Continue
                        </button>
                        <a href="/account"
                            class="flex-1 flex items-center justify-center h-10 rounded-lg bg-gray-100 text-gray-700 font-bold hover:bg-gray-200 transition-colors">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script>
        document.getElementById('changePasswordForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const oldPassword = document.getElementById('oldPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const submitBtn = document.getElementById('submitBtn');
            const msgDiv = document.getElementById('msgContainer');

            // Helper to show message
            const showMsg = (text, type = 'error') => {
                msgDiv.textContent = text;
                msgDiv.className = `p-3 rounded-lg text-sm text-center ${type === 'error' ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'}`;
                msgDiv.classList.remove('hidden');
            };

            // Validation
            if (!oldPassword || !newPassword || !confirmPassword) {
                return showMsg('All fields are required');
            }
            if (newPassword !== confirmPassword) {
                return showMsg('New passwords do not match');
            }
            if (newPassword.length < 6) {
                return showMsg('Password must be at least 6 characters');
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Processing...';
            msgDiv.classList.add('hidden');

            try {
                const response = await fetch('/api/profile/password/request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ oldPassword, newPassword, confirmPassword })
                });

                const data = await response.json();

                if (response.ok) {
                    showMsg('Password verified. Sending OTP...', 'success');
                    setTimeout(() => {
                        window.location.href = '/verify-otp?mode=password_change';
                    }, 1000);
                } else {
                    showMsg(data.error || 'Failed to request password change');
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Continue';
                }
            } catch (error) {
                console.error(error);
                showMsg('An unexpected error occurred');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Continue';
            }
        });
    </script>
</body>

</html>