<%
    const variantImages = Array.isArray(product.variants) && product.variants.length > 0 && Array.isArray(product.variants[0].images) ? product.variants[0].images : [];
    const heroImg = variantImages[0];
    const imageUrl = getCroppedImageUrl(heroImg);
%>
<a href="/product/<%= product._id %>"
    class="group flex flex-col gap-3 pb-3 border border-primary-light/45 p-2 rounded-lg bg-white shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 h-full">
    <div class="aspect-square overflow-hidden bg-primary-light/20 relative rounded-lg">
        <img src="<%= imageUrl %>" alt="<%= product.title %>"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 rounded-lg"
            loading="lazy" onerror="this.src='/images/placeholder.png'" />

        <% if (product.discountPercentage > 0) { %>
            <div
                class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-2 py-1 rounded">
                -<%= product.discountPercentage %>%
            </div>
        <% } %>
    </div>

    <div class="space-y-2 flex-1 flex flex-col">
        <h3 class="font-medium text-primary text-sm leading-tight line-clamp-2 min-h-[2.5em]">
            <%= product.title %>
        </h3>

        <div class="mt-auto pt-2">
            <% const finalPrice = Number(product.price || 0) - ((Number(product.price || 0) * Number(product.discountPercentage || 0)) / 100); %>
            <div class="flex items-baseline gap-2">
                <% if (Number(product.discountPercentage || 0) > 0) { %>
                    <span class="text-xs text-gray-400 line-through">
                        <%= formatCurrency(product.price) %>
                    </span>
                    <span class="text-primary text-sm font-normal leading-normal">
                        <%= formatCurrency(finalPrice) %>
                    </span>
                <% } else { %>
                    <span class="text-primary text-sm font-normal leading-normal">
                        <%= formatCurrency(product.price) %>
                    </span>
                <% } %>
            </div>
        </div>
    </div>
</a>
