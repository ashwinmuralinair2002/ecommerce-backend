<script>
    (() => {
        const heroSliders = document.querySelectorAll('.hero-slider');
        const SWIPE_THRESHOLD = 30;

        heroSliders.forEach((slider) => {
            const slides = slider.querySelectorAll('.hero-slide');
            const container = slider.closest('section');
            const prevButton = container ? container.querySelector('.hero-nav-prev') : null;
            const nextButton = container ? container.querySelector('.hero-nav-next') : null;

            if (!slides.length) return;

            let currentIndex = 0;
            let intervalId = null;
            let pointerStart = null;
            let suppressClick = false;

            function showSlide(index) {
                slides.forEach((slide) => {
                    slide.style.opacity = '0';
                });
                slides[index].style.opacity = '1';
                currentIndex = index;
            }

            function nextSlide() {
                showSlide((currentIndex + 1) % slides.length);
            }

            function prevSlide() {
                showSlide((currentIndex - 1 + slides.length) % slides.length);
            }

            function startAuto() {
                if (slides.length <= 1) return;
                intervalId = setInterval(nextSlide, 5000);
            }

            function resetAuto() {
                if (slides.length <= 1) return;
                if (intervalId) clearInterval(intervalId);
                startAuto();
            }

            function handleNavButtonClick(event, direction) {
                event.preventDefault();
                event.stopPropagation();

                if (direction === 'prev') {
                    prevSlide();
                } else {
                    nextSlide();
                }

                resetAuto();
            }

            function handleSwipe(deltaX, deltaY) {
                if (Math.abs(deltaX) < SWIPE_THRESHOLD || Math.abs(deltaX) <= Math.abs(deltaY)) {
                    return false;
                }

                if (deltaX < 0) {
                    nextSlide();
                } else {
                    prevSlide();
                }

                resetAuto();
                suppressClick = true;
                window.setTimeout(() => {
                    suppressClick = false;
                }, 0);
                return true;
            }

            slider.addEventListener('pointerdown', (event) => {
                if (event.pointerType === 'mouse' && event.button !== 0) return;
                pointerStart = { x: event.clientX, y: event.clientY };
            });

            slider.addEventListener('pointerup', (event) => {
                if (!pointerStart || slides.length <= 1) return;
                handleSwipe(event.clientX - pointerStart.x, event.clientY - pointerStart.y);
                pointerStart = null;
            });

            slider.addEventListener('pointercancel', () => {
                pointerStart = null;
            });

            slider.addEventListener('click', (event) => {
                if (!suppressClick) return;
                event.preventDefault();
                event.stopPropagation();
            }, true);

            if (prevButton) {
                prevButton.addEventListener('click', (event) => {
                    handleNavButtonClick(event, 'prev');
                });
            }

            if (nextButton) {
                nextButton.addEventListener('click', (event) => {
                    handleNavButtonClick(event, 'next');
                });
            }

            if (slides.length > 1) {
                startAuto();
            }
        });
    })();
</script>
