<% if (banners && banners.length > 0) { %>
    <section class="w-full relative overflow-hidden" style="height: calc(100vh - 64px);">
        <div class="hero-slider relative w-full h-full">
            <% banners.forEach((banner, index) => { %>
                <a href="/hero/redirect/<%= banner._id %>"
                    class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-500"
                    style="opacity: <%= index === 0 ? 1 : 0 %>;"
                    data-index="<%= index %>">
                    <picture>
                        <% if (banner.mobileImage && banner.mobileImage.url) { %>
                            <source media="(max-width: 767px)" srcset="<%= banner.mobileImage.url %>">
                        <% } %>
                        <img src="<%= banner.image.url %>"
                            alt="Hero banner"
                            class="w-full h-full object-cover"
                            style="object-position: center top;" />
                    </picture>
                </a>
            <% }) %>
        </div>

        <div class="hero-left absolute left-0 top-0 h-full w-1/2 cursor-pointer z-10"></div>
        <div class="hero-right absolute right-0 top-0 h-full w-1/2 cursor-pointer z-10"></div>
    </section>
<% } %>
