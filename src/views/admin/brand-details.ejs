<!-- Admin brand details page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900" />
    <title>Admin · Brand</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmAction(options, actionCallback) {
            Swal.fire({
                title: options.title,
                text: options.text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: options.confirmButtonColor || '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: options.confirmButtonText
            }).then((result) => {
                if (result.isConfirmed) {
                    actionCallback();
                }
            });
        }

        function confirmBrandDelete(brandId) {
            confirmAction({
                title: 'Delete Brand?',
                text: 'Are you sure you want to delete this brand? This action cannot be undone.',
                confirmButtonText: 'Yes, Delete',
                confirmButtonColor: '#d33'
            }, () => {
                document.getElementById('delete-form-' + brandId).submit();
            });
        }
    </script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'brands' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 p-6 md:p-8">
                <% const getCroppedBrandLogoUrl = (brand) => {
                    if (!brand || !brand.logoUrl) return '';
                    const crop = brand.logoCrop;
                    if (!crop) return brand.logoUrl;
                    const x = Number(crop.x);
                    const y = Number(crop.y);
                    const width = Number(crop.width);
                    const height = Number(crop.height);
                    if (![x, y, width, height].every(Number.isFinite)) return brand.logoUrl;
                    if (width <= 0 || height <= 0) return brand.logoUrl;
                    if (!String(brand.logoUrl).includes('/upload/')) return brand.logoUrl;
                    return String(brand.logoUrl).replace('/upload/', '/upload/c_crop,x_' + Math.max(0, Math.round(x)) + ',y_' + Math.max(0, Math.round(y)) + ',w_' + Math.round(width) + ',h_' + Math.round(height) + '/');
                }; %>
                <!-- Breadcrumb -->
                <div class="flex items-center gap-2 text-sm mb-4">
                    <a href="/admin/brands" class="text-[#685BCB] hover:underline">Brands</a>
                    <span class="text-gray-400">/</span>
                    <span class="text-[#1F1F1F]">
                        <%= brand.name %>
                    </span>
                </div>

                <!-- HEADER -->
                <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
                    <div class="flex items-center gap-4">
                        <!-- Brand Logo -->
                        <% const logoDisplayUrl = getCroppedBrandLogoUrl(brand); %>
                        <div class="w-20 h-20 rounded-lg bg-cover bg-center flex-shrink-0 <%= brand.logoUrl ? '' : 'bg-[#D3CEEA]' %>"
                            style="<%= brand.logoUrl ? " background-image:url('" + logoDisplayUrl + "')" : '' %>"></div>
                        <div>
                            <h1 class="text-[32px] font-bold text-[#1F1F1F]">
                                <%= brand.name %>
                            </h1>
                            <p class="text-sm <%= brand.isActive ? 'text-[#53a145]' : 'text-red-600' %>">
                                <%= brand.isActive ? 'Active' : 'Inactive' %>
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-3 flex-wrap">
                        <a href="/admin/brands/<%= brand._id %>/edit"
                            class="flex items-center h-10 px-4 rounded-lg bg-[#FFFFFF] font-medium text-[#1F1F1F] hover:bg-[#D3CEEA] transition-colors">
                            Edit Brand
                        </a>

                        <form method="POST" action="/admin/brands/<%= brand._id %>/toggle-status?_method=PATCH">
                            <button
                                class="h-10 px-4 rounded-lg font-medium transition-colors
                                <%= brand.isActive ? 'bg-[#ffecec] text-red-600 hover:bg-[#ffdddd]' : 'bg-[#e8f4e6] hover:bg-[#d8e4d6]' %>">
                                <%= brand.isActive ? 'Deactivate' : 'Activate' %>
                            </button>
                        </form>

                        <button type="button" onclick="confirmBrandDelete('<%= brand._id %>')"
                            class="h-10 px-4 rounded-lg bg-[#ffecec] text-red-600 font-medium hover:bg-[#ffdddd] transition-colors">
                            Delete
                        </button>
                        <!-- Hidden Form -->
                        <form id="delete-form-<%= brand._id %>" method="POST"
                            action="/admin/brands/<%= brand._id %>/delete" style="display:none;"></form>
                    </div>
                </div>

                <!-- BRAND DETAILS -->
                <div class="bg-[#D3CEEA] rounded-lg p-6 mb-6">
                    <h2 class="text-lg font-bold text-[#1F1F1F] mb-4">Brand Information</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-[#685BCB] mb-1">Website</p>
                            <p class="text-[#1F1F1F]">
                                <%= brand.website || '-' %>
                            </p>
                        </div>
                        <div>
                            <p class="text-sm text-[#685BCB] mb-1">Contact Email</p>
                            <p class="text-[#1F1F1F]">
                                <%= brand.contactEmail || '-' %>
                            </p>
                        </div>
                        <div class="md:col-span-2">
                            <p class="text-sm text-[#685BCB] mb-1">Description</p>
                            <p class="text-[#1F1F1F]">
                                <%= brand.description || '-' %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- METRICS -->
                <h2 class="text-lg font-bold text-[#1F1F1F] mb-4">Key Metrics</h2>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                    <div class="bg-[#D3CEEA] p-4 rounded-lg">
                        <p class="text-sm text-[#685BCB] mb-1">Total Products</p>
                        <p class="text-2xl font-bold text-[#1F1F1F]">
                            <%= (metrics && metrics.totalProducts) || brand.productCount || 0 %>
                        </p>
                    </div>

                    <% if (locals.metrics && metrics.totalSales) { %>
                        <div class="bg-[#D3CEEA] p-4 rounded-lg">
                            <p class="text-sm text-[#685BCB] mb-1">Total Sales</p>
                            <p class="text-2xl font-bold text-[#1F1F1F]">₹<%= metrics.totalSales.toLocaleString() %>
                            </p>
                        </div>
                        <div class="bg-[#D3CEEA] p-4 rounded-lg">
                            <p class="text-sm text-[#685BCB] mb-1">Avg. Rating</p>
                            <p class="text-2xl font-bold text-[#1F1F1F]">
                                <%= metrics.avgRating %> <span class="text-sm text-[#685BCB]">/ 5.0</span>
                            </p>
                        </div>
                        <div class="bg-[#D3CEEA] p-4 rounded-lg">
                            <p class="text-sm text-[#685BCB] mb-1">Active Promos</p>
                            <p class="text-2xl font-bold text-[#1F1F1F]">
                                <%= metrics.activePromos %>
                            </p>
                        </div>
                        <% } else { %>
                            <div
                                class="bg-gray-50 p-4 rounded-lg border border-dashed border-gray-300 flex items-center justify-center col-span-1 md:col-span-3">
                                <p class="text-sm text-gray-500">Sales and rating data will appear here once available.
                                </p>
                            </div>
                            <% } %>
                </div>

                <!-- PRODUCTS TABLE -->
                <h2 class="text-lg font-bold text-[#1F1F1F] mb-4">Products</h2>
                <div class="overflow-hidden rounded-lg border border-[#BCA6DB]">
                    <table class="w-full">
                        <thead class="bg-[#D3CEEA]">
                            <tr>
                                <th class="p-3 text-left text-sm font-medium text-[#685BCB]">Product</th>
                                <th class="p-3 text-left text-sm font-medium text-[#685BCB]">SKU</th>
                                <th class="p-3 text-left text-sm font-medium text-[#685BCB]">Price</th>
                                <th class="p-3 text-left text-sm font-medium text-[#685BCB]">Stock</th>
                                <th class="p-3 text-left text-sm font-medium text-[#685BCB]">Status</th>
                                <th class="p-3 text-left text-sm font-medium text-[#685BCB]">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (products.length===0) { %>
                                <tr>
                                    <td colspan="6" class="text-center py-8 text-gray-500">No products found for this
                                        brand.</td>
                                </tr>
                                <% } else { %>
                                    <% products.forEach(p=> { %>
                                        <tr class="border-t border-[#BCA6DB]">
                                            <td class="p-3 text-[#1F1F1F]">
                                                <%= p.name %>
                                            </td>
                                            <td class="p-3 text-[#685BCB]">
                                                <%= p.sku %>
                                            </td>
                                            <td class="p-3 text-[#1F1F1F]">₹<%= p.price %>
                                            </td>
                                            <td class="p-3 text-[#685BCB]">
                                                <%= p.stock %>
                                            </td>
                                            <td class="p-3">
                                                <span
                                                    class="px-2 py-1 rounded-lg text-xs font-medium <%= p.isActive ? 'bg-[#e6f4ea] text-[#1e7e34]' : 'bg-gray-100 text-gray-600' %>">
                                                    <%= p.isActive ? 'Active' : 'Inactive' %>
                                                </span>
                                            </td>
                                            <td class="p-3">
                                                <a href="/admin/products/<%= p._id %>"
                                                    class="text-[#53a145] hover:underline">View</a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
</body>

</html>
