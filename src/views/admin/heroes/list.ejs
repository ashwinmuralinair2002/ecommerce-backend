<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900" />
    <title>Admin · Hero Management</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%
        const currentFilters = filters || {};
        const currentType = currentFilters.type || '';
        const currentPlacement = currentFilters.placement || '';
        const currentRefId = currentFilters.refId || '';
        const currentStatus = currentFilters.isActive || '';
        const currentSearch = currentFilters.search || '';
        const refOptions = refs || { brands: [], categories: [], products: [] };
        const buildPageUrl = (pageNumber) => {
            const params = new URLSearchParams();
            if (currentType) params.set('type', currentType);
            if (currentPlacement) params.set('placement', currentPlacement);
            if (currentRefId) params.set('refId', currentRefId);
            if (currentStatus) params.set('isActive', currentStatus);
            if (currentSearch) params.set('search', currentSearch);
            params.set('page', String(pageNumber));
            return `/admin/heroes?${params.toString()}`;
        };
        const getEffectivePlacements = (hero) => {
            const rawPlacements = Array.isArray(hero && hero.placements)
                ? hero.placements.map((placement) => String(placement || '').trim().toLowerCase()).filter(Boolean)
                : [];
            const validPlacements = [...new Set(rawPlacements)].filter((placement) => ['home', 'brand', 'category'].includes(placement));

            if (validPlacements.length > 0) return validPlacements;
            if (hero && hero.type === 'brand') return ['brand'];
            if (hero && hero.type === 'category') return ['category'];
            return ['home'];
        };
        const formatPlacementLabel = (placement) => placement.charAt(0).toUpperCase() + placement.slice(1);
    %>
    <div class="min-h-screen flex flex-col bg-white" style='font-family: Inter, "Noto Sans", sans-serif;'>
        <%- include("../../partials/admin/navbar") %>

        <main class="flex flex-1 bg-white">
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../../partials/admin/sidebar', { page: 'heroes' }) %>
            </aside>

            <section class="flex-1 p-6 md:p-8">
                <div class="admin-page-container max-w-[1400px] mx-auto">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h1 class="text-3xl font-bold text-[#1F1F1F]">Hero Management</h1>
                            <p class="text-sm text-[#685BCB]">Manage homepage hero banner assets (backend only)</p>
                        </div>
                        <a href="/admin/heroes/add"
                            class="px-4 py-2 rounded-lg bg-[#685BCB] text-white font-bold hover:bg-[#5a4dc0] transition-colors">
                            Add Hero Banner
                        </a>
                    </div>

                    <% if (error) { %>
                        <div class="mb-4 p-3 rounded-xl text-sm font-medium bg-red-100 text-red-800"><%= error %></div>
                    <% } %>

                    <% if (success) { %>
                        <div class="mb-4 p-3 rounded-xl text-sm font-medium bg-emerald-100 text-emerald-800"><%= success %></div>
                    <% } %>

                    <% if (activeCount >= 10) { %>
                        <div class="mb-4 p-3 rounded-xl text-sm font-medium bg-amber-100 text-amber-900 border border-amber-300">
                            <%= maxActiveError %>
                        </div>
                    <% } %>

                    <form id="heroFiltersForm" method="GET" action="/admin/heroes">
                        <div class="px-4 pt-1 pb-4">
                            <div class="relative">
                                <input id="searchInput" type="text" name="search" placeholder="Search banners..."
                                    value="<%= currentSearch %>" onkeydown="handleSearch(event)"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] border border-[#BCA6DB] pl-4 pr-12 text-[#1F1F1F] placeholder:text-[#685BCB] focus:outline-none focus:ring-2 focus:ring-[#685BCB]" />
                                <% if (currentSearch) { %>
                                    <button type="button" onclick="clearSearch()"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-full p-1 transition-colors"
                                        title="Clear Search">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                            viewBox="0 0 256 256">
                                            <path
                                                d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z">
                                            </path>
                                        </svg>
                                    </button>
                                <% } %>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-4 px-4 pb-4">
                            <select id="filterType" name="type" onchange="handleTypeChange(); applyFilters();"
                                class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                                <option value="">All Types</option>
                                <option value="custom" <%= currentType === 'custom' ? 'selected' : '' %>>Custom</option>
                                <option value="brand" <%= currentType === 'brand' ? 'selected' : '' %>>Brand</option>
                                <option value="category" <%= currentType === 'category' ? 'selected' : '' %>>Category</option>
                                <option value="product" <%= currentType === 'product' ? 'selected' : '' %>>Product</option>
                            </select>

                            <select id="filterPlacement" name="placement" onchange="applyFilters()"
                                class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                                <option value="">Appears In: All</option>
                                <option value="home" <%= currentPlacement === 'home' ? 'selected' : '' %>>Home</option>
                                <option value="brand" <%= currentPlacement === 'brand' ? 'selected' : '' %>>Brand</option>
                                <option value="category" <%= currentPlacement === 'category' ? 'selected' : '' %>>Category</option>
                            </select>

                            <div id="targetFilterWrap" class="min-w-[220px] <%= ['brand', 'category', 'product'].includes(currentType) ? '' : 'hidden' %>">
                                <select id="filterRefId" name="refId" onchange="applyFilters()"
                                    class="form-input w-full rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                                    <option value="">All Targets</option>
                                </select>
                            </div>

                            <select id="filterStatus" name="isActive" onchange="applyFilters()"
                                class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                                <option value="">All Statuses</option>
                                <option value="active" <%= currentStatus === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="inactive" <%= currentStatus === 'inactive' ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>
                    </form>

                    <div class="border-b border-[#BCA6DB] mx-4 mb-4"></div>

                    <div class="overflow-hidden rounded-xl border border-[#BCA6DB]">
                        <table class="w-full">
                            <thead class="bg-white border-b">
                                <tr>
                                    <th class="p-3 text-left">Image</th>
                                    <th class="p-3 text-left">Type</th>
                                    <th class="p-3 text-left">Target Name</th>
                                    <th class="p-3 text-left">Appears In</th>
                                    <th class="p-3 text-left">Order</th>
                                    <th class="p-3 text-left">Status</th>
                                    <th class="p-3 text-left">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% if (!heroes || heroes.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="p-8 text-center text-sm text-[#685BCB]">No hero banners found.</td>
                                    </tr>
                                <% } %>

                                <% (heroes || []).forEach((hero) => { %>
                                    <% const placementSummary = getEffectivePlacements(hero).map(formatPlacementLabel).join(' • '); %>
                                    <tr class="border-t border-[#BCA6DB] align-middle cursor-pointer hover:bg-gray-50"
                                        onclick="window.location.href='/admin/heroes/<%= hero._id %>'">
                                        <td class="p-3">
                                            <div class="w-28 h-16 rounded-md overflow-hidden border border-gray-200 bg-gray-100">
                                                <img src="<%= hero.image && hero.image.url ? hero.image.url : '' %>" alt="Hero preview"
                                                    class="w-full h-full object-cover">
                                            </div>
                                        </td>
                                        <td class="p-3 text-[#1F1F1F] capitalize"><%= hero.type %></td>
                                        <td class="p-3 text-[#1F1F1F] break-all"><%= hero.refId?.name || hero.refId?.title || '-' %></td>
                                        <td class="p-3 text-sm text-[#1F1F1F] whitespace-nowrap"><%= placementSummary %></td>
                                        <td class="p-3 text-[#1F1F1F]"><%= hero.order %></td>
                                        <td class="p-3">
                                            <span class="px-3 py-1 rounded-full text-xs font-semibold <%= hero.isActive ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700' %>">
                                                <%= hero.isActive ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td class="p-3 text-sm font-medium">
                                            <div class="flex items-center gap-3 text-[#685BCB]">
                                                <a href="/admin/heroes/<%= hero._id %>/edit" class="hover:underline" onclick="event.stopPropagation();">Edit</a>
                                                <form action="/admin/heroes/<%= hero._id %>/toggle?_method=PATCH" method="POST">
                                                    <button type="submit" class="hover:underline" onclick="event.stopPropagation();"><%= hero.isActive ? 'Unlist' : 'List' %></button>
                                                </form>
                                                <form id="delete-hero-<%= hero._id %>" action="/admin/heroes/<%= hero._id %>?_method=DELETE" method="POST">
                                                    <button type="button" onclick="event.stopPropagation(); confirmDeleteHero('<%= hero._id %>')" class="text-red-600 hover:underline">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% if (pagination) { %>
                        <div class="flex justify-center items-center gap-2 mt-6">
                            <% if (pagination.hasPrevPage) { %>
                                <a href="<%= buildPageUrl(pagination.currentPage - 1) %>"
                                   class="flex items-center justify-center h-10 px-4 rounded-lg bg-white text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    &laquo; Previous
                                </a>
                            <% } else { %>
                                <span class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium">
                                    &laquo; Previous
                                </span>
                            <% } %>

                            <div class="flex gap-1">
                                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                    <% if (i === pagination.currentPage) { %>
                                        <span class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#685BCB] text-white text-sm font-bold">
                                            <%= i %>
                                        </span>
                                    <% } else { %>
                                        <a href="<%= buildPageUrl(i) %>"
                                           class="flex items-center justify-center h-10 w-10 rounded-lg bg-white text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                            <%= i %>
                                        </a>
                                    <% } %>
                                <% } %>
                            </div>

                            <% if (pagination.hasNextPage) { %>
                                <a href="<%= buildPageUrl(pagination.currentPage + 1) %>"
                                   class="flex items-center justify-center h-10 px-4 rounded-lg bg-white text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    Next &raquo;
                                </a>
                            <% } else { %>
                                <span class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium">
                                    Next &raquo;
                                </span>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </section>
        </main>
    </div>

    <script>
        const heroRefs = {
            brands: <%- JSON.stringify(refOptions.brands || []) %>,
            categories: <%- JSON.stringify(refOptions.categories || []) %>,
            products: <%- JSON.stringify(refOptions.products || []) %>
        };
        const currentRefId = <%- JSON.stringify(currentRefId) %>;

        function getRefOptionsByType(type) {
            if (type === 'brand') return heroRefs.brands;
            if (type === 'category') return heroRefs.categories;
            if (type === 'product') return heroRefs.products;
            return [];
        }

        function getRefLabel(option) {
            return option.name || option.title || '';
        }

        function handleSearch(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                applyFilters();
            }
        }

        function clearSearch() {
            const searchInput = document.getElementById('searchInput');
            if (searchInput) searchInput.value = '';
            applyFilters();
        }

        function applyFilters() {
            const form = document.getElementById('heroFiltersForm');
            if (!form) return;

            const params = new URLSearchParams(new FormData(form));
            params.delete('page');

            Array.from(params.keys()).forEach((key) => {
                const value = params.get(key);
                if (!value || !String(value).trim()) {
                    params.delete(key);
                }
            });

            const queryString = params.toString();
            window.location.href = queryString ? `/admin/heroes?${queryString}` : '/admin/heroes';
        }

        function handleTypeChange() {
            const typeSelect = document.getElementById('filterType');
            const refSelect = document.getElementById('filterRefId');
            const targetFilterWrap = document.getElementById('targetFilterWrap');
            if (!typeSelect || !refSelect || !targetFilterWrap) return;

            const type = typeSelect.value;
            const options = getRefOptionsByType(type);
            const previousValue = refSelect.value;
            const selectedValue = previousValue || currentRefId;
            const placeholder =
                type === 'brand' ? 'All Brands'
                    : type === 'category' ? 'All Categories'
                        : type === 'product' ? 'All Products'
                            : 'All Targets';

            refSelect.innerHTML = '';

            const defaultOption = document.createElement('option');
            defaultOption.value = '';
            defaultOption.textContent = placeholder;
            refSelect.appendChild(defaultOption);

            options.forEach((option) => {
                const optionNode = document.createElement('option');
                optionNode.value = option._id;
                optionNode.textContent = getRefLabel(option);
                if (String(option._id) === String(selectedValue || '')) {
                    optionNode.selected = true;
                }
                refSelect.appendChild(optionNode);
            });

            if (type === 'brand' || type === 'category' || type === 'product') {
                targetFilterWrap.classList.remove('hidden');
            } else {
                refSelect.value = '';
                targetFilterWrap.classList.add('hidden');
            }
        }
        function confirmDeleteHero(heroId) {
            Swal.fire({
                title: 'Delete Hero Banner?',
                text: 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, Delete'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('delete-hero-' + heroId);
                    if (form) form.submit();
                }
            });
        }

        handleTypeChange();
    </script>
</body>

</html>
