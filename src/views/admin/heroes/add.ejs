<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" />
    <title>Admin · Add Hero Banner</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white" style='font-family: Inter, "Noto Sans", sans-serif;'>
        <%- include("../../partials/admin/navbar") %>

        <main class="flex flex-1 bg-white">
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../../partials/admin/sidebar', { page: 'heroes' }) %>
            </aside>

            <section class="flex-1 p-6 md:p-8">
                <div class="max-w-5xl">
                    <div class="flex items-center gap-2 text-sm mb-4">
                        <a href="/admin/heroes" class="text-[#685BCB] hover:underline">Hero Management</a>
                        <span class="text-gray-400">/</span>
                        <span class="text-[#1F1F1F]">Add Hero Banner</span>
                    </div>

                    <h1 class="text-[32px] font-bold text-[#1F1F1F] mb-2">Add Hero Banner</h1>
                    <p class="text-sm text-[#685BCB] mb-6">Upload fully designed 16:9 hero posters</p>

                    <% if (error) { %>
                        <div class="mb-4 p-3 rounded-xl text-sm font-medium bg-red-100 text-red-800"><%= error %></div>
                    <% } %>

                    <form action="/admin/heroes" method="POST" enctype="multipart/form-data" class="space-y-6" id="heroAddForm">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Type <span class="text-red-500">*</span></label>
                                <select id="heroType" name="type"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border border-[#BCA6DB] text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] <%= (errors && errors.type) ? 'ring-2 ring-red-400' : '' %>">
                                    <% ['product', 'category', 'brand', 'custom'].forEach((item) => { %>
                                        <option value="<%= item %>" <%= String(oldInput && oldInput.type || 'custom') === item ? 'selected' : '' %>>
                                            <%= item.charAt(0).toUpperCase() + item.slice(1) %>
                                        </option>
                                    <% }) %>
                                </select>
                                <% if (errors && errors.type) { %><p class="text-red-500 text-xs mt-1"><%= errors.type %></p><% } %>
                            </div>

                            <div class="md:col-span-2">
                                <label class="block text-sm text-[#685BCB] mb-2">Where This Banner Appears</label>
                                <div class="rounded-xl border border-[#BCA6DB] bg-[#F8F6FD] p-4">
                                    <div id="heroPlacementsGrid" class="grid grid-cols-2 md:grid-cols-3 gap-3">
                                        <% const selectedPlacements = Array.isArray(oldInput && oldInput.placements) ? oldInput.placements : []; %>
                                        <% (heroPlacements || []).forEach((placement) => { %>
                                            <label
                                                data-placement-card="<%= placement %>"
                                                class="flex items-center gap-3 rounded-lg border border-[#D8CFEE] bg-white px-4 py-3 text-sm text-[#1F1F1F] hover:border-[#685BCB] transition-colors">
                                                <input
                                                    type="checkbox"
                                                    name="placements"
                                                    data-placement-checkbox="<%= placement %>"
                                                    value="<%= placement %>"
                                                    <%= selectedPlacements.includes(placement) ? 'checked' : '' %>
                                                    class="h-4 w-4 rounded border-[#BCA6DB] text-[#685BCB] focus:ring-[#685BCB]" />
                                                <span><%= placement.charAt(0).toUpperCase() + placement.slice(1) %></span>
                                            </label>
                                        <% }) %>
                                    </div>
                                    <p id="heroPlacementHint" class="mt-3 text-xs text-[#685BCB]">Choose where this banner is allowed to appear based on its ownership type.</p>
                                    <% if (errors && errors.placements) { %><p class="text-red-500 text-xs mt-2"><%= errors.placements %></p><% } %>
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Reference (Optional)</label>
                                <select id="heroRefId" name="refId"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border border-[#BCA6DB] text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB]">
                                    <option value="">No linked reference</option>
                                </select>
                                <p id="heroRefHint" class="text-xs text-[#685BCB] mt-1">Select type to load references.</p>
                            </div>

                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Order</label>
                                <input type="number" name="order" value="<%= oldInput && oldInput.order !== undefined ? oldInput.order : 0 %>"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border border-[#BCA6DB] text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB]"
                                    placeholder="0" />
                            </div>

                            <div class="flex items-center gap-3 pt-7">
                                <input id="heroIsActive" type="checkbox" name="isActive" value="true" <%= (oldInput && (String(oldInput.isActive) === 'true' || oldInput.isActive === true)) ? 'checked' : '' %>
                                    class="h-5 w-5 rounded border-[#BCA6DB] text-[#685BCB] focus:ring-[#685BCB]" />
                                <label for="heroIsActive" class="text-sm text-[#1F1F1F]">Active</label>
                            </div>
                        </div>

                        <div class="bg-[#D3CEEA] rounded-xl p-5 border border-[#BCA6DB]">
                            <p class="text-[#1F1F1F] font-medium mb-3">Desktop Hero Banner <span class="text-red-500">*</span></p>
                            <input id="heroImageInput" type="file" name="image" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/jpg,image/png,image/webp"
                                class="block w-full text-sm text-[#1F1F1F] file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[#e8f4e6] file:text-[#1F1F1F] hover:file:bg-[#BCA6DB]" />

                            <p id="heroImageClientError" class="hidden text-red-500 text-xs mt-1"></p>
                            <% if (errors && errors.image) { %><p class="text-red-500 text-xs mt-1"><%= errors.image %></p><% } %>
                            <p id="heroResolutionHint" class="hidden text-xs mt-2 text-amber-800 bg-amber-100 border border-amber-200 rounded px-2 py-1"></p>

                            <div id="heroImagePreviewWrap" class="hidden mt-4 p-4 bg-white rounded-lg border border-gray-100 w-full md:w-2/3">
                                <div class="w-full aspect-video rounded-lg overflow-hidden bg-gray-100">
                                    <img id="heroImagePreview" src="" alt="Hero preview" class="w-full h-full object-cover">
                                </div>
                                <div class="mt-3 flex justify-end">
                                    <button type="button" id="heroImageRecropBtn"
                                        class="text-xs font-semibold px-3 py-2 rounded-lg bg-[#685BCB] text-white hover:bg-[#5a4dc0]">
                                        Re-crop 16:9
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="bg-[#D3CEEA] rounded-xl p-5 border border-[#BCA6DB]">
                            <p class="text-[#1F1F1F] font-medium mb-3">Mobile Hero Image (Optional)</p>
                            <input id="heroMobileImageInput" type="file" name="mobileImage" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/jpg,image/png,image/webp"
                                class="block w-full text-sm text-[#1F1F1F] file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[#e8f4e6] file:text-[#1F1F1F] hover:file:bg-[#BCA6DB]" />

                            <div id="heroMobileImagePreviewWrap" class="hidden mt-4 p-4 bg-white rounded-lg border border-gray-100 w-full md:w-2/3">
                                <div class="w-full aspect-[4/5] rounded-lg overflow-hidden bg-gray-100">
                                    <img id="heroMobileImagePreview" src="" alt="Mobile hero preview" class="w-full h-full object-cover">
                                </div>
                                <p class="text-xs text-[#685BCB] mt-2">Mobile hero image preview</p>
                            </div>

                            <div id="heroMobileImageRemoveWrap" class="hidden mt-6 pt-4 border-t border-[#BCA6DB]">
                                <button type="button" id="heroMobileImageRemoveBtn"
                                    class="h-10 px-4 rounded-xl bg-red-100 font-semibold text-red-700 hover:bg-red-200 transition-colors">
                                    Remove Mobile Image
                                </button>
                            </div>
                        </div>

                        <div class="flex gap-3 pt-2">
                            <button type="submit"
                                class="h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">Create Hero Banner</button>
                            <a href="/admin/heroes"
                                class="h-10 px-6 rounded-xl bg-[#FFFFFF] font-bold text-[#1F1F1F] hover:bg-[#D3CEEA] transition-colors flex items-center">Cancel</a>
                        </div>
                    </form>
                </div>
            </section>
        </main>
    </div>

    <script>
        (function () {
            const form = document.getElementById('heroAddForm');
            if (!form) return;
            const imageInput = document.getElementById('heroImageInput');
            const mobileImageInput = document.getElementById('heroMobileImageInput');
            const desktopError = document.getElementById('heroImageClientError');
            const allowedMimeTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
            const invalidTypeMessage = 'Invalid file type. Only JPG, JPEG, PNG, and WEBP images are allowed.';
            const fileTooLargeMessage = 'File too large. Maximum allowed size is 5MB.';
            const requiredDesktopMessage = 'Desktop hero banner is required.';

            function getValidationMessage(file) {
                if (!file) return '';
                if (!allowedMimeTypes.includes(file.type)) return invalidTypeMessage;
                if (file.size > 5 * 1024 * 1024) return fileTooLargeMessage;
                return '';
            }

            function showHeroUploadError(message) {
                if (!message || typeof window.showToast !== 'function') return;
                window.showToast(message, 'error');
            }

            function setDesktopImageError(message) {
                if (!desktopError) return;
                desktopError.textContent = message || '';
                desktopError.classList.toggle('hidden', !message);
            }

            if (imageInput) {
                imageInput.addEventListener('change', function () {
                    const file = imageInput.files && imageInput.files[0] ? imageInput.files[0] : null;
                    setDesktopImageError(file ? '' : requiredDesktopMessage);
                });
            }

            form.addEventListener('submit', function (event) {
                const file = imageInput && imageInput.files ? imageInput.files[0] : null;
                const mobileFile = mobileImageInput && mobileImageInput.files ? mobileImageInput.files[0] : null;
                if (!file) {
                    event.preventDefault();
                    setDesktopImageError(requiredDesktopMessage);
                    showHeroUploadError(requiredDesktopMessage);
                    if (typeof hideLoader === 'function') hideLoader();
                    return;
                }

                setDesktopImageError('');
                const validationMessage = getValidationMessage(file) || getValidationMessage(mobileFile);
                if (validationMessage) {
                    event.preventDefault();
                    showHeroUploadError(validationMessage);
                    if (typeof hideLoader === 'function') hideLoader();
                    return;
                }

                showLoader();
            });
        })();

        (function () {
            const refsData = {
                product: <%- JSON.stringify((refs && refs.products) || []) %>,
                category: <%- JSON.stringify((refs && refs.categories) || []) %>,
                brand: <%- JSON.stringify((refs && refs.brands) || []) %>,
                custom: []
            };

            const typeSelect = document.getElementById('heroType');
            const refSelect = document.getElementById('heroRefId');
            const refHint = document.getElementById('heroRefHint');
            const selectedRefId = '<%= oldInput && oldInput.refId ? oldInput.refId : "" %>';
            const placementHint = document.getElementById('heroPlacementHint');
            const placementCheckboxes = Array.from(document.querySelectorAll('[data-placement-checkbox]'));
            const placementRules = {
                product: ['home', 'brand', 'category'],
                category: ['home', 'category'],
                brand: ['home', 'brand'],
                custom: ['home']
            };
            const defaultPlacementByType = {
                product: 'home',
                category: 'category',
                brand: 'brand',
                custom: 'home'
            };
            const hasInitialPlacementSelection = placementCheckboxes.some((checkbox) => checkbox.checked);
            let hasPlacementInteraction = hasInitialPlacementSelection;

            function refLabelByType(type, item) {
                if (type === 'product') return item.title || 'Untitled Product';
                return item.name || 'Untitled';
            }

            function updatePlacementHint(type, allowedPlacements) {
                if (!placementHint) return;
                const label = allowedPlacements.map((placement) => placement.charAt(0).toUpperCase() + placement.slice(1)).join(', ');
                placementHint.textContent = `Allowed placements for ${type}: ${label}. Disabled options are not valid for this ownership type.`;
            }

            function applyPlacementConstraints(options = {}) {
                if (!typeSelect || placementCheckboxes.length === 0) return;

                const type = typeSelect.value;
                const allowedPlacements = placementRules[type] || [];
                const shouldAutoDefault = options.autoDefault === true;

                placementCheckboxes.forEach((checkbox) => {
                    const placement = checkbox.value;
                    const card = checkbox.closest('[data-placement-card]');
                    const isAllowed = allowedPlacements.includes(placement);

                    if (!isAllowed && checkbox.checked) {
                        checkbox.checked = false;
                    }

                    checkbox.disabled = !isAllowed;

                    if (card) {
                        card.classList.toggle('opacity-50', !isAllowed);
                        card.classList.toggle('cursor-not-allowed', !isAllowed);
                        card.classList.toggle('bg-gray-100', !isAllowed);
                        card.classList.toggle('text-gray-400', !isAllowed);
                        card.classList.toggle('border-gray-200', !isAllowed);
                        card.classList.toggle('hover:border-[#685BCB]', isAllowed);
                    }
                });

                const hasCheckedAllowedPlacement = placementCheckboxes.some((checkbox) => !checkbox.disabled && checkbox.checked);
                if (shouldAutoDefault && !hasPlacementInteraction && !hasCheckedAllowedPlacement) {
                    const defaultPlacement = defaultPlacementByType[type];
                    const defaultCheckbox = placementCheckboxes.find((checkbox) => checkbox.value === defaultPlacement && !checkbox.disabled);
                    if (defaultCheckbox) {
                        defaultCheckbox.checked = true;
                    }
                }

                updatePlacementHint(type, allowedPlacements);
            }

            function populateRefOptions() {
                if (!typeSelect || !refSelect) return;

                const type = typeSelect.value;
                const options = Array.isArray(refsData[type]) ? refsData[type] : [];

                refSelect.innerHTML = '';
                const empty = document.createElement('option');
                empty.value = '';
                empty.textContent = type === 'custom' ? 'Custom type has no reference' : 'No linked reference';
                refSelect.appendChild(empty);

                options.forEach((item) => {
                    const option = document.createElement('option');
                    option.value = item._id;
                    option.textContent = refLabelByType(type, item);
                    refSelect.appendChild(option);
                });

                if (selectedRefId) {
                    const exists = options.some((item) => String(item._id) === String(selectedRefId));
                    refSelect.value = exists ? selectedRefId : '';
                }

                if (type === 'custom') {
                    refSelect.value = '';
                    refSelect.setAttribute('disabled', 'disabled');
                    refHint.textContent = 'Custom banners do not require a reference.';
                } else {
                    refSelect.removeAttribute('disabled');
                    refHint.textContent = options.length > 0
                        ? `Loaded ${options.length} reference option(s).`
                        : 'No references found for this type.';
                }
            }

            placementCheckboxes.forEach((checkbox) => {
                checkbox.addEventListener('change', () => {
                    hasPlacementInteraction = true;
                });
            });

            typeSelect.addEventListener('change', () => {
                populateRefOptions();
                applyPlacementConstraints({ autoDefault: true });
            });
            populateRefOptions();
            applyPlacementConstraints({ autoDefault: true });
        })();

        (function () {
            const imageInput = document.getElementById('heroImageInput');
            const previewWrap = document.getElementById('heroImagePreviewWrap');
            const previewImg = document.getElementById('heroImagePreview');
            const recropBtn = document.getElementById('heroImageRecropBtn');
            const resolutionHint = document.getElementById('heroResolutionHint');
            const allowedMimeTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
            const invalidTypeMessage = 'Invalid file type. Only JPG, JPEG, PNG, and WEBP images are allowed.';
            const fileTooLargeMessage = 'File too large. Maximum allowed size is 5MB.';

            if (!imageInput || !previewWrap || !previewImg || !recropBtn || !resolutionHint || typeof Cropper === 'undefined') return;

            let cropper = null;
            let currentSource = '';
            let latestObjectUrl = null;
            let currentFileType = 'image/png';

            const cropModal = document.createElement('div');
            cropModal.id = 'heroCropModal';
            cropModal.className = 'fixed inset-0 bg-black/60 hidden items-center justify-center z-50 p-4';
            cropModal.innerHTML = `
                <div class="bg-white rounded-xl p-4 w-full max-w-4xl">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-lg font-bold text-[#1F1F1F]">Crop Hero Image (16:9)</h2>
                        <button type="button" id="closeHeroCropModal" class="text-sm font-semibold text-[#685BCB]">Close</button>
                    </div>
                    <div class="bg-gray-100 rounded-lg overflow-hidden max-h-[72vh]">
                        <img id="heroCropperImage" src="" alt="Crop preview" class="max-w-full" />
                    </div>
                    <div class="flex justify-end gap-3 mt-4">
                        <button type="button" id="saveHeroCropBtn"
                            class="h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">
                            Save Crop
                        </button>
                    </div>
                </div>
            `;
            document.body.appendChild(cropModal);

            const cropperImage = cropModal.querySelector('#heroCropperImage');
            const closeBtn = cropModal.querySelector('#closeHeroCropModal');
            const saveBtn = cropModal.querySelector('#saveHeroCropBtn');

            function closeModal() {
                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }
                cropModal.classList.add('hidden');
                cropModal.classList.remove('flex');
            }

            function setPreview(src) {
                currentSource = src || '';
                previewImg.src = currentSource;
                if (currentSource) {
                    previewWrap.classList.remove('hidden');
                } else {
                    previewWrap.classList.add('hidden');
                }
            }

            function getValidationMessage(file) {
                if (!file) return '';
                if (!allowedMimeTypes.includes(file.type)) return invalidTypeMessage;
                if (file.size > 5 * 1024 * 1024) return fileTooLargeMessage;
                return '';
            }

            function showHeroUploadError(message) {
                if (!message || typeof window.showToast !== 'function') return;
                window.showToast(message, 'error');
            }

            function openModal(src) {
                if (!src) return;
                cropModal.classList.remove('hidden');
                cropModal.classList.add('flex');
                cropperImage.crossOrigin = 'anonymous';
                cropperImage.src = src;
                cropperImage.onload = function () {
                    if (cropper) cropper.destroy();
                    cropper = new Cropper(cropperImage, {
                        aspectRatio: 16 / 9,
                        viewMode: 1,
                        dragMode: 'move',
                        movable: true,
                        zoomable: true,
                        scalable: false,
                        cropBoxResizable: false,
                        autoCropArea: 1
                    });
                };
            }

            function setInputFile(blob, filename) {
                const file = new File([blob], filename, {
                    type: blob.type || currentFileType || 'image/png',
                    lastModified: Date.now()
                });
                const validationMessage = getValidationMessage(file);
                if (validationMessage) {
                    showHeroUploadError(validationMessage);
                    imageInput.value = '';
                    return false;
                }
                const dt = new DataTransfer();
                dt.items.add(file);
                imageInput.files = dt.files;
                return true;
            }

            function validateResolution(src) {
                const img = new Image();
                img.onload = function () {
                    if (img.naturalWidth < 1600 || img.naturalHeight < 900) {
                        resolutionHint.textContent = 'Recommended minimum resolution is 1600x900 for best quality.';
                        resolutionHint.classList.remove('hidden');
                    } else {
                        resolutionHint.classList.add('hidden');
                        resolutionHint.textContent = '';
                    }
                };
                img.src = src;
            }

            imageInput.addEventListener('change', function () {
                const file = imageInput.files && imageInput.files[0];
                if (!file) {
                    setPreview('');
                    return;
                }

                const validationMessage = getValidationMessage(file);
                if (validationMessage) {
                    showHeroUploadError(validationMessage);
                    imageInput.value = '';
                    setPreview('');
                    return;
                }

                currentFileType = file.type || 'image/png';

                const reader = new FileReader();
                reader.onload = function (e) {
                    const src = e.target && e.target.result ? String(e.target.result) : '';
                    if (!src) return;
                    validateResolution(src);
                    setPreview(src);
                    openModal(src);
                };
                reader.readAsDataURL(file);
            });

            recropBtn.addEventListener('click', function () {
                if (!currentSource) return;
                openModal(currentSource);
            });

            closeBtn.addEventListener('click', closeModal);
            cropModal.addEventListener('click', function (e) {
                if (e.target === cropModal) closeModal();
            });

            saveBtn.addEventListener('click', function () {
                if (!cropper) return;
                const canvas = cropper.getCroppedCanvas({
                    width: 1600,
                    height: 900,
                    imageSmoothingQuality: 'high'
                });

                if (!canvas) return;
                canvas.toBlob(function (blob) {
                    if (!blob) return;

                    if (latestObjectUrl) {
                        URL.revokeObjectURL(latestObjectUrl);
                    }
                    if (!setInputFile(blob, `hero-banner-${Date.now()}.${(currentFileType || 'image/png').split('/')[1] || 'png'}`)) {
                        return;
                    }

                    latestObjectUrl = URL.createObjectURL(blob);
                    setPreview(latestObjectUrl);
                    closeModal();
                }, currentFileType || 'image/png', 0.92);
            });
        })();

        (function () {
            const imageInput = document.getElementById('heroMobileImageInput');
            const previewWrap = document.getElementById('heroMobileImagePreviewWrap');
            const previewImg = document.getElementById('heroMobileImagePreview');
            const removeWrap = document.getElementById('heroMobileImageRemoveWrap');
            const removeBtn = document.getElementById('heroMobileImageRemoveBtn');
            const allowedMimeTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
            const invalidTypeMessage = 'Invalid file type. Only JPG, JPEG, PNG, and WEBP images are allowed.';
            const fileTooLargeMessage = 'File too large. Maximum allowed size is 5MB.';

            if (!imageInput || !previewWrap || !previewImg || !removeWrap || !removeBtn) return;

            function getValidationMessage(file) {
                if (!file) return '';
                if (!allowedMimeTypes.includes(file.type)) return invalidTypeMessage;
                if (file.size > 5 * 1024 * 1024) return fileTooLargeMessage;
                return '';
            }

            function showHeroUploadError(message) {
                if (!message || typeof window.showToast !== 'function') return;
                window.showToast(message, 'error');
            }

            function setPreview(src) {
                previewImg.src = src || '';
                if (src) {
                    previewWrap.classList.remove('hidden');
                    removeWrap.classList.remove('hidden');
                } else {
                    previewWrap.classList.add('hidden');
                    removeWrap.classList.add('hidden');
                }
            }

            function clearMobileImageSelection() {
                imageInput.value = '';
                setPreview('');
            }

            imageInput.addEventListener('change', function () {
                const file = imageInput.files && imageInput.files[0];
                if (!file) {
                    setPreview('');
                    return;
                }

                const validationMessage = getValidationMessage(file);
                if (validationMessage) {
                    showHeroUploadError(validationMessage);
                    imageInput.value = '';
                    setPreview('');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    const src = e.target && e.target.result ? String(e.target.result) : '';
                    setPreview(src);
                };
                reader.readAsDataURL(file);
            });

            removeBtn.addEventListener('click', function () {
                Swal.fire({
                    title: 'Remove Mobile Hero Image?',
                    text: 'This will clear the selected mobile hero image before creating the hero banner.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, Remove',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (!result.isConfirmed) return;
                    clearMobileImageSelection();
                });
            });
        })();
    </script>
    <script src="/js/utils.js"></script>
    <script src="/js/loading.util.js"></script>
    <script>
        window.addEventListener('pageshow', function () {
            hideLoader();
        });

        window.addEventListener('DOMContentLoaded', function () {
            const serverError = <%- JSON.stringify(error || (errors && errors.image) || '') %>;
            if (serverError && typeof window.showToast === 'function') {
                window.showToast(serverError, 'error');
            }
        });
    </script>
</body>

</html>
