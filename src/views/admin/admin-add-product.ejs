    <!-- Scripts -->
    <script>
        // ========== Variant Management ==========
        const hasVariantsToggle = document.getElementById('hasVariantsToggle');
        const variantBuilder = document.getElementById('variantBuilder');
        const variantList = document.getElementById('variantList');
        const variantError = document.getElementById('variantError');
        const addVariantBtn = document.getElementById('addVariantBtn');
        let variants = [];

        function normalizeHex(value) {
            const raw = String(value || '').trim();
            if (/^#?[0-9a-fA-F]{6}$/.test(raw)) {
                return raw.startsWith('#') ? raw.toUpperCase() : `#${raw.toUpperCase()}`;
            }
            return '';
        }

        function rgbToHex(rgb) {
            const match = String(rgb).match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)/i);
            if (!match) return '';
            const parts = match.slice(1, 4).map((n) => Number(n).toString(16).padStart(2, '0').toUpperCase());
            return `#${parts.join('')}`;
        }

        function colorNameToHex(name) {
            const probe = document.createElement('span');
            probe.style.color = '';
            probe.style.color = String(name || '').trim();
            if (!probe.style.color) return '';
            document.body.appendChild(probe);
            const computed = getComputedStyle(probe).color;
            document.body.removeChild(probe);
            return rgbToHex(computed);
        }

        function resolveColor(input) {
            const hex = normalizeHex(input);
            if (hex) return { colorCode: hex, colorName: '' };

            const fromName = colorNameToHex(input);
            if (fromName) return { colorCode: fromName, colorName: String(input).trim() };

            return null;
        }

        function addVariant() {
            variants.push({ colorInput: '', colorCode: '', colorName: '', files: [] });
            renderVariants();
        }

        function removeVariant(index) {
            variants.splice(index, 1);
            renderVariants();
        }

        function renderVariants() {
            variantList.innerHTML = '';
            variants.forEach((variant, index) => {
                const wrapper = document.createElement('div');
                wrapper.className = 'border border-[#BCA6DB] rounded-xl p-4 bg-white';
                wrapper.innerHTML = `
                    <div class="flex flex-wrap items-center gap-3">
                        <input type="text" data-role="color-input" data-index="${index}" value="${variant.colorInput || ''}"
                            placeholder="HEX or colour name (e.g., #000000 / royalblue)"
                            class="h-11 flex-1 min-w-[240px] rounded-xl border border-[#BCA6DB] px-3 text-sm text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB]">
                        <span data-role="color-preview" class="inline-block w-8 h-8 rounded-full border border-[#BCA6DB]" style="background:${variant.colorCode || '#FFFFFF'}"></span>
                        <button type="button" data-role="remove-variant" data-index="${index}"
                            class="h-10 px-3 rounded-lg bg-[#ffecec] text-red-600 text-sm font-bold hover:bg-[#ffdddd]">Remove</button>
                    </div>
                    <p data-role="color-meta" class="text-xs text-[#685BCB] mt-2">${variant.colorCode ? `Normalized: ${variant.colorCode}` : ''}</p>
                    <div class="mt-3">
                        <input type="file" data-role="variant-files" data-index="${index}" multiple accept="image/jpeg,image/png,image/webp"
                            class="block w-full text-sm text-[#1F1F1F]">
                        <p class="text-xs text-[#685BCB] mt-1">Selected: ${variant.files.length} image(s)</p>
                    </div>
                `;
                variantList.appendChild(wrapper);
            });

            variantList.querySelectorAll('[data-role="color-input"]').forEach((input) => {
                input.addEventListener('input', function () {
                    const idx = Number(this.dataset.index);
                    variants[idx].colorInput = this.value;
                    const resolved = resolveColor(this.value);
                    variants[idx].colorCode = resolved ? resolved.colorCode : '';
                    variants[idx].colorName = resolved ? resolved.colorName : '';
                    renderVariants();
                });
            });

            variantList.querySelectorAll('[data-role="variant-files"]').forEach((input) => {
                input.addEventListener('change', function () {
                    const idx = Number(this.dataset.index);
                    variants[idx].files = Array.from(this.files || []).filter((f) =>
                        ['image/jpeg', 'image/png', 'image/webp'].includes(f.type)
                    );
                    renderVariants();
                });
            });

            variantList.querySelectorAll('[data-role="remove-variant"]').forEach((btn) => {
                btn.addEventListener('click', () => removeVariant(Number(btn.dataset.index)));
            });
        }

        function validateVariants() {
            if (!variants.length) {
                variantError.textContent = 'Add at least one colour variant.';
                variantError.classList.add('visible');
                return false;
            }

            for (const variant of variants) {
                if (!variant.colorCode) {
                    variantError.textContent = 'Each variant needs a valid HEX or CSS colour name.';
                    variantError.classList.add('visible');
                    return false;
                }
                if (variant.files.length < 3 || variant.files.length > 10) {
                    variantError.textContent = 'Each variant must contain 3 to 10 images.';
                    variantError.classList.add('visible');
                    return false;
                }
            }

            variantError.classList.remove('visible');
            return true;
        }

        hasVariantsToggle.checked = true;
        hasVariantsToggle.disabled = true;
        variantBuilder.classList.remove('hidden');
        if (variants.length === 0) addVariant();
        addVariantBtn.addEventListener('click', addVariant);

        // ========== Connection Type Toggle ==========
        document.getElementById('connectionType').addEventListener('change', function () {
            const wiredSpecs = document.getElementById('wiredSpecs');
            const wirelessSpecs = document.getElementById('wirelessSpecs');
            wiredSpecs.classList.add('hidden');
            wirelessSpecs.classList.add('hidden');
            if (this.value === 'Wired') {
                wiredSpecs.classList.remove('hidden');
            } else if (this.value === 'Wireless') {
                wirelessSpecs.classList.remove('hidden');
            }
        });

        // ========== Validation Helpers ==========
        function showError(inputEl, errorEl) {
            inputEl.classList.add('input-error');
            errorEl.classList.add('visible');
        }
        function clearError(inputEl, errorEl) {
            inputEl.classList.remove('input-error');
            errorEl.classList.remove('visible');
        }

        function validatePattern(id, errorId) {
            const input = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!input || !error) return true;
            if (input.value.trim() === '') {
                if (input.hasAttribute('required')) {
                    showError(input, error);
                    error.textContent = 'This field is required';
                    return false;
                }
                clearError(input, error);
                return true;
            }
            const pattern = input.getAttribute('pattern');
            if (pattern && !new RegExp(pattern).test(input.value.trim())) {
                showError(input, error);
                return false;
            }
            clearError(input, error);
            return true;
        }

        function validateNumber(id, errorId, isRequired) {
            const input = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!input || !error) return true;
            const val = input.value.trim();
            if (val === '') {
                if (isRequired) {
                    showError(input, error);
                    error.textContent = 'This field is required';
                    return false;
                }
                clearError(input, error);
                return true;
            }
            const num = parseFloat(val);
            if (isNaN(num) || num < 0) {
                showError(input, error);
                return false;
            }
            const max = input.getAttribute('max');
            if (max && num > parseFloat(max)) {
                showError(input, error);
                return false;
            }
            clearError(input, error);
            return true;
        }

        function validateSelect(id, errorId) {
            const select = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!select || !error) return true;
            if (!select.value) {
                showError(select, error);
                return false;
            }
            clearError(select, error);
            return true;
        }

        // Real-time validation on blur
        document.querySelectorAll('#addProductForm input, #addProductForm select').forEach(function (el) {
            el.addEventListener('blur', function () {
                const errorEl = document.getElementById(el.id + 'Error');
                if (!errorEl) return;
                if (el.type === 'number') {
                    validateNumber(el.id, el.id + 'Error', el.hasAttribute('required'));
                } else if (el.tagName === 'SELECT') {
                    if (el.hasAttribute('required')) validateSelect(el.id, el.id + 'Error');
                } else {
                    validatePattern(el.id, el.id + 'Error');
                }
            });
        });

        // ========== Form Submission ==========
        document.getElementById('addProductForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            let valid = true;

            // Required fields
            if (!validatePattern('productTitle', 'productTitleError')) valid = false;
            if (!validatePattern('productSku', 'productSkuError')) valid = false;
            if (!validateSelect('brandSelect', 'brandSelectError')) valid = false;
            if (!validateSelect('connectionType', 'connectionTypeError')) valid = false;
            if (!validateSelect('categorySelect', 'categorySelectError')) valid = false;
            if (!validateNumber('productPrice', 'productPriceError', true)) valid = false;
            if (!validateNumber('stockCount', 'stockCountError', true)) valid = false;

            // Optional numeric fields
            if (!validateNumber('originalPrice', 'originalPriceError', false)) valid = false;
            if (!validateNumber('discountPercentage', 'discountPercentageError', false)) valid = false;
            if (!validateNumber('reservedCount', 'reservedCountError', false)) valid = false;
            if (!validateNumber('reorderThreshold', 'reorderThresholdError', false)) valid = false;
            if (!validateNumber('shippingLength', 'shippingLengthError', false)) valid = false;
            if (!validateNumber('shippingWidth', 'shippingWidthError', false)) valid = false;
            if (!validateNumber('shippingHeight', 'shippingHeightError', false)) valid = false;
            if (!validateNumber('shippingWeight', 'shippingWeightError', false)) valid = false;

            // Conditional specs
            const connType = document.getElementById('connectionType').value;
            if (connType === 'Wired') {
                if (!validateNumber('cableLength', 'cableLengthError', false)) valid = false;
                if (!validatePattern('connectorType', 'connectorTypeError')) valid = false;
                if (!validateNumber('impedance', 'impedanceError', false)) valid = false;
                if (!validateNumber('driverSize', 'driverSizeError', false)) valid = false;
            } else if (connType === 'Wireless') {
                if (!validateNumber('bluetoothVersion', 'bluetoothVersionError', false)) valid = false;
                if (!validateNumber('batteryLife', 'batteryLifeError', false)) valid = false;
                if (!validateNumber('chargingTime', 'chargingTimeError', false)) valid = false;
                if (!validateNumber('wirelessRange', 'wirelessRangeError', false)) valid = false;
            }

            if (!validateVariants()) valid = false;

            if (!valid) {
                const firstError = document.querySelector('.field-error.visible');
                if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            // Build FormData
            const formData = new FormData();
            const form = this;

            // Text/select fields
            const fieldNames = ['title', 'sku', 'brand', 'connectionType', 'category', 'shortDescription',
                'price', 'originalPrice', 'discountPercentage', 'stockCount', 'reservedCount', 'reorderThreshold',
                'cableLength', 'connectorType', 'impedance', 'driverSize',
                'bluetoothVersion', 'batteryLife', 'chargingTime', 'wirelessRange', 'noiseCancellation',
                'warrantyDuration', 'warrantyProvider',
                'length', 'width', 'height', 'weight', 'metaTitle', 'metaDescription',
                'formFactor', 'earpieceShape', 'impedanceRange', 'sensitivityRange', 'hasMicrophone', 'batteryChargingTime'];

            fieldNames.forEach(function (name) {
                const el = form.querySelector('[name="' + name + '"]');
                if (el) formData.append(name, el.value);
            });

            // Badges (multiple checkboxes)
            document.querySelectorAll('[name="badges"]:checked').forEach(function (cb) {
                formData.append('badges', cb.value);
            });
            ['noiseControlTypes', 'controlMethods', 'cableFeatures', 'smartFeatures', 'compatibleDevices', 'materials', 'includedComponents', 'audioDriverTypes']
                .forEach((name) => {
                    document.querySelectorAll(`[name="${name}"]:checked`).forEach((cb) => {
                        formData.append(name, cb.value);
                    });
                });

            formData.append('hasVariants', 'true');
            const variantPayload = variants.map((variant) => ({
                colorName: variant.colorName || '',
                colorCode: variant.colorCode || '',
                existingImages: []
            }));
            formData.append('variantPayload', JSON.stringify(variantPayload));
            variants.forEach((variant, index) => {
                variant.files.forEach((file) => {
                    formData.append(`variantImages_${index}`, file);
                });
            });

            // Submit
            const submitBtn = document.getElementById('createProductBtn');
            submitBtn.disabled = true;
            submitBtn.querySelector('span').textContent = 'Creating...';

            try {
                const res = await fetch('/admin/products', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/admin/products/' + data.productId;
                } else {
                    alert(data.message || 'Failed to create product');
                    submitBtn.disabled = false;
                    submitBtn.querySelector('span').textContent = 'Create Product';
                }
            } catch (err) {
                alert('Error creating product. Please try again.');
                submitBtn.disabled = false;
                submitBtn.querySelector('span').textContent = 'Create Product';
            }
        });
    </script>
</body>

</html>
