    <!-- Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        (function buildAdminAddProductLayout() {
            const form = document.getElementById('addProductForm');
            if (!form) return;

            const submitBtn = document.getElementById('createProductBtn');
            const actionRow = submitBtn ? submitBtn.closest('.flex.justify-stretch') : null;
            if (!actionRow) return;

            const nodes = Array.from(form.children).filter((el) => el !== actionRow);
            const takeByHeading = (headingText) => {
                const heading = nodes.find((el) =>
                    el.tagName === 'H3' && el.textContent.trim().toLowerCase().startsWith(headingText.toLowerCase())
                );
                if (!heading) return [];
                const out = [heading];
                let cursor = heading.nextElementSibling;
                while (cursor && cursor !== actionRow && cursor.tagName !== 'H3' && cursor.tagName !== 'DETAILS') {
                    out.push(cursor);
                    cursor = cursor.nextElementSibling;
                }
                return out;
            };
            const takeDetailByHeading = (headingText) =>
                nodes.find((el) =>
                    el.tagName === 'DETAILS' &&
                    el.querySelector('summary') &&
                    el.querySelector('summary').textContent.toLowerCase().includes(headingText.toLowerCase())
                );
            const pickByIds = (ids) => nodes.filter((el) => ids.some((id) => el.querySelector && el.querySelector(`#${id}`)));

            const basicNodes = pickByIds(['productTitle', 'productSku', 'brandSelect', 'connectionType', 'categorySelect', 'shortDescription']);
            const pricingNodes = takeByHeading('Pricing').filter((el) => !/^\s*pricing\s*$/i.test(el.textContent.trim()));
            const inventoryNodes = takeByHeading('Inventory').filter((el) => !/^\s*inventory\s*$/i.test(el.textContent.trim()));
            const variantsNodes = takeByHeading('Variants').filter((el) => !/^\s*variants\s*$/i.test(el.textContent.trim()));
            const warrantyNodes = takeByHeading('Warranty').filter((el) => !/^\s*warranty\s*$/i.test(el.textContent.trim()));
            const badgesNodes = takeByHeading('Badges').filter((el) => !/^\s*badges\s*$/i.test(el.textContent.trim()));
            const shippingNodes = takeByHeading('Shipping').filter((el) => !/shipping/i.test(el.textContent.trim()));
            const seoNodes = takeByHeading('SEO').filter((el) => !/^\s*seo/i.test(el.textContent.trim()));
            const audioDetail = takeDetailByHeading('Audio Specs');
            const buildDetail = takeDetailByHeading('Build & Materials');
            const smartDetail = takeDetailByHeading('Smart Features');
            const compatDetail = takeDetailByHeading('Compatibility');
            const packageDetail = takeDetailByHeading('Package Contents');

            const layout = document.createElement('div');
            layout.className = 'admin-layout';
            const main = document.createElement('div');
            main.className = 'admin-main';
            const side = document.createElement('div');
            side.className = 'admin-side';
            layout.append(main, side);

            const makeCard = (title) => {
                const card = document.createElement('section');
                card.className = 'admin-card';
                const h = document.createElement('h3');
                h.textContent = title;
                const body = document.createElement('div');
                card.append(h, body);
                return { card, body };
            };

            const basic = makeCard('1. Basic Info');
            const basicGrid = document.createElement('div');
            basicGrid.className = 'admin-grid-2';
            basicNodes.forEach((n) => basicGrid.appendChild(n));
            basic.body.appendChild(basicGrid);
            main.appendChild(basic.card);

            const commerce = makeCard('2. Pricing & Inventory');
            const commerceGrid = document.createElement('div');
            commerceGrid.className = 'admin-grid-2';
            [...pricingNodes, ...inventoryNodes].forEach((n) => commerceGrid.appendChild(n));
            commerce.body.appendChild(commerceGrid);
            main.appendChild(commerce.card);

            const variants = makeCard('3. Variants');
            variantsNodes.forEach((n) => variants.body.appendChild(n));
            main.appendChild(variants.card);

            const audio = makeCard('4. Audio Specs');
            if (audioDetail) {
                const audioContent = audioDetail.querySelector('.mt-4') || audioDetail;
                audioContent.classList.add('space-y-4');
                const wiredSpecs = document.getElementById('wiredSpecs');
                const wirelessSpecs = document.getElementById('wirelessSpecs');
                if (wiredSpecs && !audioContent.contains(wiredSpecs)) audioContent.appendChild(wiredSpecs);
                if (wirelessSpecs && !audioContent.contains(wirelessSpecs)) audioContent.appendChild(wirelessSpecs);
                audio.body.appendChild(audioContent);
                audioDetail.remove();
            }
            main.appendChild(audio.card);

            const features = makeCard('5. Feature Sections');
            const tabs = document.createElement('div');
            tabs.className = 'feature-tabs';
            const panesWrap = document.createElement('div');
            const sourceDetails = [
                { key: 'build', label: 'Build & Materials', node: buildDetail },
                { key: 'smart', label: 'Smart Features', node: smartDetail },
                { key: 'compat', label: 'Compatibility', node: compatDetail },
                { key: 'package', label: 'Package Contents', node: packageDetail }
            ];
            sourceDetails.forEach((item, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `feature-tab-btn ${idx === 0 ? 'active' : ''}`;
                btn.dataset.target = item.key;
                btn.textContent = item.label;
                tabs.appendChild(btn);

                const pane = document.createElement('div');
                pane.className = `feature-pane ${idx === 0 ? '' : 'hidden'}`;
                pane.dataset.pane = item.key;
                if (item.node) {
                    const content = item.node.querySelector('.mt-4') || item.node;
                    pane.appendChild(content);
                    item.node.remove();
                }
                panesWrap.appendChild(pane);
            });
            tabs.querySelectorAll('.feature-tab-btn').forEach((btn) => {
                btn.addEventListener('click', () => {
                    tabs.querySelectorAll('.feature-tab-btn').forEach((b) => b.classList.remove('active'));
                    btn.classList.add('active');
                    panesWrap.querySelectorAll('.feature-pane').forEach((pane) => {
                        pane.classList.toggle('hidden', pane.dataset.pane !== btn.dataset.target);
                    });
                });
            });
            features.body.append(tabs, panesWrap);
            main.appendChild(features.card);

            const shipping = makeCard('6. Shipping & Dimensions');
            const shippingGrid = document.createElement('div');
            shippingGrid.className = 'admin-grid-2';
            shippingNodes.forEach((n) => shippingGrid.appendChild(n));
            shipping.body.appendChild(shippingGrid);
            main.appendChild(shipping.card);

            const statusCard = makeCard('Product Status');
            statusCard.body.innerHTML = '<p class="text-sm text-[#685BCB] font-medium">New Product</p>';
            side.appendChild(statusCard.card);

            const badgesCard = makeCard('Badges');
            badgesNodes.forEach((n) => badgesCard.body.appendChild(n));
            side.appendChild(badgesCard.card);

            const warrantyCard = makeCard('Warranty');
            warrantyNodes.forEach((n) => warrantyCard.body.appendChild(n));
            side.appendChild(warrantyCard.card);

            const seoCard = makeCard('SEO Meta');
            seoNodes.forEach((n) => seoCard.body.appendChild(n));
            side.appendChild(seoCard.card);

            const actionsCard = makeCard('Actions');
            actionsCard.body.appendChild(actionRow);
            side.appendChild(actionsCard.card);

            Array.from(form.children).forEach((child) => child.remove());
            form.appendChild(layout);
        })();
        });

    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        // ========== Variant Management ==========
        const hasVariantsToggle = document.getElementById('hasVariantsToggle');
        const variantBuilder = document.getElementById('variantBuilder');
        const variantList = document.getElementById('variantList');
        const variantError = document.getElementById('variantError');
        const addVariantBtn = document.getElementById('addVariantBtn');
        let variants = [];
        let variantCropper = null;
        let variantCropState = { variantIndex: null, imageId: null };
        const invalidImageTypeMessage = 'Invalid file type. Only JPG, JPEG, PNG, and WEBP images are allowed.';
        const oversizedImageMessage = 'One or more images exceed the 2MB size limit.';

        function showVariantError(message) {
            if (!variantError) return;
            variantError.textContent = message;
            variantError.classList.add('visible');
        }

        function clearVariantError() {
            if (!variantError) return;
            variantError.classList.remove('visible');
        }

        // Register submit listener early so later script issues do not block submission wiring.
        const addProductFormEl = document.getElementById('addProductForm');
        if (addProductFormEl) {
            addProductFormEl.addEventListener('submit', async function (e) {
                const formError = document.getElementById('formSubmitError');
                if (formError) {
                    formError.textContent = '';
                    formError.classList.remove('visible');
                }
                const submitBtn = document.getElementById('createProductBtn');
                const submitLabel = submitBtn ? submitBtn.querySelector('span') : null;

                try {
                    const valid = validateStrictForm();

                    if (!valid) {
                        e.preventDefault();
                        if (formError) {
                            formError.textContent = 'Please fix the highlighted fields and try again.';
                            formError.classList.add('visible');
                        }
                        const firstError = document.querySelector('.field-error.visible');
                        if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }

                    // Ensure payload exists for native multipart submission.
                    this.querySelectorAll('.js-generated-submit').forEach((el) => el.remove());

                    const hasVariantsInput = document.createElement('input');
                    hasVariantsInput.type = 'hidden';
                    hasVariantsInput.name = 'hasVariants';
                    hasVariantsInput.value = 'true';
                    hasVariantsInput.className = 'js-generated-submit';
                    this.appendChild(hasVariantsInput);

                    const variantPayloadInput = document.createElement('input');
                    variantPayloadInput.type = 'hidden';
                    variantPayloadInput.name = 'variantPayload';
                    variantPayloadInput.className = 'js-generated-submit';
                    ensureGlobalHeroSelection();
                    const variantPayload = variants.map((variant) => {
                        const heroNewIndex = (variant.newImages || []).findIndex((img) => img && img.isHero === true);
                        return {
                            colorName: variant.colorName || '',
                            colorCode: variant.colorCode || '',
                            stockCount: parseInt(variant.stockCount, 10) || 0,
                            existingImages: [],
                            newImageCrops: (variant.newImages || []).map((img) => img.crop || null),
                            newImageIsHero: (variant.newImages || []).map((img) => img && img.isHero === true),
                            heroImage: heroNewIndex >= 0 ? { source: 'new', index: heroNewIndex } : null
                        };
                    });
                    variantPayloadInput.value = JSON.stringify(variantPayload);
                    this.appendChild(variantPayloadInput);

                    variants.forEach((variant, index) => {
                        (variant.newImages || []).forEach((imageObj) => {
                            if (!imageObj || !imageObj.file) return;
                            const fileInput = document.createElement('input');
                            fileInput.type = 'file';
                            fileInput.name = `variantImages_${index}`;
                            fileInput.className = 'js-generated-submit';
                            const dt = new DataTransfer();
                            dt.items.add(imageObj.file);
                            fileInput.files = dt.files;
                            this.appendChild(fileInput);
                        });
                    });

                    if (submitBtn) submitBtn.disabled = true;
                    if (submitLabel) submitLabel.textContent = 'Creating...';

                    e.preventDefault();
                    showLoader();
                    const response = await fetch(this.action || '/admin/products', {
                        method: 'POST',
                        body: new FormData(this),
                        headers: {
                            'Accept': 'application/json'
                        }
                    });
                    const data = await response.json();

                    if (response.ok && data.success) {
                        window.location.href = `/admin/products/${data.productId}`;
                        return;
                    }

                    const message = (data && data.message) ? data.message : 'Error creating product. Please try again.';
                    hideLoader();
                    if (formError) {
                        formError.textContent = message;
                        formError.classList.add('visible');
                    } else {
                        alert(message);
                    }
                    if (submitBtn) submitBtn.disabled = false;
                    if (submitLabel) submitLabel.textContent = 'Create Product';
                } catch (err) {
                    e.preventDefault();
                    hideLoader();
                    const message = 'Error creating product. Please try again.';
                    if (formError) {
                        formError.textContent = message;
                        formError.classList.add('visible');
                    } else {
                        alert(message);
                    }
                    if (submitBtn) submitBtn.disabled = false;
                    if (submitLabel) submitLabel.textContent = 'Create Product';
                }
            });
        }

        function normalizeHex(value) {
            const raw = String(value || '').trim();
            if (/^#?[0-9a-fA-F]{6}$/.test(raw)) {
                return raw.startsWith('#') ? raw.toUpperCase() : `#${raw.toUpperCase()}`;
            }
            return '';
        }

        function rgbToHex(rgb) {
            const match = String(rgb).match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)/i);
            if (!match) return '';
            const parts = match.slice(1, 4).map((n) => Number(n).toString(16).padStart(2, '0').toUpperCase());
            return `#${parts.join('')}`;
        }

        function colorNameToHex(name) {
            const probe = document.createElement('span');
            probe.style.color = '';
            probe.style.color = String(name || '').trim();
            if (!probe.style.color) return '';
            document.body.appendChild(probe);
            const computed = getComputedStyle(probe).color;
            document.body.removeChild(probe);
            return rgbToHex(computed);
        }

        function resolveColor(input) {
            const hex = normalizeHex(input);
            if (hex) return { colorCode: hex, colorName: '' };

            const fromName = colorNameToHex(input);
            if (fromName) return { colorCode: fromName, colorName: String(input).trim() };

            return null;
        }

        function clearAllHeroFlags() {
            variants.forEach((variant) => {
                (variant.newImages || []).forEach((img) => {
                    if (img) img.isHero = false;
                });
            });
        }

        function ensureGlobalHeroSelection() {
            let heroFound = false;
            variants.forEach((variant) => {
                (variant.newImages || []).forEach((img) => {
                    if (!img || img.isHero !== true) return;
                    if (!heroFound) {
                        heroFound = true;
                    } else {
                        img.isHero = false;
                    }
                });
            });
            if (heroFound) return;
            for (const variant of variants) {
                const firstImage = (variant.newImages || [])[0];
                if (firstImage) {
                    firstImage.isHero = true;
                    return;
                }
            }
        }

        function setGlobalHeroByImageId(variantIndex, imageId) {
            clearAllHeroFlags();
            const target = (variants[variantIndex] && variants[variantIndex].newImages || []).find((img) => img && img.id === imageId);
            if (target) target.isHero = true;
            ensureGlobalHeroSelection();
        }

        function addVariant() {
            variants.push({ colorInput: '', colorCode: '', colorName: '', stockCount: 0, newImages: [] });
            renderVariants();
        }

        function removeVariant(index) {
            variants.splice(index, 1);
            renderVariants();
        }

        function renderVariants() {
            ensureGlobalHeroSelection();
            variantList.innerHTML = '';
            variants.forEach((variant, index) => {
                const wrapper = document.createElement('div');
                wrapper.className = 'border border-[#BCA6DB] rounded-xl p-4 bg-white';
                wrapper.innerHTML = `
                    <div class="flex flex-wrap items-center gap-3">
                        <input type="text" data-role="color-input" data-index="${index}" value="${variant.colorInput || ''}"
                            placeholder="HEX or colour name (e.g., #000000 / royalblue)"
                            class="h-11 flex-1 min-w-[240px] rounded-xl border border-[#BCA6DB] px-3 text-sm text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB]">
                        <input type="number" data-role="variant-stock" data-index="${index}" value="${Number.isFinite(Number(variant.stockCount)) ? Number(variant.stockCount) : 0}"
                            min="0" step="1" placeholder="Stock"
                            class="h-11 w-28 rounded-xl border border-[#BCA6DB] px-3 text-sm text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB]">
                        <span data-role="color-preview" class="inline-block w-8 h-8 rounded-full border border-[#BCA6DB]" style="background:${variant.colorCode || '#FFFFFF'}"></span>
                        <button type="button" data-role="remove-variant" data-index="${index}"
                            class="h-10 px-3 rounded-lg bg-[#ffecec] text-red-600 text-sm font-bold hover:bg-[#ffdddd]">Remove</button>
                    </div>
                    <p data-role="color-meta" class="text-xs text-[#685BCB] mt-2">${variant.colorCode ? `Normalized: ${variant.colorCode}` : ''}</p>
                    <div class="mt-3">
                        <input type="file" data-role="variant-files" data-index="${index}" multiple accept="image/jpeg,image/png,image/webp"
                            class="block w-full text-sm text-[#1F1F1F]">
                        <p class="text-xs text-[#685BCB] mt-1">${(variant.newImages || []).length} images selected</p>
                    </div>
                    <div class="mt-2 flex flex-wrap gap-2">
                        ${(variant.newImages || []).map((img) => `
                            <div class="relative w-16 h-16 rounded-lg overflow-hidden border border-[#BCA6DB]">
                                <img src="${img.previewUrl}" class="w-full h-full object-cover" />
                                <button type="button" data-role="remove-new-image" data-index="${index}" data-image-id="${img.id}" class="absolute top-0 right-0 bg-red-600 text-white text-[10px] px-1">x</button>
                                <button type="button" data-role="crop-new-image" data-index="${index}" data-image-id="${img.id}" class="absolute bottom-0 left-0 bg-[#685BCB] text-white text-[9px] px-1 py-[1px]">Crop</button>
                                <label class="absolute bottom-0 right-0 bg-white/90 text-[9px] px-1 py-[1px] rounded-tl">
                                    <input type="radio" data-role="set-hero-new-image" data-index="${index}" data-image-id="${img.id}" name="heroImagePicker" ${img.isHero ? 'checked' : ''}>
                                    Hero
                                </label>
                            </div>
                        `).join('')}
                    </div>
                `;
                variantList.appendChild(wrapper);
            });

            variantList.querySelectorAll('[data-role="color-input"]').forEach((input) => {
                input.addEventListener('input', function () {
                    const idx = Number(this.dataset.index);
                    variants[idx].colorInput = this.value;
                    const resolved = resolveColor(this.value);
                    variants[idx].colorCode = resolved ? resolved.colorCode : '';
                    variants[idx].colorName = resolved ? resolved.colorName : '';

                    const card = this.closest('.border');
                    if (!card) return;
                    const preview = card.querySelector('[data-role="color-preview"]');
                    const meta = card.querySelector('[data-role="color-meta"]');
                    if (preview) {
                        preview.style.background = variants[idx].colorCode || '#FFFFFF';
                    }
                    if (meta) {
                        meta.textContent = variants[idx].colorCode ? `Normalized: ${variants[idx].colorCode}` : '';
                    }
                });
            });

            variantList.querySelectorAll('[data-role="variant-stock"]').forEach((input) => {
                input.addEventListener('input', function () {
                    const idx = Number(this.dataset.index);
                    variants[idx].stockCount = Math.max(0, parseInt(this.value, 10) || 0);
                });
            });

            variantList.querySelectorAll('[data-role="remove-variant"]').forEach((btn) => {
                btn.addEventListener('click', () => removeVariant(Number(btn.dataset.index)));
            });
        }

        const cropModal = document.createElement('div');
        cropModal.id = 'variantCropModal';
        cropModal.className = 'fixed inset-0 bg-black/60 hidden items-center justify-center z-50 p-4';
        cropModal.innerHTML = `
            <div class="bg-white rounded-xl p-4 w-full max-w-2xl">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-bold text-[#1F1F1F]">Crop Variant Image (1:1)</h2>
                    <button type="button" id="closeVariantCropModal" class="text-sm font-semibold text-[#685BCB]">Close</button>
                </div>
                <div class="bg-gray-100 rounded-lg overflow-hidden max-h-[70vh]">
                    <img id="variantCropperImage" src="" alt="Crop preview" class="max-w-full" />
                </div>
                <div class="flex justify-end gap-3 mt-4">
                    <button type="button" id="saveVariantCropBtn" class="h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">Save Crop</button>
                </div>
            </div>
        `;
        document.body.appendChild(cropModal);
        const variantCropperImage = cropModal.querySelector('#variantCropperImage');
        const closeVariantCropModal = cropModal.querySelector('#closeVariantCropModal');
        const saveVariantCropBtn = cropModal.querySelector('#saveVariantCropBtn');

        function openVariantCropModal(variantIndex, imageId) {
            const image = (variants[variantIndex].newImages || []).find((img) => img.id === imageId);
            if (!image) return;
            variantCropState = { variantIndex, imageId };
            cropModal.classList.remove('hidden');
            cropModal.classList.add('flex');
            variantCropperImage.src = image.originalPreviewUrl || image.previewUrl;
            variantCropperImage.onload = function () {
                if (variantCropper) variantCropper.destroy();
                variantCropper = new Cropper(variantCropperImage, {
                    aspectRatio: 1,
                    viewMode: 1,
                    movable: true,
                    zoomable: true,
                    scalable: false,
                    cropBoxResizable: true,
                    autoCropArea: 0.9,
                    ready() {
                        if (image.crop && image.crop.width && image.crop.height) {
                            variantCropper.setData(image.crop);
                        }
                    }
                });
            };
        }

        function closeVariantCropperModal() {
            if (variantCropper) {
                variantCropper.destroy();
                variantCropper = null;
            }
            variantCropState = { variantIndex: null, imageId: null };
            cropModal.classList.add('hidden');
            cropModal.classList.remove('flex');
        }

        if (closeVariantCropModal) {
            closeVariantCropModal.addEventListener('click', closeVariantCropperModal);
        }
        if (cropModal) {
            cropModal.addEventListener('click', (e) => {
                if (e.target === cropModal) closeVariantCropperModal();
            });
        }
        if (saveVariantCropBtn) {
            saveVariantCropBtn.addEventListener('click', async () => {
                if (!variantCropper || variantCropState.variantIndex === null || variantCropState.imageId === null) return;

                const list = variants[variantCropState.variantIndex].newImages || [];
                const idx = list.findIndex((img) => img.id === variantCropState.imageId);
                if (idx < 0) return;

                const target = list[idx];
                const canvas = variantCropper.getCroppedCanvas({ fillColor: '#ffffff' });
                if (!canvas) return;

                const outputType = (target.file && target.file.type) || 'image/jpeg';
                const blob = await new Promise((resolve) => canvas.toBlob(resolve, outputType, 0.95));
                if (!blob) return;
                const data = variantCropper.getData(true);
                const crop = {
                    x: Math.round(data.x),
                    y: Math.round(data.y),
                    width: Math.round(data.width),
                    height: Math.round(data.height)
                };

                if (target.previewUrl && target.previewUrl !== target.originalPreviewUrl) {
                    URL.revokeObjectURL(target.previewUrl);
                }

                target.previewUrl = URL.createObjectURL(blob);
                target.crop = crop;

                closeVariantCropperModal();
                renderVariants();
            });
        }

        // delegated handlers - dynamic variants
        if (variantList) {
            variantList.addEventListener('change', (event) => {
                const input = event.target;
                if (!input) return;
                if (input.dataset.role === 'set-hero-new-image') {
                    setGlobalHeroByImageId(Number(input.dataset.index), input.dataset.imageId);
                    renderVariants();
                    return;
                }
                if (input.dataset.role !== 'variant-files') return;
                const idx = Number(input.dataset.index);
                const files = Array.from(input.files || []);
                const hasInvalidType = files.some((f) => !['image/jpeg', 'image/jpg', 'image/png', 'image/webp'].includes(f.type));
                if (hasInvalidType) {
                    showVariantError(invalidImageTypeMessage);
                    input.value = '';
                    return;
                }
                const hasOversizedFile = files.some((f) => f.size > 2 * 1024 * 1024);
                if (hasOversizedFile) {
                    showVariantError(oversizedImageMessage);
                    input.value = '';
                    return;
                }
                const selected = files;
                const mapped = selected.map((file) => {
                    const previewUrl = URL.createObjectURL(file);
                    return {
                        id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
                        file,
                        previewUrl,
                        originalPreviewUrl: previewUrl,
                        crop: null,
                        isHero: false
                    };
                });
                variants[idx].newImages = [...(variants[idx].newImages || []), ...mapped];
                ensureGlobalHeroSelection();
                renderVariants();
            });
            variantList.addEventListener('click', (event) => {
                const btn = event.target;
                if (!btn || !btn.dataset || !btn.dataset.role) return;
                if (btn.dataset.role === 'remove-new-image') {
                    const variantIndex = Number(btn.dataset.index);
                    const imageId = btn.dataset.imageId;
                    variants[variantIndex].newImages = (variants[variantIndex].newImages || []).filter((img) => img.id !== imageId);
                    ensureGlobalHeroSelection();
                    renderVariants();
                    return;
                }
                if (btn.dataset.role === 'crop-new-image') {
                    openVariantCropModal(Number(btn.dataset.index), btn.dataset.imageId);
                    return;
                }
            });
        }

        function validateVariants() {
            if (!variants.length) {
                showVariantError('Add at least one colour variant.');
                return false;
            }

            for (const variant of variants) {
                if (!variant.colorCode) {
                    showVariantError('Each variant needs a valid HEX or CSS colour name.');
                    return false;
                }
                if (!/^\d+$/.test(String(variant.stockCount))) {
                    showVariantError('Each variant needs a stock count of 0 or more.');
                    return false;
                }
                const newCount = (variant.newImages || []).length;
                if (newCount < 3 || newCount > 10) {
                    showVariantError('Each variant must contain 3 to 10 images.');
                    return false;
                }
            }

            clearVariantError();
            return true;
        }

        if (hasVariantsToggle) {
            hasVariantsToggle.checked = true;
            hasVariantsToggle.disabled = true;
        }
        if (variantBuilder) {
            variantBuilder.classList.remove('hidden');
        }
        if (variants.length === 0) addVariant();
        if (addVariantBtn) {
            addVariantBtn.addEventListener('click', addVariant);
        }

        const CONNECTOR_TYPE_OPTIONS = [
            '3.5mm Jack (Mini-jack)',
            'USB-C',
            'Lightning',
            '6.35mm (1/4-inch) Jack',
            '2.5mm Jack',
            '4.4mm Pentaconn',
            'XLR (3-pin or 4-pin)',
            'Other'
        ];
        const WIRED_FORM_FACTORS = ['In-Ear (Earbuds/IEMs)', 'Over-Ear', 'On-Ear', 'Clip-On', 'Ear Hooks'];
        const WIRELESS_FORM_FACTORS = ['True Wireless (TWS)', 'Neckband', 'Over-Ear', 'On-Ear', 'Bone Conduction', 'Ear Hooks'];

        function renderBatteryChargingField(value) {
            const host = document.getElementById('batteryChargingTimeHost');
            if (!host) return;
            host.innerHTML = `
                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Charging Time (hours)</p>
                <input id="batteryChargingTime" name="batteryChargingTime" placeholder="e.g., 2" type="number"
                    step="0.1" min="0"
                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                    value="${value || ''}" />
                <p class="field-error" id="batteryChargingTimeError">Enter valid charging time in hours</p>
            `;
        }

        function removeBatteryChargingField() {
            const host = document.getElementById('batteryChargingTimeHost');
            if (host) host.innerHTML = '';
        }

        function renderFormFactorOptions(connectionType, selectedValue) {
            const host = document.getElementById('formFactorOptions');
            if (!host) return;

            const options = connectionType === 'Wired'
                ? WIRED_FORM_FACTORS
                : connectionType === 'Wireless'
                    ? WIRELESS_FORM_FACTORS
                    : [];

            if (!options.length) {
                host.innerHTML = '<p id="formFactorHint" class="text-[#685BCB] text-sm">Select connection type first</p>';
                return;
            }

            const labels = options.map((option, index) => {
                const id = `formFactor_${connectionType}_${index}`.replace(/\s+/g, '_').replace(/[()]/g, '');
                const checked = selectedValue === option ? 'checked' : '';
                return `<label class="inline-flex items-center gap-2 text-[#1F1F1F] text-sm">
                    <input id="${id}" type="radio" name="formFactor" value="${option}" ${checked}
                        class="h-4 w-4 border-[#BCA6DB] text-[#685BCB] focus:ring-[#685BCB]">
                    <span>${option}</span>
                </label>`;
            }).join('');

            host.innerHTML = labels;
        }

        // ========== Connection Type Toggle ==========
        const connectionTypeEl = document.getElementById('connectionType');
        if (connectionTypeEl) {
            const syncConnectionUI = function () {
                const wiredSpecs = document.getElementById('wiredSpecs');
                const wirelessSpecs = document.getElementById('wirelessSpecs');
                const selectedFormFactor = (document.querySelector('[name="formFactor"]:checked') || {}).value || '';
                if (!wiredSpecs || !wirelessSpecs) return;
                wiredSpecs.classList.add('hidden');
                wirelessSpecs.classList.add('hidden');
                if (this.value === 'Wired') {
                    wiredSpecs.classList.remove('hidden');
                    removeBatteryChargingField();
                    clearFieldError('batteryChargingTime');
                    renderFormFactorOptions('Wired', selectedFormFactor);
                } else if (this.value === 'Wireless') {
                    wirelessSpecs.classList.remove('hidden');
                    renderBatteryChargingField();
                    renderFormFactorOptions('Wireless', selectedFormFactor);
                } else {
                    removeBatteryChargingField();
                    renderFormFactorOptions('');
                }
            };
            connectionTypeEl.addEventListener('change', syncConnectionUI);
            syncConnectionUI.call(connectionTypeEl);
        }

        // ========== Validation Helpers ==========
        ['productTitle', 'productSku', 'brandSelect', 'connectionType', 'categorySelect', 'shortDescription', 'productPrice',
                'discountPercentage', 'reorderThreshold',
            'warrantyDuration', 'warrantyProvider', 'shippingLength', 'shippingWidth', 'shippingHeight', 'shippingWeight'
        ].forEach((id) => {
            const el = document.getElementById(id);
            if (el) el.setAttribute('required', 'required');
        });

        function showError(inputEl, errorEl) {
            inputEl.classList.add('input-error');
            errorEl.classList.add('visible');
        }
        function clearError(inputEl, errorEl) {
            inputEl.classList.remove('input-error');
            errorEl.classList.remove('visible');
        }

        function validatePattern(id, errorId) {
            const input = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!input || !error) return true;
            if (input.value.trim() === '') {
                if (input.hasAttribute('required')) {
                    showError(input, error);
                    error.textContent = 'This field is required';
                    return false;
                }
                clearError(input, error);
                return true;
            }
            const pattern = input.getAttribute('pattern');
            if (pattern && !new RegExp(pattern).test(input.value.trim())) {
                showError(input, error);
                return false;
            }
            clearError(input, error);
            return true;
        }

        function validateNumber(id, errorId, isRequired) {
            const input = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!input || !error) return true;
            const val = input.value.trim();
            if (val === '') {
                if (isRequired) {
                    showError(input, error);
                    error.textContent = 'This field is required';
                    return false;
                }
                clearError(input, error);
                return true;
            }
            const num = parseFloat(val);
            if (isNaN(num) || num < 0) {
                showError(input, error);
                return false;
            }
            const max = input.getAttribute('max');
            if (max && num > parseFloat(max)) {
                showError(input, error);
                return false;
            }
            clearError(input, error);
            return true;
        }

        function validateSelect(id, errorId) {
            const select = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!select || !error) return true;
            if (!select.value) {
                showError(select, error);
                return false;
            }
            clearError(select, error);
            return true;
        }

        function setFieldError(id, message) {
            const input = document.getElementById(id);
            const error = document.getElementById(id + 'Error');
            if (!input || !error) return false;
            error.textContent = message;
            showError(input, error);
            return false;
        }

        function clearFieldError(id) {
            const input = document.getElementById(id);
            const error = document.getElementById(id + 'Error');
            if (!input || !error) return;
            clearError(input, error);
        }

        function getValue(id) {
            const el = document.getElementById(id);
            return el ? el.value.trim() : '';
        }

        function updateShortDescriptionCounter() {
            const desc = document.getElementById('shortDescription');
            const counter = document.getElementById('shortDescriptionCounter');
            if (!desc || !counter) return;
            counter.textContent = `${desc.value.length}/1500`;
        }

        const shortDescriptionEl = document.getElementById('shortDescription');
        if (shortDescriptionEl) {
            shortDescriptionEl.addEventListener('input', updateShortDescriptionCounter);
            updateShortDescriptionCounter();
        }

        function setupAutoPriceCalculation() {
            const priceEl = document.getElementById('productPrice');
            const discountEl = document.getElementById('discountPercentage');
            const previewEl = document.getElementById('finalPricePreview');
            if (!priceEl || !discountEl || !previewEl) return;
            if (priceEl.dataset.priceCalcBound === 'true') return;

            const recalcPrice = () => {
                const priceRaw = priceEl.value.trim();
                const discountRaw = discountEl.value.trim();
                
                if (!priceRaw) {
                    previewEl.classList.add('hidden');
                    return;
                }

                const price = Number(priceRaw);
                const discount = discountRaw ? Number(discountRaw) : 0;
                
                if (!Number.isFinite(price) || !Number.isFinite(discount)) {
                    previewEl.classList.add('hidden');
                    return;
                }
                if (price < 0 || discount < 0 || discount > 100) {
                    previewEl.classList.add('hidden');
                    return;
                }

                const computed = price - ((price * discount) / 100);
                previewEl.textContent = 'Final Price: ₹' + Math.max(0, computed).toFixed(2);
                previewEl.classList.remove('hidden');
            };

            priceEl.addEventListener('input', recalcPrice);
            discountEl.addEventListener('input', recalcPrice);
            priceEl.addEventListener('change', recalcPrice);
            discountEl.addEventListener('change', recalcPrice);
            priceEl.dataset.priceCalcBound = 'true';

            recalcPrice();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupAutoPriceCalculation);
        } else {
            setupAutoPriceCalculation();
        }

        function validateStrictForm() {
            let valid = true;
            const sku = getValue('productSku');
            if (sku && !/^[A-Za-z0-9-]{2,60}$/.test(sku)) {
                valid = setFieldError('productSku', 'SKU must be 2-60 chars (letters/numbers/hyphen).') && valid;
            } else clearFieldError('productSku');

            const title = getValue('productTitle');
            if (!/^[A-Za-z0-9 -]{3,150}$/.test(title) || /\s{2,}/.test(title)) {
                valid = setFieldError('productTitle', 'Title must be 3-150 chars (letters, numbers, spaces, hyphen).') && valid;
            } else clearFieldError('productTitle');

            if (!validateSelect('brandSelect', 'brandSelectError')) valid = false;
            if (!validateSelect('connectionType', 'connectionTypeError')) valid = false;
            if (!validateSelect('categorySelect', 'categorySelectError')) valid = false;

            const shortDescription = getValue('shortDescription');
            if (shortDescription.length < 10 || shortDescription.length > 1500 || /<[^>]+>/.test(shortDescription) || /\s{2,}/.test(shortDescription)) {
                valid = setFieldError('shortDescription', 'Description must be 10-1500 chars and cannot contain HTML.') && valid;
            } else clearFieldError('shortDescription');

            const price = getValue('productPrice');
            const discount = getValue('discountPercentage');
            if (!/^\d+(\.\d{1,2})?$/.test(price) || Number(price) <= 0) valid = setFieldError('productPrice', 'Price must be > 0 with up to 2 decimals.') && valid; else clearFieldError('productPrice');
            if (!/^\d+(\.\d{1,2})?$/.test(discount) || Number(discount) < 0 || Number(discount) > 90) valid = setFieldError('discountPercentage', 'Discount must be between 0 and 90.') && valid; else clearFieldError('discountPercentage');

            const reorder = getValue('reorderThreshold');
            if (!/^\d+$/.test(reorder)) valid = setFieldError('reorderThreshold', 'Reorder threshold is required and must be an integer >= 0.') && valid; else clearFieldError('reorderThreshold');

            const connType = getValue('connectionType');
            if (connType === 'Wired') {
                if (!/^\d+(\.\d{1,2})?$/.test(getValue('cableLength')) || Number(getValue('cableLength')) <= 0) valid = setFieldError('cableLength', 'Cable length is required and must be positive.') && valid; else clearFieldError('cableLength');
                if (!CONNECTOR_TYPE_OPTIONS.includes(getValue('connectorType'))) valid = setFieldError('connectorType', 'Please select a valid connector type.') && valid; else clearFieldError('connectorType');
                if (!/^\d+$/.test(getValue('impedance')) || Number(getValue('impedance')) <= 0) valid = setFieldError('impedance', 'Impedance must be a positive integer.') && valid; else clearFieldError('impedance');
                if (!/^\d+(\.\d{1,2})?$/.test(getValue('driverSize')) || Number(getValue('driverSize')) <= 0) valid = setFieldError('driverSize', 'Driver size must be positive.') && valid; else clearFieldError('driverSize');
            } else if (connType === 'Wireless') {
                const bt = getValue('bluetoothVersion');
                if (!/^([1-9]\d?)(\.\d)?$/.test(bt)) valid = setFieldError('bluetoothVersion', 'Bluetooth version must look like 5.0 or 5.3.') && valid; else clearFieldError('bluetoothVersion');
                if (!/^\d+(\.\d{1,2})?$/.test(getValue('batteryLife')) || Number(getValue('batteryLife')) <= 0) valid = setFieldError('batteryLife', 'Battery life must be positive.') && valid; else clearFieldError('batteryLife');
                const chargingTime = getValue('batteryChargingTime');
                if (!chargingTime || !/^\d+(\.\d{1,2})?$/.test(chargingTime) || Number(chargingTime) <= 0) {
                    valid = setFieldError('batteryChargingTime', 'Enter valid charging time in hours') && valid;
                } else {
                    clearFieldError('batteryChargingTime');
                }
                if (!/^\d+(\.\d{1,2})?$/.test(getValue('wirelessRange')) || Number(getValue('wirelessRange')) <= 0) valid = setFieldError('wirelessRange', 'Wireless range must be positive.') && valid; else clearFieldError('wirelessRange');
            }

            if (!validateSelect('warrantyDuration', 'warrantyDurationError')) valid = false;
            if (!validateSelect('warrantyProvider', 'warrantyProviderError')) valid = false;

            const dims = [
                ['shippingLength', /^\d+(\.\d{1,2})?$/, 'Length must be positive with up to 2 decimals.'],
                ['shippingWidth', /^\d+(\.\d{1,2})?$/, 'Width must be positive with up to 2 decimals.'],
                ['shippingHeight', /^\d+(\.\d{1,2})?$/, 'Height must be positive with up to 2 decimals.']
            ];
            dims.forEach(([id, regex, message]) => {
                const v = getValue(id);
                if (!regex.test(v) || Number(v) <= 0) valid = setFieldError(id, message) && valid; else clearFieldError(id);
            });
            const weight = getValue('shippingWeight');
            if (!/^\d+(\.\d{1,3})?$/.test(weight) || Number(weight) <= 0) valid = setFieldError('shippingWeight', 'Weight must be positive with up to 3 decimals.') && valid; else clearFieldError('shippingWeight');

            if (!validateVariants()) valid = false;

            return valid;
        }

        // Real-time validation on blur
        document.querySelectorAll('#addProductForm input, #addProductForm select, #addProductForm textarea').forEach(function (el) {
            el.addEventListener('blur', function () {
                const errorEl = document.getElementById(el.id + 'Error');
                if (!errorEl) return;
                if (el.type === 'number') {
                    validateNumber(el.id, el.id + 'Error', el.hasAttribute('required'));
                } else if (el.tagName === 'SELECT') {
                    if (el.hasAttribute('required')) validateSelect(el.id, el.id + 'Error');
                } else {
                    validatePattern(el.id, el.id + 'Error');
                }
            });
        });

        // ========== Form Submission ==========
        // Registered earlier for reliability.
        });
    </script>
    <script>
        document.addEventListener('pageshow', function () {
            hideLoader();
            const submitBtn = document.getElementById('createProductBtn');
            const submitLabel = submitBtn ? submitBtn.querySelector('span') : null;
            if (submitBtn) submitBtn.disabled = false;
            if (submitLabel) submitLabel.textContent = 'Create Product';
        });
    </script>
    <script src="/js/loading.util.js"></script>
</body>

</html>
