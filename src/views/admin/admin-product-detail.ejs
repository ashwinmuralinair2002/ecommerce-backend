<!-- Admin product detail page — renders dynamic data from database -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />

    <title>Admin · <%= product.title %>
    </title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .gallery-scroll::-webkit-scrollbar {
            display: none;
        }

        .gallery-scroll {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white" style='font-family: Inter, "Noto Sans", sans-serif;'>
        <%- include("../partials/admin/navbar") %>

        <main class="flex flex-1 bg-white">
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'products' }) %>
            </aside>

            <section class="flex-1 p-6 md:p-8">
                <!-- Breadcrumb -->
                <div class="flex flex-wrap gap-2 pb-4">
                    <a class="text-[#685BCB] text-base font-medium leading-normal" href="/admin/products">Products</a>
                    <span class="text-[#685BCB] text-base font-medium leading-normal">/</span>
                    <span class="text-[#1F1F1F] text-base font-medium leading-normal">
                        <%= product.title %>
                    </span>
                </div>

                <!-- Page Header -->
                <div class="flex flex-wrap justify-between gap-3 pb-4">
                    <div class="flex min-w-72 flex-col gap-3">
                        <p class="text-[#1F1F1F] tracking-light text-[32px] font-bold leading-tight">
                            <%= product.title %>
                        </p>
                        <p class="text-[#685BCB] text-sm font-normal leading-normal">SKU: <%= product.sku %>
                        </p>
                    </div>
                </div>

                <!-- Action Buttons: Edit + Delete only -->
                <div class="flex justify-stretch">
                    <div class="flex flex-1 gap-3 flex-wrap px-4 py-3 justify-start">
                        <a href="/admin/products/edit/<%= product._id %>"
                            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 bg-[#685BCB] text-white text-sm font-bold leading-normal tracking-[0.015em]">
                            <span class="truncate">Edit</span>
                        </a>
                        <button id="deleteBtn"
                            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 bg-transparent text-[#1F1F1F] text-sm font-bold leading-normal tracking-[0.015em]">
                            <span class="truncate">Delete</span>
                        </button>
                    </div>
                </div>

                <p class="text-[#685BCB] text-sm font-normal leading-normal pb-3 pt-1 px-4">
                    Status: <%= product.status %> | Created: <%= product.createdAt ?
                            product.createdAt.toLocaleDateString('en-IN', { year: 'numeric' , month: 'short' ,
                            day: 'numeric' }) : 'N/A' %>
                </p>

                <!-- Product Details -->
                <h2 class="text-[#1F1F1F] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                    Product Details</h2>
                <div class="p-4 @container">
                    <div class="flex flex-col items-stretch justify-start rounded-xl @xl:flex-row @xl:items-start">
                        <!-- Image Gallery -->
                        <div class="w-full @xl:w-1/2">
                            <div class="max-w-xl mx-auto">
                                <% if (product.variants && product.variants.length > 0 && product.variants[0].images && product.variants[0].images.length > 0) { %>
                                    <% var sortedImages = product.variants[0].images.slice(); %>
                                        <div class="relative aspect-square rounded-xl overflow-hidden bg-gray-100">
                                            <% const mainImage=sortedImages[0]; %>
                                                <img id="galleryMainImg"
                                                    src="<%= mainImage && mainImage.url ? mainImage.url : '/images/placeholder.png' %>"
                                                    alt="<%= product.title %>"
                                                    class="w-full h-full object-contain transition-opacity duration-300"
                                                    onerror="this.src='/images/placeholder.png'">

                                                <% if (sortedImages.length> 1) { %>
                                                    <!-- Left Arrow -->
                                                    <button type="button" id="galleryPrev"
                                                        class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/40 hover:bg-black/60 text-white flex items-center justify-center transition-colors backdrop-blur-sm z-10">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                            fill="currentColor" viewBox="0 0 256 256">
                                                            <path
                                                                d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z" />
                                                        </svg>
                                                    </button>
                                                    <!-- Right Arrow -->
                                                    <button type="button" id="galleryNext"
                                                        class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/40 hover:bg-black/60 text-white flex items-center justify-center transition-colors backdrop-blur-sm z-10">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                            fill="currentColor" viewBox="0 0 256 256">
                                                            <path
                                                                d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z" />
                                                        </svg>
                                                    </button>
                                                    <% } %>
                                        </div>

                                        <!-- Thumbnail Strip -->
                                        <% if (sortedImages.length> 1) { %>
                                            <div class="flex gap-2 mt-3 overflow-x-auto pb-1" id="galleryThumbs"
                                                style="scrollbar-width: thin; scrollbar-color: #BCA6DB transparent;">
                                                <% sortedImages.forEach(function(img, idx) { %>
                                                    <button type="button"
                                                        class="gallery-thumb relative flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 transition-all cursor-pointer <%= idx === 0 ? 'border-[#685BCB] opacity-100' : 'border-transparent opacity-60 hover:opacity-90' %>"
                                                        data-index="<%= idx %>" data-url="<%= img.url %>">
                                                        <img src="<%= img.url || '/images/placeholder.png' %>"
                                                            alt="Thumbnail <%= idx + 1 %>"
                                                            class="w-full h-full object-cover"
                                                            onerror="this.src='/images/placeholder.png'" />
                                                    </button>
                                                    <% }) %>
                                            </div>
                                            <% } %>
                                                <% } else { %>
                                                    <div
                                                        class="aspect-square rounded-xl bg-gray-100 flex items-center justify-center w-full">
                                                        <div class="text-center text-gray-400">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="48"
                                                                height="48" fill="currentColor" viewBox="0 0 256 256"
                                                                class="mx-auto mb-2">
                                                                <path
                                                                    d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40ZM40,56H216V200H40ZM160,96a32,32,0,1,1-32-32A32,32,0,0,1,160,96Zm-72,64,27.52-27.52a8,8,0,0,1,11.31,0L144,149.66l27.52-27.52a8,8,0,0,1,11.31,0L200,139.31V200H56V176Z" />
                                                            </svg>
                                                            <p class="text-sm">No Image Available</p>
                                                        </div>
                                                    </div>
                                                    <% } %>
                            </div>
                        </div>
                        <div
                            class="flex w-full min-w-72 grow flex-col items-stretch justify-center gap-1 py-4 @xl:px-4">
                            <p class="text-[#1F1F1F] text-lg font-bold leading-tight tracking-[-0.015em]">
                                <%= product.title %>
                            </p>
                            <p class="text-[#685BCB] text-base font-normal leading-normal">
                                <%= product.shortDescription || 'No description available.' %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Technical Specifications -->
                <h2 class="text-[#1F1F1F] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                    Technical Specifications</h2>
                <div class="p-4 grid grid-cols-2">
                    <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pr-2">
                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Connection Type</p>
                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                            <%= product.connectionType %>
                        </p>
                    </div>
                    <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pl-2">
                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Category</p>
                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                            <%= product.category %>
                        </p>
                    </div>
                    <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pr-2">
                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Brand</p>
                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                            <%= product.brand ? product.brand.name : 'N/A' %>
                        </p>
                    </div>

                    <% if (product.connectionType==='Wired' ) { %>
                        <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pl-2">
                            <p class="text-[#685BCB] text-sm font-normal leading-normal">Cable Length</p>
                            <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                <%= product.cableLength || '—' %>
                            </p>
                        </div>
                        <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pr-2">
                            <p class="text-[#685BCB] text-sm font-normal leading-normal">Connector Type</p>
                            <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                <%= product.connectorType || '—' %>
                            </p>
                        </div>
                        <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pl-2">
                            <p class="text-[#685BCB] text-sm font-normal leading-normal">Impedance</p>
                            <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                <%= product.impedance || '—' %>
                            </p>
                        </div>
                        <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pr-2">
                            <p class="text-[#685BCB] text-sm font-normal leading-normal">Driver Size</p>
                            <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                <%= product.driverSize || '—' %>
                            </p>
                        </div>
                        <% } else if (product.connectionType==='Wireless' ) { %>
                            <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pl-2">
                                <p class="text-[#685BCB] text-sm font-normal leading-normal">Bluetooth Version</p>
                                <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                    <%= product.bluetoothVersion || '—' %>
                                </p>
                            </div>
                            <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pr-2">
                                <p class="text-[#685BCB] text-sm font-normal leading-normal">Battery Life</p>
                                <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                    <%= product.batteryLife || '—' %>
                                </p>
                            </div>
                            <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pl-2">
                                <p class="text-[#685BCB] text-sm font-normal leading-normal">Charging Time</p>
                                <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                    <%= product.chargingTime || '—' %>
                                </p>
                            </div>
                            <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pr-2">
                                <p class="text-[#685BCB] text-sm font-normal leading-normal">Wireless Range</p>
                                <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                    <%= product.wirelessRange || '—' %>
                                </p>
                            </div>
                            <div class="flex flex-col gap-1 border-t border-solid border-t-[#BCA6DB] py-4 pl-2">
                                <p class="text-[#685BCB] text-sm font-normal leading-normal">Noise Cancellation</p>
                                <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                    <%= product.noiseCancellation || '—' %>
                                </p>
                            </div>
                            <% } %>
                </div>

                <!-- Pricing & Offers -->
                <h2 class="text-[#1F1F1F] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                    Pricing &amp; Offers</h2>
                <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
                    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Current Price</p>
                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">₹<%=
                                product.price.toLocaleString('en-IN') %>
                        </p>
                    </div>
                    <% if (product.originalPrice) { %>
                        <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                            <p class="text-[#685BCB] text-sm font-normal leading-normal">Original Price</p>
                            <p class="text-[#1F1F1F] text-sm font-normal leading-normal">₹<%=
                                    product.originalPrice.toLocaleString('en-IN') %>
                            </p>
                        </div>
                        <% } %>
                            <% if (product.discountPercentage> 0) { %>
                                <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                                    <p class="text-[#685BCB] text-sm font-normal leading-normal">Discount</p>
                                    <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                        <%= product.discountPercentage %>%
                                    </p>
                                </div>
                                <% } %>
                </div>

                <!-- Inventory -->
                <h2 class="text-[#1F1F1F] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                    Inventory</h2>
                <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
                    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Stock Count</p>
                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                            <%= product.stockCount %>
                        </p>
                    </div>
                    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Reserved Count</p>
                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                            <%= product.reservedCount %>
                        </p>
                    </div>
                    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Reorder Threshold</p>
                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                            <%= product.reorderThreshold %>
                        </p>
                    </div>
                </div>

                <!-- Shipping & Weight -->
                <% if (product.length || product.width || product.height || product.weight) { %>
                    <h2 class="text-[#1F1F1F] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                        Shipping &amp; Weight</h2>
                    <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
                        <% if (product.length) { %>
                            <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                                <p class="text-[#685BCB] text-sm font-normal leading-normal">Length</p>
                                <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                    <%= product.length %> cm
                                </p>
                            </div>
                            <% } %>
                                <% if (product.width) { %>
                                    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Width</p>
                                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                            <%= product.width %> cm
                                        </p>
                                    </div>
                                    <% } %>
                                        <% if (product.height) { %>
                                            <div
                                                class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                                                <p class="text-[#685BCB] text-sm font-normal leading-normal">Height</p>
                                                <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                                    <%= product.height %> cm
                                                </p>
                                            </div>
                                            <% } %>
                                                <% if (product.weight) { %>
                                                    <div
                                                        class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                                                        <p class="text-[#685BCB] text-sm font-normal leading-normal">
                                                            Weight</p>
                                                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                                            <%= product.weight %> kg
                                                        </p>
                                                    </div>
                                                    <% } %>
                    </div>
                    <% } %>

                        <!-- SEO & Metadata -->
                        <% if (product.metaTitle || product.metaDescription) { %>
                            <h2
                                class="text-[#1F1F1F] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                                SEO
                                &amp; Metadata</h2>
                            <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
                                <% if (product.metaTitle) { %>
                                    <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                                        <p class="text-[#685BCB] text-sm font-normal leading-normal">Meta Title</p>
                                        <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                            <%= product.metaTitle %>
                                        </p>
                                    </div>
                                    <% } %>
                                        <% if (product.metaDescription) { %>
                                            <div
                                                class="col-span-2 grid grid-cols-subgrid border-t border-t-[#BCA6DB] py-5">
                                                <p class="text-[#685BCB] text-sm font-normal leading-normal">Meta
                                                    Description</p>
                                                <p class="text-[#1F1F1F] text-sm font-normal leading-normal">
                                                    <%= product.metaDescription %>
                                                </p>
                                            </div>
                                            <% } %>
                            </div>
                            <% } %>

                                <!-- Badges -->
                                <% if (product.badges && product.badges.length> 0) { %>
                                    <h2
                                        class="text-[#1F1F1F] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                                        Badges</h2>
                                    <div class="flex flex-wrap gap-2 px-4 pb-4">
                                        <% product.badges.forEach(function(badge) { %>
                                            <span
                                                class="inline-flex items-center rounded-lg h-8 px-4 bg-[#e6f4ea] text-[#1e7e34] text-sm font-medium">
                                                <%= badge %>
                                            </span>
                                            <% }) %>
                                    </div>
                                    <% } %>

            </section>
        </main>
    </div>

    <script>
        // ========== Image Gallery ==========
        (function () {
            const mainImg = document.getElementById('galleryMainImg');
            const prevBtn = document.getElementById('galleryPrev');
            const nextBtn = document.getElementById('galleryNext');
            const thumbs = document.querySelectorAll('.gallery-thumb');
            if (!mainImg || thumbs.length === 0) return;

            const urls = Array.from(thumbs).map(t => t.dataset.url);
            let current = 0;

            function goTo(index) {
                current = (index + urls.length) % urls.length;
                mainImg.style.opacity = '0';
                setTimeout(() => {
                    mainImg.src = urls[current];
                    mainImg.style.opacity = '1';
                }, 150);
                thumbs.forEach((t, i) => {
                    if (i === current) {
                        t.classList.add('border-[#685BCB]', 'opacity-100');
                        t.classList.remove('border-transparent', 'opacity-60');
                        t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                    } else {
                        t.classList.remove('border-[#685BCB]', 'opacity-100');
                        t.classList.add('border-transparent', 'opacity-60');
                    }
                });
            }

            if (prevBtn) prevBtn.addEventListener('click', () => goTo(current - 1));
            if (nextBtn) nextBtn.addEventListener('click', () => goTo(current + 1));
            thumbs.forEach(t => t.addEventListener('click', () => goTo(parseInt(t.dataset.index))));
        })();
    </script>

    <script>
        document.getElementById('deleteBtn').addEventListener('click', function () {
            Swal.fire({
                title: 'Delete Product?',
                text: 'This will unlist the product. It will no longer appear in any listing.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch('/admin/products/<%= product._id %>', {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            await Swal.fire('Deleted!', 'Product has been unlisted.', 'success');
                            window.location.href = '/admin/products';
                        } else {
                            Swal.fire('Error', data.message || 'Failed to delete product', 'error');
                        }
                    } catch (err) {
                        Swal.fire('Error', 'Something went wrong. Please try again.', 'error');
                    }
                }
            });
        });
    </script>
</body>

</html>
