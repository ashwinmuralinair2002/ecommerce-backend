<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />
    <title>Admin · <%= product.title %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.svg" />
    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-background-soft" style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
    <div class="min-h-screen flex flex-col">
        <%- include("../partials/admin/navbar") %>

        <main class="flex flex-1">
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'products' }) %>
            </aside>

            <section class="flex-1 px-4 md:px-6 lg:px-8 xl:px-10 py-5 overflow-x-hidden">
                <% const hasVariants = Array.isArray(product.variants) && product.variants.length > 0;
                    const getCroppedImageUrl = (image) => {
                        if (!image || !image.url) return '/images/placeholder.png';
                        const crop = image.crop;
                        if (!crop) return image.url;
                        const x = Number(crop.x);
                        const y = Number(crop.y);
                        const width = Number(crop.width);
                        const height = Number(crop.height);
                        if (![x, y, width, height].every(Number.isFinite)) return image.url;
                        if (width <= 0 || height <= 0) return image.url;
                        if (!String(image.url).includes('/upload/')) return image.url;
                        return String(image.url).replace('/upload/', '/upload/c_crop,x_' + Math.max(0, Math.round(x)) + ',y_' + Math.max(0, Math.round(y)) + ',w_' + Math.round(width) + ',h_' + Math.round(height) + '/');
                    };
                    const selectedVariant = hasVariants ? product.variants[0] : null;
                    const variantImages = selectedVariant && Array.isArray(selectedVariant.images) ? selectedVariant.images : [];
                    const allImages = variantImages;
                    const heroImage = allImages.find(img => img.isHero) || allImages[0];
                    const heroUrl = heroImage ? getCroppedImageUrl(heroImage) : '/images/placeholder.png';
                    const warrantyDuration = product.warranty && product.warranty.duration ? product.warranty.duration : '';
                    const warrantyProvider = product.warranty && product.warranty.provider ? product.warranty.provider : 'Brand';
                    const hasWarranty = warrantyDuration && warrantyDuration !== 'No Warranty';
                    const nonEmpty = (arr) => Array.isArray(arr) ? arr.filter(Boolean) : [];
                    const noiseCancellationTypes = nonEmpty(product.noiseControlTypes);
                    const advancedAudio = nonEmpty(product.audioDriverTypes);
                    const buildMeta = nonEmpty(product.materials).concat(nonEmpty(product.cableFeatures));
                    const smartMeta = nonEmpty(product.controlMethods).concat(nonEmpty(product.smartFeatures));
                    const compatibilityMeta = nonEmpty(product.compatibleDevices).concat(nonEmpty(product.includedComponents));
                    const isCategoryObj = product.category && typeof product.category === 'object' && product.category.name;
                %>

                <div class="w-full">
                    <nav class="flex text-sm text-gray-500 mb-3" aria-label="Breadcrumb">
                        <ol class="inline-flex items-center space-x-1 md:space-x-2">
                            <li class="inline-flex items-center">
                                <a href="/admin/products" class="inline-flex items-center text-gray-500 hover:text-primary">
                                    Products
                                </a>
                            </li>
                            <li aria-current="page">
                                <div class="flex items-center">
                                    <span class="mx-2 text-gray-400">/</span>
                                    <span class="text-primary font-medium"><%= product.title %></span>
                                </div>
                            </li>
                        </ol>
                    </nav>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
                        <section class="lg:col-span-5">
                            <div class="lg:sticky lg:top-24">
                                <div class="flex flex-col sm:flex-row gap-3 relative z-20">
                                    <% if (allImages.length > 1) { %>
                                        <div
                                            class="order-2 sm:order-1 flex sm:flex-col gap-2 overflow-x-auto sm:overflow-visible py-1 scrollbar-hide sm:min-w-[88px]">
                                            <% allImages.forEach((img, index) => { %>
                                                <button
                                                    class="thumbnail-image w-20 h-20 border-2 rounded-lg overflow-hidden flex-shrink-0 transition-all duration-200 bg-white p-1 <%= (getCroppedImageUrl(img) === heroUrl) ? 'border-primary ring-1 ring-primary scale-105' : 'border-gray-200 hover:border-primary-light' %>"
                                                    data-index="<%= index %>">
                                                    <img src="<%= getCroppedImageUrl(img) %>" class="w-full h-full object-contain" alt="Product image <%= index + 1 %>">
                                                </button>
                                            <% }); %>
                                        </div>
                                    <% } %>

                                    <div class="order-1 sm:order-2 flex-1">
                                        <div class="relative overflow-visible">
                                            <div id="imageContainer"
                                                class="group relative w-full aspect-square bg-white rounded-xl border border-gray-200 shadow-sm flex justify-center items-center overflow-visible cursor-crosshair">
                                                <img src="<%= heroUrl %>" alt="<%= product.title %>"
                                                    class="w-full h-full object-contain p-4 rounded-xl" id="mainImage">

                                                <button id="prevBtn"
                                                    class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 p-2 rounded-full shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-sm z-10"
                                                    aria-label="Previous image">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                                                        stroke="currentColor" class="w-5 h-5">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                                                    </svg>
                                                </button>
                                                <button id="nextBtn"
                                                    class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 p-2 rounded-full shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-sm z-10"
                                                    aria-label="Next image">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                                                        stroke="currentColor" class="w-5 h-5">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                                                    </svg>
                                                </button>
                                            </div>

                                            <div id="zoomBox"
                                                class="xl:block absolute top-0 left-full ml-4 w-[400px] h-[400px] bg-white border border-gray-200 shadow-2xl rounded-xl z-[9999] bg-no-repeat opacity-0 invisible pointer-events-none transition-all duration-200"
                                                style="background-size: 200%;">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 bg-white border border-primary-light/40 rounded-lg p-4">
                                    <h3 class="text-primary text-lg font-bold leading-tight mb-2">Description</h3>
                                    <p class="text-primary text-sm leading-6 whitespace-pre-line"><%= product.description || product.shortDescription || 'No description available.' %></p>
                                </div>
                            </div>
                        </section>

                        <section class="lg:col-span-4 space-y-4">
                            <h1 class="text-primary tracking-light text-[30px] font-bold leading-tight"><%= product.title %></h1>

                            <% if (Array.isArray(product.badges) && product.badges.length > 0) { %>
                                <div class="flex flex-wrap gap-2">
                                    <% product.badges.forEach((badge) => { %>
                                        <span class="rounded-md bg-accent px-2 py-1 text-xs font-bold text-black"><%= badge %></span>
                                    <% }) %>
                                </div>
                            <% } %>

                            <div class="flex items-center gap-3 text-sm text-primary">
                                <span class="font-semibold">SKU:</span>
                                <span class="text-gray-600"><%= product.sku || 'N/A' %></span>
                            </div>

                            <p class="text-sm text-gray-600">
                                Brand:
                                <span class="text-primary font-medium"><%= product.brand ? product.brand.name : 'N/A' %></span>
                            </p>

                            <div class="bg-white border border-primary-light/40 rounded-lg p-4">
                                <h3 class="text-primary text-lg font-bold leading-tight mb-2">Specifications</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
                                    <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                        <p class="text-primary text-sm font-normal leading-normal">Brand</p>
                                        <p class="text-primary text-sm font-normal leading-normal"><%= product.brand ? product.brand.name : 'N/A' %></p>
                                    </div>
                                    <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                        <p class="text-primary text-sm font-normal leading-normal">Category</p>
                                        <p class="text-primary text-sm font-normal leading-normal"><%= isCategoryObj ? product.category.name : (product.category || 'N/A') %></p>
                                    </div>
                                    <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                        <p class="text-primary text-sm font-normal leading-normal">Connection Type</p>
                                        <p class="text-primary text-sm font-normal leading-normal"><%= product.connectionType || '—' %></p>
                                    </div>
                                    <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                        <p class="text-primary text-sm font-normal leading-normal">Form Factor</p>
                                        <p class="text-primary text-sm font-normal leading-normal"><%= product.formFactor || '—' %></p>
                                    </div>
                                    <% if (product.driverSize) { %>
                                        <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                            <p class="text-primary text-sm font-normal leading-normal">Driver Size</p>
                                            <p class="text-primary text-sm font-normal leading-normal"><%= product.driverSize %></p>
                                        </div>
                                    <% } %>
                                    <% if (product.batteryLife) { %>
                                        <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                            <p class="text-primary text-sm font-normal leading-normal">Battery Life</p>
                                            <p class="text-primary text-sm font-normal leading-normal"><%= product.batteryLife %></p>
                                        </div>
                                    <% } %>
                                    <% if (product.bluetoothVersion) { %>
                                        <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                            <p class="text-primary text-sm font-normal leading-normal">Bluetooth Version</p>
                                            <p class="text-primary text-sm font-normal leading-normal"><%= product.bluetoothVersion %></p>
                                        </div>
                                    <% } %>
                                    <% if (product.weight) { %>
                                        <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                            <p class="text-primary text-sm font-normal leading-normal">Weight</p>
                                            <p class="text-primary text-sm font-normal leading-normal"><%= product.weight %>g</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <% if (noiseCancellationTypes.length || advancedAudio.length || buildMeta.length || smartMeta.length || compatibilityMeta.length || product.formFactor || product.earpieceShape || product.impedanceRange || product.sensitivityRange || typeof product.ambientModeAvailable === 'boolean' || product.hasMicrophone || product.batteryChargingTime) { %>
                                <div class="bg-white border border-primary-light/40 rounded-lg p-4 space-y-4">
                                    <h3 class="text-primary text-lg font-bold leading-tight">Technical Highlights</h3>
                                    <% if (noiseCancellationTypes.length || advancedAudio.length || product.formFactor || product.earpieceShape || product.impedanceRange || product.sensitivityRange || typeof product.ambientModeAvailable === 'boolean') { %>
                                        <div>
                                            <p class="text-sm font-semibold text-primary mb-1">Audio</p>
                                            <div class="space-y-1 text-sm text-gray-700">
                                                <% if (product.formFactor) { %><p><span class="font-semibold text-primary">Form Factor:</span> <%= product.formFactor %></p><% } %>
                                                <% if (product.earpieceShape) { %><p><span class="font-semibold text-primary">Earpiece Shape:</span> <%= product.earpieceShape %></p><% } %>
                                                <% if (product.impedanceRange) { %><p><span class="font-semibold text-primary">Impedance Range:</span> <%= product.impedanceRange %></p><% } %>
                                                <% if (product.sensitivityRange) { %><p><span class="font-semibold text-primary">Sensitivity Range:</span> <%= product.sensitivityRange %></p><% } %>
                                                <% if (noiseCancellationTypes.length) { %><p><span class="font-semibold text-primary">Noise Cancellation Types:</span> <%= noiseCancellationTypes.join(', ') %></p><% } %>
                                                <% if (advancedAudio.length) { %><p><span class="font-semibold text-primary">Audio Driver Types:</span> <%= advancedAudio.join(', ') %></p><% } %>
                                                <% if (typeof product.ambientModeAvailable === 'boolean') { %><p><span class="font-semibold text-primary">Ambient Mode:</span> <%= product.ambientModeAvailable ? 'Yes' : 'No' %></p><% } %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <% if (buildMeta.length) { %>
                                        <div>
                                            <p class="text-sm font-semibold text-primary mb-1">Build & Materials</p>
                                            <div class="space-y-1 text-sm text-gray-700">
                                                <% if (Array.isArray(product.materials) && product.materials.length) { %><p><span class="font-semibold text-primary">Materials:</span> <%= product.materials.join(', ') %></p><% } %>
                                                <% if (Array.isArray(product.cableFeatures) && product.cableFeatures.length) { %><p><span class="font-semibold text-primary">Cable Features:</span> <%= product.cableFeatures.join(', ') %></p><% } %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <% if (smartMeta.length || typeof product.hasMicrophone === 'boolean' || product.batteryChargingTime) { %>
                                        <div>
                                            <p class="text-sm font-semibold text-primary mb-1">Controls & Smart</p>
                                            <div class="space-y-1 text-sm text-gray-700">
                                                <% if (Array.isArray(product.controlMethods) && product.controlMethods.length) { %><p><span class="font-semibold text-primary">Control Methods:</span> <%= product.controlMethods.join(', ') %></p><% } %>
                                                <% if (Array.isArray(product.smartFeatures) && product.smartFeatures.length) { %><p><span class="font-semibold text-primary">Smart Features:</span> <%= product.smartFeatures.join(', ') %></p><% } %>
                                                <% if (typeof product.hasMicrophone === 'boolean') { %><p><span class="font-semibold text-primary">Microphone:</span> <%= product.hasMicrophone ? 'Yes' : 'No' %></p><% } %>
                                                <% if (product.batteryChargingTime) { %><p><span class="font-semibold text-primary">Battery Charging Time:</span> <%= product.batteryChargingTime %>h</p><% } %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <% if (compatibilityMeta.length) { %>
                                        <div>
                                            <p class="text-sm font-semibold text-primary mb-1">Compatibility & Box Contents</p>
                                            <div class="space-y-1 text-sm text-gray-700">
                                                <% if (Array.isArray(product.compatibleDevices) && product.compatibleDevices.length) { %><p><span class="font-semibold text-primary">Compatible Devices:</span> <%= product.compatibleDevices.join(', ') %></p><% } %>
                                                <% if (Array.isArray(product.includedComponents) && product.includedComponents.length) { %><p><span class="font-semibold text-primary">Included Components:</span> <%= product.includedComponents.join(', ') %></p><% } %>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            <% } %>

                            <div class="bg-white border border-primary-light/40 rounded-lg p-4">
                                <h3 class="text-primary text-lg font-bold leading-tight mb-2">Reviews</h3>
                                <p class="text-primary text-base font-normal leading-normal">No reviews yet.</p>
                            </div>
                        </section>

                        <aside class="lg:col-span-3 flex flex-col gap-6">
                            <div class="lg:sticky lg:top-24 border border-primary-light/45 bg-white rounded-lg shadow-sm p-4 space-y-4">
                                <div class="pb-3 border-b border-primary-light/30">
                                    <% const adminFinalPrice = Number(product.price || 0) - ((Number(product.price || 0) * Number(product.discountPercentage || 0)) / 100); %>
                                    <h2 class="text-primary tracking-light text-[30px] font-bold leading-tight">₹<%= adminFinalPrice.toLocaleString('en-IN') %></h2>
                                    <% if (Number(product.discountPercentage || 0) > 0) { %>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-gray-500 line-through text-sm">₹<%= Number(product.price || 0).toLocaleString('en-IN') %></span>
                                            <span class="rounded-md bg-accent px-2 py-1 text-xs font-bold text-black"><%= product.discountPercentage %>% OFF</span>
                                        </div>
                                    <% } %>
                                </div>

                                <div>
                                    <% const initialVariantStock = selectedVariant ? (parseInt(selectedVariant.stockCount, 10) || 0) : 0; %>
                                    <% const reorderThreshold = parseInt(product.reorderThreshold, 10) || 0; %>
                                    <% let initialStockText = 'Out of Stock'; %>
                                    <% let initialStockClass = 'text-red-600'; %>
                                    <% if (initialVariantStock > 0 && initialVariantStock <= reorderThreshold) { %>
                                        <% initialStockText = `⚠ Low Stock (${initialVariantStock} pieces remaining)`; %>
                                    <% } else if (initialVariantStock > reorderThreshold) { %>
                                        <% initialStockText = `In Stock (${initialVariantStock} pieces remaining)`; %>
                                        <% initialStockClass = 'text-green-700'; %>
                                    <% } %>
                                    <span id="variantStockLabel" class="<%= initialStockClass %> font-semibold">
                                        <%= initialStockText %>
                                    </span>
                                </div>

                                <% if (hasVariants) { %>
                                    <div>
                                        <p class="text-sm text-primary font-semibold mb-2">Color</p>
                                        <div id="colorSelector" class="flex flex-wrap gap-2">
                                            <% product.variants.forEach((variant, index) => { %>
                                                <button type="button"
                                                    class="variant-chip h-8 w-8 rounded-full border-2 <%= index === 0 ? 'border-primary ring-1 ring-primary' : 'border-gray-300' %>"
                                                    data-variant-index="<%= index %>"
                                                    title="<%= variant.colorName || variant.colorCode %>"
                                                    style="background-color:<%= variant.colorCode %>"></button>
                                            <% }) %>
                                        </div>
                                        <p id="selectedColorLabel" class="text-xs text-[#685BCB] mt-2"><%= selectedVariant && (selectedVariant.colorName || selectedVariant.colorCode) %></p>
                                    </div>
                                <% } %>

                                <div class="space-y-3">
                                    <a href="/admin/products/edit/<%= product._id %>"
                                        class="theme-primary-btn w-full flex cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 text-sm leading-normal tracking-[0.015em]">
                                        Edit
                                    </a>

                                    <button id="deleteBtn"
                                        class="theme-accent-btn w-full flex h-10 items-center justify-center rounded-lg px-6 text-sm font-bold">
                                        Delete
                                    </button>

                                    <button id="toggleListBtn"
                                        class="w-full flex items-center justify-center gap-2 rounded-lg h-10 border border-primary-light/45 text-primary hover:bg-primary-light/35">
                                        <span><%= product.isListed ? 'Unlist' : 'List' %></span>
                                    </button>
                                </div>

                                <div class="pt-3 border-t border-primary-light/30 space-y-2 text-sm text-primary">
                                    <p><span class="font-semibold">Status:</span> <%= product.status || 'N/A' %></p>
                                    <p><span class="font-semibold">Listed:</span> <%= product.isListed ? 'Yes' : 'No' %></p>
                                    <% if (hasWarranty) { %>
                                        <p><span class="font-semibold">Warranty:</span> <%= warrantyDuration %> <%= warrantyProvider === 'SoundWave' ? 'SoundWave warranty.' : 'manufacturer warranty.' %></p>
                                    <% } %>
                                </div>
                            </div>

                        </aside>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let currentIndex = 0;
            let currentVariantIndex = 0;
            const variants = <%- JSON.stringify(product && Array.isArray(product.variants) ? product.variants : []) %>;

            const mainImg = document.getElementById('mainImage');
            const zoomBox = document.getElementById('zoomBox');
            const container = document.getElementById('imageContainer');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const colorLabel = document.getElementById('selectedColorLabel');
            const stockLabel = document.getElementById('variantStockLabel');
            const colorChips = Array.from(document.querySelectorAll('.variant-chip'));
            const thumbnailStrip = document.querySelector('.thumbnail-image')?.parentElement || null;

            function toUrls(images) {
                return (images || [])
                    .map((img) => {
                        if (!img || typeof img !== 'object') return img;
                        const crop = img.crop;
                        if (!crop || !img.url || !String(img.url).includes('/upload/')) return img.url;
                        const x = Number(crop.x);
                        const y = Number(crop.y);
                        const width = Number(crop.width);
                        const height = Number(crop.height);
                        if (![x, y, width, height].every(Number.isFinite)) return img.url;
                        if (width <= 0 || height <= 0) return img.url;
                        return String(img.url).replace('/upload/', `/upload/c_crop,x_${Math.max(0, Math.round(x))},y_${Math.max(0, Math.round(y))},w_${Math.round(width)},h_${Math.round(height)}/`);
                    })
                    .filter((url) => typeof url === 'string' && url.trim().length > 0);
            }

            function getActiveImageUrls() {
                if (variants.length > 0) {
                    const variant = variants[currentVariantIndex] || {};
                    const variantUrls = toUrls(variant.images || []);
                    if (variantUrls.length > 0) return variantUrls;
                }
                return [];
            }

            let activeImageUrls = getActiveImageUrls();
            if (activeImageUrls.length > 0 && mainImg) {
                const currentSrc = mainImg.getAttribute('src');
                const found = activeImageUrls.findIndex((url) => (
                    url === currentSrc ||
                    mainImg.src === url ||
                    mainImg.src.endsWith(url)
                ));
                if (found !== -1) currentIndex = found;
            }

            function updateZoomBackground() {
                if (zoomBox && mainImg) {
                    zoomBox.style.backgroundImage = `url('${mainImg.src}')`;
                    zoomBox.style.backgroundSize = '200% 200%';
                }
            }

            function renderThumbnails() {
                if (!thumbnailStrip) return;
                thumbnailStrip.innerHTML = '';
                if (activeImageUrls.length <= 1) {
                    thumbnailStrip.classList.add('hidden');
                    return;
                }
                thumbnailStrip.classList.remove('hidden');
                activeImageUrls.forEach((url, index) => {
                    const btn = document.createElement('button');
                    btn.className = `thumbnail-image w-20 h-20 border-2 rounded-lg overflow-hidden flex-shrink-0 transition-all duration-200 bg-white p-1 ${index === currentIndex ? 'border-primary ring-1 ring-primary scale-105' : 'border-gray-200 hover:border-primary-light'}`;
                    btn.dataset.index = String(index);
                    btn.innerHTML = `<img src="${url}" class="w-full h-full object-contain" alt="Thumbnail ${index + 1}">`;
                    btn.addEventListener('click', () => updateHeroImage(index));
                    thumbnailStrip.appendChild(btn);
                });
            }

            function updateSelectedColorState() {
                if (!colorChips.length) return;
                colorChips.forEach((chip, idx) => {
                    if (idx === currentVariantIndex) {
                        chip.classList.add('border-primary', 'ring-1', 'ring-primary');
                        chip.classList.remove('border-gray-300');
                    } else {
                        chip.classList.remove('border-primary', 'ring-1', 'ring-primary');
                        chip.classList.add('border-gray-300');
                    }
                });
                if (colorLabel && variants[currentVariantIndex]) {
                    colorLabel.textContent = variants[currentVariantIndex].colorName || variants[currentVariantIndex].colorCode || '';
                }
                if (stockLabel) {
                    const activeVariant = variants[currentVariantIndex] || {};
                    const stockCount = parseInt(activeVariant.stockCount, 10) || 0;
                    const reorderThreshold = <%- JSON.stringify(parseInt(product.reorderThreshold, 10) || 0) %>;

                    let stockText = 'Out of Stock';
                    let isInStock = false;

                    if (stockCount > 0 && stockCount <= reorderThreshold) {
                        stockText = `⚠ Low Stock (${stockCount} pieces remaining)`;
                    } else if (stockCount > reorderThreshold) {
                        stockText = `In Stock (${stockCount} pieces remaining)`;
                        isInStock = true;
                    }

                    stockLabel.textContent = stockText;
                    stockLabel.classList.toggle('text-green-700', isInStock);
                    stockLabel.classList.toggle('text-red-600', !isInStock);
                }
            }

            function updateHeroImage(index) {
                if (!activeImageUrls.length || !mainImg) return;

                if (index < 0) index = activeImageUrls.length - 1;
                if (index >= activeImageUrls.length) index = 0;

                currentIndex = index;
                mainImg.src = activeImageUrls[currentIndex];
                updateZoomBackground();

                document.querySelectorAll('.thumbnail-image').forEach((btn, idx) => {
                    if (idx === currentIndex) {
                        btn.classList.add('border-primary', 'ring-1', 'ring-primary', 'scale-105');
                        btn.classList.remove('border-gray-200', 'hover:border-primary-light');
                    } else {
                        btn.classList.remove('border-primary', 'ring-1', 'ring-primary', 'scale-105');
                        btn.classList.add('border-gray-200', 'hover:border-primary-light');
                    }
                });
            }

            function switchVariant(variantIndex) {
                currentVariantIndex = variantIndex;
                activeImageUrls = getActiveImageUrls();
                currentIndex = 0;
                if (mainImg && activeImageUrls.length > 0) {
                    mainImg.src = activeImageUrls[0];
                }
                updateZoomBackground();
                renderThumbnails();
                updateSelectedColorState();
            }

            updateZoomBackground();
            renderThumbnails();
            updateSelectedColorState();

            if (prevBtn) prevBtn.addEventListener('click', () => updateHeroImage(currentIndex - 1));
            if (nextBtn) nextBtn.addEventListener('click', () => updateHeroImage(currentIndex + 1));
            colorChips.forEach((chip) => chip.addEventListener('click', () => switchVariant(Number(chip.dataset.variantIndex))));

            if (container && zoomBox) {
                container.addEventListener('mousemove', (e) => {
                    const rect = container.getBoundingClientRect();
                    const x = ((e.clientX - rect.left) / rect.width) * 100;
                    const y = ((e.clientY - rect.top) / rect.height) * 100;
                    zoomBox.style.backgroundPosition = `${x}% ${y}%`;
                    zoomBox.style.display = 'block';
                    zoomBox.style.visibility = 'visible';
                    zoomBox.style.opacity = '1';
                });

                container.addEventListener('mouseleave', () => {
                    zoomBox.style.display = 'none';
                });
            }
        });

        document.getElementById('deleteBtn')?.addEventListener('click', async function () {
            const result = await Swal.fire({
                title: 'Delete Product?',
                text: 'This will unlist the product.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#aaa',
                confirmButtonText: 'Yes, Delete'
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch('/admin/products/<%= product._id %>', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (response.ok && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: data.message || 'Product unlisted successfully',
                        timer: 1200,
                        showConfirmButton: false
                    });
                    window.location.href = '/admin/products';
                } else {
                    Swal.fire('Error', data.message || 'Failed to delete product', 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'An unexpected error occurred', 'error');
            }
        });

        document.getElementById('toggleListBtn')?.addEventListener('click', async function () {
            try {
                const response = await fetch('/admin/products/<%= product._id %>/toggle-list', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (response.ok && data.success) {
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.message || 'Failed to update listing', 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'An unexpected error occurred', 'error');
            }
        });
    </script>
</body>

</html>
