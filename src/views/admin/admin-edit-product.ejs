                                                    <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Meta Title</p>
                                                    <input id="metaTitle" name="metaTitle" placeholder="Meta Title"
                                                        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                        value="<%= product.metaTitle || '' %>" />
                                                </label>
                                            </div>
                                            <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                <label class="flex flex-col min-w-40 flex-1">
                                                    <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Meta Description</p>
                                                    <textarea id="metaDescription" name="metaDescription" placeholder="Meta Description"
                                                        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] min-h-36 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"><%= product.metaDescription || '' %></textarea>
                                                </label>
                                            </div>
                    </div>

<!-- Action Buttons -->
                    <div class="flex justify-stretch">
                        <div class="flex flex-1 gap-3 flex-wrap px-4 py-3 justify-end">
                            <button type="button" onclick="window.location.href='/admin/products/<%= product._id %>'"
                                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 bg-[#FFFFFF] text-[#1F1F1F] text-sm font-bold leading-normal tracking-[0.015em]">
                                <span class="truncate">Cancel</span>
                            </button>
                            <button type="submit" id="updateProductBtn"
                                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 bg-[#685BCB] text-white text-sm font-bold leading-normal tracking-[0.015em]">
                                <span class="truncate">Update Product</span>
                            </button>
                        </div>
                    </div>
                </form>
            </section>
        </main>
    </div>

    <!-- Scripts -->
    <script>
        const PRODUCT_ID = '<%= product._id %>';

        // ========== Variant Management ==========
        const hasVariantsToggle = document.getElementById('hasVariantsToggle');
        const variantBuilder = document.getElementById('variantBuilder');
        const variantList = document.getElementById('variantList');
        const variantError = document.getElementById('variantError');
        const addVariantBtn = document.getElementById('addVariantBtn');
        let variants = <%- JSON.stringify(product.variants || []) %>.map((variant) => ({
            colorInput: variant.colorName || variant.colorCode || '',
            colorName: variant.colorName || '',
            colorCode: variant.colorCode || '',
            existingImages: Array.isArray(variant.images) ? variant.images.map((img) => ({
                url: img.url,
                public_id: img.public_id
            })) : [],
            files: []
        }));

        function normalizeHex(value) {
            const raw = String(value || '').trim();
            if (/^#?[0-9a-fA-F]{6}$/.test(raw)) {
                return raw.startsWith('#') ? raw.toUpperCase() : `#${raw.toUpperCase()}`;
            }
            return '';
        }

        function rgbToHex(rgb) {
            const match = String(rgb).match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)/i);
            if (!match) return '';
            const parts = match.slice(1, 4).map((n) => Number(n).toString(16).padStart(2, '0').toUpperCase());
            return `#${parts.join('')}`;
        }

        function colorNameToHex(name) {
            const probe = document.createElement('span');
            probe.style.color = '';
            probe.style.color = String(name || '').trim();
            if (!probe.style.color) return '';
            document.body.appendChild(probe);
            const computed = getComputedStyle(probe).color;
            document.body.removeChild(probe);
            return rgbToHex(computed);
        }

        function resolveColor(input) {
            const hex = normalizeHex(input);
            if (hex) return { colorCode: hex, colorName: '' };
            const fromName = colorNameToHex(input);
            if (fromName) return { colorCode: fromName, colorName: String(input).trim() };
            return null;
        }

        function addVariant() {
            variants.push({ colorInput: '', colorName: '', colorCode: '', existingImages: [], files: [] });
            renderVariants();
        }

        function removeVariant(index) {
            variants.splice(index, 1);
            renderVariants();
        }

        function removeExistingVariantImage(variantIndex, imageIndex) {
            variants[variantIndex].existingImages.splice(imageIndex, 1);
            renderVariants();
        }

        function renderVariants() {
            variantList.innerHTML = '';
            variants.forEach((variant, index) => {
                const existingCount = variant.existingImages.length;
                const newCount = variant.files.length;

                const wrapper = document.createElement('div');
                wrapper.className = 'border border-[#BCA6DB] rounded-xl p-4 bg-white';
                wrapper.innerHTML = `
                    <div class="flex flex-wrap items-center gap-3">
                        <input type="text" data-role="color-input" data-index="${index}" value="${variant.colorInput || ''}"
                            placeholder="HEX or colour name (e.g., #000000 / royalblue)"
                            class="h-11 flex-1 min-w-[240px] rounded-xl border border-[#BCA6DB] px-3 text-sm text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB]">
                        <span class="inline-block w-8 h-8 rounded-full border border-[#BCA6DB]" style="background:${variant.colorCode || '#FFFFFF'}"></span>
                        <button type="button" data-role="remove-variant" data-index="${index}"
                            class="h-10 px-3 rounded-lg bg-[#ffecec] text-red-600 text-sm font-bold hover:bg-[#ffdddd]">Remove</button>
                    </div>
                    <p class="text-xs text-[#685BCB] mt-2">${variant.colorCode ? `Normalized: ${variant.colorCode}` : ''}</p>
                    <div class="mt-3">
                        <input type="file" data-role="variant-files" data-index="${index}" multiple accept="image/jpeg,image/png,image/webp"
                            class="block w-full text-sm text-[#1F1F1F]">
                        <p class="text-xs text-[#685BCB] mt-1">Existing: ${existingCount}, New: ${newCount}</p>
                    </div>
                    <div data-role="variant-existing-list" data-index="${index}" class="mt-2 flex flex-wrap gap-2"></div>
                `;
                variantList.appendChild(wrapper);

                const existingList = wrapper.querySelector('[data-role="variant-existing-list"]');
                variant.existingImages.forEach((img, imageIndex) => {
                    const chip = document.createElement('div');
                    chip.className = 'relative w-16 h-16 rounded-lg overflow-hidden border border-[#BCA6DB]';
                    chip.innerHTML = `<img src="${img.url}" class="w-full h-full object-cover"><button type="button" data-role="remove-existing-variant-image" data-variant-index="${index}" data-image-index="${imageIndex}" class="absolute top-0 right-0 bg-red-600 text-white text-[10px] px-1">x</button>`;
                    existingList.appendChild(chip);
                });
            });

            variantList.querySelectorAll('[data-role="color-input"]').forEach((input) => {
                input.addEventListener('input', function () {
                    const idx = Number(this.dataset.index);
                    variants[idx].colorInput = this.value;
                    const resolved = resolveColor(this.value);
                    variants[idx].colorCode = resolved ? resolved.colorCode : '';
                    variants[idx].colorName = resolved ? resolved.colorName : '';
                    renderVariants();
                });
            });

            variantList.querySelectorAll('[data-role="variant-files"]').forEach((input) => {
                input.addEventListener('change', function () {
                    const idx = Number(this.dataset.index);
                    variants[idx].files = Array.from(this.files || []).filter((f) =>
                        ['image/jpeg', 'image/png', 'image/webp'].includes(f.type)
                    );
                    renderVariants();
                });
            });

            variantList.querySelectorAll('[data-role="remove-variant"]').forEach((btn) => {
                btn.addEventListener('click', () => removeVariant(Number(btn.dataset.index)));
            });

            variantList.querySelectorAll('[data-role="remove-existing-variant-image"]').forEach((btn) => {
                btn.addEventListener('click', () => {
                    removeExistingVariantImage(Number(btn.dataset.variantIndex), Number(btn.dataset.imageIndex));
                });
            });
        }

        function validateVariants() {
            if (!variants.length) {
                variantError.textContent = 'Add at least one colour variant.';
                variantError.classList.add('visible');
                return false;
            }

            for (const variant of variants) {
                if (!variant.colorCode) {
                    variantError.textContent = 'Each variant needs a valid HEX or CSS colour name.';
                    variantError.classList.add('visible');
                    return false;
                }
                const total = variant.existingImages.length + variant.files.length;
                if (total < 3 || total > 10) {
                    variantError.textContent = 'Each variant must contain 3 to 10 images.';
                    variantError.classList.add('visible');
                    return false;
                }
            }

            variantError.classList.remove('visible');
            return true;
        }

        hasVariantsToggle.checked = true;
        hasVariantsToggle.disabled = true;
        variantBuilder.classList.remove('hidden');
        if (variants.length === 0) {
            addVariant();
        } else {
            renderVariants();
        }
        addVariantBtn.addEventListener('click', addVariant);

        const WIRED_FORM_FACTORS = ['In-Ear (Earbuds/IEMs)', 'Over-Ear', 'On-Ear', 'Clip-On', 'Ear Hooks'];
        const WIRELESS_FORM_FACTORS = ['True Wireless (TWS)', 'Neckband', 'Over-Ear', 'On-Ear', 'Bone Conduction', 'Ear Hooks'];
        const savedFormFactorRaw = <%- JSON.stringify(product.formFactor || '') %>;

        function normalizeFormFactor(value) {
            if (value === 'In-Ear') return 'In-Ear (Earbuds/IEMs)';
            return value || '';
        }

        function renderFormFactorOptions(connectionType, selectedValue) {
            const host = document.getElementById('formFactorOptions');
            if (!host) return;

            const options = connectionType === 'Wired'
                ? WIRED_FORM_FACTORS
                : connectionType === 'Wireless'
                    ? WIRELESS_FORM_FACTORS
                    : [];

            if (!options.length) {
                host.innerHTML = '<p id="formFactorHint" class="text-[#685BCB] text-sm">Select connection type first</p>';
                return;
            }

            const normalizedSelected = normalizeFormFactor(selectedValue);
            const labels = options.map((option, index) => {
                const id = `formFactor_${connectionType}_${index}`.replace(/\s+/g, '_').replace(/[()]/g, '');
                const checked = normalizedSelected === option ? 'checked' : '';
                return `<label class="inline-flex items-center gap-2 text-[#1F1F1F] text-sm">
                    <input id="${id}" type="radio" name="formFactor" value="${option}" ${checked}
                        class="h-4 w-4 border-[#BCA6DB] text-[#685BCB] focus:ring-[#685BCB]">
                    <span>${option}</span>
                </label>`;
            }).join('');

            host.innerHTML = labels;
        }

        // ========== Connection Type Toggle ==========
        const connectionTypeEl = document.getElementById('connectionType');
        const syncConnectionUI = function () {
            const wiredSpecs = document.getElementById('wiredSpecs');
            const wirelessSpecs = document.getElementById('wirelessSpecs');
            const selectedFormFactor = (document.querySelector('[name="formFactor"]:checked') || {}).value || savedFormFactorRaw;
            if (!wiredSpecs || !wirelessSpecs) return;
            wiredSpecs.classList.add('hidden');
            wirelessSpecs.classList.add('hidden');
            if (this.value === 'Wired') {
                wiredSpecs.classList.remove('hidden');
                renderFormFactorOptions('Wired', selectedFormFactor);
            } else if (this.value === 'Wireless') {
                wirelessSpecs.classList.remove('hidden');
                renderFormFactorOptions('Wireless', selectedFormFactor);
            } else {
                renderFormFactorOptions('', '');
            }
        };
        if (connectionTypeEl) {
            connectionTypeEl.addEventListener('change', syncConnectionUI);
            syncConnectionUI.call(connectionTypeEl);
        }

        // ========== Validation Helpers ==========
        function showError(inputEl, errorEl) {
            inputEl.classList.add('input-error');
            errorEl.classList.add('visible');
        }
        function clearError(inputEl, errorEl) {
            inputEl.classList.remove('input-error');
            errorEl.classList.remove('visible');
        }

        function validatePattern(id, errorId) {
            const input = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!input || !error) return true;
            if (input.value.trim() === '') {
                if (input.hasAttribute('required')) {
                    showError(input, error);
                    error.textContent = 'This field is required';
                    return false;
                }
                clearError(input, error);
                return true;
            }
            const pattern = input.getAttribute('pattern');
            if (pattern && !new RegExp(pattern).test(input.value.trim())) {
                showError(input, error);
                return false;
            }
            clearError(input, error);
            return true;
        }

        function validateNumber(id, errorId, isRequired) {
            const input = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!input || !error) return true;
            const val = input.value.trim();
            if (val === '') {
                if (isRequired) {
                    showError(input, error);
                    error.textContent = 'This field is required';
                    return false;
                }
                clearError(input, error);
                return true;
            }
            const num = parseFloat(val);
            if (isNaN(num) || num < 0) {
                showError(input, error);
                return false;
            }
            const max = input.getAttribute('max');
            if (max && num > parseFloat(max)) {
                showError(input, error);
                return false;
            }
            clearError(input, error);
            return true;
        }

        function validateSelect(id, errorId) {
            const select = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!select || !error) return true;
            if (!select.value) {
                showError(select, error);
                return false;
            }
            clearError(select, error);
            return true;
        }

        function setupAutoPriceCalculation() {
            const originalPriceEl = document.getElementById('originalPrice');
            const discountEl = document.getElementById('discountPercentage');
            const priceEl = document.getElementById('productPrice');
            if (!originalPriceEl || !discountEl || !priceEl) return;
            if (originalPriceEl.dataset.priceCalcBound === 'true') return;

            const recalcPrice = () => {
                const originalRaw = originalPriceEl.value.trim();
                const discountRaw = discountEl.value.trim();
                if (!originalRaw || !discountRaw) return;

                const originalPrice = Number(originalRaw);
                const discount = Number(discountRaw);
                if (!Number.isFinite(originalPrice) || !Number.isFinite(discount)) return;
                if (originalPrice < 0 || discount < 0 || discount > 90) return;

                const computed = originalPrice - ((originalPrice * discount) / 100);
                priceEl.value = Math.max(0, computed).toFixed(2);
            };

            originalPriceEl.addEventListener('input', recalcPrice);
            discountEl.addEventListener('input', recalcPrice);
            originalPriceEl.addEventListener('change', recalcPrice);
            discountEl.addEventListener('change', recalcPrice);
            originalPriceEl.dataset.priceCalcBound = 'true';

            recalcPrice();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupAutoPriceCalculation);
        } else {
            setupAutoPriceCalculation();
        }

        // Real-time validation on blur
        document.querySelectorAll('#editProductForm input, #editProductForm select').forEach(function (el) {
            el.addEventListener('blur', function () {
                const errorEl = document.getElementById(el.id + 'Error');
                if (!errorEl) return;
                if (el.type === 'number') {
                    validateNumber(el.id, el.id + 'Error', el.hasAttribute('required'));
                } else if (el.tagName === 'SELECT') {
                    if (el.hasAttribute('required')) validateSelect(el.id, el.id + 'Error');
                } else {
                    validatePattern(el.id, el.id + 'Error');
                }
            });
        });

        // ========== Form Submission ==========
        document.getElementById('editProductForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            let valid = true;

            // Required fields
            if (!validatePattern('productTitle', 'productTitleError')) valid = false;
            if (!validatePattern('productSku', 'productSkuError')) valid = false;
            if (!validateSelect('brandSelect', 'brandSelectError')) valid = false;
            if (!validateSelect('connectionType', 'connectionTypeError')) valid = false;
            if (!validateSelect('categorySelect', 'categorySelectError')) valid = false;
            if (!validateNumber('productPrice', 'productPriceError', true)) valid = false;
            if (!validateNumber('stockCount', 'stockCountError', true)) valid = false;

            // Optional numeric fields
            if (!validateNumber('originalPrice', 'originalPriceError', false)) valid = false;
            if (!validateNumber('discountPercentage', 'discountPercentageError', false)) valid = false;
            if (!validateNumber('reservedCount', 'reservedCountError', false)) valid = false;
            if (!validateNumber('reorderThreshold', 'reorderThresholdError', false)) valid = false;
            if (!validateNumber('shippingLength', 'shippingLengthError', false)) valid = false;
            if (!validateNumber('shippingWidth', 'shippingWidthError', false)) valid = false;
            if (!validateNumber('shippingHeight', 'shippingHeightError', false)) valid = false;
            if (!validateNumber('shippingWeight', 'shippingWeightError', false)) valid = false;

            // Conditional specs
            const connType = document.getElementById('connectionType').value;
            if (connType === 'Wired') {
                if (!validateNumber('cableLength', 'cableLengthError', false)) valid = false;
                if (!validatePattern('connectorType', 'connectorTypeError')) valid = false;
                if (!validateNumber('impedance', 'impedanceError', false)) valid = false;
                if (!validateNumber('driverSize', 'driverSizeError', false)) valid = false;
            } else if (connType === 'Wireless') {
                if (!validateNumber('bluetoothVersion', 'bluetoothVersionError', false)) valid = false;
                if (!validateNumber('batteryLife', 'batteryLifeError', false)) valid = false;
                if (!validateNumber('chargingTime', 'chargingTimeError', false)) valid = false;
                if (!validateNumber('wirelessRange', 'wirelessRangeError', false)) valid = false;
            }

            if (!validateVariants()) valid = false;

            if (!valid) {
                const firstError = document.querySelector('.field-error.visible');
                if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            // Build FormData
            const formData = new FormData();
            const form = this;

            // Text/select fields
            const fieldNames = ['title', 'sku', 'brand', 'connectionType', 'category', 'shortDescription',
                'price', 'originalPrice', 'discountPercentage', 'stockCount', 'reservedCount', 'reorderThreshold',
                'cableLength', 'connectorType', 'impedance', 'driverSize',
                'bluetoothVersion', 'batteryLife', 'chargingTime', 'wirelessRange',
                'warrantyDuration', 'warrantyProvider',
                'length', 'width', 'height', 'weight', 'metaTitle', 'metaDescription',
                'formFactor', 'earpieceShape', 'impedanceRange', 'sensitivityRange', 'hasMicrophone', 'batteryChargingTime', 'ambientModeAvailable'];

            fieldNames.forEach(function (name) {
                const el = form.querySelector('[name="' + name + '"]');
                if (!el) return;
                if (el.type === 'checkbox') {
                    formData.append(name, el.checked ? 'true' : 'false');
                    return;
                }
                if (el.type === 'radio') {
                    const checkedRadio = form.querySelector(`[name="${name}"]:checked`);
                    formData.append(name, checkedRadio ? checkedRadio.value : '');
                    return;
                }
                formData.append(name, el.value);
            });

            // Badges
            document.querySelectorAll('[name="badges"]:checked').forEach(function (cb) {
                formData.append('badges', cb.value);
            });
            ['noiseControlTypes', 'controlMethods', 'cableFeatures', 'smartFeatures', 'compatibleDevices', 'materials', 'includedComponents', 'audioDriverTypes']
                .forEach((name) => {
                    document.querySelectorAll(`[name="${name}"]:checked`).forEach((cb) => {
                        formData.append(name, cb.value);
                    });
                });

            formData.append('hasVariants', 'true');
            const variantPayload = variants.map((variant) => ({
                colorName: variant.colorName || '',
                colorCode: variant.colorCode || '',
                existingImages: variant.existingImages || []
            }));
            formData.append('variantPayload', JSON.stringify(variantPayload));
            variants.forEach((variant, index) => {
                variant.files.forEach((file) => {
                    formData.append(`variantImages_${index}`, file);
                });
            });

            // Submit via PUT
            const submitBtn = document.getElementById('updateProductBtn');
            submitBtn.disabled = true;
            submitBtn.querySelector('span').textContent = 'Updating...';

            try {
                const res = await fetch('/admin/products/' + PRODUCT_ID, {
                    method: 'PUT',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/admin/products/' + PRODUCT_ID;
                } else {
                    alert(data.message || 'Failed to update product');
                    submitBtn.disabled = false;
                    submitBtn.querySelector('span').textContent = 'Update Product';
                }
            } catch (err) {
                alert('Error updating product. Please try again.');
                submitBtn.disabled = false;
                submitBtn.querySelector('span').textContent = 'Update Product';
            }
        });
    </script>
</body>

</html>
