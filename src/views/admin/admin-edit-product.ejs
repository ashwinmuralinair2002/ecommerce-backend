<!-- Admin Edit Product page — identical layout to Add Product, pre-filled -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />

    <title>Admin · Edit Product</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
    <style>
        :root {
            --checkbox-tick-svg: url('data:image/svg+xml,%3csvg viewBox=%270 0 16 16%27 fill=%27rgb(18,24,16)%27 xmlns=%27http://www.w3.org/2000/svg%27%3e%3cpath d=%27M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z%27/%3e%3c/svg%3e');
            --select-button-svg: url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2724px%27 height=%2724px%27 fill=%27rgb(101,141,94)%27 viewBox=%270 0 256 256%27%3e%3cpath d=%27M181.66,170.34a8,8,0,0,1,0,11.32l-48,48a8,8,0,0,1-11.32,0l-48-48a8,8,0,0,1,11.32-11.32L128,212.69l42.34-42.35A8,8,0,0,1,181.66,170.34Zm-96-84.68L128,43.31l42.34,42.35a8,8,0,0,0,11.32-11.32l-48-48a8,8,0,0,0-11.32,0l-48,48A8,8,0,0,0,85.66,85.66Z%27%3e%3c/path%3e%3c/svg%3e');
        }

        .field-error {
            color: #dc2626;
            font-size: 0.75rem;
            margin-top: 4px;
            display: none;
        }

        .field-error.visible {
            display: block;
        }

        .input-error {
            border-color: #dc2626 !important;
        }

        .hero-badge {
            position: absolute;
            top: 4px;
            left: 4px;
            background: #685BCB;
            color: #1F1F1F;
            font-size: 0.625rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .hero-set-btn {
            position: absolute;
            bottom: 4px;
            left: 4px;
            background: rgba(0, 0, 0, 0.6);
            color: #fff;
            font-size: 0.6rem;
            font-weight: 600;
            padding: 3px 7px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .image-preview-item:hover .hero-set-btn {
            opacity: 1;
        }

        .hero-set-btn:hover {
            background: rgba(55, 255, 20, 0.8);
            color: #1F1F1F;
        }

        .image-preview-item {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            aspect-ratio: 1;
        }

        .image-preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .image-remove-btn {
            position: absolute;
            top: 4px;
            right: 4px;
            background: rgba(220, 38, 38, 0.9);
            color: white;
            border: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
    </style>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'products' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 p-6 md:p-8">
                <!-- Breadcrumb -->
                <div class="flex flex-wrap gap-2 pb-4">
                    <a class="text-[#685BCB] text-base font-medium leading-normal" href="/admin/products">Products</a>
                    <span class="text-[#685BCB] text-base font-medium leading-normal">/</span>
                    <a class="text-[#685BCB] text-base font-medium leading-normal"
                        href="/admin/products/<%= product._id %>">
                        <%= product.title %>
                    </a>
                    <span class="text-[#685BCB] text-base font-medium leading-normal">/</span>
                    <span class="text-[#1F1F1F] text-base font-medium leading-normal">Edit</span>
                </div>

                <!-- Page Title -->
                <div class="flex flex-wrap justify-between gap-3 pb-4">
                    <p class="text-[#1F1F1F] tracking-light text-[32px] font-bold leading-tight min-w-72">Edit Product
                    </p>
                </div>

                <!-- Form Content -->
                <form id="editProductForm" class="w-full" enctype="multipart/form-data" novalidate>
                                                            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 items-start">
                        <div class="space-y-6">
                            <details open class="self-start mx-4 mt-4 rounded-xl border border-[#BCA6DB] bg-white p-4">
                                                                        <summary class="cursor-pointer text-[#1F1F1F] font-bold">1. Basic Details</summary>
                                                                        <div class="mt-4">
                                                                    <!-- Title -->
                                                                    <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                        <label class="flex flex-col min-w-40 flex-1">
                                                                            <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Title <span
                                                                                    class="text-red-500">*</span></p>
                                                                            <input id="productTitle" name="title" placeholder="Product Title" required
                                                                                pattern="^[a-zA-Z0-9 ]+$"
                                                                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                value="<%= product.title %>" />
                                                                            <p class="field-error" id="productTitleError">Only letters, numbers, and spaces allowed</p>
                                                                        </label>
                                                                    </div>
                            
                                                                    <!-- SKU -->
                                                                    <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                        <label class="flex flex-col min-w-40 flex-1">
                                                                            <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">SKU</p>
                                                                            <input id="productSku" name="sku" placeholder="SKU" pattern="^[a-zA-Z0-9\-]+$"
                                                                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                value="<%= product.sku %>" />
                                                                            <p class="field-error" id="productSkuError">Only letters, numbers, and hyphens allowed</p>
                                                                        </label>
                                                                    </div>
                            
                                                                    <!-- Brand (Dynamic, pre-selected) -->
                                                                    <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                        <label class="flex flex-col min-w-40 flex-1">
                                                                            <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Brand <span
                                                                                    class="text-red-500">*</span></p>
                                                                            <select id="brandSelect" name="brand" required
                                                                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 bg-[image:--select-button-svg] placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal">
                                                                                <option value="">Select Brand</option>
                                                                                <% if (brands && brands.length> 0) { %>
                                                                                    <% brands.forEach(function(brand) { %>
                                                                                        <option value="<%= brand._id %>" <%=product.brand && (product.brand._id ?
                                                                                            product.brand._id.toString() :
                                                                                            product.brand.toString())===brand._id.toString() ? 'selected' : '' %>><%=
                                                                                                brand.name %>
                                                                                        </option>
                                                                                        <% }) %>
                                                                                            <% } %>
                                                                            </select>
                                                                            <p class="field-error" id="brandSelectError">Please select a brand</p>
                                                                        </label>
                                                                    </div>
                            
                                                                    <!-- Connection Type (pre-selected) -->
                                                                    <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                        <label class="flex flex-col min-w-40 flex-1">
                                                                            <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Connection Type <span
                                                                                    class="text-red-500">*</span></p>
                                                                            <select id="connectionType" name="connectionType" required
                                                                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 bg-[image:--select-button-svg] placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal">
                                                                                <option value="">Select Connection Type</option>
                                                                                <option value="Wired" <%=product.connectionType==='Wired' ? 'selected' : '' %>>Wired
                                                                                </option>
                                                                                <option value="Wireless" <%=product.connectionType==='Wireless' ? 'selected' : '' %>
                                                                                    >Wireless</option>
                                                                            </select>
                                                                            <p class="field-error" id="connectionTypeError">Please select a connection type</p>
                                                                        </label>
                                                                    </div>
                            
                                                                    <!-- Category (pre-selected) -->
                                                                    <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                        <% const categoryRaw = (product && product.category && (product.category.name || product.category)) || ''; %>
                                                                        <label class="flex flex-col min-w-40 flex-1">
                                                                            <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Category <span
                                                                                    class="text-red-500">*</span></p>
                                                                            <select id="categorySelect" name="category" required
                                                                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 bg-[image:--select-button-svg] placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal">
                                                                                <option value="">Select Category</option>
                                                                                <% if (categories && categories.length > 0) { %>
                                                                                    <% categories.forEach(function(category) { %>
                                                                                        <option value="<%= category.name %>" <%= String(categoryRaw).toLowerCase() === String(category.name).toLowerCase() ? 'selected' : '' %>>
                                                                                            <%= category.name %>
                                                                                        </option>
                                                                                    <% }) %>
                                                                                <% } %>
                                                                            </select>
                                                                            <p class="field-error" id="categorySelectError">Please select a category</p>
                                                                        </label>
                                                                    </div>

                                                                    <!-- Form Factor -->
                                                                    <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                        <label class="flex flex-col min-w-40 flex-1">
                                                                            <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Form Factor</p>
                                                                            <div id="formFactorOptions" class="flex flex-wrap gap-4">
                                                                                <p id="formFactorHint" class="text-[#685BCB] text-sm">Select connection type first</p>
                                                                            </div>
                                                                        </label>
                                                                    </div>
                            
                                                                    <!-- Short Description -->
                                                                    <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                        <label class="flex flex-col min-w-40 flex-1">
                                                                            <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Short Description</p>
                                                                            <textarea id="shortDescription" name="shortDescription"
                                                                                placeholder="Brief product description"
                                                                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] min-h-36 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"><%= product.shortDescription || '' %></textarea>
                                                                        </label>
                                                                    </div>
                                                                        </div>
                                                                    </details>

                            <details open class="self-start mx-4 mt-4 rounded-xl border border-[#BCA6DB] bg-white p-4">
                                                                        <summary class="cursor-pointer text-[#1F1F1F] font-bold">4. Variants</summary>
                                                                        <div class="mt-4">
                                                                    <div class="px-4 py-2">
                                                                        <label class="flex items-center gap-2 text-sm text-[#1F1F1F] font-medium">
                                                                            <input type="checkbox" id="hasVariantsToggle"
                                                                                class="h-4 w-4 rounded border-[#BCA6DB] text-[#685BCB] focus:ring-[#685BCB]">
                                                                            Other colours available
                                                                        </label>
                                                                    </div>
                                                                    <div id="variantBuilder" class="hidden px-4 space-y-3">
                                                                        <p class="text-[#685BCB] text-sm">Each variant must include 3 to 10 images.</p>
                                                                        <div id="variantList" class="space-y-3"></div>
                                                                        <button type="button" id="addVariantBtn"
                                                                            class="h-10 px-4 rounded-xl bg-[#FFFFFF] text-[#1F1F1F] font-bold border border-[#BCA6DB] hover:bg-[#D3CEEA] transition-colors">
                                                                            + Add Colour Variant
                                                                        </button>
                                                                        <p class="field-error" id="variantError">Please fix variant details before submitting.</p>
                                                                    </div>
                            
                                                                    <!-- Conditional Specs: Wired -->
                                                                    <div id="wiredSpecs" class="<%= product.connectionType === 'Wired' ? '' : 'hidden' %>">
                                                                        <h3 class="text-[#1F1F1F] text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4">
                                                                            Wired Specs</h3>
                                                                        <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                            <label class="flex flex-col min-w-40 flex-1">
                                                                                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Cable Length</p>
                                                                                <input id="cableLength" name="cableLength" placeholder="e.g., 1.2" type="number"
                                                                                    step="0.01" min="0"
                                                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                    value="<%= product.cableLength || '' %>" />
                                                                                <p class="field-error" id="cableLengthError">Must be a positive number</p>
                                                                            </label>
                                                                            <label class="flex flex-col min-w-40 flex-1">
                                                                                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Connector Type</p>
                                                                                <input id="connectorType" name="connectorType" placeholder="e.g., 3.5mm Jack"
                                                                                    pattern="^[a-zA-Z0-9 .]+$"
                                                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                    value="<%= product.connectorType || '' %>" />
                                                                                <p class="field-error" id="connectorTypeError">Only letters, numbers, spaces, and
                                                                                    periods allowed</p>
                                                                            </label>
                                                                        </div>
                                                                        <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                            <label class="flex flex-col min-w-40 flex-1">
                                                                                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Impedance (Ω)</p>
                                                                                <input id="impedance" name="impedance" placeholder="e.g., 32" type="number" step="0.1"
                                                                                    min="0"
                                                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                    value="<%= product.impedance || '' %>" />
                                                                                <p class="field-error" id="impedanceError">Must be a positive number</p>
                                                                            </label>
                                                                            <label class="flex flex-col min-w-40 flex-1">
                                                                                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Driver Size (mm)</p>
                                                                                <input id="driverSize" name="driverSize" placeholder="e.g., 40" type="number" step="0.1"
                                                                                    min="0"
                                                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                    value="<%= product.driverSize || '' %>" />
                                                                                <p class="field-error" id="driverSizeError">Must be a positive number</p>
                                                                            </label>
                                                                        </div>
                                                                    </div>
                            
                                                                    <!-- Conditional Specs: Wireless -->
                                                                    <div id="wirelessSpecs" class="<%= product.connectionType === 'Wireless' ? '' : 'hidden' %>">
                                                                        <h3 class="text-[#1F1F1F] text-lg font-bold leading-tight tracking-[-0.015em] px-4 pb-2 pt-4">
                                                                            Wireless Specs</h3>
                                                                        <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                            <label class="flex flex-col min-w-40 flex-1">
                                                                                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Bluetooth Version
                                                                                </p>
                                                                                <input id="bluetoothVersion" name="bluetoothVersion" placeholder="e.g., 5.2"
                                                                                    type="number" step="0.1" min="0"
                                                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                    value="<%= product.bluetoothVersion || '' %>" />
                                                                                <p class="field-error" id="bluetoothVersionError">Must be a positive number</p>
                                                                            </label>
                                                                            <label class="flex flex-col min-w-40 flex-1">
                                                                                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Battery Life (hours)
                                                                                </p>
                                                                                <input id="batteryLife" name="batteryLife" placeholder="e.g., 30" type="number"
                                                                                    step="0.1" min="0"
                                                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                    value="<%= product.batteryLife || '' %>" />
                                                                                <p class="field-error" id="batteryLifeError">Must be a positive number</p>
                                                                            </label>
                                                                        </div>
                                                                        <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                            <label class="flex flex-col min-w-40 flex-1">
                                                                                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Charging Time
                                                                                    (hours)</p>
                                                                                <input id="chargingTime" name="chargingTime" placeholder="e.g., 2" type="number"
                                                                                    step="0.1" min="0"
                                                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                    value="<%= product.chargingTime || '' %>" />
                                                                                <p class="field-error" id="chargingTimeError">Must be a positive number</p>
                                                                            </label>
                                                                            <label class="flex flex-col min-w-40 flex-1">
                                                                                <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Wireless Range (m)
                                                                                </p>
                                                                                <input id="wirelessRange" name="wirelessRange" placeholder="e.g., 10" type="number"
                                                                                    step="0.1" min="0"
                                                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                    value="<%= product.wirelessRange || '' %>" />
                                                                                <p class="field-error" id="wirelessRangeError">Must be a positive number</p>
                                                                            </label>
                                                                        </div>
                                                                    </div>
                                                                        </div>
                                                                    </details>

                            <details class="self-start mx-4 mt-4 rounded-xl border border-[#BCA6DB] bg-white p-4">
                                                                        <summary class="cursor-pointer text-[#1F1F1F] font-bold">7. Build & Materials</summary>
                                                                        <div class="mt-4 flex flex-wrap gap-4">
                                                                            <% ['Plastic','Aluminium','Steel','Leather','Fabric','Silicone'].forEach(function(item){ %>
                                                                                <label><input type="checkbox" name="materials" value="<%= item %>" <%= product.materials && product.materials.includes(item) ? 'checked' : '' %>> <%= item %></label>
                                                                            <% }) %>
                                                                        </div>
                                                                    </details>

                            <details open class="self-start mx-4 mt-4 rounded-xl border border-[#BCA6DB] bg-white p-4">
                                                                        <summary class="cursor-pointer text-[#1F1F1F] font-bold">10. Inventory</summary>
                                                                        <div class="mt-4">
                                                                    <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                                                        <label class="flex flex-col min-w-40 flex-1">
                                                                            <p class="text-[#1F1F1F] text-base font-medium leading-normal pb-2">Reorder Threshold</p>
                                                                            <input id="reorderThreshold" name="reorderThreshold"
                                                                                placeholder="Minimum stock before reordering" type="number" step="1" min="0"
                                                                                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#1F1F1F] focus:outline-0 focus:ring-0 border border-[#BCA6DB] bg-white focus:border-[#BCA6DB] h-14 placeholder:text-[#685BCB] p-[15px] text-base font-normal leading-normal"
                                                                                value="<%= product.reorderThreshold %>" />
