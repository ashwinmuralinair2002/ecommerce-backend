                                                                                    <label><input type="radio" name="noiseControlTypes" value="Feedback ANC" <%= selectedNoiseControlType === 'Feedback ANC' ? 'checked' : '' %>> Feedback ANC</label>
                                                                                    <label><input type="radio" name="noiseControlTypes" value="Hybrid ANC" <%= selectedNoiseControlType === 'Hybrid ANC' ? 'checked' : '' %>> Hybrid ANC</label>
