<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900">
    <title>SoundWave - Coupons</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function clearSearch() {
            const searchInput = document.getElementById('couponSearch');

            if (!searchInput) {
                return;
            }

            searchInput.value = '';

            const url = new URL(window.location.href);
            url.searchParams.delete('search');
            url.searchParams.delete('page');
            window.location.href = url.toString();
        }

        function submitCouponFilters() {
            const filtersForm = document.getElementById('couponFiltersForm');

            if (!filtersForm) {
                return;
            }

            filtersForm.requestSubmit();
        }

        function handleDeleteCoupon(event, form, couponId) {
            event.preventDefault();

            Swal.fire({
                title: 'Delete Coupon?',
                text: 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then(async (result) => {
                if (!result.isConfirmed) {
                    return;
                }

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        throw new Error('Failed to delete coupon');
                    }

                    await Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: 'Coupon has been deleted.'
                    });

                    window.location.reload();
                } catch (error) {
                    await Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to delete coupon.'
                    });
                }
                });
        }
    </script>
</head>

<body>
    <%
        const formatCurrency = (value) => {
            const amount = Number(value || 0);

            return `₹ ${amount.toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            })}`;
        };

        const getCouponStatus = (couponData) => {
            const now = new Date();
            const startDate = couponData?.startDate ? new Date(couponData.startDate) : null;
            const endDate = couponData?.endDate ? new Date(couponData.endDate) : null;

            if (!couponData?.isActive) {
                return {
                    label: 'Inactive',
                    classes: 'bg-[#f3f4f6] text-[#6b7280]'
                };
            }

            if (startDate && now < startDate) {
                return {
                    label: 'Scheduled',
                    classes: 'bg-[#fff7e6] text-[#b45309]'
                };
            }

            if (endDate && now > endDate) {
                return {
                    label: 'Expired',
                    classes: 'bg-[#fef2f2] text-[#b91c1c]'
                };
            }

            return {
                label: 'Active',
                classes: 'bg-[#e6f4ea] text-[#1e7e34]'
            };
        };

        const safeCoupons = Array.isArray(coupons) ? coupons : [];
        const activePage = Number(currentPage) > 0 ? Number(currentPage) : 1;
        const pageCount = Number(totalPages) > 0 ? Number(totalPages) : 1;
        const couponCount = Number(totalCoupons) >= 0 ? Number(totalCoupons) : safeCoupons.length;
        const hasActiveFilters = Boolean(filters?.search || filters?.status || filters?.discountType);
        const baseParams = new URLSearchParams();

        if (filters?.search) baseParams.set('search', filters.search);
        if (filters?.status) baseParams.set('status', filters.status);
        if (filters?.discountType) baseParams.set('discountType', filters.discountType);

        const buildPageHref = (pageNumber) => {
            const params = new URLSearchParams(baseParams.toString());
            params.set('page', pageNumber);
            return `/admin/coupons?${params.toString()}`;
        };
    %>

    <div class="min-h-screen flex flex-col bg-white" style='font-family: Inter, "Noto Sans", sans-serif;'>
        <%- include("../partials/admin/navbar") %>

        <main class="flex flex-1 bg-white">
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'coupons' }) %>
            </aside>

            <section class="flex-1 p-6 md:p-8">
                <div class="admin-page-container max-w-[1400px] mx-auto">
                    <div class="flex flex-wrap justify-between gap-3 mb-6">
                        <div class="flex min-w-72 flex-col gap-1">
                            <h1 class="text-[32px] font-bold text-[#1F1F1F]">Coupons</h1>
                            <p class="text-[#685BCB] text-sm">Create and manage coupon campaigns for checkout promotions.</p>
                        </div>
                        <a href="/admin/coupons/create"
                            class="inline-flex items-center justify-center rounded-lg h-10 px-4 bg-[#685BCB] text-sm font-bold text-white hover:bg-[#5a4dc0] transition-colors">
                            Create Coupon
                        </a>
                    </div>

                    <% if (typeof formError === 'string' && formError) { %>
                        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= formError %></div>
                    <% } %>

                    <form id="couponFiltersForm" action="/admin/coupons" method="GET">
                        <div class="px-4 pt-1 pb-4">
                            <div class="relative">
                                <input
                                    id="couponSearch"
                                    type="text"
                                    name="search"
                                    value="<%= searchQuery || '' %>"
                                    placeholder="Search coupons..."
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] border border-[#BCA6DB] pl-4 pr-12 text-[#1F1F1F] placeholder:text-[#685BCB] focus:outline-none focus:ring-2 focus:ring-[#685BCB]" />
                                <button onclick="clearSearch()"
                                    type="button"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-full p-1 transition-colors"
                                    title="Clear Search">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                        viewBox="0 0 256 256">
                                        <path
                                            d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z">
                                        </path>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-4 px-4 pb-4">
                            <select id="statusFilter" name="status" onchange="submitCouponFilters()"
                                class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                                <option value="" <%= !filters?.status ? 'selected' : '' %>>All Statuses</option>
                                <option value="active" <%= filters?.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="inactive" <%= filters?.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                            </select>

                            <select id="discountTypeFilter" name="discountType" onchange="submitCouponFilters()"
                                class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                                <option value="" <%= !filters?.discountType ? 'selected' : '' %>>All Discount Types</option>
                                <option value="FLAT" <%= filters?.discountType === 'FLAT' ? 'selected' : '' %>>Flat</option>
                                <option value="PERCENTAGE" <%= filters?.discountType === 'PERCENTAGE' ? 'selected' : '' %>>Percentage</option>
                            </select>

                            <button type="submit" class="sr-only">Apply filters</button>
                        </div>
                    </form>

                    <div class="border-b border-[#BCA6DB] mx-4 mb-4"></div>

                    <div class="px-4 py-2 @container">
                        <div class="flex overflow-hidden rounded-lg border border-[#BCA6DB] bg-white">
                            <table class="flex-1">
                                <thead>
                                    <tr class="bg-white">
                                        <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Code</th>
                                        <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Type</th>
                                        <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Value</th>
                                        <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Min Order</th>
                                        <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Usage</th>
                                        <th class="px-4 py-3 text-left text-[#1F1F1F] w-60 text-sm font-medium leading-normal">Status</th>
                                        <th class="px-4 py-3 text-left text-[#1F1F1F] w-60 text-sm font-medium leading-normal">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="<%= safeCoupons.length ? 'hidden' : '' %>">
                                        <td colspan="7" class="text-center py-4 text-sm text-[#685BCB]">
                                            <%= hasActiveFilters ? 'No coupons match your current search or filters' : 'No coupons found yet' %>
                                        </td>
                                    </tr>
                                    <% safeCoupons.forEach((coupon) => { %>
                                        <%
                                            const discountValue = Number(coupon?.discountValue || 0);
                                            const minOrderValue = Number(coupon?.minOrderValue || 0);
                                            const usedCount = Number(coupon?.usedCount || 0);
                                            const usageLimit = coupon?.usageLimit == null ? '∞' : Number(coupon.usageLimit);
                                            const couponStatus = getCouponStatus(coupon);
                                        %>
                                        <tr class="border-t border-t-[#BCA6DB] hover:bg-gray-50">
                                            <td class="h-[72px] px-4 py-2 text-sm font-medium leading-normal text-[#1F1F1F]"><%= coupon?.code || '-' %></td>
                                            <td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal text-[#1F1F1F]"><%= coupon?.discountType || '-' %></td>
                                            <td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal text-[#1F1F1F]">
                                                <%= coupon?.discountType === 'PERCENTAGE' ? `${discountValue}%` : formatCurrency(discountValue) %>
                                            </td>
                                            <td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal text-[#1F1F1F]"><%= formatCurrency(minOrderValue) %></td>
                                            <td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal text-[#1F1F1F]"><%= usedCount %> / <%= usageLimit %></td>
                                            <td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
                                                <button
                                                    class="flex min-w-[84px] max-w-[480px] cursor-default items-center justify-center overflow-hidden rounded-lg h-8 px-4 text-sm font-medium leading-normal w-full user-select-none <%= couponStatus.classes %>">
                                                    <span class="truncate"><%= couponStatus.label %></span>
                                                </button>
                                            </td>
                                            <td class="h-[72px] px-4 py-2 text-sm">
                                                <div class="flex items-center gap-2">
                                                    <a href="/admin/coupons/<%= coupon._id %>"
                                                        class="px-3 py-1.5 rounded bg-[#685BCB] text-white text-xs font-medium hover:bg-[#5a4dc0]">
                                                        View
                                                    </a>

                                                    <form method="POST" action="/admin/coupons/<%= coupon._id %>/toggle-status">
                                                        <button
                                                            type="submit"
                                                            class="px-3 py-1.5 rounded text-xs font-medium <%= coupon.isActive ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700' %>">
                                                            <%= coupon.isActive ? 'Deactivate' : 'Activate' %>
                                                        </button>
                                                    </form>

                                                    <form method="POST" action="/admin/coupons/<%= coupon._id %>/delete"
                                                        onsubmit="handleDeleteCoupon(event, this, '<%= coupon._id %>');">
                                                        <button
                                                            type="submit"
                                                            class="px-3 py-1.5 rounded bg-red-100 text-red-700 text-xs font-medium">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="px-4 pt-6">
                        <div class="flex justify-center items-center gap-2">
                            <% if (activePage > 1) { %>
                                <a href="<%= buildPageHref(activePage - 1) %>"
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    &laquo; Previous
                                </a>
                            <% } else { %>
                                <span
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                    &laquo; Previous
                                </span>
                            <% } %>

                            <div class="flex gap-1">
                                <% for (let i = 1; i <= pageCount; i += 1) { %>
                                    <% if (i === activePage) { %>
                                        <span
                                            class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#685BCB] text-white text-sm font-bold">
                                            <%= i %>
                                        </span>
                                    <% } else { %>
                                        <a href="<%= buildPageHref(i) %>"
                                            class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                            <%= i %>
                                        </a>
                                    <% } %>
                                <% } %>
                            </div>

                            <% if (activePage < pageCount) { %>
                                <a href="<%= buildPageHref(activePage + 1) %>"
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    Next &raquo;
                                </a>
                            <% } else { %>
                                <span
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                    Next &raquo;
                                </span>
                            <% } %>
                        </div>

                        <p class="text-center text-sm text-[#685BCB] mt-2">
                            Showing page <%= activePage %> of <%= pageCount %> (<%= couponCount %> coupons)
                        </p>
                    </div>
                </div>
            </section>
        </main>
    </div>
    <script>
        (() => {
            const searchInput = document.getElementById('couponSearch');
            if (!searchInput) return;

            let debounceTimer;

            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(() => {
                    const query = searchInput.value.trim();
                    const url = new URL(window.location.href);

                    if (query) {
                        url.searchParams.set('search', query);
                    } else {
                        url.searchParams.delete('search');
                    }

                    url.searchParams.delete('page');
                    window.location.href = url.toString();
                }, 500);
            });
        })();
    </script>
</body>

</html>
