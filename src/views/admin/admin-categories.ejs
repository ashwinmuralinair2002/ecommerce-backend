<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900" />
    <title>Admin · Categories</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmAction(options, actionCallback) {
            Swal.fire({
                title: options.title,
                text: options.text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: options.confirmButtonColor || '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: options.confirmButtonText
            }).then((result) => {
                if (result.isConfirmed) actionCallback();
            });
        }

        function confirmCategoryDelete(categoryId) {
            confirmAction({
                title: 'Delete Category?',
                text: 'This will soft delete the category.',
                confirmButtonText: 'Yes, Delete',
                confirmButtonColor: '#d33'
            }, () => document.getElementById('delete-form-' + categoryId)?.submit());
        }

        function confirmCategoryBlockToggle(categoryId, isListed) {
            confirmAction({
                title: isListed ? 'Unlist Category?' : 'List Category?',
                text: isListed ? 'Category and its products will be hidden on user side.' : 'Category will become visible to users again.',
                confirmButtonText: isListed ? 'Yes, Unlist' : 'Yes, List',
                confirmButtonColor: isListed ? '#d33' : '#685BCB'
            }, () => document.getElementById('block-form-' + categoryId)?.submit());
        }

        function handleSearch(e) {
            if (e.key !== 'Enter') return;
            applyFilters();
        }

        function clearSearch() {
            const searchInput = document.getElementById('searchInput');
            if (searchInput) searchInput.value = '';
            applyFilters();
        }

        function applyFilters() {
            const params = new URLSearchParams();
            const search = document.getElementById('searchInput').value.trim();
            const status = document.getElementById('filterStatus').value;
            const sort = document.getElementById('sortSelect').value;

            if (search) params.set('search', search);
            if (status && status !== 'all') params.set('status', status);
            if (sort && sort !== 'newest') params.set('sort', sort);

            window.location.href = '/admin/categories?' + params.toString();
        }
    </script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white" style='font-family: Inter, "Noto Sans", sans-serif;'>
        <%- include("../partials/admin/navbar") %>

        <main class="flex flex-1 bg-white">
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'categories' }) %>
            </aside>

            <section class="flex-1 p-6 md:p-8">
                <div class="admin-page-container max-w-[1400px] mx-auto">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h1 class="text-3xl font-bold text-[#1F1F1F]">Categories</h1>
                            <p class="text-sm text-[#685BCB]">Manage categories, listing state, and visibility</p>
                        </div>
                        <a href="/admin/categories/add"
                            class="px-4 py-2 rounded-lg bg-[#685BCB] text-white font-bold hover:bg-[#5a4dc0] transition-colors">
                            Add Category
                        </a>
                    </div>

                    <div class="mb-4 relative">
                        <input id="searchInput" type="text" name="search" placeholder="Search category name" value="<%= locals.search || '' %>"
                            onkeydown="handleSearch(event)"
                            class="w-full h-12 rounded-xl bg-[#FFFFFF] border border-[#BCA6DB] pl-4 pr-12 text-[#1F1F1F] placeholder:text-[#685BCB] focus:outline-none focus:ring-2 focus:ring-[#685BCB]" />
                        <% if (locals.search) { %>
                            <button onclick="clearSearch()"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-full p-1 transition-colors"
                                title="Clear Search">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256">
                                    <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"></path>
                                </svg>
                            </button>
                        <% } %>
                    </div>

                    <div class="flex flex-wrap gap-4 pb-4">
                        <select id="filterStatus" onchange="applyFilters()"
                            class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                            <option value="all" <%= (status || 'all') === 'all' ? 'selected' : '' %>>All</option>
                            <option value="listed" <%= status === 'listed' ? 'selected' : '' %>>Listed</option>
                            <option value="unlisted" <%= status === 'unlisted' ? 'selected' : '' %>>Unlisted</option>
                        </select>

                        <select id="sortSelect" onchange="applyFilters()"
                            class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                            <option value="newest" <%= (currentSort || 'newest') === 'newest' ? 'selected' : '' %>>Newest</option>
                            <option value="oldest" <%= currentSort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                        </select>
                    </div>

                    <div class="overflow-hidden rounded-xl border border-[#BCA6DB]">
                        <table class="w-full">
                            <thead class="bg-white border-b">
                                <tr>
                                    <th class="p-3 text-left">Category</th>
                                    <th class="p-3 text-left">Slug</th>
                                    <th class="p-3 text-left">Status</th>
                                    <th class="p-3 text-left">Last Updated</th>
                                    <th class="p-3 text-left">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!categories || categories.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="p-6 text-center text-[#685BCB]">No categories found</td>
                                    </tr>
                                <% } %>
                                <% (categories || []).forEach(category => { %>
                                    <tr class="border-t border-[#BCA6DB] cursor-pointer hover:bg-gray-50"
                                        onclick="window.location.href='/admin/categories/<%= category._id %>'">
                                        <td class="p-3 flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-lg bg-cover bg-center <%= category.image && category.image.url ? '' : 'bg-[#D3CEEA]' %>"
                                                style="<%= category.image && category.image.url ? 'background-image:url(' + category.image.url + ')' : '' %>"></div>
                                            <span class="font-medium text-[#1F1F1F]"><%= category.name %></span>
                                        </td>
                                        <td class="p-3 text-[#685BCB]"><%= category.slug || '-' %></td>
                                        <td class="p-3">
                                            <span class="px-4 py-1 rounded-lg text-sm font-medium <%= category.isBlocked ? 'bg-[#ffecec] text-red-600' : 'bg-[#e6f4ea] text-[#1e7e34]' %>">
                                                <%= category.isBlocked ? 'Unlisted' : 'Listed' %>
                                            </span>
                                        </td>
                                        <td class="p-3 text-[#685BCB]"><%= new Date(category.updatedAt).toDateString() %></td>
                                        <td class="p-3 flex gap-3 text-sm font-medium text-[#685BCB]" onclick="event.stopPropagation()">
                                            <button type="button" onclick="event.stopPropagation(); window.location.href='/admin/categories/<%= category._id %>/edit'">Edit</button>
                                            <button type="button"
                                                class="<%= category.isBlocked ? 'text-[#685BCB]' : 'text-red-600' %>"
                                                onclick="event.stopPropagation(); confirmCategoryBlockToggle('<%= category._id %>', <%= !category.isBlocked %>)">
                                                <%= category.isBlocked ? 'List' : 'Unlist' %>
                                            </button>
                                            <button type="button" class="text-red-600"
                                                onclick="event.stopPropagation(); confirmCategoryDelete('<%= category._id %>')">Delete</button>
                                            <form id="block-form-<%= category._id %>" method="POST"
                                                action="/admin/categories/<%= category._id %>/block-toggle?_method=PATCH" style="display:none;"></form>
                                            <form id="delete-form-<%= category._id %>" method="POST"
                                                action="/admin/categories/<%= category._id %>/delete" style="display:none;"></form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% if (pagination && pagination.totalPages > 1) { %>
                        <% var qp = [];
                           if (search) qp.push('search=' + encodeURIComponent(search));
                           if (status && status !== 'all') qp.push('status=' + encodeURIComponent(status));
                           if (currentSort && currentSort !== 'newest') qp.push('sort=' + encodeURIComponent(currentSort));
                           var baseQs = qp.length > 0 ? '&' + qp.join('&') : ''; %>
                        <div class="flex justify-center items-center gap-2 mt-6">
                            <% if (pagination.hasPrevPage) { %>
                                <a href="/admin/categories?page=<%= pagination.currentPage - 1 %><%= baseQs %>"
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    &laquo; Previous
                                </a>
                            <% } else { %>
                                <span class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                    &laquo; Previous
                                </span>
                            <% } %>

                            <div class="flex gap-1">
                                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                    <% if (i === pagination.currentPage) { %>
                                        <span class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#685BCB] text-white text-sm font-bold"><%= i %></span>
                                    <% } else { %>
                                        <a href="/admin/categories?page=<%= i %><%= baseQs %>"
                                            class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                            <%= i %>
                                        </a>
                                    <% } %>
                                <% } %>
                            </div>

                            <% if (pagination.hasNextPage) { %>
                                <a href="/admin/categories?page=<%= pagination.currentPage + 1 %><%= baseQs %>"
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    Next &raquo;
                                </a>
                            <% } else { %>
                                <span class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                    Next &raquo;
                                </span>
                            <% } %>
                        </div>

                        <p class="text-center text-sm text-[#685BCB] mt-2">
                            Showing page <%= pagination.currentPage %> of <%= pagination.totalPages %> (<%= pagination.totalCategories %> categories)
                        </p>
                    <% } %>
                </div>
            </section>
        </main>
    </div>
</body>

</html>
