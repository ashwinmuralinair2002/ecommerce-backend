<!-- Admin product listing page with dynamic data, search, filters, sort, pagination, and select mode -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />

    <title>Admin · Products</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // ──── Search ────
        function handleSearch(e) {
            if (e.key === 'Enter') {
                applyFilters();
            }
        }
        function clearSearch() {
            document.getElementById('searchInput').value = '';
            applyFilters();
        }

        // ──── Filters / Sort ────
        function applyFilters() {
            const params = new URLSearchParams();
            const search = document.getElementById('searchInput').value.trim();
            const category = document.getElementById('filterCategory').value;
            const brand = document.getElementById('filterBrand').value;
            const connectionType = document.getElementById('filterConnection').value;
            const sort = document.getElementById('sortSelect').value;

            if (search) params.set('search', search);
            if (category) params.set('category', category);
            if (brand) params.set('brand', brand);
            if (connectionType) params.set('connectionType', connectionType);
            if (sort) params.set('sort', sort);

            window.location.href = '/admin/products?' + params.toString();
        }

        // ──── Select Mode ────
        let selectMode = false;

        function toggleSelectMode() {
            selectMode = !selectMode;
            const checkboxCells = document.querySelectorAll('.checkbox-cell');
            const selectBtn = document.getElementById('selectBtn');

            checkboxCells.forEach(cell => {
                cell.classList.toggle('hidden', !selectMode);
            });

            selectBtn.textContent = selectMode ? 'Cancel' : 'Select';

            if (!selectMode) {
                // Uncheck all
                document.querySelectorAll('.product-checkbox').forEach(cb => cb.checked = false);
            }
        }

        function getSelectedIds() {
            const checked = document.querySelectorAll('input[name="selectedProducts"]:checked');
            return Array.from(checked).map(cb => cb.value || cb.dataset.id);
        }

        // ──── Delete ────
        function deleteSelected() {
            const ids = getSelectedIds();
            if (ids.length === 0) {
                Swal.fire('No Selection', 'Please select at least one product to delete.', 'info');
                return;
            }

            Swal.fire({
                title: 'Delete Products?',
                text: `Are you sure you want to delete ${ids.length} product(s)? They will be unlisted.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#aaa',
                confirmButtonText: 'Yes, Delete'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch('/admin/products/soft-delete', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ ids })
                        });
                        const data = await response.json();
                        if (response.ok && data.success) {
                            await Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: data.message,
                                timer: 1200,
                                showConfirmButton: false
                            });
                            window.location.reload();
                        } else {
                            Swal.fire('Error', data.message || 'Failed to delete products', 'error');
                        }
                    } catch (err) {
                        Swal.fire('Error', 'An unexpected error occurred', 'error');
                    }
                }
            });
        }

        async function deleteSingle(productId) {
            const result = await Swal.fire({
                title: 'Delete Product?',
                text: 'This will unlist the product.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#aaa',
                confirmButtonText: 'Yes, Delete'
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch(`/admin/products/${productId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (response.ok && data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: data.message || 'Product unlisted successfully',
                        timer: 1200,
                        showConfirmButton: false
                    });
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.message || 'Failed to delete product', 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'An unexpected error occurred', 'error');
            }
        }

        // ──── List / Unlist Toggle ────
        async function toggleProductList(productId) {
            try {
                const response = await fetch(`/admin/products/${productId}/toggle-list`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (response.ok && data.success) {
                    window.location.reload();
                } else {
                    Swal.fire('Error', data.message || 'Failed to update listing', 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'An unexpected error occurred', 'error');
            }
        }

        // ──── Build pagination query string (preserves search + filters + sort) ────
        function paginationQuery(pageNum) {
            const params = new URLSearchParams(window.location.search);
            params.set('page', pageNum);
            return '/admin/products?' + params.toString();
        }
    </script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'products' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 p-6 md:p-8">
                <div class="admin-page-container max-w-[1400px] mx-auto">

                <!-- Header: Title + Add Product -->
                <div class="flex flex-wrap justify-between gap-3 mb-6">
                    <div class="flex min-w-72 flex-col gap-1">
                        <h1 class="text-[32px] font-bold text-[#1F1F1F]">Products</h1>
                        <p class="text-[#685BCB] text-sm">Manage your product catalog</p>
                    </div>
                    <a href="/admin/products/add"
                        class="flex items-center justify-center rounded-lg h-10 px-4 bg-[#685BCB] text-white text-sm font-bold hover:bg-[#5a4dc0] transition-colors">
                        <span>Add Product</span>
                    </a>
                </div>

                <!-- Action Buttons: Select + Delete -->
                <div class="flex flex-wrap items-center gap-3 px-4 py-4">
                    <button id="selectBtn" onclick="toggleSelectMode()"
                        class="flex items-center justify-center rounded-lg h-10 px-5 bg-[#685BCB] text-white text-sm font-bold shadow-sm hover:bg-[#5a4dc0] transition-colors">
                        Select
                    </button>
                    <button onclick="deleteSelected()"
                        class="flex items-center justify-center rounded-lg h-10 px-5 bg-red-500 text-white text-sm font-bold shadow-sm hover:bg-red-600 transition-colors">
                        Delete
                    </button>
                </div>

                <!-- Search Bar -->
                <div class="px-4 pt-1 pb-4">
                    <div class="relative">
                        <input id="searchInput" type="text" placeholder="Search by product title or SKU"
                            value="<%= search %>" onkeydown="handleSearch(event)"
                            class="w-full h-12 rounded-xl bg-[#FFFFFF] border border-[#BCA6DB] pl-4 pr-12 text-[#1F1F1F] placeholder:text-[#685BCB] focus:outline-none focus:ring-2 focus:ring-[#685BCB]" />
                        <% if (search) { %>
                            <button onclick="clearSearch()"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-full p-1 transition-colors"
                                title="Clear Search">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                    viewBox="0 0 256 256">
                                    <path
                                        d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z">
                                    </path>
                                </svg>
                            </button>
                            <% } %>
                    </div>
                </div>

                <!-- Filter & Sort Row -->
                <div class="flex flex-wrap gap-4 px-4 pb-4">
                    <select id="filterCategory" onchange="applyFilters()"
                        class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                        <option value="">All Categories</option>
                        <% (categories || []).forEach(cat => { %>
                            <option value="<%= cat._id %>" <%= String(filters.category || '')===String(cat._id) ? 'selected' : '' %>>
                                <%= cat.name %><%= cat.isBlocked ? ' (Blocked)' : '' %>
                            </option>
                        <% }) %>
                    </select>

                    <select id="filterBrand" onchange="applyFilters()"
                        class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                        <option value="">All Brands</option>
                        <% brands.forEach(b=> { %>
                            <option value="<%= b._id %>" <%=filters.brand===b._id.toString() ? 'selected' : '' %>><%=
                                    b.name %>
                            </option>
                            <% }) %>
                    </select>

                    <select id="filterConnection" onchange="applyFilters()"
                        class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                        <option value="">All Connection Types</option>
                        <option value="Wired" <%=filters.connectionType==='Wired' ? 'selected' : '' %>>Wired</option>
                        <option value="Wireless" <%=filters.connectionType==='Wireless' ? 'selected' : '' %>>Wireless
                        </option>
                    </select>

                    <select id="sortSelect" onchange="applyFilters()"
                        class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB] ml-auto">
                        <option value="newest" <%=currentSort==='newest' ? 'selected' : '' %>>Newest First</option>
                        <option value="az" <%=currentSort==='az' ? 'selected' : '' %>>A–Z</option>
                        <option value="za" <%=currentSort==='za' ? 'selected' : '' %>>Z–A</option>
                        <option value="price_asc" <%=currentSort==='price_asc' ? 'selected' : '' %>>Price: Low to High
                        </option>
                        <option value="price_desc" <%=currentSort==='price_desc' ? 'selected' : '' %>>Price: High to Low
                        </option>
                    </select>
                </div>

                <!-- Divider -->
                <div class="border-b border-[#BCA6DB] mx-4 mb-4"></div>

                <!-- Product Table -->
                <div class="px-4 py-2 @container">
                    <div class="flex overflow-hidden rounded-lg border border-[#BCA6DB] bg-white">
                        <table class="flex-1">
                            <thead>
                                <tr class="bg-white">
                                    <th
                                        class="checkbox-cell hidden px-4 py-3 w-10 text-sm font-medium text-[#1F1F1F] leading-normal">
                                        <input type="checkbox" id="selectAll"
                                            onchange="document.querySelectorAll('.product-checkbox').forEach(cb => cb.checked = this.checked)"
                                            class="h-4 w-4 rounded border-[#BCA6DB] text-[#685BCB] focus:ring-0" />
                                    </th>
                                    <th
                                        class="px-4 py-3 text-left text-[#1F1F1F] w-14 text-sm font-medium leading-normal">
                                        Image</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Title</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        SKU</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Brand</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Category</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Price</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Stock</th>
                                    <th
                                        class="px-4 py-3 text-left text-[#1F1F1F] w-28 text-sm font-medium leading-normal">
                                        Status</th>
                                    <th
                                        class="px-4 py-3 text-left text-[#1F1F1F] w-36 text-sm font-medium leading-normal">
                                        Listing</th>
                                    <th
                                        class="px-4 py-3 text-left text-[#1F1F1F] w-28 text-sm font-medium leading-normal">
                                        Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (products.length===0) { %>
                                    <tr>
                                        <td colspan="11" class="text-center py-8 text-[#685BCB]">No products found</td>
                                    </tr>
                                    <% } else { %>
                                        <% products.forEach(product=> { %>
                                            <tr class="border-t border-t-[#BCA6DB] hover:bg-gray-50 cursor-pointer"
                                                onclick="window.location.href='/admin/products/<%= product._id %>'">

                                                <!-- Checkbox (hidden by default) -->
                                                <td class="checkbox-cell hidden h-[72px] px-4 py-2 w-10"
                                                    onclick="event.stopPropagation()">
                                                    <input type="checkbox"
                                                        class="product-checkbox h-4 w-4 rounded border-[#BCA6DB] text-[#685BCB] focus:ring-0"
                                                        name="selectedProducts"
                                                        value="<%= product._id %>"
                                                        data-id="<%= product._id %>" />
                                                </td>

                                                <!-- Thumbnail -->
                                                <td class="h-[72px] px-4 py-2 w-14 text-sm font-normal leading-normal">
                                                    <% if (product.variants && product.variants.length > 0 && product.variants[0].images && product.variants[0].images.length > 0) { %>
                                                        <% const heroImg = product.variants[0].images[0]; %>
                                                            <div class="w-10 h-10 rounded bg-center bg-cover bg-no-repeat"
                                                                style="background-image: url('<%= heroImg.url %>');">
                                                            </div>
                                                            <% } else { %>
                                                                <div
                                                                    class="w-10 h-10 rounded bg-[#FFFFFF] flex items-center justify-center text-[#685BCB] text-xs font-bold">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20"
                                                                        height="20" fill="currentColor"
                                                                        viewBox="0 0 256 256">
                                                                        <path
                                                                            d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40ZM40,56H216V200H40ZM160,96a32,32,0,1,1-32-32A32,32,0,0,1,160,96Zm-72,64,27.52-27.52a8,8,0,0,1,11.31,0L144,149.66l27.52-27.52a8,8,0,0,1,11.31,0L200,139.31V200H56V176Z" />
                                                                    </svg>
                                                                </div>
                                                                <% } %>
                                                </td>

                                                <!-- Title -->
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#1F1F1F] text-sm font-normal leading-normal">
                                                    <%= product.title %>
                                                </td>

                                                <!-- SKU -->
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    <%= product.sku %>
                                                </td>

                                                <!-- Brand -->
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    <%= product.brand ? product.brand.name : 'N/A' %>
                                                </td>

                                                <!-- Category -->
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    <%= product.category %>
                                                </td>

                                                <!-- Price -->
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#1F1F1F] text-sm font-normal leading-normal">
                                                    ₹<%= product.price.toLocaleString('en-IN') %>
                                                </td>

                                                <!-- Stock -->
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    <%= product.stockCount %>
                                                </td>

                                                <!-- Status -->
                                                <td class="h-[72px] px-4 py-2 w-28 text-sm font-normal leading-normal">
                                                    <span
                                                        class="inline-flex items-center justify-center rounded-lg h-8 px-4 text-sm font-medium w-full user-select-none
                                                    <%= product.status === 'Active' ? 'bg-[#e6f4ea] text-[#1e7e34]' : 'bg-[#f3f4f6] text-[#6b7280]' %>">
                                                        <%= product.status %>
                                                    </span>
                                                </td>

                                                <td class="h-[72px] px-4 py-2 w-36 text-sm font-normal leading-normal"
                                                    onclick="event.stopPropagation()">
                                                    <button onclick="toggleProductList('<%= product._id %>')"
                                                        class="inline-flex items-center justify-center rounded-lg h-8 px-4 text-xs font-bold transition-colors <%= product.isListed ? 'bg-[#ffecec] text-red-600 hover:bg-[#ffdddd]' : 'bg-[#ecffef] text-green-700 hover:bg-[#ddffe3]' %>">
                                                        <%= product.isListed ? 'Unlist' : 'List' %>
                                                    </button>
                                                </td>

                                                <td class="h-[72px] px-4 py-2 w-28 text-sm font-normal leading-normal"
                                                    onclick="event.stopPropagation()">
                                                    <button onclick="deleteSingle('<%= product._id %>')"
                                                        class="inline-flex items-center justify-center rounded-lg h-8 px-4 text-xs font-bold bg-red-500 text-white hover:bg-red-600 transition-colors">
                                                        Delete
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (pagination && pagination.totalPages> 0) { %>
                        <% var qp=[]; if (search) qp.push('search=' + encodeURIComponent(search));
                            if (filters.category) qp.push('category=' + encodeURIComponent(filters.category));
                            if (filters.brand) qp.push('brand=' + encodeURIComponent(filters.brand));
                            if (filters.connectionType) qp.push('connectionType=' + encodeURIComponent(filters.connectionType));
                            if (currentSort && currentSort !== 'newest') qp.push('sort=' + encodeURIComponent(currentSort));
                            var baseQs = qp.length > 0 ? '&' + qp.join('&') : '' ; %>
                            <div class="flex justify-center items-center gap-2 mt-6">
                                <!-- Previous -->
                                <% if (pagination.hasPrevPage) { %>
                                    <a href="/admin/products?page=<%= pagination.currentPage - 1 %><%= baseQs %>"
                                        class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                        &laquo; Previous
                                    </a>
                                    <% } else { %>
                                        <span
                                            class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                            &laquo; Previous
                                        </span>
                                        <% } %>

                                            <!-- Page Numbers -->
                                            <div class="flex gap-1">
                                                <% for (let i=1; i <=pagination.totalPages; i++) { %>
                                                    <% if (i===pagination.currentPage) { %>
                                                        <span
                                                            class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#685BCB] text-white text-sm font-bold">
                                                            <%= i %>
                                                        </span>
                                                        <% } else { %>
                                                            <a href="/admin/products?page=<%= i %><%= baseQs %>"
                                                                class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                                                <%= i %>
                                                            </a>
                                                            <% } %>
                                                                <% } %>
                                            </div>

                                            <!-- Next -->
                                            <% if (pagination.hasNextPage) { %>
                                                <a href="/admin/products?page=<%= pagination.currentPage + 1 %><%= baseQs %>"
                                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                                    Next &raquo;
                                                </a>
                                                <% } else { %>
                                                    <span
                                                        class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                                        Next &raquo;
                                                    </span>
                                                    <% } %>
                            </div>

                            <!-- Pagination Info -->
                            <p class="text-center text-sm text-[#685BCB] mt-2">
                                Showing page <%= pagination.currentPage %> of <%= pagination.totalPages %> (<%=
                                            pagination.totalProducts %> products)
                            </p>
                            <% } %>
                </div>
                </div>
            </section>
        </main>
    </div>
</body>

</html>
