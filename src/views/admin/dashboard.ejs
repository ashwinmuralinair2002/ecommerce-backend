<!-- Admin dashboard page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" />
    <title>Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/utils.js"></script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 gap-0 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'dashboard' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 bg-white p-6 md:p-8">
                <h1 class="text-2xl font-bold text-[#1F1F1F] mb-6">Admin Account</h1>

                <!-- Profile Summary -->
                <section class="flex items-center gap-6 mb-8">
                    <div class="w-24 h-24 rounded-full bg-cover bg-center border-2 border-[#D3CEEA]"
                        style="background-image:url('/images/admin/profile.jpg');">
                    </div>

                    <div>
                        <p class="text-[22px] font-bold text-[#1F1F1F]">
                            <%= user ? user.name : 'Ashwin Murali Nair' %>
                        </p>
                        <p class="text-sm text-[#685BCB]">Super Admin</p>
                    </div>
                </section>

                <!-- PROFILE DETAILS -->
                <section class="max-w-3xl">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-[22px] font-bold text-[#1F1F1F]">Profile Details</h2>
                    </div>

                    <!-- Inline Messaging Container -->
                    <div id="messageContainer" class="hidden mb-4 p-3 rounded-xl text-sm font-medium"></div>

                    <!-- View Mode -->
                    <div id="viewMode" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <p class="text-sm text-[#685BCB]">Full Name</p>
                            <p class="text-sm text-[#1F1F1F]" id="viewName">
                                <%= user ? user.name : 'Ashwin Murali Nair' %>
                            </p>
                        </div>
                        <div>
                            <p class="text-sm text-[#685BCB]">Role</p>
                            <p class="text-sm text-[#1F1F1F]">Super Admin</p>
                        </div>
                        <div>
                            <p class="text-sm text-[#685BCB]">Email</p>
                            <p class="text-sm text-[#1F1F1F]" id="viewEmail">
                                <%= user ? user.email : 'admin@soundwave.com' %>
                            </p>
                        </div>
                        <div>
                            <p class="text-sm text-[#685BCB]">Phone</p>
                            <p class="text-sm text-[#1F1F1F]" id="viewPhone">
                                <%= user && user.phone ? user.phone : '—' %>
                            </p>
                        </div>
                    </div>

                    <!-- Edit Mode (Hidden by default) -->
                    <form id="editForm" class="hidden grid grid-cols-1 gap-4 max-w-xl" onsubmit="saveAdminInfo(event)">
                        <div>
                            <label class="block text-sm text-[#685BCB] mb-1">Full Name</label>
                            <input type="text" id="editName" name="name"
                                value="<%= user ? user.name : 'Ashwin Murali Nair' %>"
                                class="w-full h-10 rounded-xl bg-[#FFFFFF] px-3 border-none text-[#1F1F1F] focus:ring-1 focus:ring-[#685BCB]" />
                        </div>
                        <div>
                            <label class="block text-sm text-[#685BCB] mb-1">Email</label>
                            <input type="email" id="editEmail" name="email"
                                value="<%= user ? user.email : 'admin@soundwave.com' %>"
                                class="w-full h-10 rounded-xl bg-[#FFFFFF] px-3 border-none text-[#1F1F1F] focus:ring-1 focus:ring-[#685BCB]" />
                        </div>
                        <div>
                            <label class="block text-sm text-[#685BCB] mb-1">Phone</label>
                            <input type="tel" id="editPhone" name="phone"
                                value="<%= user && user.phone ? user.phone : '' %>"
                                class="w-full h-10 rounded-xl bg-[#FFFFFF] px-3 border-none text-[#1F1F1F] focus:ring-1 focus:ring-[#685BCB]" />
                        </div>

                        <div class="flex gap-3 mt-2">
                            <button type="submit" id="saveBtn"
                                class="h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0]">
                                Save Changes
                            </button>
                            <button type="button" onclick="cancelEdit()"
                                class="h-10 px-6 rounded-xl bg-[#FFFFFF] font-bold text-[#1F1F1F] hover:bg-[#D3CEEA]">
                                Cancel
                            </button>
                        </div>
                    </form>
                </section>

                <script>
                    const originalName = "<%= user ? user.name : 'Ashwin Murali Nair' %>";
                    const originalEmail = "<%= user ? user.email : 'admin@soundwave.com' %>";
                    const originalPhone = "<%= user && user.phone ? user.phone : '' %>";

                    function toggleEditMode() {
                        document.getElementById('viewMode').classList.add('hidden');
                        document.getElementById('editInfoBtn').classList.add('hidden');
                        document.getElementById('editForm').classList.remove('hidden');

                        // Reset message
                        const msgContainer = document.getElementById('messageContainer');
                        msgContainer.classList.add('hidden');
                    }

                    function cancelEdit() {
                        document.getElementById('viewMode').classList.remove('hidden');
                        document.getElementById('editInfoBtn').classList.remove('hidden');
                        document.getElementById('editForm').classList.add('hidden');

                        // Restore values
                        document.getElementById('editName').value = originalName;
                        document.getElementById('editEmail').value = originalEmail;
                        document.getElementById('editPhone').value = originalPhone;
                    }

                    async function saveAdminInfo(e) {
                        e.preventDefault();
                        const name = document.getElementById('editName').value.trim();
                        const email = document.getElementById('editEmail').value.trim();
                        const phone = document.getElementById('editPhone').value.trim();
                        const msgContainer = document.getElementById('messageContainer');
                        const saveBtn = document.getElementById('saveBtn');

                        // Client-side Validation (Regex)
                        const nameRegex = /^[a-zA-Z\s]+$/;
                        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

                        if (name.length < 2 || !nameRegex.test(name)) {
                            showMessage('Name must be at least 2 characters and allow only letters.', 'error');
                            return;
                        }
                        if (!emailRegex.test(email)) {
                            showMessage('Please enter a valid email address.', 'error');
                            return;
                        }

                        // Disable button
                        saveBtn.disabled = true;
                        saveBtn.innerText = 'Saving...';

                        try {
                            const response = await fetch('/admin/profile/update', {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ name, email, phone })
                            });

                            const data = await response.json();

                            if (data.requiresOtp) {
                                window.location.href = '/verify-otp?mode=email_change';
                                return;
                            }

                            if (response.ok) {
                                showMessage('Profile updated successfully!', 'success');

                                // Update View Mode values
                                document.getElementById('viewName').innerText = name;
                                document.getElementById('viewEmail').innerText = email;
                                document.getElementById('viewPhone').innerText = phone || '—';

                                // Update Header Name (Visual consistency)
                                const headerName = document.querySelector('.text-\\[22px\\].font-bold.text-\\[\\#1F1F1F\\]');
                                if (headerName) headerName.innerText = name;

                                setTimeout(() => {
                                    location.reload(); // Refresh to ensure session/server sync is perfect
                                }, 1000);
                            } else {
                                showMessage(data.error || 'Failed to update profile', 'error');
                                saveBtn.disabled = false;
                                saveBtn.innerText = 'Save Changes';
                            }
                        } catch (error) {
                            console.error(error);
                            showMessage('An unexpected error occurred.', 'error');
                            saveBtn.disabled = false;
                            saveBtn.innerText = 'Save Changes';
                        }
                    }

                    function showMessage(text, type) {
                        const container = document.getElementById('messageContainer');
                        container.innerText = text;
                        container.classList.remove('hidden', 'bg-red-100', 'text-red-800', 'bg-green-100', 'text-green-800');

                        if (type === 'error') {
                            container.classList.add('bg-red-100', 'text-red-800');
                        } else {
                            container.classList.add('bg-green-100', 'text-green-800');
                        }
                        container.classList.remove('hidden');
                    }
                </script>

                <!-- SECURITY & ACCOUNT ACTIONS -->
                <section class="mt-10 pb-10 max-w-3xl">
                    <h2 class="text-[22px] font-bold mb-3 text-[#1F1F1F]">Account Actions</h2>
                    <p class="text-sm text-[#685BCB] mb-4">Manage your profile and security settings</p>

                    <div class="flex flex-wrap gap-3">
                        <!-- Edit Info Button -->
                        <button id="editInfoBtn" onclick="toggleEditMode()"
                            class="inline-flex items-center gap-2 h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                                viewBox="0 0 256 256">
                                <path
                                    d="M227.31,73.37,182.63,28.69a16,16,0,0,0-22.63,0L36.69,152A15.86,15.86,0,0,0,32,163.31V208a16,16,0,0,0,16,16H92.69A15.86,15.86,0,0,0,104,219.31l60-60,22.34,22.34a8,8,0,0,0,11.32-11.32L175.31,148l52-52A16,16,0,0,0,227.31,73.37ZM92.69,208H48V163.31l88-88L180.69,120ZM192,108.68,147.32,64l24-24L216,84.68Z">
                                </path>
                            </svg>
                            Edit Info
                        </button>

                        <!-- Change Password Button -->
                        <a href="/admin/change-password"
                            class="inline-flex items-center gap-2 h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                                viewBox="0 0 256 256">
                                <path
                                    d="M208,80H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96ZM208,208H48V96H208V208Zm-80-88a28,28,0,0,0-8,54.83V184a8,8,0,0,0,16,0V174.83A28,28,0,0,0,128,120Z">
                                </path>
                            </svg>
                            Change Password
                        </a>
                    </div>
                </section>
            </section>
        </main>
    </div>
</body>

</html>
