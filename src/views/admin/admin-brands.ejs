<!-- Admin brands list page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900" />
    <title>Admin · Brands</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmAction(options, actionCallback) {
            Swal.fire({
                title: options.title,
                text: options.text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: options.confirmButtonColor || '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: options.confirmButtonText
            }).then((result) => {
                if (result.isConfirmed) {
                    actionCallback();
                }
            });
        }

        function confirmBrandDelete(brandId) {
            confirmAction({
                title: 'Delete Brand?',
                text: 'Are you sure you want to delete this brand?',
                confirmButtonText: 'Yes, Delete',
                confirmButtonColor: '#d33'
            }, () => {
                const form = document.getElementById('delete-form-' + brandId);
                if (form) form.submit();
            });
        }
    </script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'brands' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 p-6 md:p-8">
                <div class="admin-page-container max-w-[1400px] mx-auto">
                <% const getCroppedBrandLogoUrl = (brand) => {
                    if (!brand || !brand.logoUrl) return '';
                    const crop = brand.logoCrop;
                    if (!crop) return brand.logoUrl;
                    const x = Number(crop.x);
                    const y = Number(crop.y);
                    const width = Number(crop.width);
                    const height = Number(crop.height);
                    if (![x, y, width, height].every(Number.isFinite)) return brand.logoUrl;
                    if (width <= 0 || height <= 0) return brand.logoUrl;
                    if (!String(brand.logoUrl).includes('/upload/')) return brand.logoUrl;
                    return String(brand.logoUrl).replace('/upload/', '/upload/c_crop,x_' + Math.max(0, Math.round(x)) + ',y_' + Math.max(0, Math.round(y)) + ',w_' + Math.round(width) + ',h_' + Math.round(height) + '/');
                }; %>
                <!-- HEADER -->
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h1 class="text-3xl font-bold text-[#1F1F1F]">Brands</h1>
                        <p class="text-sm text-[#685BCB]">Manage product brands and their status</p>
                    </div>
                    <a href="/admin/brands/add"
                        class="px-4 py-2 rounded-lg bg-[#685BCB] text-white font-bold hover:bg-[#5a4dc0] transition-colors">
                        Add Brand
                    </a>
                </div>

                <!-- SEARCH -->
                <!-- SEARCH -->
                <div class="mb-4 relative">
                    <input id="searchInput" type="text" name="search" placeholder="Search brand name" value="<%= locals.search || '' %>"
                        onkeydown="handleSearch(event)"
                        class="w-full h-12 rounded-xl bg-[#FFFFFF] border border-[#BCA6DB] pl-4 pr-12 text-[#1F1F1F] placeholder:text-[#685BCB] focus:outline-none focus:ring-2 focus:ring-[#685BCB]" />

                    <% if (locals.search) { %>
                        <button onclick="clearSearch()"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-full p-1 transition-colors"
                            title="Clear Search">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                viewBox="0 0 256 256">
                                <path
                                    d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z">
                                </path>
                            </svg>
                        </button>
                        <% } %>
                </div>

                <script>
                    function applyFilters() {
                        const params = new URLSearchParams();
                        const search = document.getElementById('searchInput').value.trim();
                        const status = document.getElementById('filterStatus').value;
                        const sort = document.getElementById('sortSelect').value;

                        if (search) params.set('search', search);
                        if (status) params.set('status', status);
                        if (sort && sort !== 'newest') params.set('sort', sort);

                        window.location.href = '/admin/brands?' + params.toString();
                    }

                    function handleSearch(e) {
                        if (e.key === 'Enter') {
                            applyFilters();
                        }
                    }

                    function clearSearch() {
                        document.getElementById('searchInput').value = '';
                        applyFilters();
                    }
                </script>

                <div class="flex flex-wrap gap-4 pb-4">
                    <select id="filterStatus" onchange="applyFilters()"
                        class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                        <option value="">All</option>
                        <option value="listed" <%=status==='listed' ? 'selected' : '' %>>Listed</option>
                        <option value="unlisted" <%=status==='unlisted' ? 'selected' : '' %>>Unlisted</option>
                    </select>

                    <select id="sortSelect" onchange="applyFilters()"
                        class="form-input rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB]">
                        <option value="newest" <%=currentSort==='newest' ? 'selected' : '' %>>Newest First</option>
                        <option value="oldest" <%=currentSort==='oldest' ? 'selected' : '' %>>Oldest First</option>
                        <option value="az" <%=currentSort==='az' ? 'selected' : '' %>>Name (A–Z)</option>
                        <option value="za" <%=currentSort==='za' ? 'selected' : '' %>>Name (Z–A)</option>
                    </select>
                </div>

                <!-- TABLE -->
                <div class="overflow-hidden rounded-xl border border-[#BCA6DB]">
                    <table class="w-full">
                        <thead class="bg-white border-b">
                            <tr>
                                <th class="p-3 text-left">Brand</th>
                                <th class="p-3 text-left">Products</th>
                                <th class="p-3 text-left">Status</th>
                                <th class="p-3 text-left">Last Updated</th>
                                <th class="p-3 text-left">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% brands.forEach(brand=> { %>
                                <tr class="border-t border-[#BCA6DB] cursor-pointer hover:bg-gray-50"
                                    onclick="window.location.href='/admin/brands/<%= brand._id %>'">
                                    <td class="p-3 flex items-center gap-3">
                                        <% const logoDisplayUrl = getCroppedBrandLogoUrl(brand); %>
                                        <div class="w-10 h-10 rounded-full bg-cover bg-center <%= brand.logoUrl ? '' : 'bg-[#D3CEEA]' %>"
                                            style="<%= brand.logoUrl ? " background-image:url('" + logoDisplayUrl + "')"
                                            : '' %>"></div>
                                        <span class="font-medium text-[#1F1F1F]">
                                            <%= brand.name %>
                                        </span>
                                    </td>

                                    <td class="p-3 text-[#685BCB]">
                                        <%= brand.productCount %>
                                    </td>

                                    <td class="p-3 brand-status-cell">
                                        <span class="brand-status px-4 py-1 rounded-lg text-sm font-medium
                                            <%= brand.isActive ? 'bg-[#e6f4ea] text-[#1e7e34]' : 'bg-[#ffecec] text-red-600' %>">
                                            <%= brand.isActive ? 'Listed' : 'Unlisted' %>
                                        </span>
                                    </td>

                                    <td class="p-3 text-[#685BCB]">
                                        <%= brand.updatedAt.toDateString() %>
                                    </td>

                                    <td class="p-3 flex gap-3 text-sm font-medium text-[#685BCB]" onclick="event.stopPropagation()">
                                        <button type="button"
                                            onclick="event.stopPropagation(); toggleBrandStatus('<%= brand._id %>', this)"
                                            class="px-3 py-1 rounded-md <%= brand.isActive ? 'bg-red-500 hover:bg-red-600' : 'bg-green-600 hover:bg-green-700' %> text-white text-sm transition">
                                            <%= brand.isActive ? 'Unlist' : 'List' %>
                                        </button>
                                        <button type="button" class="text-red-600"
                                            onclick="event.stopPropagation(); confirmBrandDelete('<%= brand._id %>')">Delete</button>
                                        <form id="delete-form-<%= brand._id %>" method="POST"
                                            action="/admin/brands/<%= brand._id %>/delete" style="display:none;">
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination UI -->
                <% if (pagination && pagination.totalPages> 0) { %>
                    <% var qp=[]; if (search) qp.push('search=' + encodeURIComponent(search));
                        if (status) qp.push('status=' + encodeURIComponent(status));
                        if (currentSort && currentSort !== 'newest') qp.push('sort=' + encodeURIComponent(currentSort));
                        var baseQs = qp.length > 0 ? '&' + qp.join('&') : '' ; %>
                    <div class="flex justify-center items-center gap-2 mt-6">
                        <!-- Previous Button -->
                        <% if (pagination.hasPrevPage) { %>
                            <a href="/admin/brands?page=<%= pagination.currentPage - 1 %><%= baseQs %>"
                                class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                &laquo; Previous
                            </a>
                            <% } else { %>
                                <span
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                    &laquo; Previous
                                </span>
                                <% } %>

                                    <!-- Page Numbers -->
                                    <div class="flex gap-1">
                                        <% for (let i=1; i <=pagination.totalPages; i++) { %>
                                            <% if (i===pagination.currentPage) { %>
                                                <span
                                                    class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#685BCB] text-white text-sm font-bold">
                                                    <%= i %>
                                                </span>
                                                <% } else { %>
                                                    <a href="/admin/brands?page=<%= i %><%= baseQs %>"
                                                        class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                                        <%= i %>
                                                    </a>
                                                    <% } %>
                                                        <% } %>
                                    </div>

                                    <!-- Next Button -->
                                    <% if (pagination.hasNextPage) { %>
                                        <a href="/admin/brands?page=<%= pagination.currentPage + 1 %><%= baseQs %>"
                                            class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                            Next &raquo;
                                        </a>
                                        <% } else { %>
                                            <span
                                                class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                                Next &raquo;
                                            </span>
                                            <% } %>
                    </div>

                    <!-- Pagination Info -->
                    <p class="text-center text-sm text-[#685BCB] mt-2">
                        Showing page <%= pagination.currentPage %> of <%= pagination.totalPages %> (<%=
                                    pagination.totalBrands %> brands)
                    </p>
                    <% } %>
                </div>
            </section>
        </main>
    </div>
    <script>
        async function toggleBrandStatus(id, btn) {
            try {
                const res = await fetch(`/admin/brands/${id}/toggle-status`, {
                    method: 'PATCH',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await res.json();

                if (res.ok && data.success) {
                    const isListed = data.isListed;

                    btn.textContent = isListed ? 'Unlist' : 'List';
                    btn.classList.remove('bg-red-500', 'hover:bg-red-600', 'bg-green-600', 'hover:bg-green-700');

                    if (isListed) {
                        btn.classList.add('bg-red-500', 'hover:bg-red-600');
                    } else {
                        btn.classList.add('bg-green-600', 'hover:bg-green-700');
                    }

                    const row = btn.closest('tr');
                    const statusCell = row ? row.querySelector('.brand-status') : null;
                    if (statusCell) {
                        statusCell.textContent = isListed ? 'Listed' : 'Unlisted';
                        statusCell.classList.remove('bg-[#e6f4ea]', 'text-[#1e7e34]', 'bg-[#ffecec]', 'text-red-600');
                        if (isListed) {
                            statusCell.classList.add('bg-[#e6f4ea]', 'text-[#1e7e34]');
                        } else {
                            statusCell.classList.add('bg-[#ffecec]', 'text-red-600');
                        }
                    }
                }
            } catch (err) {
                console.error('Toggle failed', err);
            }
        }
    </script>
</body>

</html>
