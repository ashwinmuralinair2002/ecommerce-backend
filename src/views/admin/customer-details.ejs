<!-- Admin customer details page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" />
    <title>SoundWave - <%= customer.name %>
    </title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmAction(options, callback) {
            Swal.fire({
                title: options.title,
                text: options.text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: options.confirmButtonColor || '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: options.confirmButtonText
            }).then((result) => {
                if (result.isConfirmed) callback();
            });
        }

        async function toggleBlock(userId, currentStatus) {
            confirmAction({
                title: currentStatus ? 'Unblock User?' : 'Block User?',
                text: `Are you sure you want to ${currentStatus ? 'unblock' : 'block'} this user?`,
                confirmButtonText: currentStatus ? 'Yes, Unblock' : 'Yes, Block',
                confirmButtonColor: currentStatus ? '#685BCB' : '#d33'
            }, async () => {
                try {
                    const response = await fetch(`/admin/customers/${userId}/toggle-block`, { method: 'PATCH' });
                    if (response.ok) {
                        Swal.fire({ icon: 'success', title: 'Success', timer: 1500, showConfirmButton: false });
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        Swal.fire('Error', 'Failed to update status', 'error');
                    }
                } catch (e) {
                    Swal.fire('Error', 'An unexpected error occurred', 'error');
                }
            });
        }

        async function deleteUser(userId) {
            confirmAction({
                title: 'Delete User?',
                text: 'Are you sure you want to delete this user? This action cannot be undone.',
                confirmButtonText: 'Yes, Delete',
                confirmButtonColor: '#d33'
            }, async () => {
                try {
                    const response = await fetch(`/admin/customers/${userId}/delete`, { method: 'POST' });
                    if (response.ok) {
                        Swal.fire({ icon: 'success', title: 'Deleted!', timer: 1500, showConfirmButton: false });
                        setTimeout(() => window.location.href = '/admin/customers', 1000);
                    } else {
                        Swal.fire('Error', 'Failed to delete user', 'error');
                    }
                } catch (e) {
                    Swal.fire('Error', 'An unexpected error occurred', 'error');
                }
            });
        }

        async function saveNotes(userId) {
            const adminNotes = document.getElementById('adminNotes').value;
            try {
                const response = await fetch(`/admin/customers/${userId}/notes`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ adminNotes })
                });
                if (response.ok) {
                    Swal.fire({ icon: 'success', title: 'Notes saved', timer: 1500, showConfirmButton: false });
                } else {
                    Swal.fire('Error', 'Failed to save notes', 'error');
                }
            } catch (e) {
                Swal.fire('Error', 'Error saving notes', 'error');
            }
        }

        function openTab(evt, tabName) {
            document.querySelectorAll('.tabcontent').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.tablinks').forEach(el => {
                el.classList.remove('border-b-[#1F1F1F]', 'text-[#1F1F1F]');
                el.classList.add('border-b-transparent', 'text-[#685BCB]');
            });
            document.getElementById(tabName).style.display = 'block';
            evt.currentTarget.classList.remove('border-b-transparent', 'text-[#685BCB]');
            evt.currentTarget.classList.add('border-b-[#1F1F1F]', 'text-[#1F1F1F]');
        }
    </script>
    <style>
        .tabcontent {
            display: none;
        }
    </style>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../partials/admin/navbar") %>

	        <!-- Main Layout: Sidebar + Content -->
	        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'customers' }) %>
            </aside>

	            <!-- Main Content Panel -->
	            <section class="flex-1 p-6 md:p-8">
	                <%
	                    const user = customer;
	                    const totalOrders = Number(customer.totalOrders || 0);
	                    const lifetimeValue = Number(customer.lifetimeValue || 0);
	                    const walletBalance = Number(customer.walletBalance || 0);
	                %>
	                <!-- Breadcrumb -->
	                <div class="flex items-center gap-2 text-sm mb-4">
	                    <a href="/admin/customers" class="text-[#685BCB] hover:underline">Customers</a>
                    <span class="text-gray-400">/</span>
	                    <span class="text-[#1F1F1F]">
	                        <%= customer.name %>
	                    </span>
	                </div>
	
	                <div class="mb-6 overflow-hidden rounded-[28px] border border-[#E7DDF5] bg-gradient-to-br from-[#F8F4FF] via-white to-[#F4EEFF] shadow-[0_18px_45px_rgba(104,91,203,0.10)]">
	                    <div class="flex flex-col gap-6 px-6 py-7 md:px-8 md:py-8">
	                        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
	                            <div class="flex items-center gap-5">
	                                <% if (user.profileImage) { %>
	                                    <img src="<%= user.profileImage %>" alt="<%= user.name %>" class="h-24 w-24 rounded-full object-cover ring-4 ring-white shadow-lg" />
	                                <% } else { %>
	                                    <div class="flex h-24 w-24 items-center justify-center rounded-full bg-[#D9D1F7] text-3xl font-bold text-[#3F3478] ring-4 ring-white shadow-lg">
	                                        <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
	                                    </div>
	                                <% } %>
	                                <div>
	                                    <div class="flex flex-wrap items-center gap-3">
	                                        <h1 class="text-[30px] font-black tracking-tight text-[#1F1F1F]"><%= user.name %></h1>
	                                        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] <%= user.isBlocked ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700' %>">
	                                            <%= user.isBlocked ? 'Banned' : 'Active' %>
	                                        </span>
	                                    </div>
	                                    <p class="mt-2 text-sm text-[#6B6382]"><%= user.email %></p>
	                                    <p class="mt-1 text-sm text-[#8A82A6]">Customer profile and account activity overview</p>
	                                </div>
	                            </div>
	                            <div class="flex flex-wrap gap-3">
	                                <a href="/admin/customers/<%= customer._id %>/edit"
	                                    class="flex h-11 items-center justify-center rounded-xl border border-[#D7CAEF] bg-white px-5 text-sm font-bold text-[#1F1F1F] shadow-sm transition-colors hover:bg-[#F3ECFF]">
	                                    Edit Profile
	                                </a>
	                                <button onclick="toggleBlock('<%= customer._id %>', <%= customer.isBlocked %>)"
	                                    class="flex h-11 items-center justify-center rounded-xl px-5 text-sm font-bold transition-colors <%= customer.isBlocked ? 'bg-emerald-100 text-emerald-700 hover:bg-emerald-200' : 'bg-red-100 text-red-700 hover:bg-red-200' %>">
	                                    <%= customer.isBlocked ? 'Unban' : 'Ban' %>
	                                </button>
	                                <button onclick="deleteUser('<%= customer._id %>')"
	                                    class="flex h-11 items-center justify-center rounded-xl border border-red-200 bg-white px-5 text-sm font-bold text-red-600 transition-colors hover:bg-red-50">
	                                    Delete
	                                </button>
	                            </div>
	                        </div>
	                        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
	                            <div class="rounded-2xl border border-[#EFE6FB] bg-white px-5 py-5 shadow-[0_12px_30px_rgba(31,31,31,0.05)]">
	                                <div class="text-3xl font-black text-[#1F1F1F]"><%= totalOrders %></div>
	                                <p class="mt-2 text-sm font-medium text-[#7A7198]">Total Orders</p>
	                            </div>
	                            <div class="rounded-2xl border border-[#EFE6FB] bg-white px-5 py-5 shadow-[0_12px_30px_rgba(31,31,31,0.05)]">
	                                <div class="text-3xl font-black text-[#1F1F1F]">RS <%= Number(lifetimeValue || 0).toFixed(2) %></div>
	                                <p class="mt-2 text-sm font-medium text-[#7A7198]">Lifetime Value</p>
	                            </div>
	                            <div class="rounded-2xl border border-[#EFE6FB] bg-white px-5 py-5 shadow-[0_12px_30px_rgba(31,31,31,0.05)]">
	                                <div class="text-3xl font-black text-[#1F1F1F]">₹<%= walletBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
	                                <p class="mt-2 text-sm font-medium text-[#7A7198]">Wallet Balance</p>
	                            </div>
	                        </div>
	                    </div>
	                </div>

	                <!-- Tabs -->
	                <div class="border-b border-[#BCA6DB] mb-4">
                    <div class="flex gap-6">
                        <button onclick="openTab(event, 'Overview')"
                            class="tablinks pb-3 border-b-[3px] border-b-[#1F1F1F] text-[#1F1F1F] text-sm font-bold">
                            Overview
                        </button>
                        <button onclick="openTab(event, 'Orders')"
                            class="tablinks pb-3 border-b-[3px] border-b-transparent text-[#685BCB] text-sm font-bold">
                            Orders
                        </button>
                        <button onclick="openTab(event, 'Addresses')"
                            class="tablinks pb-3 border-b-[3px] border-b-transparent text-[#685BCB] text-sm font-bold">
                            Addresses
                        </button>
                        <button onclick="openTab(event, 'Notes')"
                            class="tablinks pb-3 border-b-[3px] border-b-transparent text-[#685BCB] text-sm font-bold">
                            Notes
                        </button>
                    </div>
                </div>

	                <!-- Tab Content: Overview -->
	                <div id="Overview" class="tabcontent" style="display:block;">
	                    <div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
	                        <div class="rounded-3xl border border-[#ECE4F8] bg-white p-6 shadow-[0_14px_35px_rgba(31,31,31,0.05)]">
	                            <h2 class="text-lg font-bold text-[#1F1F1F]">Contact Information</h2>
	                            <p class="mt-1 text-sm text-[#847A9F]">Primary contact details used for account communication.</p>
	                            <div class="mt-6 space-y-4">
	                                <div class="rounded-2xl bg-[#F8F5FF] px-4 py-4">
	                                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#7A6F9B]">Email</p>
	                                    <p class="mt-2 text-sm font-medium text-[#1F1F1F] break-all"><%= user.email %></p>
	                                </div>
	                                <div class="rounded-2xl bg-[#F8F5FF] px-4 py-4">
	                                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#7A6F9B]">Phone</p>
	                                    <p class="mt-2 text-sm font-medium text-[#1F1F1F]"><%= user.phone || 'N/A' %></p>
	                                </div>
	                            </div>
	                        </div>
	                        <div class="rounded-3xl border border-[#ECE4F8] bg-white p-6 shadow-[0_14px_35px_rgba(31,31,31,0.05)]">
	                            <h2 class="text-lg font-bold text-[#1F1F1F]">Account Meta</h2>
	                            <p class="mt-1 text-sm text-[#847A9F]">Snapshot of when this customer joined and their latest activity.</p>
	                            <div class="mt-6 space-y-4">
	                                <div class="flex items-center justify-between rounded-2xl bg-[#F8F5FF] px-4 py-4">
	                                    <span class="text-sm font-medium text-[#7A6F9B]">Joined</span>
	                                    <span class="text-sm font-bold text-[#1F1F1F]"><%= new Date(user.joinedDate).toLocaleDateString() %></span>
	                                </div>
	                                <div class="flex items-center justify-between rounded-2xl bg-[#F8F5FF] px-4 py-4">
	                                    <span class="text-sm font-medium text-[#7A6F9B]">Last Login</span>
	                                    <span class="text-sm font-bold text-[#1F1F1F]"><%= user.lastLogin ? new Date(user.lastLogin).toLocaleDateString() : 'N/A' %></span>
	                                </div>
	                            </div>
	                        </div>
	                    </div>
	                </div>

                <!-- Tab Content: Orders -->
                <div id="Orders" class="tabcontent">
                    <div class="text-center py-8 text-gray-500">
                        <p>No orders found</p>
                        <a href="/admin/customers/<%= customer._id %>/orders"
                            class="text-[#685BCB] hover:underline mt-2 inline-block">
                            View Orders Page
                        </a>
                    </div>
                </div>

                <!-- Tab Content: Addresses -->
                <div id="Addresses" class="tabcontent">
                    <% if (customer.addresses && customer.addresses.length> 0) { %>
                        <div class="space-y-3">
                            <% customer.addresses.forEach(addr=> { %>
                                <div class="border border-gray-200 rounded-lg p-4">
                                    <p class="font-bold text-[#1F1F1F] mb-1">
                                        <%= addr.label || 'Address' %>
                                            <% if(addr.isDefault){ %><span
                                                    class="text-xs text-green-600 ml-2">(Default)</span>
                                                <% } %>
                                    </p>
                                    <p class="text-sm text-gray-600">
                                        <%= addr.name %>
                                    </p>
                                    <p class="text-sm text-gray-600">
                                        <%= addr.houseNo %>, <%= addr.street %>
                                    </p>
                                    <p class="text-sm text-gray-600">
                                        <%= addr.city %>, <%= addr.state %>
                                                <%= addr.zip %>
                                    </p>
                                    <p class="text-sm text-gray-600">
                                        <%= addr.country %>
                                    </p>
                                    <p class="text-sm text-gray-600">Phone: <%= addr.phone %>
                                    </p>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <p class="text-center py-8 text-gray-500">No saved addresses.</p>
                            <% } %>
                </div>

                <!-- Tab Content: Notes -->
                <div id="Notes" class="tabcontent">
                    <label class="block mb-2 text-sm font-bold text-[#1F1F1F]">Admin Notes (Internal Use Only)</label>
                    <textarea id="adminNotes" rows="5"
                        class="w-full rounded-lg border border-gray-200 p-3 text-sm focus:ring-2 focus:ring-[#685BCB] focus:border-transparent"
                        placeholder="Add internal notes about this customer..."><%= customer.adminNotes || '' %></textarea>
                    <button onclick="saveNotes('<%= customer._id %>')"
                        class="mt-4 h-10 px-6 rounded-lg bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">
                        Save Notes
                    </button>
                </div>
            </section>
        </main>
    </div>
</body>

</html>
