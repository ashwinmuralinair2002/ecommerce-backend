<!DOCTYPE html>
<html>

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />

    <title>SoundWave - <%= customer.name %>
    </title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        async function toggleBlock(userId, currentStatus) {
            confirmAction({
                title: currentStatus ? 'Unblock User?' : 'Block User?',
                text: `Are you sure you want to ${currentStatus ? 'unblock' : 'block'} this user?`,
                confirmButtonText: currentStatus ? 'Yes, Unblock' : 'Yes, Block',
                confirmButtonColor: currentStatus ? '#1ff91f' : '#d33'
            }, async () => {
                try {
                    const response = await fetch(`/admin/customers/${userId}/toggle-block`, { method: 'POST' });
                    if (response.ok) {
                        showToast(`User ${currentStatus ? 'unblocked' : 'blocked'} successfully`);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showError('Action Failed', 'Failed to update status');
                    }
                } catch (e) {
                    showError('Error', 'An unexpected error occurred');
                }
            });
        }

        async function deleteUser(userId) {
            confirmAction({
                title: 'Delete User?',
                text: 'Are you sure you want to delete this user? This action cannot be undone.',
                confirmButtonText: 'Yes, Delete',
                confirmButtonColor: '#d33'
            }, async () => {
                try {
                    const response = await fetch(`/admin/customers/${userId}/delete`, { method: 'POST' });
                    if (response.ok) {
                        showToast('User deleted successfully');
                        setTimeout(() => window.location.href = '/admin/customers', 1000);
                    } else {
                        showError('Delete Failed', 'Failed to delete user');
                    }
                } catch (e) {
                    showError('Error', 'An unexpected error occurred');
                }
            });
        }

        async function saveNotes(userId) {
            const adminNotes = document.getElementById('adminNotes').value;
            try {
                const response = await fetch(`/admin/customers/${userId}/notes`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ adminNotes })
                });
                if (response.ok) {
                    showToast('Notes updated successfully');
                } else {
                    showError('Update Failed', 'Failed to update notes');
                }
            } catch (e) {
                showError('Error', 'Error updating notes');
            }
        }

        function openTab(evt, tabName) {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                // Very basic active state toggle logic for this implementation
                tablinks[i].classList.remove("border-b-[#121810]", "text-[#121810]");
                tablinks[i].classList.add("border-b-transparent", "text-[#658d5e]");
            }
            document.getElementById(tabName).style.display = "block";
            evt.currentTarget.classList.remove("border-b-transparent", "text-[#658d5e]");
            evt.currentTarget.classList.add("border-b-[#121810]", "text-[#121810]");
        }
    </script>
    <style>
        .tabcontent {
            display: none;
        }
    </style>
</head>

<body>
    <div class="relative flex h-auto min-h-screen w-full flex-col bg-white group/design-root overflow-x-hidden"
        style='font-family: Inter, "Noto Sans", sans-serif;'>
        <div class="layout-container flex h-full grow flex-col">
            <div class="gap-1 px-6 flex flex-1 justify-center py-5">
                <div class="layout-content-container flex flex-col w-80">
                    <%- include('../partials/admin/sidebar', { page: 'customers' }) %>
                </div>
                <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
                    <%- include('../partials/admin/navbar') %>

                        <div class="flex flex-wrap gap-2 p-4">
                            <a href="/admin/customers" class="text-[#658d5e] text-base font-medium leading-normal"
                                href="#">Customers</a>
                            <span class="text-[#658d5e] text-base font-medium leading-normal">/</span>
                            <span class="text-[#121810] text-base font-medium leading-normal">
                                <%= customer.name %>
                            </span>
                        </div>
                        <div class="flex flex-wrap justify-between gap-3 p-4">
                            <p class="text-[#121810] tracking-light text-[32px] font-bold leading-tight min-w-72">
                                <%= customer.name %>
                            </p>
                            <a href="/admin/customers/<%= customer._id %>/edit"
                                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-8 px-4 bg-[#f0f5f0] text-[#121810] text-sm font-medium leading-normal">
                                <span class="truncate">Edit profile</span>
                            </a>
                        </div>
                        <div class="flex gap-3 p-3 flex-wrap pr-4">
                            <div
                                class="flex h-8 shrink-0 items-center justify-center gap-x-2 rounded-xl <%= customer.isBlocked ? 'bg-red-100 text-red-800' : 'bg-[#f0f5f0] text-[#121810]' %> pl-4 pr-4">
                                <p class="text-sm font-medium leading-normal">
                                    <%= customer.isBlocked ? 'Blocked' : 'Active' %>
                                </p>
                            </div>
                        </div>
                        <div class="flex justify-stretch">
                            <div class="flex flex-1 gap-3 flex-wrap px-4 py-3 justify-start">
                                <button onclick="toggleBlock('<%= customer._id %>', <%= customer.isBlocked %>)"
                                    class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 <%= customer.isBlocked ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %> text-sm font-bold leading-normal tracking-[0.015em]">
                                    <span class="truncate">
                                        <%= customer.isBlocked ? 'Unban' : 'Ban' %>
                                    </span>
                                </button>
                                <button onclick="deleteUser('<%= customer._id %>')"
                                    class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 bg-transparent text-red-600 text-sm font-bold leading-normal tracking-[0.015em] border border-red-200">
                                    <span class="truncate">Delete customer</span>
                                </button>
                            </div>
                        </div>

                        <div class="pb-3">
                            <div class="flex border-b border-[#dce7da] px-4 gap-8">
                                <button onclick="openTab(event, 'Overview')"
                                    class="tablinks flex flex-col items-center justify-center border-b-[3px] border-b-[#121810] text-[#121810] pb-[13px] pt-4">
                                    <p class="text-sm font-bold leading-normal tracking-[0.015em]">Overview</p>
                                </button>
                                <button onclick="openTab(event, 'Orders')"
                                    class="tablinks flex flex-col items-center justify-center border-b-[3px] border-b-transparent text-[#658d5e] pb-[13px] pt-4">
                                    <p class="text-sm font-bold leading-normal tracking-[0.015em]">Orders</p>
                                </button>
                                <button onclick="openTab(event, 'Addresses')"
                                    class="tablinks flex flex-col items-center justify-center border-b-[3px] border-b-transparent text-[#658d5e] pb-[13px] pt-4">
                                    <p class="text-sm font-bold leading-normal tracking-[0.015em]">Addresses</p>
                                </button>
                                <button onclick="openTab(event, 'Notes')"
                                    class="tablinks flex flex-col items-center justify-center border-b-[3px] border-b-transparent text-[#658d5e] pb-[13px] pt-4">
                                    <p class="text-sm font-bold leading-normal tracking-[0.015em]">Notes</p>
                                </button>
                            </div>
                        </div>

                        <!-- Tab Content: Overview -->
                        <div id="Overview" class="tabcontent" style="display:block;">
                            <h2
                                class="text-[#121810] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                                Contact Information</h2>
                            <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                <label class="flex flex-col min-w-40 flex-1">
                                    <p class="text-[#121810] text-base font-medium leading-normal pb-2">Email</p>
                                    <input disabled
                                        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#121810] focus:outline-0 focus:ring-0 border border-[#dce7da] bg-white focus:border-[#dce7da] h-14 placeholder:text-[#658d5e] p-[15px] text-base font-normal leading-normal disabled:bg-gray-100"
                                        value="<%= customer.email %>" />
                                </label>
                            </div>
                            <div class="flex max-w-[480px] flex-wrap items-end gap-4 px-4 py-3">
                                <label class="flex flex-col min-w-40 flex-1">
                                    <p class="text-[#121810] text-base font-medium leading-normal pb-2">Phone</p>
                                    <input disabled
                                        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#121810] focus:outline-0 focus:ring-0 border border-[#dce7da] bg-white focus:border-[#dce7da] h-14 placeholder:text-[#658d5e] p-[15px] text-base font-normal leading-normal disabled:bg-gray-100"
                                        value="<%= customer.phone || 'N/A' %>" />
                                </label>
                            </div>
                            <h2
                                class="text-[#121810] text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">
                                Account Meta</h2>
                            <div class="p-4 grid grid-cols-[20%_1fr] gap-x-6">
                                <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dce7da] py-5">
                                    <p class="text-[#658d5e] text-sm font-normal leading-normal">Joined</p>
                                    <p class="text-[#121810] text-sm font-normal leading-normal">
                                        <%= new Date(customer.joinedDate).toLocaleDateString() %>
                                    </p>
                                </div>
                                <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dce7da] py-5">
                                    <p class="text-[#658d5e] text-sm font-normal leading-normal">Last Login</p>
                                    <p class="text-[#121810] text-sm font-normal leading-normal">
                                        <%= customer.lastLogin ? new Date(customer.lastLogin).toLocaleDateString()
                                            : 'N/A' %>
                                    </p>
                                </div>
                                <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dce7da] py-5">
                                    <p class="text-[#658d5e] text-sm font-normal leading-normal">Total Orders</p>
                                    <p class="text-[#121810] text-sm font-normal leading-normal">
                                        <%= customer.totalOrders %>
                                    </p>
                                </div>
                                <div class="col-span-2 grid grid-cols-subgrid border-t border-t-[#dce7da] py-5">
                                    <p class="text-[#658d5e] text-sm font-normal leading-normal">Lifetime Value</p>
                                    <p class="text-[#121810] text-sm font-normal leading-normal">$<%=
                                            customer.lifetimeValue %>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Tab Content: Orders -->
                        <div id="Orders" class="tabcontent">
                            <div class="p-4 text-center text-gray-500">
                                <p>No orders found (Placeholder: No Order Model)</p>
                                <a href="/admin/customers/<%= customer._id %>/orders"
                                    class="text-blue-500 hover:text-blue-700 mt-2 block">View Orders Page (Coming
                                    Soon)</a>
                            </div>
                        </div>

                        <!-- Tab Content: Addresses -->
                        <div id="Addresses" class="tabcontent">
                            <div class="p-4">
                                <% if (customer.addresses && customer.addresses.length> 0) { %>
                                    <% customer.addresses.forEach(addr=> { %>
                                        <div class="border border-gray-200 rounded p-4 mb-3">
                                            <p class="font-bold">
                                                <%= addr.label || 'Address' %>
                                                    <% if(addr.isDefault){ %>(Default)<% } %>
                                            </p>
                                            <p>
                                                <%= addr.name %>
                                            </p>
                                            <p>
                                                <%= addr.houseNo %>, <%= addr.street %>
                                            </p>
                                            <p>
                                                <%= addr.city %>, <%= addr.state %>
                                                        <%= addr.zip %>
                                            </p>
                                            <p>
                                                <%= addr.country %>
                                            </p>
                                            <p>Phone: <%= addr.phone %>
                                            </p>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <p class="text-gray-500">No saved addresses.</p>
                                                <% } %>
                            </div>
                        </div>

                        <!-- Tab Content: Notes -->
                        <div id="Notes" class="tabcontent">
                            <div class="p-4">
                                <label class="block mb-2 text-sm font-bold text-gray-700" for="adminNotes">
                                    Admin Notes (Internal Use Only)
                                </label>
                                <textarea
                                    class="form-textarea mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50"
                                    id="adminNotes" rows="5"
                                    placeholder="Add internal notes about this customer..."><%= customer.adminNotes || '' %></textarea>
                                <div class="mt-4">
                                    <button onclick="saveNotes('<%= customer._id %>')"
                                        class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                                        Save Notes
                                    </button>
                                </div>
                            </div>
                        </div>

                </div>
            </div>
        </div>
    </div>
</body>

</html>