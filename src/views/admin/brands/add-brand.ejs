<!-- Admin add new brand form template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" />
    <title>Admin · Add Brand</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-[#f8fcf8]"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 gap-6 px-6 py-5">
            <!-- Sidebar -->
            <aside class="w-80">
                <%- include('../../partials/admin/sidebar', { page: 'brands' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 bg-white rounded-lg p-6">
                <!-- Breadcrumb -->
                <div class="flex items-center gap-2 text-sm mb-4">
                    <a href="/admin/brands" class="text-[#5f8c5f] hover:underline">Brands</a>
                    <span class="text-gray-400">/</span>
                    <span class="text-[#111811]">Add Brand</span>
                </div>

                <h1 class="text-[32px] font-bold text-[#121811] mb-2">Add New Brand</h1>
                <p class="text-sm text-[#658d5e] mb-6">Enter details to add a new brand to your catalog</p>

                <!-- General Error Message -->
                <% if (locals.error) { %>
                    <div class="mb-4 p-3 rounded-xl text-sm font-medium bg-red-100 text-red-800">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/admin/brands" method="POST" enctype="multipart/form-data"
                            class="max-w-lg space-y-5" id="addBrandForm" novalidate>

                            <!-- Brand Name -->
                            <div>
                                <label class="block text-sm text-[#628d5e] mb-1">Brand Name <span
                                        class="text-red-500">*</span></label>
                                <input type="text" name="name" value="<%= locals.oldInput ? oldInput.name || '' : '' %>"
                                    class="w-full h-12 rounded-xl bg-[#f0f5f0] px-4 border-none text-[#111810] focus:ring-2 focus:ring-[#27ff14] <%= (locals.errors && errors.name) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="Enter brand name" />
                                <% if (locals.errors && errors.name) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.name %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-1 hidden" id="err-name"></p>
                            </div>

                            <!-- Description -->
                            <div>
                                <label class="block text-sm text-[#628d5e] mb-1">Description</label>
                                <textarea name="description" rows="3"
                                    class="w-full rounded-xl bg-[#f0f5f0] px-4 py-3 border-none text-[#111810] focus:ring-2 focus:ring-[#27ff14]"
                                    placeholder="Enter brand description"><%= locals.oldInput ? oldInput.description || '' : '' %></textarea>
                            </div>

                            <!-- Brand Logo Section -->
                            <div class="bg-[#f8fcf8] rounded-xl p-5 border border-[#dce7da]">
                                <p class="text-[#121810] font-medium mb-3">Brand Logo</p>

                                <!-- Upload Logo -->
                                <label class="block mb-3">
                                    <span
                                        class="text-xs font-semibold text-[#658d5e] uppercase tracking-wide mb-1 block">Upload
                                        Logo (JPG, PNG, WEBP - max 2MB)</span>
                                    <input type="file" name="logo"
                                        accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                        class="block w-full text-sm text-[#121810] file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[#e8f4e6] file:text-[#121810] hover:file:bg-[#dce7da]" />
                                </label>

                                <!-- Divider -->
                                <div class="relative my-3">
                                    <div class="absolute inset-0 flex items-center">
                                        <div class="w-full border-t border-gray-200"></div>
                                    </div>
                                    <div class="relative flex justify-center">
                                        <span class="bg-[#f8fcf8] px-2 text-sm text-gray-400">OR</span>
                                    </div>
                                </div>

                                <!-- Logo URL -->
                                <div>
                                    <label
                                        class="block text-xs font-semibold text-[#658d5e] uppercase tracking-wide mb-1">Logo
                                        URL</label>
                                    <input type="url" name="logoUrl"
                                        value="<%= locals.oldInput ? oldInput.logoUrl || '' : '' %>"
                                        class="w-full h-10 rounded-xl bg-white px-4 border border-[#dce7da] text-[#111810] focus:ring-2 focus:ring-[#27ff14] text-sm"
                                        placeholder="https://example.com/logo.png" />
                                </div>
                                <% if (locals.errors && errors.logo) { %>
                                    <p class="text-red-500 text-xs mt-2">
                                        <%= errors.logo %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-2 hidden" id="err-logo"></p>
                            </div>

                            <!-- Website -->
                            <div>
                                <label class="block text-sm text-[#628d5e] mb-1">Website</label>
                                <input type="url" name="website"
                                    value="<%= locals.oldInput ? oldInput.website || '' : '' %>"
                                    class="w-full h-12 rounded-xl bg-[#f0f5f0] px-4 border-none text-[#111810] focus:ring-2 focus:ring-[#27ff14]"
                                    placeholder="https://brand-website.com" />
                            </div>

                            <!-- Contact Email -->
                            <div>
                                <label class="block text-sm text-[#628d5e] mb-1">Contact Email</label>
                                <input type="email" name="contactEmail"
                                    value="<%= locals.oldInput ? oldInput.contactEmail || '' : '' %>"
                                    class="w-full h-12 rounded-xl bg-[#f0f5f0] px-4 border-none text-[#111810] focus:ring-2 focus:ring-[#27ff14] <%= (locals.errors && errors.contactEmail) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="contact@brand.com" />
                                <% if (locals.errors && errors.contactEmail) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.contactEmail %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-1 hidden" id="err-contactEmail"></p>
                            </div>

                            <!-- Status Toggle -->
                            <div class="flex items-center justify-between py-2">
                                <div>
                                    <p class="font-medium text-[#121810]">Status</p>
                                    <p class="text-sm text-[#658d5e]">Enable or disable brand visibility</p>
                                </div>
                                <label
                                    class="relative flex h-[31px] w-[51px] cursor-pointer items-center rounded-full bg-[#e8f4e6] p-0.5 has-[:checked]:justify-end has-[:checked]:bg-[#37ff14]">
                                    <div class="h-full w-[27px] rounded-full bg-white shadow"></div>
                                    <input type="checkbox" name="isActive" checked class="absolute invisible" />
                                </label>
                            </div>

                            <!-- Buttons -->
                            <div class="flex gap-3 pt-4">
                                <button type="submit" id="submitBtn"
                                    class="h-10 px-6 rounded-xl bg-[#27ff14] font-bold text-[#111810] hover:bg-[#20e010] transition-colors">
                                    Create Brand
                                </button>
                                <a href="/admin/brands"
                                    class="h-10 px-6 rounded-xl bg-[#f0f5f0] font-bold text-[#111810] hover:bg-[#e0e5e0] transition-colors flex items-center">
                                    Cancel
                                </a>
                            </div>
                        </form>
            </section>
        </main>
    </div>

    <script>
        document.getElementById('addBrandForm').addEventListener('submit', function (e) {
            let valid = true;

            // Clear previous JS errors
            document.querySelectorAll('[id^="err-"]').forEach(el => { el.textContent = ''; el.classList.add('hidden'); });

            const name = this.querySelector('[name="name"]');
            const logo = this.querySelector('[name="logo"]');
            const logoUrl = this.querySelector('[name="logoUrl"]');
            const contactEmail = this.querySelector('[name="contactEmail"]');

            if (!name.value.trim() || name.value.trim().length < 2) {
                document.getElementById('err-name').textContent = 'Brand name is required (min 2 characters).';
                document.getElementById('err-name').classList.remove('hidden');
                valid = false;
            }

            if (!logo.files.length && !logoUrl.value.trim()) {
                document.getElementById('err-logo').textContent = 'Please upload a logo or provide a URL.';
                document.getElementById('err-logo').classList.remove('hidden');
                valid = false;
            }

            if (contactEmail.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contactEmail.value.trim())) {
                document.getElementById('err-contactEmail').textContent = 'Please enter a valid email address.';
                document.getElementById('err-contactEmail').classList.remove('hidden');
                valid = false;
            }

            if (!valid) e.preventDefault();
        });
    </script>
</body>

</html>