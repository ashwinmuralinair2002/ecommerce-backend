<!DOCTYPE html>
<html>

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900" />
    <title>Admin · Add Brand</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>

<body class="bg-[#f8fcf8] font-[Inter]">
    <div class="flex min-h-screen">

        <!-- UNIFORM SIDEBAR -->
        <%- include('../../partials/admin/sidebar', { page: 'brands' }) %>

            <!-- MAIN CONTENT -->
            <div class="flex-1 max-w-[960px] p-6">

                <!-- Navbar Inclusion (Requirement: Sidebar and navbar must match Admin Home) -->
                <%- include('../../partials/admin/navbar') %>

                    <div class="mb-8 pt-6">
                        <h1 class="text-3xl font-bold text-[#0f1d0c]">Add New Brand</h1>
                        <p class="text-sm text-[#53a145]">
                            Enter details to add a new brand to your catalog
                        </p>
                    </div>

                    <% if (locals.error) { %>
                        <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-xl">
                            <%= error %>
                        </div>
                        <% } %>

                            <form action="/admin/brands" method="POST" enctype="multipart/form-data"
                                class="space-y-6 max-w-[480px]">

                                <!-- BRAND NAME -->
                                <div>
                                    <label class="block font-medium mb-2">Brand Name</label>
                                    <input name="name" required placeholder="Enter brand name"
                                        class="w-full rounded-xl bg-[#e8f4e6] h-14 px-4 outline-none"
                                        value="<%= locals.oldInput ? oldInput.name : '' %>" />
                                </div>

                                <!-- BRAND LOGO -->
                                <div class="border-2 border-dashed rounded-xl p-8 text-center">
                                    <p class="font-bold mb-1">Brand Logo</p>
                                    <p class="text-sm mb-4">Upload brand logo image</p>
                                    <input type="file" name="logo" accept="image/*" class="block w-full text-sm" />
                                </div>

                                <!-- BRAND LOGO URL -->
                                <div>
                                    <label class="block font-medium mb-2">Or Logo URL</label>
                                    <input name="logoUrl" placeholder="https://example.com/logo.png"
                                        class="w-full rounded-xl bg-[#e8f4e6] h-14 px-4 outline-none"
                                        value="<%= locals.oldInput ? oldInput.logoUrl : '' %>" />
                                </div>

                                <!-- WEBSITE -->
                                <div>
                                    <label class="block font-medium mb-2">Website</label>
                                    <input name="website" placeholder="https://example.com"
                                        class="w-full rounded-xl bg-[#e8f4e6] h-14 px-4 outline-none"
                                        value="<%= locals.oldInput ? oldInput.website : '' %>" />
                                </div>

                                <!-- CONTACT EMAIL -->
                                <div>
                                    <label class="block font-medium mb-2">Contact Email</label>
                                    <input type="email" name="contactEmail" placeholder="support@example.com"
                                        class="w-full rounded-xl bg-[#e8f4e6] h-14 px-4 outline-none"
                                        value="<%= locals.oldInput ? oldInput.contactEmail : '' %>" />
                                </div>

                                <!-- DESCRIPTION -->
                                <div>
                                    <label class="block font-medium mb-2">Description</label>
                                    <textarea name="description" placeholder="Enter brand description"
                                        class="w-full rounded-xl bg-[#e8f4e6] min-h-[140px] px-4 py-3 outline-none"><%= locals.oldInput ? oldInput.description : '' %></textarea>
                                </div>

                                <!-- STATUS -->
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium">Status</p>
                                        <p class="text-sm text-[#53a145]">Enable or disable brand</p>
                                    </div>

                                    <label
                                        class="relative flex h-[31px] w-[51px] cursor-pointer items-center rounded-full bg-[#e8f4e6] p-0.5 has-[:checked]:justify-end has-[:checked]:bg-[#37ff14]">
                                        <div class="h-full w-[27px] rounded-full bg-white shadow"></div>
                                        <input type="checkbox" name="isActive" checked class="absolute invisible" />
                                    </label>
                                </div>

                                <!-- ACTIONS -->
                                <div class="flex gap-4 pt-4">
                                    <button type="submit" class="px-6 h-10 rounded-xl bg-[#37ff14] font-bold">
                                        Create Brand
                                    </button>

                                    <a href="/admin/brands"
                                        class="px-6 h-10 rounded-xl bg-[#e8f4e6] font-bold flex items-center">
                                        Cancel
                                    </a>
                                </div>

                            </form>
            </div>
    </div>
</body>

</html>