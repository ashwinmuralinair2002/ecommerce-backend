<!-- Admin add new brand form template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" />
    <title>Admin · Add Brand</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../../partials/admin/sidebar', { page: 'brands' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 p-6 md:p-8">
                <!-- Breadcrumb -->
                <div class="flex items-center gap-2 text-sm mb-4">
                    <a href="/admin/brands" class="text-[#685BCB] hover:underline">Brands</a>
                    <span class="text-gray-400">/</span>
                    <span class="text-[#1F1F1F]">Add Brand</span>
                </div>

                <h1 class="text-[32px] font-bold text-[#1F1F1F] mb-2">Add New Brand</h1>
                <p class="text-sm text-[#685BCB] mb-6">Enter details to add a new brand to your catalog</p>

                <!-- General Error Message -->
                <% if (locals.error) { %>
                    <div class="mb-4 p-3 rounded-xl text-sm font-medium bg-red-100 text-red-800">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/admin/brands" method="POST" enctype="multipart/form-data"
                            class="max-w-lg space-y-5" id="addBrandForm" novalidate>

                            <!-- Brand Name -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Brand Name <span
                                        class="text-red-500">*</span></label>
                                <input type="text" name="name" value="<%= locals.oldInput ? oldInput.name || '' : '' %>"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] <%= (locals.errors && errors.name) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="Enter brand name" />
                                <% if (locals.errors && errors.name) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.name %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-1 hidden" id="err-name"></p>
                            </div>

                            <!-- Description -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Description</label>
                                <textarea name="description" rows="3"
                                    class="w-full rounded-xl bg-[#FFFFFF] px-4 py-3 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB]"
                                    placeholder="Enter brand description"><%= locals.oldInput ? oldInput.description || '' : '' %></textarea>
                            </div>

                            <!-- Brand Logo Section -->
                            <div class="bg-[#D3CEEA] rounded-xl p-5 border border-[#BCA6DB]">
                                <p class="text-[#1F1F1F] font-medium mb-3">Brand Logo</p>

                                <!-- Upload Logo -->
                                <label class="block mb-3">
                                    <span
                                        class="text-xs font-semibold text-[#685BCB] uppercase tracking-wide mb-1 block">Upload
                                        Logo (JPG, PNG, WEBP - max 2MB)</span>
                                    <input type="file" name="logo"
                                        id="brandLogoInput"
                                        accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                        class="block w-full text-sm text-[#1F1F1F] file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[#e8f4e6] file:text-[#1F1F1F] hover:file:bg-[#BCA6DB]" />
                                </label>
                                <input type="hidden" name="logoCrop" id="logoCropInput" value="" />
                                <div id="brandLogoPreviewWrap"
                                    class="hidden mb-4 p-3 bg-white rounded-lg border border-gray-100 w-full">
                                    <div class="w-full max-w-[220px] mx-auto">
                                        <img id="brandLogoPreview" src="" alt="Brand logo preview"
                                            class="w-full h-28 object-contain rounded-md border border-gray-100 bg-[#FAFAFA]">
                                    </div>
                                    <div class="mt-2 flex justify-center">
                                        <button type="button" id="brandLogoRecropBtn"
                                            class="h-9 px-4 rounded-lg bg-[#685BCB] text-white text-sm font-semibold hover:bg-[#5a4dc0] transition-colors">
                                            Re-crop Logo
                                        </button>
                                    </div>
                                </div>

                                <% if (locals.errors && errors.logo) { %>
                                    <p class="text-red-500 text-xs mt-2">
                                        <%= errors.logo %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-2 hidden" id="err-logo"></p>
                            </div>

                            <!-- Website -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Website</label>
                                <input type="url" name="website"
                                    value="<%= locals.oldInput ? oldInput.website || '' : '' %>"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] <%= (locals.errors && errors.website) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="https://brand-website.com" />
                                <% if (locals.errors && errors.website) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.website %>
                                    </p>
                                <% } %>
                                <p class="text-red-500 text-xs mt-1 hidden" id="err-website"></p>
                            </div>

                            <!-- Contact Email -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Contact Email</label>
                                <input type="email" name="contactEmail"
                                    value="<%= locals.oldInput ? oldInput.contactEmail || '' : '' %>"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] <%= (locals.errors && errors.contactEmail) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="contact@brand.com" />
                                <% if (locals.errors && errors.contactEmail) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.contactEmail %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-1 hidden" id="err-contactEmail"></p>
                            </div>

                            <!-- Status Toggle -->
                            <div class="flex items-center justify-between py-2">
                                <div>
                                    <p class="font-medium text-[#1F1F1F]">Status</p>
                                    <p class="text-sm text-[#685BCB]">Enable or disable brand visibility</p>
                                </div>
                                <label
                                    class="relative flex h-[31px] w-[51px] cursor-pointer items-center rounded-full bg-[#e8f4e6] p-0.5 has-[:checked]:justify-end has-[:checked]:bg-[#685BCB]">
                                    <div class="h-full w-[27px] rounded-full bg-white shadow"></div>
                                    <input type="checkbox" name="isActive" checked class="absolute invisible" />
                                </label>
                            </div>

                            <!-- Buttons -->
                            <div class="flex gap-3 pt-4">
                                <button type="submit" id="submitBtn"
                                    class="h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">
                                    Create Brand
                                </button>
                                <a href="/admin/brands"
                                    class="h-10 px-6 rounded-xl bg-[#FFFFFF] font-bold text-[#1F1F1F] hover:bg-[#D3CEEA] transition-colors flex items-center">
                                    Cancel
                                </a>
                            </div>
                        </form>
            </section>
        </main>
    </div>

    <script>
        (function () {
            const logoInput = document.getElementById('brandLogoInput');
            const previewWrap = document.getElementById('brandLogoPreviewWrap');
            const previewImg = document.getElementById('brandLogoPreview');
            const recropBtn = document.getElementById('brandLogoRecropBtn');
            const logoCropInput = document.getElementById('logoCropInput');
            if (!logoInput || !previewWrap || !previewImg || !recropBtn || !logoCropInput || typeof Cropper === 'undefined') return;

            let cropper = null;
            let currentObjectUrl = '';
            let originalPreviewUrl = '';
            let croppedPreviewUrl = '';
            let latestCrop = null;

            const cropModal = document.createElement('div');
            cropModal.id = 'brandLogoCropModal';
            cropModal.className = 'fixed inset-0 bg-black/60 hidden items-center justify-center z-50 p-4';
            cropModal.innerHTML = `
                <div class="bg-white rounded-xl p-4 w-full max-w-2xl">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-lg font-bold text-[#1F1F1F]">Crop Brand Logo (1:1)</h2>
                        <button type="button" id="closeBrandLogoCropModal" class="text-sm font-semibold text-[#685BCB]">Close</button>
                    </div>
                    <div class="bg-gray-100 rounded-lg overflow-hidden max-h-[70vh]">
                        <img id="brandLogoCropperImage" src="" alt="Crop preview" class="max-w-full" />
                    </div>
                    <div class="flex justify-end gap-3 mt-4">
                        <button type="button" id="saveBrandLogoCropBtn" class="h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">Save Crop</button>
                    </div>
                </div>
            `;
            document.body.appendChild(cropModal);
            const cropperImage = cropModal.querySelector('#brandLogoCropperImage');
            const closeBtn = cropModal.querySelector('#closeBrandLogoCropModal');
            const saveBtn = cropModal.querySelector('#saveBrandLogoCropBtn');

            function closeModal() {
                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }
                cropModal.classList.add('hidden');
                cropModal.classList.remove('flex');
            }

            function setPreview(src) {
                if (!src) return;
                previewImg.src = src;
                previewWrap.classList.remove('hidden');
            }

            function openModal(src) {
                if (!src) return;
                cropModal.classList.remove('hidden');
                cropModal.classList.add('flex');
                cropperImage.src = src;
                cropperImage.onload = function () {
                    if (cropper) cropper.destroy();
                    cropper = new Cropper(cropperImage, {
                        aspectRatio: 1,
                        viewMode: 1,
                        movable: true,
                        zoomable: true,
                        scalable: false,
                        cropBoxResizable: true,
                        autoCropArea: 0.9,
                        ready() {
                            if (latestCrop && latestCrop.width && latestCrop.height) {
                                cropper.setData(latestCrop);
                            }
                        }
                    });
                };
            }

            logoInput.addEventListener('change', function () {
                const file = (this.files || [])[0];
                if (!file) return;
                if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
                currentObjectUrl = URL.createObjectURL(file);
                originalPreviewUrl = currentObjectUrl;
                latestCrop = null;
                logoCropInput.value = '';
                if (croppedPreviewUrl && croppedPreviewUrl !== currentObjectUrl) {
                    URL.revokeObjectURL(croppedPreviewUrl);
                    croppedPreviewUrl = '';
                }
                setPreview(currentObjectUrl);
                openModal(currentObjectUrl);
            });

            recropBtn.addEventListener('click', function () {
                if (!originalPreviewUrl) return;
                openModal(originalPreviewUrl);
            });

            if (closeBtn) closeBtn.addEventListener('click', closeModal);
            if (cropModal) {
                cropModal.addEventListener('click', function (e) {
                    if (e.target === cropModal) closeModal();
                });
            }
            if (saveBtn) {
                saveBtn.addEventListener('click', async function () {
                    if (!cropper) return;
                    const canvas = cropper.getCroppedCanvas({ fillColor: '#ffffff' });
                    if (!canvas) return;
                    const file = (logoInput.files || [])[0];
                    const outputType = (file && file.type) || 'image/jpeg';
                    const blob = await new Promise((resolve) => canvas.toBlob(resolve, outputType, 0.95));
                    if (!blob) return;

                    if (croppedPreviewUrl && croppedPreviewUrl !== originalPreviewUrl) {
                        URL.revokeObjectURL(croppedPreviewUrl);
                    }
                    croppedPreviewUrl = URL.createObjectURL(blob);
                    setPreview(croppedPreviewUrl);

                    const data = cropper.getData(true);
                    latestCrop = {
                        x: Math.round(data.x),
                        y: Math.round(data.y),
                        width: Math.round(data.width),
                        height: Math.round(data.height)
                    };
                    logoCropInput.value = JSON.stringify(latestCrop);
                    closeModal();
                });
            }
        })();

        document.getElementById('addBrandForm').addEventListener('submit', function (e) {
            let valid = true;
            const invalidTypeMessage = 'Invalid file type. Only JPG, JPEG, PNG, and WEBP images are allowed.';
            const fileTooLargeMessage = 'One or more images exceed the 2MB size limit.';

            // Clear previous JS errors
            document.querySelectorAll('[id^="err-"]').forEach(el => { el.textContent = ''; el.classList.add('hidden'); });

            const name = this.querySelector('[name="name"]');
            const logo = this.querySelector('[name="logo"]');
            const website = this.querySelector('[name="website"]');
            const contactEmail = this.querySelector('[name="contactEmail"]');

            if (!name.value.trim() || name.value.trim().length < 2) {
                document.getElementById('err-name').textContent = 'Brand name is required (min 2 characters).';
                document.getElementById('err-name').classList.remove('hidden');
                valid = false;
            }

            if (!logo.files.length) {
                document.getElementById('err-logo').textContent = 'Please upload a brand logo.';
                document.getElementById('err-logo').classList.remove('hidden');
                valid = false;
            } else {
                const selectedLogo = logo.files[0];
                if (selectedLogo && !['image/jpeg', 'image/jpg', 'image/png', 'image/webp'].includes(selectedLogo.type)) {
                    document.getElementById('err-logo').textContent = invalidTypeMessage;
                    document.getElementById('err-logo').classList.remove('hidden');
                    valid = false;
                } else if (selectedLogo && selectedLogo.size > 2 * 1024 * 1024) {
                    document.getElementById('err-logo').textContent = fileTooLargeMessage;
                    document.getElementById('err-logo').classList.remove('hidden');
                    valid = false;
                }
            }

            if (website.value.trim()) {
                try {
                    new URL(website.value.trim());
                } catch {
                    document.getElementById('err-website').textContent = 'Please enter a valid website URL.';
                    document.getElementById('err-website').classList.remove('hidden');
                    valid = false;
                }
            }

            if (contactEmail.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contactEmail.value.trim())) {
                document.getElementById('err-contactEmail').textContent = 'Please enter a valid email address.';
                document.getElementById('err-contactEmail').classList.remove('hidden');
                valid = false;
            }

            if (!valid) {
                e.preventDefault();
                return;
            }

            showLoader();
        });
    </script>
    <script src="/js/loading.util.js"></script>
    <script>
        window.addEventListener('pageshow', function () {
            hideLoader();
        });
    </script>
</body>

</html>
