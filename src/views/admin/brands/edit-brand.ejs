<!DOCTYPE html>
<html>

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />
    <title>SoundWave - Edit Brand</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>

<body>
    <div class="relative flex h-auto min-h-screen w-full flex-col bg-white group/design-root overflow-x-hidden"
        style='font-family: Inter, "Noto Sans", sans-serif;'>
        <div class="layout-container flex h-full grow flex-col">
            <div class="gap-1 px-6 flex flex-1 justify-center py-5">
                <div class="layout-content-container flex flex-col w-80">
                    <%- include('../../partials/admin/sidebar', { page: 'brands' }) %>
                </div>
                <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
                    <%- include('../../partials/admin/navbar') %>

                        <div class="max-w-[512px] p-4">
                            <h2
                                class="text-[#121810] text-[22px] font-bold leading-tight tracking-[-0.015em] pb-3 pt-5">
                                Edit Brand</h2>

                            <form action="/admin/brands/<%= brand._id %>/edit" method="POST">
                                <div class="flex flex-col gap-4 py-3">
                                    <label class="flex flex-col w-full">
                                        <p class="text-[#121810] text-base font-medium leading-normal pb-2">Brand Name
                                        </p>
                                        <input name="name" value="<%= brand.name %>" required
                                            class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#121810] focus:outline-0 focus:ring-0 border border-[#dce7da] bg-white focus:border-[#dce7da] h-14 placeholder:text-[#658d5e] p-[15px] text-base font-normal leading-normal" />
                                    </label>

                                    <label class="flex flex-col w-full">
                                        <p class="text-[#121810] text-base font-medium leading-normal pb-2">Description
                                        </p>
                                        <textarea name="description"
                                            class="form-textarea flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#121810] focus:outline-0 focus:ring-0 border border-[#dce7da] bg-white focus:border-[#dce7da] h-24 placeholder:text-[#658d5e] p-[15px] text-base font-normal leading-normal"><%= brand.description || '' %></textarea>
                                    </label>

                                    <div class="flex gap-3 justify-end pt-4">
                                        <a href="/admin/brands"
                                            class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-12 px-5 bg-[#f0f5f0] text-[#121810] text-base font-bold leading-normal tracking-[0.015em]">Cancel</a>
                                        <button type="submit"
                                            class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-12 px-5 bg-[#37ff14] text-[#121810] text-base font-bold leading-normal tracking-[0.015em]">Update
                                            Brand</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>