<!-- Admin edit brand form template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" />
    <title>Admin · Edit Brand</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../../partials/admin/sidebar', { page: 'brands' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 p-6 md:p-8">
                <!-- Breadcrumb -->
                <div class="flex items-center gap-2 text-sm mb-4">
                    <a href="/admin/brands" class="text-[#685BCB] hover:underline">Brands</a>
                    <span class="text-gray-400">/</span>
                    <a href="/admin/brands/<%= brand._id %>" class="text-[#685BCB] hover:underline">
                        <%= brand.name %>
                    </a>
                    <span class="text-gray-400">/</span>
                    <span class="text-[#1F1F1F]">Edit</span>
                </div>

                <h1 class="text-[32px] font-bold text-[#1F1F1F] mb-6">Edit Brand</h1>

                <!-- General Error -->
                <% if (locals.error) { %>
                    <div class="mb-4 p-3 rounded-xl text-sm font-medium bg-red-100 text-red-800">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/admin/brands/<%= brand._id %>/edit" method="POST" enctype="multipart/form-data"
                            class="max-w-lg space-y-5" id="editBrandForm" novalidate>

                            <!-- Brand Name -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Brand Name <span
                                        class="text-red-500">*</span></label>
                                <input type="text" name="name"
                                    value="<%= locals.oldInput ? oldInput.name || '' : brand.name %>"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] <%= (locals.errors && errors.name) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="Enter brand name" />
                                <% if (locals.errors && errors.name) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.name %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-1 hidden" id="err-name"></p>
                            </div>

                            <!-- Description -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Description</label>
                                <textarea name="description" rows="3"
                                    class="w-full rounded-xl bg-[#FFFFFF] px-4 py-3 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB]"
                                    placeholder="Enter brand description"><%= locals.oldInput ? oldInput.description || '' : brand.description || '' %></textarea>
                            </div>

                            <!-- Brand Logo Section -->
                            <div class="bg-[#D3CEEA] rounded-xl p-5 border border-[#BCA6DB]">
                                <p class="text-[#1F1F1F] font-medium mb-3">Brand Logo</p>

                                <!-- Current Logo Preview -->
                                <% if (brand.logoUrl) { %>
                                    <div
                                        class="mb-4 p-3 bg-white rounded-lg border border-gray-100 flex justify-center">
                                        <img src="<%= brand.logoUrl %>" alt="Current Logo" class="h-20 object-contain">
                                    </div>
                                    <% } else { %>
                                        <div
                                            class="mb-4 p-3 bg-white rounded-lg border border-dashed border-gray-300 text-center">
                                            <p class="text-sm text-gray-400">No logo uploaded</p>
                                        </div>
                                        <% } %>

                                            <!-- Upload New Logo -->
                                            <label class="block mb-3">
                                                <span
                                                    class="text-xs font-semibold text-[#685BCB] uppercase tracking-wide mb-1 block">Upload
                                                    New Logo (JPG, PNG, WEBP - max 2MB)</span>
                                                <input type="file" name="logo"
                                                    accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                                    class="block w-full text-sm text-[#1F1F1F] file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[#e8f4e6] file:text-[#1F1F1F] hover:file:bg-[#BCA6DB]" />
                                            </label>

                                            <!-- Divider -->
                                            <div class="relative my-3">
                                                <div class="absolute inset-0 flex items-center">
                                                    <div class="w-full border-t border-gray-200"></div>
                                                </div>
                                                <div class="relative flex justify-center">
                                                    <span class="bg-[#D3CEEA] px-2 text-sm text-gray-400">OR</span>
                                                </div>
                                            </div>

                                            <!-- Logo URL -->
                                            <div>
                                                <label
                                                    class="block text-xs font-semibold text-[#685BCB] uppercase tracking-wide mb-1">Logo
                                                    URL</label>
                                                <input type="url" name="logoUrl"
                                                    value="<%= brand.logoUrl && brand.logoUrl.startsWith('http') ? brand.logoUrl : '' %>"
                                                    class="w-full h-10 rounded-xl bg-white px-4 border border-[#BCA6DB] text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] text-sm"
                                                    placeholder="https://example.com/logo.png" />
                                            </div>
                            </div>

                            <!-- Buttons -->
                            <div class="flex gap-3 pt-4">
                                <button type="submit"
                                    class="h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">
                                    Update Brand
                                </button>
                                <a href="/admin/brands/<%= brand._id %>"
                                    class="h-10 px-6 rounded-xl bg-[#FFFFFF] font-bold text-[#1F1F1F] hover:bg-[#D3CEEA] transition-colors flex items-center">
                                    Cancel
                                </a>
                            </div>
                        </form>
            </section>
        </main>
    </div>

    <script>
        document.getElementById('editBrandForm').addEventListener('submit', function (e) {
            let valid = true;
            document.querySelectorAll('[id^="err-"]').forEach(el => { el.textContent = ''; el.classList.add('hidden'); });

            const name = this.querySelector('[name="name"]');

            if (!name.value.trim() || name.value.trim().length < 2) {
                document.getElementById('err-name').textContent = 'Brand name is required (min 2 characters).';
                document.getElementById('err-name').classList.remove('hidden');
                valid = false;
            }

            if (!valid) e.preventDefault();
        });
    </script>
</body>

</html>