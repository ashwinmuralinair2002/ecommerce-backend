<!-- Admin change password page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" />
    <title>Admin · Change Password</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/utils.js"></script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-[#f8fcf8]"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 gap-6 px-6 py-5">
            <!-- Sidebar -->
            <aside class="w-80">
                <%- include('../partials/admin/sidebar', { page: 'dashboard' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 bg-white rounded-lg p-6">
                <!-- Breadcrumb -->
                <div class="flex items-center gap-2 text-sm mb-4">
                    <a href="/admin/dashboard" class="text-[#5f8c5f] hover:underline">Dashboard</a>
                    <span class="text-gray-400">/</span>
                    <span class="text-[#111811]">Change Password</span>
                </div>

                <h1 class="text-[32px] font-bold text-[#121811] mb-6">Change Password</h1>

                <!-- Message Container -->
                <% if (typeof message !=='undefined' && message) { %>
                    <div
                        class="mb-4 p-3 rounded-xl text-sm font-medium <%= messageType === 'error' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
                        <%= message %>
                    </div>
                    <% } %>

                        <form action="/admin/change-password" method="POST" class="max-w-md space-y-4"
                            id="changePasswordForm">
                            <!-- Current Password -->
                            <div>
                                <label class="block text-sm text-[#628d5e] mb-1">Current Password</label>
                                <div class="relative">
                                    <input type="password" name="currentPassword" id="currentPassword" required
                                        class="w-full h-12 rounded-xl bg-[#f0f5f0] px-4 pr-10 border-none text-[#111810] focus:ring-2 focus:ring-[#27ff14]"
                                        placeholder="Enter current password" />
                                    <button type="button"
                                        onclick="togglePasswordVisibility('currentPassword', 'icon-current')"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-[#628d5e] hover:text-[#27ff14] focus:outline-none p-1">
                                        <span id="icon-current">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </span>
                                    </button>
                                </div>
                            </div>

                            <!-- New Password -->
                            <div>
                                <label class="block text-sm text-[#628d5e] mb-1">New Password</label>
                                <div class="relative">
                                    <input type="password" name="newPassword" id="newPassword" required
                                        class="w-full h-12 rounded-xl bg-[#f0f5f0] px-4 pr-10 border-none text-[#111810] focus:ring-2 focus:ring-[#27ff14]"
                                        placeholder="Enter new password" />
                                    <button type="button" onclick="togglePasswordVisibility('newPassword', 'icon-new')"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-[#628d5e] hover:text-[#27ff14] focus:outline-none p-1">
                                        <span id="icon-new">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </span>
                                    </button>
                                </div>
                                <p class="text-xs text-[#658d5e] mt-1">Minimum 8 characters</p>
                            </div>

                            <!-- Confirm New Password -->
                            <div>
                                <label class="block text-sm text-[#628d5e] mb-1">Confirm New Password</label>
                                <div class="relative">
                                    <input type="password" name="confirmPassword" id="confirmPassword" required
                                        class="w-full h-12 rounded-xl bg-[#f0f5f0] px-4 pr-10 border-none text-[#111810] focus:ring-2 focus:ring-[#27ff14]"
                                        placeholder="Confirm new password" />
                                    <button type="button"
                                        onclick="togglePasswordVisibility('confirmPassword', 'icon-confirm')"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-[#628d5e] hover:text-[#27ff14] focus:outline-none p-1">
                                        <span id="icon-confirm">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </span>
                                    </button>
                                </div>
                            </div>

                            <!-- Client-side Validation Message -->
                            <div id="clientMessage" class="hidden p-3 rounded-xl text-sm font-medium"></div>

                            <!-- Buttons -->
                            <div class="flex gap-3 pt-4">
                                <button type="submit" id="submitBtn"
                                    class="h-10 px-6 rounded-xl bg-[#27ff14] font-bold text-[#111810] hover:bg-[#20e010] transition-colors">
                                    Update Password
                                </button>
                                <a href="/admin/dashboard"
                                    class="h-10 px-6 rounded-xl bg-[#f0f5f0] font-bold text-[#111810] hover:bg-[#e0e5e0] transition-colors flex items-center">
                                    Cancel
                                </a>
                            </div>
                        </form>
            </section>
        </main>
    </div>

    <script>
        document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const msgContainer = document.getElementById('clientMessage');

            // Clear previous messages
            msgContainer.classList.add('hidden');

            // Validate password length
            if (newPassword.length < 8) {
                e.preventDefault();
                showClientMessage('Password must be at least 8 characters', 'error');
                return;
            }

            // Validate passwords match
            if (newPassword !== confirmPassword) {
                e.preventDefault();
                showClientMessage('Passwords do not match', 'error');
                return;
            }
        });

        function showClientMessage(text, type) {
            const container = document.getElementById('clientMessage');
            container.innerText = text;
            container.classList.remove('hidden', 'bg-red-100', 'text-red-800', 'bg-green-100', 'text-green-800');
            if (type === 'error') {
                container.classList.add('bg-red-100', 'text-red-800');
            } else {
                container.classList.add('bg-green-100', 'text-green-800');
            }
        }
    </script>
</body>

</html>