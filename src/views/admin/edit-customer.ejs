<!-- Admin edit customer form template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap" />
    <title>Edit Customer - <%= customer.name %>
    </title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'customers' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 p-6 md:p-8">
                <!-- Breadcrumb -->
                <div class="flex items-center gap-2 text-sm mb-4">
                    <a href="/admin/customers" class="text-[#685BCB] hover:underline">Customers</a>
                    <span class="text-gray-400">/</span>
                    <a href="/admin/customers/<%= customer._id %>" class="text-[#685BCB] hover:underline">
                        <%= customer.name %>
                    </a>
                    <span class="text-gray-400">/</span>
                    <span class="text-[#1F1F1F]">Edit</span>
                </div>

                <h1 class="text-[32px] font-bold text-[#1F1F1F] mb-6">Edit Customer: <%= customer.name %>
                </h1>

                <!-- General Error -->
                <% if (locals.error) { %>
                    <div class="mb-4 p-3 rounded-xl text-sm font-medium bg-red-100 text-red-800">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/admin/customers/<%= customer._id %>/update" method="POST"
                            class="max-w-md space-y-4" id="editCustomerForm" novalidate>

                            <!-- Name -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Full Name <span
                                        class="text-red-500">*</span></label>
                                <input type="text" name="name"
                                    value="<%= locals.oldInput ? oldInput.name || '' : customer.name %>"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] <%= (locals.errors && errors.name) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="Full Name" />
                                <% if (locals.errors && errors.name) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.name %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-1 hidden" id="err-name"></p>
                            </div>

                            <!-- Email -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Email Address <span
                                        class="text-red-500">*</span></label>
                                <input type="email" name="email"
                                    value="<%= locals.oldInput ? oldInput.email || '' : customer.email %>"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] <%= (locals.errors && errors.email) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="Email Address" />
                                <% if (locals.errors && errors.email) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.email %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-1 hidden" id="err-email"></p>
                            </div>

                            <!-- Phone -->
                            <div>
                                <label class="block text-sm text-[#685BCB] mb-1">Phone Number</label>
                                <input type="tel" name="phone"
                                    value="<%= locals.oldInput ? oldInput.phone || '' : customer.phone || '' %>"
                                    class="w-full h-12 rounded-xl bg-[#FFFFFF] px-4 border-none text-[#1F1F1F] focus:ring-2 focus:ring-[#685BCB] <%= (locals.errors && errors.phone) ? 'ring-2 ring-red-400' : '' %>"
                                    placeholder="Phone Number" />
                                <% if (locals.errors && errors.phone) { %>
                                    <p class="text-red-500 text-xs mt-1">
                                        <%= errors.phone %>
                                    </p>
                                    <% } %>
                                        <p class="text-red-500 text-xs mt-1 hidden" id="err-phone"></p>
                            </div>

                            <!-- Buttons -->
                            <div class="flex gap-3 pt-4">
                                <button type="submit"
                                    class="h-10 px-6 rounded-xl bg-[#685BCB] font-bold text-white hover:bg-[#5a4dc0] transition-colors">
                                    Save Changes
                                </button>
                                <a href="/admin/customers/<%= customer._id %>"
                                    class="h-10 px-6 rounded-xl bg-[#FFFFFF] font-bold text-[#1F1F1F] hover:bg-[#D3CEEA] transition-colors flex items-center">
                                    Cancel
                                </a>
                            </div>
                        </form>
            </section>
        </main>
    </div>

    <script>
        document.getElementById('editCustomerForm').addEventListener('submit', function (e) {
            let valid = true;
            document.querySelectorAll('[id^="err-"]').forEach(el => { el.textContent = ''; el.classList.add('hidden'); });

            const name = this.querySelector('[name="name"]');
            const email = this.querySelector('[name="email"]');
            const phone = this.querySelector('[name="phone"]');

            if (!name.value.trim() || name.value.trim().length < 2) {
                document.getElementById('err-name').textContent = 'Name is required (min 2 characters).';
                document.getElementById('err-name').classList.remove('hidden');
                valid = false;
            }

            if (!email.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
                document.getElementById('err-email').textContent = 'Please enter a valid email address.';
                document.getElementById('err-email').classList.remove('hidden');
                valid = false;
            }

            if (phone.value.trim() && !/^\d{10}$/.test(phone.value.trim())) {
                document.getElementById('err-phone').textContent = 'Phone must be exactly 10 digits.';
                document.getElementById('err-phone').classList.remove('hidden');
                valid = false;
            }

            if (!valid) e.preventDefault();
        });
    </script>
</body>

</html>