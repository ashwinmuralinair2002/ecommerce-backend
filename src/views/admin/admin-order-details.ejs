<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />
    <title>Admin · <%= order.orderId %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.svg" />
    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-background-soft" style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
    <div class="min-h-screen flex flex-col">
        <%- include("../partials/admin/navbar") %>

        <main class="flex flex-1">
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'orders' }) %>
            </aside>

            <section class="flex-1 px-4 md:px-6 lg:px-8 xl:px-10 py-5 overflow-x-hidden">
                <% const statusOptions = ['pending', 'shipped', 'delivered', 'cancelled']; %>
                <% const allItemsCancelled = Array.isArray(order.items) && order.items.length > 0 ? order.items.every((item) => item.status === 'cancelled') : false; %>
                <% const isDelivered = order.orderStatus === 'delivered'; %>
                <% const isCancelled = order.orderStatus === 'cancelled'; %>
                <% const isReturned = order.orderStatus === 'returned'; %>
                <% const isPartiallyReturned = order.orderStatus === 'partially_returned'; %>
                <% const isStatusLocked = isDelivered || isCancelled || isReturned || isPartiallyReturned || allItemsCancelled; %>
                <% const STATUS_FLOW = {
                    pending: ['shipped'],
                    shipped: ['delivered']
                }; %>
                <% const LOCKED_ITEM_STATUSES = ['cancelled', 'returned', 'return_requested', 'return_rejected']; %>
                <% const address = order.shippingAddress || {}; %>
                <% const getStatusClasses = (status) => {
                    const normalizedStatus = String(status || '').toLowerCase();

                    if (normalizedStatus === 'pending') {
                        return 'bg-yellow-100 text-yellow-800 border-yellow-200';
                    }

                    if (normalizedStatus === 'shipped') {
                        return 'bg-blue-100 text-blue-800 border-blue-200';
                    }

                    if (normalizedStatus === 'delivered' || normalizedStatus === 'returned') {
                        return 'bg-green-100 text-green-800 border-green-200';
                    }

                    if (normalizedStatus === 'cancelled' || normalizedStatus === 'return_rejected') {
                        return 'bg-red-100 text-red-700 border-red-200';
                    }

                    if (normalizedStatus === 'return_requested' || normalizedStatus === 'partially_cancelled') {
                        return 'bg-orange-100 text-orange-700 border-orange-200';
                    }

                    return 'bg-gray-100 text-gray-700 border-gray-200';
                }; %>

                <div class="w-full">
                    <nav class="flex text-sm text-gray-500 mb-3" aria-label="Breadcrumb">
                        <ol class="inline-flex items-center space-x-1 md:space-x-2">
                            <li class="inline-flex items-center">
                                <a href="/admin/orders-page" class="inline-flex items-center text-gray-500 hover:text-primary">
                                    Orders
                                </a>
                            </li>
                            <li aria-current="page">
                                <div class="flex items-center">
                                    <span class="mx-2 text-gray-400">/</span>
                                    <span class="text-primary font-medium"><%= order.orderId %></span>
                                </div>
                            </li>
                        </ol>
                    </nav>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
                        <section class="lg:col-span-8 space-y-4">
                            <div class="bg-white border border-primary-light/40 rounded-lg p-4">
                                <h1 class="text-primary tracking-light text-[30px] font-bold leading-tight"><%= order.orderId %></h1>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 mt-4">
                                    <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                        <p class="text-primary text-sm font-normal leading-normal">Customer Name</p>
                                        <p class="text-primary text-sm font-normal leading-normal"><%= order.user && order.user.name ? order.user.name : 'N/A' %></p>
                                    </div>
                                    <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                        <p class="text-primary text-sm font-normal leading-normal">Payment Method</p>
                                        <p class="text-primary text-sm font-normal leading-normal"><%= order.paymentMethod %></p>
                                    </div>
                                    <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pr-2">
                                        <p class="text-primary text-sm font-normal leading-normal">Order Date</p>
                                        <p class="text-primary text-sm font-normal leading-normal"><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></p>
                                    </div>
                                    <div class="flex flex-col gap-1 border-t border-solid border-t-primary-light/70 py-3 pl-2">
                                        <p class="text-primary text-sm font-normal leading-normal">Total Amount</p>
                                        <p class="text-primary text-sm font-normal leading-normal">₹<%= Number(order.totalAmount || 0).toLocaleString('en-IN') %></p>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-white border border-primary-light/40 rounded-lg p-4">
                                <h3 class="text-primary text-lg font-bold leading-tight mb-4">Items</h3>
                                <div class="flex overflow-hidden rounded-lg border border-[#BCA6DB] bg-white">
                                    <table class="flex-1">
                                        <thead>
                                            <tr class="bg-white">
                                                <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Image</th>
                                                <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Product</th>
                                                <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Variant</th>
                                                <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Quantity</th>
                                                <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Price</th>
                                                <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Total</th>
                                                <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Status</th>
                                                <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">Refund</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% order.items.forEach(item => { %>
                                                <% const itemGST = item.gstAmount || 0; %>
                                                <% const itemFinalPrice = item.finalPrice || item.priceSnapshot || item.price || 0; %>
                                                <tr class="border-t border-t-[#BCA6DB] hover:bg-gray-50">
                                                    <td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
                                                        <img
                                                            src="<%= item.imageUrl && item.imageUrl.trim() !== '' ? item.imageUrl : '/images/placeholder.png' %>"
                                                            class="h-12 w-12 object-cover rounded-lg border bg-gray-100"
                                                            alt="Product Image">
                                                    </td>
                                                    <td class="h-[72px] px-4 py-2 text-[#1F1F1F] text-sm font-normal leading-normal"><%= item.productName %></td>
                                                    <td class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal"><%= item.colorName || 'N/A' %></td>
                                                    <td class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal"><%= item.quantity %></td>
                                                    <td class="h-[72px] px-4 py-2 text-[#1F1F1F] text-sm font-normal leading-normal price-breakdown">
                                                        <div>₹ <%= Number(item.priceSnapshot ?? item.price ?? 0).toLocaleString('en-IN') %></div>

                                                        <% if (item.offerDiscount && item.offerDiscount > 0) { %>
                                                            <div style="color: red;">
                                                                - ₹ <%= Number(item.offerDiscount).toLocaleString('en-IN') %>
                                                            </div>

                                                            <div style="color: green; font-size: 12px;">
                                                                You saved ₹ <%= Number(item.offerDiscount).toLocaleString('en-IN') %>
                                                            </div>
                                                        <% } %>

                                                        <% if (itemGST) { %>
                                                            <div style="font-size: 12px; color: #555;">
                                                                GST: ₹ <%= Number(itemGST).toLocaleString('en-IN') %>
                                                            </div>
                                                        <% } %>

                                                        <div style="font-weight: bold;">
                                                            = ₹ <%= Number(itemFinalPrice).toLocaleString('en-IN') %>
                                                        </div>
                                                    </td>
                                                    <td class="h-[72px] px-4 py-2 text-[#1F1F1F] text-sm font-normal leading-normal">₹<%= Number(item.finalPrice || ((item.priceSnapshot || item.price || 0) * (item.quantity || 0))).toLocaleString('en-IN') %></td>
                                                    <td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
                                                        <div class="flex flex-col items-start">
                                                            <div class="flex items-center gap-2">
                                                                <span
                                                                    data-item-status-badge
                                                                    data-status="<%= item.status %>"
                                                                    class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold capitalize <%= getStatusClasses(item.status) %>">
                                                                    <%= item.status %>
                                                                </span>

                                                                <% const itemStatus = String(item.status || '').toLowerCase(); %>
                                                                <% const nextStatuses = STATUS_FLOW[itemStatus] || []; %>
                                                                <% const isItemStatusLocked = LOCKED_ITEM_STATUSES.includes(itemStatus); %>
                                                                <% const nextStatus = nextStatuses[0] || ''; %>
                                                                <% const itemActionLabel = nextStatus === 'shipped' ? 'Mark as Shipped' : (nextStatus === 'delivered' ? 'Mark as Delivered' : ''); %>
                                                                <% const itemActionClasses = nextStatus === 'shipped'
                                                                    ? 'bg-blue-100 text-blue-700 border-blue-200 hover:bg-blue-200'
                                                                    : 'bg-green-100 text-green-700 border-green-200 hover:bg-green-200'; %>

                                                                <% if (!isItemStatusLocked && item.itemId && nextStatus) { %>
                                                                    <button
                                                                        type="button"
                                                                        data-item-status-action
                                                                        data-order-id="<%= order.orderId %>"
                                                                        data-item-id="<%= item.itemId %>"
                                                                        data-next-status="<%= nextStatus %>"
                                                                        class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold transition <%= itemActionClasses %>">
                                                                        <%= itemActionLabel %>
                                                                    </button>
                                                                <% } %>

                                                                <% if (
                                                                    (item.status === 'cancelled' && item.cancellationReason && item.cancellationReason.trim())
                                                                    || ((item.status === 'return_requested' || item.status === 'returned') && item.returnReason && item.returnReason.trim())
                                                                ) { %>
                                                                    <button
                                                                        type="button"
                                                                        data-toggle-reason
                                                                        data-item-id="<%= item.itemId %>"
                                                                        class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold bg-blue-100 text-blue-700 border-blue-200 hover:bg-blue-200 transition">
                                                                        View Reason
                                                                    </button>
                                                                <% } %>
                                                            </div>

                                                            <% if (item.status === 'return_requested') { %>
                                                                <div class="flex gap-2 mt-2">
                                                                    <button
                                                                        type="button"
                                                                        data-return-approve
                                                                        data-order-id="<%= order.orderId %>"
                                                                        data-item-id="<%= item.itemId %>"
                                                                        class="theme-primary-btn px-3 py-1 text-sm rounded">
                                                                        Approve
                                                                    </button><button
                                                                    type="button"
                                                                    data-return-reject
                                                                    data-order-id="<%= order.orderId %>"
                                                                    data-item-id="<%= item.itemId %>"
                                                                    class="theme-secondary-btn px-3 py-1 text-sm rounded">
                                                                    Reject
                                                                </button>

                                                                </div>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
                                                        <% if (item.refundStatus === 'processed') { %>
                                                            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-semibold bg-green-100 text-green-700">
                                                                Refunded
                                                            </span>
                                                        <% } else if (item.refundStatus === 'pending') { %>
                                                            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-semibold bg-yellow-100 text-yellow-700">
                                                                Pending
                                                            </span>
                                                        <% } else { %>
                                                            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-semibold bg-gray-100 text-gray-600">
                                                                Not Initiated
                                                            </span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                                <% if (
                                                    (item.status === 'cancelled' && item.cancellationReason && item.cancellationReason.trim())
                                                    || ((item.status === 'return_requested' || item.status === 'returned') && item.returnReason && item.returnReason.trim())
                                                ) { %>
                                                    <tr id="reason-<%= item.itemId %>" class="hidden border-t border-t-[#BCA6DB] bg-gray-50/60">
                                                        <td colspan="8" class="px-4 py-2">
                                                            <div class="mt-2 p-3 bg-gray-50 border rounded max-h-32 overflow-y-auto text-sm text-gray-700">
                                                                <% if (item.status === 'cancelled') { %>
                                                                    <%= item.cancellationReason %>
                                                                <% } else { %>
                                                                    <%= item.returnReason %>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </section>

                        <aside class="lg:col-span-4 flex flex-col gap-6">
                            <div class="lg:sticky lg:top-24 border border-primary-light/45 bg-white rounded-lg shadow-sm p-4 space-y-4">
                                <div class="pb-3 border-b border-primary-light/30">
                                    <h2 class="text-primary tracking-light text-[30px] font-bold leading-tight">Status Control</h2>
                                    <p class="text-sm text-gray-600 mt-1">Update the order status without leaving this page.</p>
                                </div>

                                <div class="space-y-2 text-sm text-primary">
                                    <p>
                                        <span class="font-semibold">Current Status:</span>
                                        <span
                                            id="currentOrderStatus"
                                            data-status="<%= order.orderStatus %>"
                                            class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold capitalize <%= getStatusClasses(order.orderStatus) %>">
                                            <%= order.orderStatus %>
                                        </span>
                                    </p>
                                    <% if (order.user) { %>
                                        <p><span class="font-semibold">Customer Email:</span> <%= order.user.email || 'N/A' %></p>
                                        <p><span class="font-semibold">Customer Phone:</span> <%= order.user.phone || 'N/A' %></p>
                                    <% } %>
                                </div>

                                <div>
                                    <label for="orderStatusSelect" class="block text-sm text-primary font-semibold mb-2">Order Status</label>
                                    <select id="orderStatusSelect"
                                        value="<%= order.orderStatus %>"
                                        class="form-input w-full rounded-xl border border-[#BCA6DB] bg-white text-[#1F1F1F] text-sm h-11 px-4 focus:outline-none focus:ring-2 focus:ring-[#685BCB] disabled:bg-gray-100 disabled:text-gray-400 disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed <%= isStatusLocked ? 'opacity-50 pointer-events-none cursor-not-allowed bg-gray-100 text-gray-400' : '' %>"
                                        <%= isStatusLocked ? 'disabled' : '' %>>
                                        <% statusOptions.forEach((status) => { %>
                                            <option value="<%= status %>" <%= order.orderStatus === status ? 'selected' : '' %>><%= status %></option>
                                        <% }) %>
                                    </select>
                                    <% if (isDelivered) { %>
                                        <p class="text-xs text-red-600 mt-2">Delivered orders cannot be updated.</p>
                                    <% } else if (isCancelled) { %>
                                        <p class="text-xs text-red-600 mt-2">Cancelled orders cannot be updated.</p>
                                    <% } else if (isReturned) { %>
                                        <p class="text-xs text-red-600 mt-2">Returned orders cannot be updated.</p>
                                    <% } else if (isPartiallyReturned) { %>
                                        <p class="text-xs text-red-600 mt-2">Partially returned orders cannot be updated.</p>
                                    <% } else if (allItemsCancelled) { %>
                                        <p class="text-xs text-red-600 mt-2">Fully cancelled orders cannot be updated.</p>
                                    <% } %>
                                </div>

                                <div class="pt-3 border-t border-primary-light/30 space-y-2 text-sm text-primary">
                                    <h3 class="text-primary text-lg font-bold leading-tight">Shipping Address</h3>
                                    <p><span class="font-semibold">Name:</span> <%= address.name || 'N/A' %></p>
                                    <p><span class="font-semibold">Phone:</span> <%= address.phone || 'N/A' %></p>
                                    <p><span class="font-semibold">Address:</span> <%= address.addressLine1 || 'N/A' %></p>
                                    <p><span class="font-semibold">City, State, Pincode:</span> <%= [address.city, address.state, address.pincode].filter(Boolean).join(', ') || 'N/A' %></p>
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const orderId = <%- JSON.stringify(order.orderId) %>;
            const statusSelect = document.getElementById('orderStatusSelect');
            const currentOrderStatus = document.getElementById('currentOrderStatus');
            const ORDER_STATUS_STYLES = {
                pending: 'bg-yellow-100 text-yellow-800 border-yellow-200',
                shipped: 'bg-blue-100 text-blue-800 border-blue-200',
                delivered: 'bg-green-100 text-green-800 border-green-200',
                returned: 'bg-green-100 text-green-800 border-green-200',
                cancelled: 'bg-red-100 text-red-700 border-red-200',
                return_rejected: 'bg-red-100 text-red-700 border-red-200',
                return_requested: 'bg-orange-100 text-orange-700 border-orange-200',
                partially_cancelled: 'bg-orange-100 text-orange-700 border-orange-200',
                partially_returned: 'bg-orange-100 text-orange-700 border-orange-200'
            };

            function formatStatusLabel(status) {
                const normalizedStatus = String(status || '').toLowerCase();

                return normalizedStatus
                    .split('_')
                    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
                    .join(' ');
            }

            function updateStatusBadge(element, status) {
                if (!element) {
                    return;
                }

                const normalizedStatus = String(status || '').toLowerCase();
                const allStatusClasses = Object.values(ORDER_STATUS_STYLES).join(' ').split(' ');
                const nextClasses = ORDER_STATUS_STYLES[normalizedStatus] || 'bg-gray-100 text-gray-700 border-gray-200';

                element.classList.remove(...allStatusClasses);
                element.classList.add(...nextClasses.split(' '));
                element.dataset.status = normalizedStatus;
                element.textContent = formatStatusLabel(normalizedStatus);
            }

            function syncOrderStatusFromItems() {
                const itemBadges = Array.from(document.querySelectorAll('[data-item-status-badge]'));

                if (itemBadges.length === 0) {
                    return;
                }

                const allItemsCompleted = itemBadges.every((badge) => {
                    const status = String(badge.dataset.status || '').toLowerCase();
                    return ['delivered', 'cancelled', 'returned'].includes(status);
                });

                if (allItemsCompleted && currentOrderStatus) {
                    updateStatusBadge(currentOrderStatus, 'delivered');
                }
            }

            if (statusSelect && !statusSelect.disabled) {
                let previousValue = statusSelect.value;

                statusSelect.addEventListener('change', async function () {
                    const selectedValue = statusSelect.value;

                    statusSelect.disabled = true;
                    statusSelect.classList.add('opacity-50', 'pointer-events-none');

                    try {
                        const response = await fetch(`/admin/orders/${orderId}/status`, {
                            method: 'PATCH',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                status: selectedValue
                            })
                        });

                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Failed to update order status');
                        }

                        previousValue = selectedValue;
                        if (currentOrderStatus) {
                            updateStatusBadge(
                                currentOrderStatus,
                                data.data && data.data.orderStatus ? data.data.orderStatus : selectedValue
                            );
                        }

                        if (selectedValue === 'delivered') {
                            document.querySelectorAll('[data-item-status-badge]').forEach((badge) => {
                                if (String(badge.dataset.status || '').toLowerCase() !== 'cancelled') {
                                    updateStatusBadge(badge, 'delivered');
                                }
                            });
                        }

                        if (selectedValue === 'delivered') {
                            statusSelect.disabled = true;
                        } else {
                            statusSelect.disabled = false;
                            statusSelect.classList.remove('opacity-50', 'pointer-events-none');
                        }

                        await Swal.fire({
                            icon: 'success',
                            title: 'Updated',
                            text: 'Order status updated successfully',
                            timer: 1400,
                            showConfirmButton: false
                        });
                    } catch (error) {
                        statusSelect.value = previousValue;
                        statusSelect.disabled = false;
                        statusSelect.classList.remove('opacity-50', 'pointer-events-none');

                        Swal.fire('Error', error.message || 'Failed to update order status', 'error');
                    }
                });
            }

            async function handleReturnAction(button, action) {
                if (!button || button.dataset.loading === 'true') {
                    return;
                }

                button.dataset.loading = 'true';

                const actionButtons = Array.from(button.parentElement ? button.parentElement.querySelectorAll('button') : [button]);
                const orderIdValue = button.dataset.orderId;
                const itemId = button.dataset.itemId;
                const itemRow = button.closest('tr');
                const itemStatusBadge = itemRow ? itemRow.querySelector('[data-item-status-badge]') : null;

                if (!orderIdValue || !itemId) {
                    button.dataset.loading = 'false';
                    await Swal.fire('Error', 'Missing return details for this item.', 'error');
                    return;
                }

                actionButtons.forEach((actionButton) => {
                    actionButton.disabled = true;
                    actionButton.classList.add('opacity-50', 'pointer-events-none');
                });

                const confirmation = await Swal.fire({
                    title: action === 'approve' ? 'Approve this return request?' : 'Reject this return request?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: action === 'approve' ? 'Approve' : 'Reject',
                    cancelButtonText: 'Cancel'
                });

                if (!confirmation.isConfirmed) {
                    actionButtons.forEach((actionButton) => {
                        actionButton.disabled = false;
                        actionButton.classList.remove('opacity-50', 'pointer-events-none');
                    });
                    button.dataset.loading = 'false';
                    return;
                }

                try {
                    const response = await fetch(`/admin/orders/${orderIdValue}/item/${itemId}/return`, {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            action
                        })
                    });

                    const data = await response.json().catch(() => null);

                    if (!response.ok || !data || !data.success) {
                        throw new Error(data?.message || 'Failed to process return');
                    }

                    updateStatusBadge(itemStatusBadge, action === 'approve' ? 'returned' : 'return_rejected');

                    if (button.parentElement) {
                        button.parentElement.remove();
                    }

                    await Swal.fire({
                        icon: 'success',
                        title: action === 'approve' ? 'Return Approved' : 'Return Rejected',
                        text: data.message || (action === 'approve' ? 'Return approved' : 'Return rejected'),
                        timer: 1400,
                        showConfirmButton: false
                    });
                } catch (error) {
                    actionButtons.forEach((actionButton) => {
                        actionButton.disabled = false;
                        actionButton.classList.remove('opacity-50', 'pointer-events-none');
                    });

                    await Swal.fire('Error', error.message || 'Failed to process return', 'error');
                } finally {
                    button.dataset.loading = 'false';
                }
            }

            const ITEM_STATUS_FLOW = {
                pending: ['shipped'],
                shipped: ['delivered']
            };

            document.querySelectorAll('[data-item-status-action]').forEach((button) => {
                button.addEventListener('click', async () => {
                    if (button.dataset.loading === 'true') {
                        return;
                    }

                    button.dataset.loading = 'true';

                    const orderIdValue = button.dataset.orderId;
                    const itemId = button.dataset.itemId;
                    const selectedValue = button.dataset.nextStatus;
                    const itemRow = button.closest('tr');
                    const itemStatusBadge = itemRow ? itemRow.querySelector('[data-item-status-badge]') : null;

                    if (!orderIdValue || !itemId || !selectedValue) {
                        button.dataset.loading = 'false';
                        await Swal.fire('Error', 'Missing item status details.', 'error');
                        return;
                    }

                    button.disabled = true;
                    button.classList.add('opacity-50', 'pointer-events-none');

                    try {
                        const response = await fetch(`/admin/orders/${orderIdValue}/item/${itemId}/status`, {
                            method: 'PATCH',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                status: selectedValue
                            })
                        });

                        const data = await response.json().catch(() => null);

                        if (!response.ok || !data || !data.success) {
                            throw new Error(data?.message || 'Failed to update item status');
                        }

                        updateStatusBadge(itemStatusBadge, selectedValue);

                        const nextStatuses = ITEM_STATUS_FLOW[selectedValue] || [];
                        const nextStatus = nextStatuses[0] || '';

                        if (!nextStatus) {
                            button.remove();
                        } else {
                            button.dataset.nextStatus = nextStatus;
                            button.textContent = nextStatus === 'shipped' ? 'Mark as Shipped' : 'Mark as Delivered';
                            button.className = `inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold transition ${
                                nextStatus === 'shipped'
                                    ? 'bg-blue-100 text-blue-700 border-blue-200 hover:bg-blue-200'
                                    : 'bg-green-100 text-green-700 border-green-200 hover:bg-green-200'
                            }`;
                            button.disabled = false;
                            button.classList.remove('opacity-50', 'pointer-events-none');
                        }

                        syncOrderStatusFromItems();

                        await Swal.fire({
                            icon: 'success',
                            title: 'Updated',
                            text: data.message || 'Item status updated successfully',
                            timer: 1400,
                            showConfirmButton: false
                        });
                    } catch (error) {
                        button.disabled = false;
                        button.classList.remove('opacity-50', 'pointer-events-none');

                        await Swal.fire('Error', error.message || 'Failed to update item status', 'error');
                    } finally {
                        button.dataset.loading = 'false';
                    }
                });
            });

            document.querySelectorAll('[data-return-approve]').forEach((button) => {
                button.addEventListener('click', () => handleReturnAction(button, 'approve'));
            });

            document.querySelectorAll('[data-return-reject]').forEach((button) => {
                button.addEventListener('click', () => handleReturnAction(button, 'reject'));
            });

            document.querySelectorAll('[data-toggle-reason]').forEach((button) => {
                button.addEventListener('click', () => {
                    const itemId = button.dataset.itemId;
                    const reasonRow = itemId ? document.getElementById(`reason-${itemId}`) : null;

                    if (!reasonRow) {
                        return;
                    }

                    reasonRow.classList.toggle('hidden');
                });
            });
        });
    </script>
</body>

</html>
