<!DOCTYPE html>
<html>

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />

    <title>Stitch Design - Customers</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        async function toggleBlock(userId, currentStatus) {
            confirmAction({
                title: currentStatus ? 'Unblock User?' : 'Block User?',
                text: `Are you sure you want to ${currentStatus ? 'unblock' : 'block'} this user?`,
                confirmButtonText: currentStatus ? 'Yes, Unblock' : 'Yes, Block',
                confirmButtonColor: currentStatus ? '#1ff91f' : '#d33' // Green for unblock, Red for block
            }, async () => {
                try {
                    const response = await fetch(`/admin/customers/${userId}/toggle-block`, { method: 'POST' });
                    if (response.ok) {
                        showToast(`User ${currentStatus ? 'unblocked' : 'blocked'} successfully`);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showError('Action Failed', 'Failed to update status');
                    }
                } catch (e) {
                    showError('Error', 'An unexpected error occurred');
                }
            });
        }

        async function deleteUser(userId) {
            confirmAction({
                title: 'Delete User?',
                text: 'Are you sure you want to delete this user? This action cannot be undone.',
                confirmButtonText: 'Yes, Delete',
                confirmButtonColor: '#d33'
            }, async () => {
                try {
                    const response = await fetch(`/admin/customers/${userId}/delete`, { method: 'POST' });
                    if (response.ok) {
                        showToast('User deleted successfully');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showError('Delete Failed', 'Failed to delete user');
                    }
                } catch (e) {
                    showError('Error', 'An unexpected error occurred');
                }
            });
        }

        function handleSearch(e) {
            if (e.key === 'Enter') {
                window.location.href = '?search=' + encodeURIComponent(e.target.value);
            }
        }
    </script>
</head>

<body>
    <div class="relative flex h-auto min-h-screen w-full flex-col bg-white group/design-root overflow-x-hidden"
        style='font-family: Inter, "Noto Sans", sans-serif;'>
        <div class="layout-container flex h-full grow flex-col">
            <div class="gap-1 px-6 flex flex-1 justify-center py-5">
                <div class="layout-content-container flex flex-col w-80">
                    <%- include('../partials/admin/sidebar', { page: 'customers' }) %>
                </div>
                <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
                    <%- include('../partials/admin/navbar') %>

                        <div class="flex flex-wrap justify-between gap-3 p-4">
                            <div class="flex min-w-72 flex-col gap-3">
                                <p class="text-[#121810] tracking-light text-[32px] font-bold leading-tight">Customers
                                </p>
                                <p class="text-[#658d5e] text-sm font-normal leading-normal">Manage user accounts,
                                    orders, and activity</p>
                            </div>
                            <button
                                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-8 px-4 bg-[#f0f5f0] text-[#121810] text-sm font-medium leading-normal">
                                <span class="truncate">Add customer</span>
                            </button>
                        </div>
                        <div class="flex justify-between gap-2 px-4 py-3">
                            <div class="flex gap-2">
                                <a href="/admin/customers/export?search=<%= search %>" class="p-2 text-[#121810]">
                                    <div class="text-[#121810]" data-icon="Export" data-size="24px"
                                        data-weight="regular">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px"
                                            fill="currentColor" viewBox="0 0 256 256">
                                            <path
                                                d="M216,112v96a16,16,0,0,1-16,16H56a16,16,0,0,1-16-16V112A16,16,0,0,1,56,96H80a8,8,0,0,1,0,16H56v96H200V112H176a8,8,0,0,1,0-16h24A16,16,0,0,1,216,112ZM93.66,69.66,120,43.31V136a8,8,0,0,0,16,0V43.31l26.34,26.35a8,8,0,0,0,11.32-11.32l-40-40a8,8,0,0,0-11.32,0l-40,40A8,8,0,0,0,93.66,69.66Z">
                                            </path>
                                        </svg>
                                    </div>
                                </a>
                            </div>
                            <a href="/admin/customers/export?search=<%= search %>"
                                class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 bg-[#37ff14] text-[#121810] gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-4">
                                <div class="text-[#121810]" data-icon="CaretDown" data-size="20px" data-weight="fill">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px"
                                        fill="currentColor" viewBox="0 0 256 256">
                                        <path
                                            d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,48,88H208a8,8,0,0,1,5.66,13.66Z">
                                        </path>
                                    </svg>
                                </div>
                                <span class="truncate">Export</span>
                            </a>
                        </div>
                        <div class="px-4 py-3">
                            <label class="flex flex-col min-w-40 h-12 w-full">
                                <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
                                    <div class="text-[#658d5e] flex border-none bg-[#f0f5f0] items-center justify-center pl-4 rounded-l-lg border-r-0"
                                        data-icon="MagnifyingGlass" data-size="24px" data-weight="regular">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px"
                                            fill="currentColor" viewBox="0 0 256 256">
                                            <path
                                                d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z">
                                            </path>
                                        </svg>
                                    </div>
                                    <input placeholder="Search by name / email / phone"
                                        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#121810] focus:outline-0 focus:ring-0 border-none bg-[#f0f5f0] focus:border-none h-full placeholder:text-[#658d5e] px-4 rounded-l-none border-l-0 pl-2 text-base font-normal leading-normal"
                                        value="<%= search %>" onkeydown="handleSearch(event)" />
                                </div>
                            </label>
                        </div>
                        <div class="pb-3">
                            <div class="flex border-b border-[#dce7da] px-4 gap-8">
                                <a class="flex flex-col items-center justify-center border-b-[3px] border-b-[#121810] text-[#121810] pb-[13px] pt-4"
                                    href="#">
                                    <p class="text-[#121810] text-sm font-bold leading-normal tracking-[0.015em]">All
                                    </p>
                                </a>
                            </div>
                        </div>
                        <div class="px-4 py-3 @container">
                            <div class="flex overflow-hidden rounded-lg border border-[#dce7da] bg-white">
                                <table class="flex-1">
                                    <thead>
                                        <tr class="bg-white">
                                            <!-- Removed empty column -->
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] w-14 text-sm font-medium leading-normal">
                                                Avatar</th>
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] text-sm font-medium leading-normal">
                                                Name</th>
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] text-sm font-medium leading-normal">
                                                Email</th>
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] text-sm font-medium leading-normal">
                                                Phone</th>
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] text-sm font-medium leading-normal">
                                                Total orders
                                            </th>
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] text-sm font-medium leading-normal">
                                                Lifetime value
                                            </th>
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] w-60 text-sm font-medium leading-normal">
                                                Status</th>
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] text-sm font-medium leading-normal">
                                                Last active
                                            </th>
                                            <th
                                                class="px-4 py-3 text-left text-[#121810] w-60 text-[#658d5e] text-sm font-medium leading-normal">
                                                Actions
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (consumers.length===0) { %>
                                            <tr>
                                                <td colspan="9" class="text-center py-4">No customers found</td>
                                            </tr>
                                            <% } else { %>
                                                <% consumers.forEach((user)=> { %>
                                                    <tr class="border-t border-t-[#dce7da] hover:bg-gray-50 cursor-pointer"
                                                        onclick="window.location.href='/admin/customers/<%= user._id %>'">
                                                        <td
                                                            class="h-[72px] px-4 py-2 w-14 text-sm font-normal leading-normal">
                                                            <div
                                                                class="bg-center bg-no-repeat aspect-square bg-cover rounded-full w-10 flex items-center justify-center bg-gray-200 text-gray-600 font-bold">
                                                                <%= user.name.charAt(0).toUpperCase() %>
                                                            </div>
                                                        </td>
                                                        <td
                                                            class="h-[72px] px-4 py-2 text-[#121810] text-sm font-normal leading-normal">
                                                            <%= user.name %>
                                                        </td>
                                                        <td
                                                            class="h-[72px] px-4 py-2 text-[#658d5e] text-sm font-normal leading-normal">
                                                            <%= user.email %>
                                                        </td>
                                                        <td
                                                            class="h-[72px] px-4 py-2 text-[#658d5e] text-sm font-normal leading-normal">
                                                            <%= user.phone || 'N/A' %>
                                                        </td>
                                                        <td
                                                            class="h-[72px] px-4 py-2 text-[#658d5e] text-sm font-normal leading-normal">
                                                            <%= user.totalOrders %>
                                                        </td>
                                                        <td
                                                            class="h-[72px] px-4 py-2 text-[#658d5e] text-sm font-normal leading-normal">
                                                            $<%= user.lifetimeValue %>
                                                        </td>
                                                        <td
                                                            class="h-[72px] px-4 py-2 w-60 text-sm font-normal leading-normal">
                                                            <button
                                                                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-8 px-4 text-[#121810] text-sm font-medium leading-normal w-full user-select-none <%= user.isBlocked ? 'bg-red-100 text-red-800' : 'bg-[#f0f5f0]' %>"
                                                                style="pointer-events: none;">
                                                                <span class="truncate">
                                                                    <%= user.isBlocked ? 'Blocked' : 'Active' %>
                                                                </span>
                                                            </button>
                                                        </td>
                                                        <td
                                                            class="h-[72px] px-4 py-2 text-[#658d5e] text-sm font-normal leading-normal">
                                                            <%= user.lastActive ? new
                                                                Date(user.lastActive).toLocaleString() : 'N/A' %>
                                                        </td>
                                                        <td class="h-[72px] px-4 py-2 w-60 text-[#658d5e] text-sm font-bold leading-normal tracking-[0.015em] flex gap-2 items-center"
                                                            onclick="event.stopPropagation()">
                                                            <a href="/admin/customers/<%= user._id %>"
                                                                class="hover:text-[#121810]">View</a>
                                                            <button
                                                                onclick="toggleBlock('<%= user._id %>', <%= user.isBlocked %>)"
                                                                class="hover:text-[#121810]">
                                                                <%= user.isBlocked ? 'Unban' : 'Ban' %>
                                                            </button>
                                                            <button onclick="deleteUser('<%= user._id %>')"
                                                                class="text-red-500 hover:text-red-700">Delete</button>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>