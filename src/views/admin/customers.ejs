<!-- Admin customers list page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />

    <title>SoundWave - Customers</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Helper for consistent confirmation dialogs
        function confirmAction(options, onConfirm) {
            Swal.fire({
                title: options.title,
                text: options.text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: options.confirmButtonColor || '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: options.confirmButtonText || 'Yes, proceed!'
            }).then((result) => {
                if (result.isConfirmed) {
                    onConfirm();
                }
            });
        }

        async function toggleBlock(userId, currentStatus, btnElement) {
            confirmAction({
                title: currentStatus ? 'Unblock User?' : 'Block User?',
                text: `Are you sure you want to ${currentStatus ? 'unblock' : 'block'} this user?`,
                confirmButtonText: currentStatus ? 'Yes, Unblock' : 'Yes, Block',
                confirmButtonColor: currentStatus ? '#685BCB' : '#d33'
            }, async () => {
                try {
                    const response = await fetch(`/admin/customers/${userId}/toggle-block`, { method: 'POST' });
                    const data = await response.json();

                    if (response.ok && data.success) {
                        // Dynamic UI Update without Reload
                        const row = document.getElementById(`row-${userId}`);
                        const statusBadge = document.getElementById(`status-${userId}`);
                        const actionBtn = document.getElementById(`btn-action-${userId}`);

                        const isNowBlocked = data.isBlocked;

                        // Update Badge
                        if (isNowBlocked) {
                            statusBadge.className = "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-8 px-4 text-sm font-medium leading-normal w-full user-select-none bg-[#f3f4f6] text-[#6b7280]";
                            statusBadge.querySelector('span').innerText = "Banned";
                        } else {
                            statusBadge.className = "flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-8 px-4 text-sm font-medium leading-normal w-full user-select-none bg-[#e6f4ea] text-[#1e7e34]";
                            statusBadge.querySelector('span').innerText = "Active";
                        }

                        // Update Toggle Button
                        // We need to update the onclick handler to reflect new state
                        actionBtn.innerText = isNowBlocked ? 'Unban' : 'Ban';
                        actionBtn.setAttribute('onclick', `toggleBlock('${userId}', ${isNowBlocked}, this)`);

                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: `User ${isNowBlocked ? 'blocked' : 'unblocked'} successfully`,
                            timer: 1500,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire('Error', 'Failed to update status', 'error');
                    }
                } catch (e) {
                    console.error(e);
                    Swal.fire('Error', 'An unexpected error occurred', 'error');
                }
            });
        }

        async function deleteUser(userId) {
            confirmAction({
                title: 'Delete User?',
                text: 'Are you sure you want to delete this user? This action cannot be undone.',
                confirmButtonText: 'Yes, Delete',
                confirmButtonColor: '#d33'
            }, async () => {
                try {
                    const response = await fetch(`/admin/customers/${userId}/delete`, { method: 'POST' });
                    if (response.ok) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'User has been deleted.',
                            timer: 1200,
                            showConfirmButton: false
                        });
                        // Reload current page to recalculate pagination server-side
                        window.location.reload();
                    } else {
                        Swal.fire('Error', 'Failed to delete user', 'error');
                    }
                } catch (e) {
                    Swal.fire('Error', 'An unexpected error occurred', 'error');
                }
            });
        }

        function handleSearch(e) {
            if (e.key === 'Enter') {
                const val = e.target.value.trim();
                if (val) {
                    window.location.href = '?search=' + encodeURIComponent(val);
                } else {
                    window.location.href = window.location.pathname;
                }
            }
        }

        function clearSearch() {
            window.location.href = window.location.pathname;
        }
    </script>
</head>

<body>
    <div class="min-h-screen flex flex-col bg-white"
        style='font-family: Inter, "Noto Sans", sans-serif;'>

        <%- include("../partials/admin/navbar") %>

        <!-- Main Layout: Sidebar + Content -->
        <main class="flex flex-1 bg-white">
            <!-- Sidebar -->
            <aside class="w-64 flex-shrink-0 border-r border-[#BCA6DB] bg-[#BCA6DB]">
                <%- include('../partials/admin/sidebar', { page: 'customers' }) %>
            </aside>

            <!-- Main Content Panel -->
            <section class="flex-1 p-6 md:p-8">
                <div class="admin-page-container max-w-[1400px] mx-auto">
                <div class="flex flex-wrap justify-between gap-3 mb-6">
                    <div class="flex min-w-72 flex-col gap-1">
                        <h1 class="text-[32px] font-bold text-[#1F1F1F]">Customers</h1>
                        <p class="text-[#685BCB] text-sm">Manage user accounts, orders, and activity</p>
                    </div>
                    <a href="/admin/customers/add"
                        class="flex items-center justify-center rounded-lg h-10 px-4 bg-[#685BCB] text-white text-sm font-bold hover:bg-[#5a4dc0] transition-colors">
                        <span>Add customer</span>
                    </a>
                </div>
                <div class="px-4 pt-1 pb-4">
                    <div class="relative">
                        <input type="text" placeholder="Search by name / email / phone" value="<%= search %>"
                            onkeydown="handleSearch(event)"
                            class="w-full h-12 rounded-xl bg-[#FFFFFF] border border-[#BCA6DB] pl-4 pr-12 text-[#1F1F1F] placeholder:text-[#685BCB] focus:outline-none focus:ring-2 focus:ring-[#685BCB]" />
                        <% if (search) { %>
                            <button onclick="clearSearch()"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-full p-1 transition-colors"
                                title="Clear Search">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                    viewBox="0 0 256 256">
                                    <path
                                        d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z">
                                    </path>
                                </svg>
                            </button>
                            <% } %>
                    </div>
                </div>
                <!-- Divider line -->
                <div class="border-b border-[#BCA6DB] mx-4 mb-4"></div>
                <div class="px-4 py-2 @container">
                    <div class="flex overflow-hidden rounded-lg border border-[#BCA6DB] bg-white">
                        <table class="flex-1">
                            <thead>
                                <tr class="bg-white">
                                    <!-- Removed empty column -->
                                    <th
                                        class="px-4 py-3 text-left text-[#1F1F1F] w-14 text-sm font-medium leading-normal">
                                        Avatar</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Name</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Email</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Phone</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Total orders
                                    </th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Lifetime value
                                    </th>
                                    <th
                                        class="px-4 py-3 text-left text-[#1F1F1F] w-60 text-sm font-medium leading-normal">
                                        Status</th>
                                    <th class="px-4 py-3 text-left text-[#1F1F1F] text-sm font-medium leading-normal">
                                        Last active
                                    </th>
                                    <th
                                        class="px-4 py-3 text-left text-[#1F1F1F] w-60 text-[#685BCB] text-sm font-medium leading-normal">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (consumers.length===0) { %>
                                    <tr>
                                        <td colspan="9" class="text-center py-4">No customers found</td>
                                    </tr>
                                    <% } else { %>
                                        <% consumers.forEach((user)=> { %>
                                            <tr id="row-<%= user._id %>"
                                                class="border-t border-t-[#BCA6DB] hover:bg-gray-50 cursor-pointer"
                                                onclick="window.location.href='/admin/customers/<%= user._id %>'">
                                                <td class="h-[72px] px-4 py-2 w-14 text-sm font-normal leading-normal">
                                                    <% const nameParts=user.name.trim().split(/\s+/); const
                                                        initials=nameParts.length> 1
                                                        ? (nameParts[0].charAt(0) + nameParts[nameParts.length -
                                                        1].charAt(0)).toUpperCase()
                                                        : user.name.substring(0, 2).toUpperCase();
                                                        const hasImage = user.profileImage && user.profileImage.length >
                                                        0;
                                                        %>
                                                        <% if (hasImage) { %>
                                                            <img src="<%= user.profileImage %>" alt="<%= initials %>"
                                                                class="w-10 h-10 rounded-full object-cover"
                                                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                            <div class="w-10 h-10 rounded-full bg-[#BCA6DB] text-[#2d6a2d] font-bold text-sm items-center justify-center"
                                                                style="display:none;">
                                                                <%= initials %>
                                                            </div>
                                                            <% } else { %>
                                                                <div
                                                                    class="w-10 h-10 rounded-full bg-[#BCA6DB] text-[#2d6a2d] font-bold text-sm flex items-center justify-center">
                                                                    <%= initials %>
                                                                </div>
                                                                <% } %>
                                                </td>
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#1F1F1F] text-sm font-normal leading-normal">
                                                    <%= user.name %>
                                                </td>
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    <%= user.email %>
                                                </td>
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    <%= user.phone || 'N/A' %>
                                                </td>
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    <%= user.totalOrders %>
                                                </td>
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    $<%= user.lifetimeValue %>
                                                </td>
                                                <td class="h-[72px] px-4 py-2 w-60 text-sm font-normal leading-normal">
                                                    <button id="status-<%= user._id %>"
                                                        class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-8 px-4 text-sm font-medium leading-normal w-full user-select-none <%= user.isBlocked ? 'bg-[#f3f4f6] text-[#6b7280]' : 'bg-[#e6f4ea] text-[#1e7e34]' %>"
                                                        style="pointer-events: none;">
                                                        <span class="truncate">
                                                            <%= user.isBlocked ? 'Banned' : 'Active' %>
                                                        </span>
                                                    </button>
                                                </td>
                                                <td
                                                    class="h-[72px] px-4 py-2 text-[#685BCB] text-sm font-normal leading-normal">
                                                    <%= user.lastActive ? new Date(user.lastActive).toLocaleString()
                                                        : 'N/A' %>
                                                </td>
                                                <td class="h-[72px] px-4 py-2 w-48 text-[#685BCB] text-sm font-bold leading-normal tracking-[0.015em] flex gap-3 items-center"
                                                    onclick="event.stopPropagation()">
                                                    <button id="btn-action-<%= user._id %>"
                                                        onclick="toggleBlock('<%= user._id %>', <%= user.isBlocked %>, this)"
                                                        class="hover:text-[#1F1F1F]">
                                                        <%= user.isBlocked ? 'Unban' : 'Ban' %>
                                                    </button>
                                                    <button onclick="deleteUser('<%= user._id %>')"
                                                        class="text-red-500 hover:text-red-700">Delete</button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination UI -->
                    <% if (pagination && pagination.totalPages> 0) { %>
                        <div class="flex justify-center items-center gap-2 mt-6">
                            <!-- Previous Button -->
                            <% if (pagination.hasPrevPage) { %>
                                <a href="/admin/customers?page=<%= pagination.currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                    &laquo; Previous
                                </a>
                                <% } else { %>
                                    <span
                                        class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                        &laquo; Previous
                                    </span>
                                    <% } %>

                                        <!-- Page Numbers -->
                                        <div class="flex gap-1">
                                            <% for (let i=1; i <=pagination.totalPages; i++) { %>
                                                <% if (i===pagination.currentPage) { %>
                                                    <span
                                                        class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#685BCB] text-white text-sm font-bold">
                                                        <%= i %>
                                                    </span>
                                                    <% } else { %>
                                                        <a href="/admin/customers?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                                                            class="flex items-center justify-center h-10 w-10 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                                            <%= i %>
                                                        </a>
                                                        <% } %>
                                                            <% } %>
                                        </div>

                                        <!-- Next Button -->
                                        <% if (pagination.hasNextPage) { %>
                                            <a href="/admin/customers?page=<%= pagination.currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                                                class="flex items-center justify-center h-10 px-4 rounded-lg bg-[#FFFFFF] text-[#1F1F1F] text-sm font-medium hover:bg-[#D3CEEA] transition-colors">
                                                Next &raquo;
                                            </a>
                                            <% } else { %>
                                                <span
                                                    class="flex items-center justify-center h-10 px-4 rounded-lg bg-gray-100 text-gray-400 text-sm font-medium cursor-not-allowed">
                                                    Next &raquo;
                                                </span>
                                                <% } %>
                        </div>

                        <!-- Pagination Info -->
                        <p class="text-center text-sm text-[#685BCB] mt-2">
                            Showing page <%= pagination.currentPage %> of <%= pagination.totalPages %> (<%=
                                        pagination.totalCustomers %> customers)
                        </p>
                        <% } %>
                </div>
                </div>
            </section>
        </main>
    </div>
</body>

</html>
