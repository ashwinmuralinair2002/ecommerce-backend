<!-- Password reset page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />

    <title>SoundWave | Set New Password</title>
    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // --- LOGIC INTEGRATION ---
            // 1. Get query params (email, otp)
            const urlParams = new URLSearchParams(window.location.search);
            const email = urlParams.get('email');
            const otp = urlParams.get('otp'); // Expecting OTP in URL for this flow

            if (!email) {
                showMessage('Missing email parameter. Please use the link from your email.', 'error');
                // Optional: Redirect to forgot-password
            }

            // Note: The UI doesn't have an OTP input, implying the link includes it.
            // If OTP is missing and can't be input, this page is stuck. 
            // For this task, we assume the link provided ??otp=...
            if (!otp) {
                // If we really can't change UI, we can only warn.
                console.warn('Missing OTP in URL. Backend will likely fail.');
            }

            const submitButton = document.getElementById('submitBtn');
            const inputs = document.querySelectorAll('input[type="password"]');
            const passwordInput = inputs[0];
            const confirmInput = inputs[1];

            // Message Helper
            const msgContainer = document.getElementById('auth-message');
            const showMessage = (msg, type) => {
                msgContainer.textContent = msg;
                msgContainer.classList.remove('hidden');
                if (type === 'error') {
                    msgContainer.classList.add('bg-red-100', 'text-red-700');
                    msgContainer.classList.remove('bg-primary-light/40', 'text-primary');
                } else {
                    msgContainer.classList.add('bg-primary-light/40', 'text-primary');
                    msgContainer.classList.remove('bg-red-100', 'text-red-700');
                }
            };

            submitButton.addEventListener('click', async () => {
                // Clear previous
                msgContainer.classList.add('hidden');

                const newPassword = passwordInput.value;
                const confirmPassword = confirmInput.value;

                if (!newPassword || !confirmPassword) {
                    showMessage('Please fill in all fields.', 'error');
                    return;
                }

                if (newPassword !== confirmPassword) {
                    showMessage('Passwords do not match.', 'error');
                    return;
                }

                if (newPassword.length < 6) {
                    showMessage('Password must be at least 6 characters.', 'error');
                    return;
                }

                if (!otp) {
                    // Use SweetAlert input instead of native prompt
                    const { value: manualOtp } = await Swal.fire({
                        title: 'Enter OTP',
                        text: 'Please enter the OTP sent to your email:',
                        input: 'text',
                        inputPlaceholder: '6-digit OTP',
                        showCancelButton: true,
                        confirmButtonText: 'Verify',
                        confirmButtonColor: '#685BCB',
                        preConfirm: (value) => {
                            if (!value) {
                                Swal.showValidationMessage('You need to enter an OTP')
                            }
                            return value
                        }
                    });

                    if (!manualOtp) return;
                    await submitReset(email, manualOtp, newPassword);
                    return;
                }

                await submitReset(email, otp, newPassword);
            });

            async function submitReset(email, otp, newPassword) {
                submitButton.disabled = true;
                submitButton.textContent = 'Resetting...';

                try {
                    const response = await fetch('/api/auth/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email, otp, newPassword })
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        throw new Error(data.error || 'Password reset failed');
                    }

                    showMessage('Password reset successfully! Redirecting...', 'success');
                    setTimeout(() => window.location.href = '/login', 2000);

                } catch (error) {
                    showMessage(error.message, 'error');
                    submitButton.disabled = false;
                    submitButton.textContent = 'Set New Password';
                }
            }

            // Back to login
            document.querySelector('p.cursor-pointer').addEventListener('click', () => {
                window.location.href = '/login';
            });
        });
    </script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-white overflow-x-hidden"
        style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
        <header class="theme-top-nav flex items-center justify-between border-b px-10 py-3">
            <div class="flex items-center gap-4 text-white">
                <h2 class="text-lg font-bold">AudioGear</h2>
            </div>
        </header>

        <main class="flex flex-1 items-center justify-center px-4">
            <div class="w-full max-w-md py-8 flex flex-col items-center">
                <h2 class="text-primary text-[28px] font-bold text-center mb-6">
                    Set New Password
                </h2>

                <div class="relative w-full mb-4">
                    <input type="password" id="newPassword" placeholder="New Password"
                        class="peer form-input w-full h-14 rounded-lg border border-primary-light/70 bg-white px-4 pt-4 pr-10 text-base placeholder-transparent focus:outline-none focus:border-primary text-center" />
                    <label for="newPassword"
                        class="absolute left-1/2 -translate-x-1/2 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-primary/80 peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-primary pointer-events-none">
                        New Password
                    </label>
                    <button type="button" onclick="togglePasswordVisibility('newPassword', 'reset-new-icon')"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-primary/80 hover:text-primary focus:outline-none p-1">
                        <span id="reset-new-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </button>
                </div>

                <div class="relative w-full mb-6">
                    <input type="password" id="confirmPassword" placeholder="Confirm New Password"
                        class="peer form-input w-full h-14 rounded-lg border border-primary-light/70 bg-white px-4 pt-4 pr-10 text-base placeholder-transparent focus:outline-none focus:border-primary text-center" />
                    <label for="confirmPassword"
                        class="absolute left-1/2 -translate-x-1/2 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-primary/80 peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-primary pointer-events-none">
                        Confirm New Password
                    </label>
                    <button type="button" onclick="togglePasswordVisibility('confirmPassword', 'reset-confirm-icon')"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-primary/80 hover:text-primary focus:outline-none p-1">
                        <span id="reset-confirm-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </button>
                </div>

                <button id="submitBtn" class="theme-primary-btn mb-4 h-10 w-full rounded-lg text-sm">
                    Set New Password
                </button>

                <!-- Message Container -->
                <div id="auth-message"
                    class="hidden w-full mb-4 p-3 rounded-lg text-sm font-medium text-center transition-all duration-300">
                </div>

                <p class="text-primary text-sm underline cursor-pointer text-center">
                    Back to Login
                </p>
            </div>
        </main>
    </div>
</body>

</html>
