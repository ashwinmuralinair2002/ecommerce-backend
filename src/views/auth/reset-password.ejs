<!-- Password reset page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />

    <title>SoundWave | Set New Password</title>
    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const email = <%- JSON.stringify(email || '') %>;
            const msgContainer = document.getElementById('auth-message');
            const passwordHint = document.getElementById('password-hint');
            const confirmHint = document.getElementById('confirm-hint');
            const showMessage = (msg, type) => {
                msgContainer.textContent = msg;
                msgContainer.classList.remove('hidden');
                if (type === 'error') {
                    msgContainer.classList.add('bg-red-100', 'text-red-700');
                    msgContainer.classList.remove('bg-primary-light/40', 'text-primary');
                } else {
                    msgContainer.classList.add('bg-primary-light/40', 'text-primary');
                    msgContainer.classList.remove('bg-red-100', 'text-red-700');
                }
            };

            if (!email) {
                showMessage('Reset session expired. Please start again.', 'error');
                return;
            }

            const submitButton = document.getElementById('submitBtn');
            const btnText = submitButton.querySelector('.btn-text');
            const passwordInput = document.getElementById('newPassword');
            const confirmInput = document.getElementById('confirmPassword');

            const validatePasswordStrength = (value) => {
                const trimmedValue = value.trim();

                if (trimmedValue.length < 8) {
                    return 'Password must be at least 8 characters.';
                }

                if (!/[A-Z]/.test(trimmedValue)) {
                    return 'Password must include at least one uppercase letter.';
                }

                if (!/[a-z]/.test(trimmedValue)) {
                    return 'Password must include at least one lowercase letter.';
                }

                if (!/\d/.test(trimmedValue)) {
                    return 'Password must include at least one number.';
                }

                if (!/[^A-Za-z0-9]/.test(trimmedValue)) {
                    return 'Password must include at least one special character.';
                }

                return '';
            };

            const updatePasswordHint = () => {
                const strengthMessage = validatePasswordStrength(passwordInput.value);

                if (!passwordInput.value.trim()) {
                    passwordHint.textContent = 'Use 8+ characters with uppercase, lowercase, number, and special character.';
                    passwordHint.className = 'mt-2 text-xs text-primary/80 text-left';
                    return strengthMessage;
                }

                if (strengthMessage) {
                    passwordHint.textContent = strengthMessage;
                    passwordHint.className = 'mt-2 text-xs text-red-600 text-left';
                } else {
                    passwordHint.textContent = 'Strong password looks good.';
                    passwordHint.className = 'mt-2 text-xs text-green-600 text-left';
                }

                return strengthMessage;
            };

            const updateConfirmHint = () => {
                const trimmedPassword = passwordInput.value.trim();
                const trimmedConfirm = confirmInput.value.trim();

                if (!trimmedConfirm) {
                    confirmHint.textContent = '';
                    confirmHint.className = 'hidden';
                    return '';
                }

                if (trimmedPassword !== trimmedConfirm) {
                    confirmHint.textContent = 'Passwords do not match.';
                    confirmHint.className = 'mt-2 text-xs text-red-600 text-left';
                    return 'Passwords do not match.';
                }

                confirmHint.textContent = 'Passwords match.';
                confirmHint.className = 'mt-2 text-xs text-green-600 text-left';
                return '';
            };

            passwordInput.addEventListener('input', () => {
                updatePasswordHint();
                updateConfirmHint();
            });

            confirmInput.addEventListener('input', updateConfirmHint);

            submitButton.addEventListener('click', async () => {
                // Clear previous
                msgContainer.classList.add('hidden');

                const newPassword = passwordInput.value.trim();
                const confirmPassword = confirmInput.value.trim();

                if (!newPassword || !confirmPassword) {
                    showMessage('Please fill in all fields.', 'error');
                    return;
                }

                const passwordStrengthMessage = updatePasswordHint();
                if (passwordStrengthMessage) {
                    showMessage(passwordStrengthMessage, 'error');
                    return;
                }

                const confirmMessage = updateConfirmHint();
                if (confirmMessage) {
                    showMessage(confirmMessage, 'error');
                    return;
                }

                await submitReset(email, newPassword);
            });

            async function submitReset(email, newPassword) {
                submitButton.disabled = true;
                btnText.textContent = 'Resetting...';

                if (!submitButton.querySelector('.btn-spinner')) {
                    const spinner = document.createElement('span');
                    spinner.className = 'btn-spinner';
                    submitButton.prepend(spinner);
                }

                try {
                    const response = await fetch('/api/auth/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email, newPassword })
                    });

                    let data;
                    try {
                        data = await response.json();
                    } catch {
                        throw new Error("Invalid server response");
                    }

                    if (!response.ok) {
                        if (data.success === false && data.errors && data.errors.length > 0) {
                            throw new Error(data.errors?.[0]?.message || 'Validation failed');
                        } else if (data.message) {
                            throw new Error(data.message);
                        }
                        throw new Error(data.error || "Something went wrong");
                    }

                    showMessage('Password reset successfully! Redirecting...', 'success');
                    setTimeout(() => window.location.href = '/login', 2000);

                } catch (error) {
                    showMessage(error.message, 'error');
                } finally {
                    submitButton.disabled = false;
                    btnText.textContent = 'Set New Password';

                    const spinnerEl = submitButton.querySelector('.btn-spinner');
                    if (spinnerEl) spinnerEl.remove();
                }
            }

            // Back to login
            document.getElementById('back-to-login-btn').addEventListener('click', () => {
                window.location.href = '/login';
            });
        });
    </script>
</head>

<body>
    <div class="theme-auth-shell relative flex min-h-screen w-full flex-col overflow-x-hidden"
        style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
        <header class="theme-top-nav flex items-center justify-between border-b px-10 py-3">
            <div class="flex items-center gap-4 text-white">
                <div class="size-4">
                    <svg viewBox="0 0 48 48" fill="none">
                        <path
                            d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462C2.19985 28.361 1.76794 23.9758 2.60947 19.7452C3.451 15.5145 5.52816 11.6284 8.57829 8.5783C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948C23.9758 1.76795 28.361 2.19986 32.3462 3.85057C36.3314 5.50129 39.7376 8.29668 42.134 11.8833C44.5305 15.4698 45.8096 19.6865 45.8096 24L24 24L24 45.8096Z"
                            fill="currentColor" />
                    </svg>
                </div>
                <h2 class="text-lg font-bold tracking-tight">SoundWave</h2>
            </div>
        </header>

        <main class="flex flex-1 items-center justify-center px-4 py-8">
            <div class="theme-auth-card w-full max-w-md p-8">
                <h2 class="text-primary text-[28px] font-bold text-center mb-6">
                    Set New Password
                </h2>

                <div class="relative w-full mb-4">
                    <input type="password" id="newPassword" placeholder="New Password"
                        class="peer form-input w-full h-14 rounded-lg border border-primary-light/70 bg-white px-4 pt-4 pr-10 text-base placeholder-transparent focus:outline-none focus:border-primary" />
                    <label for="newPassword"
                        class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-primary/80 peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-primary pointer-events-none">
                        New Password
                    </label>
                    <button type="button" onclick="togglePasswordVisibility('newPassword', 'reset-new-icon')"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-primary/80 hover:text-primary focus:outline-none p-1">
                        <span id="reset-new-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </button>
                    <p id="password-hint" class="mt-2 text-xs text-primary/80 text-left">
                        Use 8+ characters with uppercase, lowercase, number, and special character.
                    </p>
                </div>

                <div class="relative w-full mb-6">
                    <input type="password" id="confirmPassword" placeholder="Confirm New Password"
                        class="peer form-input w-full h-14 rounded-lg border border-primary-light/70 bg-white px-4 pt-4 pr-10 text-base placeholder-transparent focus:outline-none focus:border-primary" />
                    <label for="confirmPassword"
                        class="absolute left-4 top-1 text-xs text-primary transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-primary/80 peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-primary pointer-events-none">
                        Confirm New Password
                    </label>
                    <button type="button" onclick="togglePasswordVisibility('confirmPassword', 'reset-confirm-icon')"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-primary/80 hover:text-primary focus:outline-none p-1">
                        <span id="reset-confirm-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </button>
                    <p id="confirm-hint" class="hidden"></p>
                </div>

                <button id="submitBtn"
                    class="theme-primary-btn mb-4 h-10 w-full rounded-lg text-sm flex items-center justify-center gap-2">
                    <span class="btn-text">Set New Password</span>
                </button>

                <!-- Message Container -->
                <div id="auth-message"
                    class="hidden w-full mb-4 p-3 rounded-lg text-sm font-medium text-center transition-all duration-300">
                </div>

                <div class="flex flex-col items-center gap-2">
                    <button id="back-to-login-btn" class="text-sm text-primary">Back to Login</button>
                </div>
            </div>
        </main>
    </div>
</body>

</html>
