<!-- User registration page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />
    <title>SoundWave | Create Account</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <script>
        async function handleSignup() {
            // Get inputs
            const inputs = document.querySelectorAll('input');
            const firstName = inputs[0].value.trim();
            const lastName = inputs[1].value.trim();
            const email = inputs[2].value.trim();
            const password = inputs[3].value;
            const confirmPassword = inputs[4].value;
            const referralCode = inputs[5].value.trim();
            const submitButton = document.getElementById('signup-submit-btn');

            // Message Helper
            const msgContainer = document.getElementById('auth-message');
            const showMessage = (msg, type) => {
                msgContainer.textContent = msg;
                msgContainer.classList.remove('hidden');
                if (type === 'error') {
                    msgContainer.classList.add('bg-red-100', 'text-red-700');
                    msgContainer.classList.remove('bg-green-100', 'text-green-700');
                } else {
                    msgContainer.classList.add('bg-green-100', 'text-green-700');
                    msgContainer.classList.remove('bg-red-100', 'text-red-700');
                }
            };

            // Clear previous
            msgContainer.classList.add('hidden');

            // Reset UI
            submitButton.disabled = true;
            submitButton.textContent = 'Creating Account...';

            try {
                // Client-side validation
                if (!firstName || !lastName || !email || !password || !confirmPassword) {
                    throw new Error('Please fill in all required fields');
                }

                if (password !== confirmPassword) {
                    throw new Error('Passwords do not match');
                }

                if (password.length < 6) {
                    throw new Error('Password must be at least 6 characters');
                }

                // Construct Payload (Mapping firstName + lastName -> name)
                const payload = {
                    name: `${firstName} ${lastName}`,
                    email: email,
                    password: password
                };

                // Call API
                const response = await fetch('/api/auth/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'Signup failed');
                }

                // Success

                showMessage('Account created successfully! Redirecting to OTP...', 'success');
                setTimeout(() => {
                    window.location.href = `/verify-otp`;
                }, 1500);

            } catch (error) {
                showMessage(error.message, 'error');
                submitButton.disabled = false;
                submitButton.textContent = 'Create Account';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const submitButton = document.getElementById('signup-submit-btn');
            if (submitButton) {
                submitButton.addEventListener('click', (e) => {
                    e.preventDefault();
                    handleSignup();
                });
            }
        });
    </script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-[#f8fcf8] overflow-x-hidden"
        style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
        <header class="flex items-center justify-between border-b border-[#e7f4e7] px-10 py-3">
            <div class="flex items-center gap-4 text-[#0d1c0d]">
                <h2 class="text-lg font-bold">SoundWave</h2>
            </div>
        </header>

        <main class="flex flex-1 items-center justify-center px-4">
            <div class="w-full max-w-md py-8">
                <h2 class="text-center text-[28px] font-bold text-[#0d1c0d] mb-6">
                    Create Account
                </h2>

                <div class="relative mb-3">
                    <input id="firstName"
                        class="peer form-input w-full h-14 rounded-lg border border-[#cee8ce] bg-[#f8fcf8] px-4 pt-4 text-base placeholder-transparent focus:outline-none focus:border-[#499c49]"
                        placeholder="First Name" />
                    <label for="firstName"
                        class="absolute left-4 top-1 text-xs text-[#499c49] transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-[#658d5e] peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-[#499c49] pointer-events-none">
                        First Name
                    </label>
                </div>

                <div class="relative mb-3">
                    <input id="lastName"
                        class="peer form-input w-full h-14 rounded-lg border border-[#cee8ce] bg-[#f8fcf8] px-4 pt-4 text-base placeholder-transparent focus:outline-none focus:border-[#499c49]"
                        placeholder="Last Name" />
                    <label for="lastName"
                        class="absolute left-4 top-1 text-xs text-[#499c49] transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-[#658d5e] peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-[#499c49] pointer-events-none">
                        Last Name
                    </label>
                </div>

                <div class="relative mb-3">
                    <input id="email"
                        class="peer form-input w-full h-14 rounded-lg border border-[#cee8ce] bg-[#f8fcf8] px-4 pt-4 text-base placeholder-transparent focus:outline-none focus:border-[#499c49]"
                        placeholder="Email / Phone" />
                    <label for="email"
                        class="absolute left-4 top-1 text-xs text-[#499c49] transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-[#658d5e] peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-[#499c49] pointer-events-none">
                        Email / Phone
                    </label>
                </div>

                <div class="relative mb-3">
                    <input type="password" id="password"
                        class="peer form-input w-full h-14 rounded-lg border border-[#cee8ce] bg-[#f8fcf8] px-4 pt-4 pr-10 text-base placeholder-transparent focus:outline-none focus:border-[#499c49]"
                        placeholder="Password" />
                    <label for="password"
                        class="absolute left-4 top-1 text-xs text-[#499c49] transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-[#658d5e] peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-[#499c49] pointer-events-none">
                        Password
                    </label>
                    <button type="button" onclick="togglePasswordVisibility('password', 'signup-pass-icon')"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-[#658d5e] hover:text-[#499c49] focus:outline-none p-1">
                        <span id="signup-pass-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </button>
                </div>

                <div class="relative mb-3">
                    <input type="password" id="confirmPassword"
                        class="peer form-input w-full h-14 rounded-lg border border-[#cee8ce] bg-[#f8fcf8] px-4 pt-4 pr-10 text-base placeholder-transparent focus:outline-none focus:border-[#499c49]"
                        placeholder="Confirm Password" />
                    <label for="confirmPassword"
                        class="absolute left-4 top-1 text-xs text-[#499c49] transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-[#658d5e] peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-[#499c49] pointer-events-none">
                        Confirm Password
                    </label>
                    <button type="button" onclick="togglePasswordVisibility('confirmPassword', 'signup-confirm-icon')"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-[#658d5e] hover:text-[#499c49] focus:outline-none p-1">
                        <span id="signup-confirm-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </button>
                </div>

                <div class="relative mb-5">
                    <input id="referralCode"
                        class="peer form-input w-full h-14 rounded-lg border border-[#cee8ce] bg-[#f8fcf8] px-4 pt-4 text-base placeholder-transparent focus:outline-none focus:border-[#499c49]"
                        placeholder="Have a referral code? (optional)" />
                    <label for="referralCode"
                        class="absolute left-4 top-1 text-xs text-[#499c49] transition-all duration-200 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:text-base peer-placeholder-shown:text-[#658d5e] peer-focus:top-1 peer-focus:-translate-y-0 peer-focus:text-xs peer-focus:text-[#499c49] pointer-events-none">
                        Have a referral code? (optional)
                    </label>
                </div>

                <button id="signup-submit-btn"
                    class="w-full h-10 rounded-lg bg-[#0df20d] text-sm font-bold text-[#0d1c0d] mb-3">
                    Create Account
                </button>

                <button onclick="window.location.href='/api/auth/google'"
                    class="w-full h-10 rounded-lg bg-[#e7f4e7] text-sm font-bold text-[#0d1c0d] mb-4">
                    Sign up with Google
                </button>

                <!-- Auth Message Container -->
                <div id="auth-message"
                    class="hidden mt-4 p-3 rounded-lg text-sm font-medium text-center transition-all duration-300">
                </div>

                <p class="text-center text-sm text-[#499c49]">
                    Already have an account?
                    <a href="/login" class="underline">Login</a>
                </p>
            </div>
        </main>
    </div>
</body>

</html>