<!-- OTP verification page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />
    <title>SoundWave | OTP Verification</title>
    <%- include('../partials/user/theme-config') %>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <style>
        /* Ensure OTP inputs don't show spinners */
        .otp-input::-webkit-outer-spin-button,
        .otp-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .otp-input {
            -moz-appearance: textfield;
            appearance: textfield;
            width: 3rem;
            height: 3rem;
            text-align: center;
            font-size: 1.25rem;
            border-radius: 0.5rem;
            border: 1px solid var(--primary-light);
            background-color: var(--white);
        }

        .otp-input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 30%, transparent);
        }
    </style>
</head>

<body>
    <div class="theme-auth-shell relative flex min-h-screen w-full flex-col overflow-x-hidden"
        style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
        <header class="theme-top-nav flex items-center justify-between border-b px-10 py-3">
            <h2 class="text-lg font-bold text-white">SoundWave</h2>
        </header>

        <main class="flex flex-1 items-center justify-center px-4 py-8">
            <div class="theme-auth-card w-full max-w-md p-8">
                <h2 class="text-center text-[28px] font-bold text-primary mb-2">
                    Enter OTP
                </h2>

                <p class="text-center text-base text-primary mb-6">
                    We've sent a 6-digit code to your email address<%= email ? ' (' + email + ')' : '' %>.
                </p>

                <div class="flex justify-center gap-4 mb-6">
                    <input class="otp-input" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]*" />
                    <input class="otp-input" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]*" />
                    <input class="otp-input" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]*" />
                    <input class="otp-input" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]*" />
                    <input class="otp-input" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]*" />
                    <input class="otp-input" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]*" />
                </div>

                <button id="verifyOtpBtn" class="theme-primary-btn mb-4 h-10 w-full rounded-lg text-sm font-bold">
                    Verify OTP
                </button>

                <!-- Auth Message Container -->
                <div id="auth-message"
                    class="hidden mb-4 p-3 rounded-lg text-sm font-medium text-center transition-all duration-300">
                </div>

                <p id="resendOtp"
                    class="text-primary text-sm text-center underline cursor-not-allowed opacity-60 mb-2">
                    Resend OTP in <span id="timer">0:59</span> seconds
                </p>

                <p class="text-primary text-sm text-center underline">
                    Change Email
                </p>

                <script>
                    let timeLeft = 29;
                    const timerSpan = document.getElementById("timer");
                    const resendOtp = document.getElementById("resendOtp");

                    const countdown = setInterval(() => {
                        if (timeLeft <= 0) {
                            clearInterval(countdown);
                            resendOtp.textContent = "Resend OTP";
                            resendOtp.classList.remove("cursor-not-allowed", "opacity-60");
                            resendOtp.classList.add("cursor-pointer");
                            resendOtp.onclick = handleResendOtp; // Enable click
                            return;
                        }

                        timerSpan.textContent = "0:" + timeLeft.toString().padStart(2, "0");
                        timeLeft--;
                    }, 1000);

                    // --- LOGIC INTEGRATION START ---

                    // Message Container Helper
                    const msgContainer = document.getElementById('auth-message');
                    const showMessage = (msg, type) => {
                        msgContainer.textContent = msg;
                        msgContainer.classList.remove('hidden');
                        if (type === 'error') {
                            msgContainer.classList.add('bg-red-100', 'text-red-700');
                            msgContainer.classList.remove('bg-primary-light/40', 'text-primary');
                        } else {
                            msgContainer.classList.add('bg-primary-light/40', 'text-primary');
                            msgContainer.classList.remove('bg-red-100', 'text-red-700');
                        }
                    };

                    // Get Email and Mode from URL
                    const urlParams = new URLSearchParams(window.location.search);
                    // Prioritize rendered email from session, fallback to URL (backward compat)
                    const email = "<%= email %>" || urlParams.get('email');
                    const mode = urlParams.get('mode');

                    if (!email) {
                        // Redirect logic, simplified
                        window.location.href = '/login?error=' + encodeURIComponent('No email provided.');
                    }

                    // OTP Input Handling (Focus movement)
                    const inputs = document.querySelectorAll('.otp-input');
                    inputs.forEach((input, index) => {
                        input.addEventListener('input', (e) => {
                            // Ensure only numbers
                            e.target.value = e.target.value.replace(/[^0-9]/g, '');

                            if (e.target.value.length === 1) {
                                if (index < inputs.length - 1) {
                                    inputs[index + 1].focus();
                                }
                            }
                        });

                        input.addEventListener('paste', (e) => {
                            e.preventDefault();
                            const clipboardData = e.clipboardData || window.clipboardData;
                            const pastedData = clipboardData.getData('Text');
                            // Extract only digits
                            const digits = pastedData.replace(/\D/g, '').split('');

                            if (digits.length > 0) {
                                let currentIndex = index;
                                for (let i = 0; i < digits.length; i++) {
                                    if (currentIndex < inputs.length) {
                                        inputs[currentIndex].value = digits[i];
                                        currentIndex++;
                                    }
                                }

                                // Focus the appropriate bit
                                if (currentIndex < inputs.length) {
                                    inputs[currentIndex].focus();
                                } else {
                                    inputs[inputs.length - 1].focus();
                                }
                            }
                        });

                        input.addEventListener('keydown', (e) => {
                            if (e.key === 'Backspace' && !e.target.value) {
                                if (index > 0) {
                                    inputs[index - 1].focus();
                                }
                            }
                        });
                    });

                    // Verify OTP
                    const verifyButton = document.getElementById('verifyOtpBtn');
                    verifyButton.addEventListener('click', async () => {
                        const otp = Array.from(inputs).map(input => input.value).join('');

                        // Clear previous
                        msgContainer.classList.add('hidden');

                        if (otp.length !== 6) {
                            showMessage('Please enter a valid 6-digit OTP', 'error');
                            return;
                        }

                        // --- RESET PASSWORD MODE ---
                        if (mode === 'reset') {
                            window.location.href = `/reset-password?email=${encodeURIComponent(email)}&otp=${encodeURIComponent(otp)}`;
                            return;
                        }

                        // --- PASSWORD CHANGE MODE ---
                        if (mode === 'password_change') {
                            verifyButton.disabled = true;
                            verifyButton.textContent = 'Verifying...';

                            try {
                                const response = await fetch('/api/profile/password/verify', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ otp })
                                });
                                const data = await response.json();

                                if (!response.ok) throw new Error(data.error || 'Verification failed');

                                showMessage('Password updated successfully!', 'success');
                                setTimeout(() => window.location.href = '/account', 1500);
                                return;
                            } catch (error) {
                                showMessage(error.message, 'error');
                                verifyButton.disabled = false;
                                verifyButton.textContent = 'Verify OTP';
                            }
                            return;
                        }

                        // --- EMAIL CHANGE MODE ---
                        if (mode === 'email_change') {
                            verifyButton.disabled = true;
                            verifyButton.textContent = 'Verifying...';

                            try {
                                const response = await fetch('/api/profile/email/verify', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ otp })
                                });
                                const data = await response.json();

                                if (!response.ok) throw new Error(data.error || 'Verification failed');

                                showMessage('Email updated successfully!', 'success');
                                setTimeout(() => window.location.href = '/account', 1500);
                                return;
                            } catch (error) {
                                showMessage(error.message, 'error');
                                verifyButton.disabled = false;
                                verifyButton.textContent = 'Verify OTP';
                            }
                            return;
                        }

                        // --- DEFAULT SIGNUP MODE ---
                        verifyButton.disabled = true;
                        verifyButton.textContent = 'Verifying...';

                        try {
                            const response = await fetch('/api/auth/verify-otp', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ email, otp })
                            });

                            const data = await response.json();

                            if (!response.ok) {
                                throw new Error(data.error || 'Verification failed');
                            }

                            showMessage('Email verified successfully!', 'success');

                            setTimeout(() => {
                                if (data.redirect) {
                                    window.location.href = data.redirect;
                                } else {
                                    window.location.href = '/home?signup=success';
                                }
                            }, 1000);

                        } catch (error) {
                            showMessage(error.message, 'error');
                        } finally {
                            if (verifyButton.textContent !== 'Verify OTP') { // Only reset if not redirected (heuristic)
                                verifyButton.disabled = false;
                                verifyButton.textContent = 'Verify OTP';
                            }
                        }
                    });

                    // Resend OTP Logic
                    async function handleResendOtp() {
                        if (resendOtp.classList.contains('cursor-not-allowed')) return;

                        // Clear previous
                        msgContainer.classList.add('hidden');

                        resendOtp.textContent = "Sending...";

                        try {
                            let response;
                            if (mode === 'reset') {
                                // Use Forgot Password endpoint for resending reset OTP
                                response = await fetch('/api/auth/forgot-password', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ email })
                                });
                            } else if (mode === 'email_change') {
                                // Re-request email change (generates new OTP)
                                response = await fetch('/api/profile/email/request', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ newEmail: email })
                                });
                            } else if (mode === 'password_change') {
                                // Password Change Resend
                                response = await fetch('/api/profile/password/resend', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    // No body needed as it uses session, but passing empty object just in case
                                    body: JSON.stringify({})
                                });
                            } else {
                                // Default Signup Resend
                                response = await fetch('/api/auth/resend-otp', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ email })
                                });
                            }
                            const data = await response.json();

                            if (!response.ok) {
                                // Check for specific cooldown error
                                if (response.status === 429) {
                                    throw new Error(data.error || 'Please wait before resending.');
                                }
                                throw new Error(data.error || 'Resend failed');
                            }



                            showMessage('OTP Resent! Please check your email.', 'success');
                            // Reset Timer (Optional, but good UX)
                            setTimeout(() => window.location.reload(), 1500);

                        } catch (error) {
                            showMessage(error.message, 'error');
                            resendOtp.textContent = "Resend OTP";
                        }
                    }

                    // Change Email
                    const changeEmailBtn = document.querySelectorAll('p.underline')[1]; // Second P tag with underline
                    if (changeEmailBtn && changeEmailBtn.textContent.trim() === 'Change Email') {
                        changeEmailBtn.style.cursor = 'pointer';
                        changeEmailBtn.addEventListener('click', () => {
                            window.history.back(); // Or redirect to signup
                        });
                    }
                </script>
            </div>
        </main>
    </div>
</body>

</html>
