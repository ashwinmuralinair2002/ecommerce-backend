<!-- OTP verification page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />
    <title>SoundWave | OTP Verification</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/utils.js"></script>
    <style>
        /* Ensure OTP inputs don't show spinners */
        .otp-input::-webkit-outer-spin-button,
        .otp-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .otp-input {
            -moz-appearance: textfield;
            appearance: textfield;
            width: 3rem;
            height: 3rem;
            text-align: center;
            font-size: 1.25rem;
            border-radius: 0.5rem;
            border: 1px solid #cee8ce;
            background-color: #f8fcf8;
        }

        .otp-input:focus {
            border-color: #1ff91f;
            outline: none;
            box-shadow: 0 0 0 2px #1ff91f;
        }
    </style>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-[#f8fcf8] overflow-x-hidden"
        style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
        <header class="flex items-center justify-between border-b border-[#e6f4e6] px-10 py-3">
            <h2 class="text-lg font-bold text-[#0d1c0d]">SoundWave</h2>
        </header>

        <main class="flex flex-1 items-center justify-center px-4">
            <div class="w-full max-w-md py-8">
                <h2 class="text-center text-[28px] font-bold text-[#0d1c0d] mb-2">
                    Enter OTP
                </h2>

                <p class="text-center text-base text-[#0d1c0d] mb-6">
                    We've sent a 6-digit code to your email address.
                </p>

                <div class="flex justify-center gap-4 mb-6">
                    <input class="otp-input" type="number" maxlength="1" />
                    <input class="otp-input" type="number" maxlength="1" />
                    <input class="otp-input" type="number" maxlength="1" />
                    <input class="otp-input" type="number" maxlength="1" />
                    <input class="otp-input" type="number" maxlength="1" />
                    <input class="otp-input" type="number" maxlength="1" />
                </div>

                <button class="w-full h-10 rounded-lg bg-[#1ff91f] text-sm font-bold text-[#0d1c0d] mb-4">
                    Verify OTP
                </button>

                <!-- Auth Message Container -->
                <div id="auth-message"
                    class="hidden mb-4 p-3 rounded-lg text-sm font-medium text-center transition-all duration-300">
                </div>

                <p id="resendOtp"
                    class="text-[#479e47] text-sm text-center underline cursor-not-allowed opacity-60 mb-2">
                    Resend OTP in <span id="timer">0:59</span> seconds
                </p>

                <p class="text-[#479e47] text-sm text-center underline">
                    Change Email
                </p>

                <script>
                    let timeLeft = 59;
                    const timerSpan = document.getElementById("timer");
                    const resendOtp = document.getElementById("resendOtp");

                    const countdown = setInterval(() => {
                        if (timeLeft <= 0) {
                            clearInterval(countdown);
                            resendOtp.textContent = "Resend OTP";
                            resendOtp.classList.remove("cursor-not-allowed", "opacity-60");
                            resendOtp.classList.add("cursor-pointer");
                            resendOtp.onclick = handleResendOtp; // Enable click
                            return;
                        }

                        timerSpan.textContent = "0:" + timeLeft.toString().padStart(2, "0");
                        timeLeft--;
                    }, 1000);

                    // --- LOGIC INTEGRATION START ---

                    // Message Container Helper
                    const msgContainer = document.getElementById('auth-message');
                    const showMessage = (msg, type) => {
                        msgContainer.textContent = msg;
                        msgContainer.classList.remove('hidden');
                        if (type === 'error') {
                            msgContainer.classList.add('bg-red-100', 'text-red-700');
                            msgContainer.classList.remove('bg-green-100', 'text-green-700');
                        } else {
                            msgContainer.classList.add('bg-green-100', 'text-green-700');
                            msgContainer.classList.remove('bg-red-100', 'text-red-700');
                        }
                    };

                    // Get Email and Mode from URL
                    const urlParams = new URLSearchParams(window.location.search);
                    const email = urlParams.get('email');
                    const mode = urlParams.get('mode');

                    if (!email) {
                        // Redirect logic, simplified
                        window.location.href = '/login?error=' + encodeURIComponent('No email provided.');
                    }

                    // OTP Input Handling (Focus movement)
                    const inputs = document.querySelectorAll('.otp-input');
                    inputs.forEach((input, index) => {
                        input.addEventListener('input', (e) => {
                            if (e.target.value.length === 1) {
                                if (index < inputs.length - 1) {
                                    inputs[index + 1].focus();
                                }
                            }
                        });

                        input.addEventListener('keydown', (e) => {
                            if (e.key === 'Backspace' && !e.target.value) {
                                if (index > 0) {
                                    inputs[index - 1].focus();
                                }
                            }
                        });
                    });

                    // Verify OTP
                    const verifyButton = document.querySelector('button.bg-\\[\\#1ff91f\\]');
                    verifyButton.addEventListener('click', async () => {
                        const otp = Array.from(inputs).map(input => input.value).join('');

                        // Clear previous
                        msgContainer.classList.add('hidden');

                        if (otp.length !== 6) {
                            showMessage('Please enter a valid 6-digit OTP', 'error');
                            return;
                        }

                        // --- RESET PASSWORD MODE ---
                        if (mode === 'reset') {
                            window.location.href = `/reset-password?email=${encodeURIComponent(email)}&otp=${encodeURIComponent(otp)}`;
                            return;
                        }

                        // --- DEFAULT SIGNUP MODE ---
                        verifyButton.disabled = true;
                        verifyButton.textContent = 'Verifying...';

                        try {
                            const response = await fetch('/api/auth/verify-otp', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ email, otp })
                            });

                            const data = await response.json();

                            if (!response.ok) {
                                throw new Error(data.error || 'Verification failed');
                            }

                            showMessage('Email verified successfully!', 'success');
                            window.location.href = '/home'; // Go to post-login home

                        } catch (error) {
                            showMessage(error.message, 'error');
                        } finally {
                            if (verifyButton.textContent !== 'Verify OTP') { // Only reset if not redirected (heuristic)
                                verifyButton.disabled = false;
                                verifyButton.textContent = 'Verify OTP';
                            }
                        }
                    });

                    // Resend OTP Logic
                    async function handleResendOtp() {
                        if (resendOtp.classList.contains('cursor-not-allowed')) return;

                        // Clear previous
                        msgContainer.classList.add('hidden');

                        resendOtp.textContent = "Sending...";

                        try {
                            let response;
                            if (mode === 'reset') {
                                // Use Forgot Password endpoint for resending reset OTP
                                response = await fetch('/api/auth/forgot-password', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ email })
                                });
                            } else {
                                // Default Signup Resend
                                response = await fetch('/api/auth/resend-otp', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ email })
                                });
                            }
                            const data = await response.json();

                            if (!response.ok) {
                                // Check for specific cooldown error
                                if (response.status === 429) {
                                    throw new Error(data.error || 'Please wait before resending.');
                                }
                                throw new Error(data.error || 'Resend failed');
                            }

                            showMessage('OTP Resent! Please check your email.', 'success');
                            // Reset Timer (Optional, but good UX)
                            setTimeout(() => window.location.reload(), 1500);

                        } catch (error) {
                            showMessage(error.message, 'error');
                            resendOtp.textContent = "Resend OTP";
                        }
                    }

                    // Change Email
                    const changeEmailBtn = document.querySelectorAll('p.underline')[1]; // Second P tag with underline
                    if (changeEmailBtn && changeEmailBtn.textContent.trim() === 'Change Email') {
                        changeEmailBtn.style.cursor = 'pointer';
                        changeEmailBtn.addEventListener('click', () => {
                            window.history.back(); // Or redirect to signup
                        });
                    }
                </script>
            </div>
        </main>
    </div>
</body>

</html>