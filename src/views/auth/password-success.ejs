<!-- Password reset success page template -->
<!DOCTYPE html>
<html>

<head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link rel="stylesheet" as="style" onload="this.rel='stylesheet'"
        href="https://fonts.googleapis.com/css2?display=swap&family=Noto+Sans:wght@400;500;700;900&family=Space+Grotesk:wght@400;500;700" />

    <title>SoundWave | Password Updated</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const loginBtn = document.querySelector('button');
            loginBtn.addEventListener('click', () => {
                window.location.href = '/login';
            });
        });
    </script>
</head>

<body>
    <div class="relative flex min-h-screen w-full flex-col bg-[#f8fcf8] overflow-x-hidden"
        style='font-family: "Space Grotesk", "Noto Sans", sans-serif;'>
        <header class="flex items-center justify-between border-b border-[#e6f4e6] px-10 py-3">
            <div class="flex items-center gap-4 text-[#0d1c0d]">
                <h2 class="text-lg font-bold">SoundWave</h2>
            </div>
        </header>

        <main class="flex flex-1 items-center justify-center px-4">
            <div class="w-full max-w-md py-8 flex flex-col items-center">
                <h2 class="text-[#0d1c0d] text-[28px] font-bold text-center mb-3">
                    Password Updated Successfully!
                </h2>

                <p class="text-[#0d1c0d] text-base text-center mb-6">
                    Your password has been successfully updated. You can now log in with your new password.
                </p>

                <button class="w-full h-10 rounded-lg bg-[#1ff91f] text-[#0d1c0d] text-sm font-bold">
                    Continue to Login
                </button>
            </div>
        </main>
    </div>
</body>

</html>